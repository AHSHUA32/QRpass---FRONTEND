/* QRPass v65 — scoped mobile + desktop auth polish, loaded after older auth styles. */
/* Both pages use the viewport safely: center short forms, scroll long forms. */
#root .qrpass-auth-page:has(.qrpass-auth-forgot-card),
#root .qrpass-auth-page:has(.qrpass-auth-register-card) {
  min-height: 100vh !important;
  min-height: 100dvh !important;
  height: auto !important;
  overflow-x: clip !important;
  overflow-y: auto !important;
}
#root .qrpass-auth-page .qrpass-auth-content:has(.qrpass-auth-forgot-card),
#root .qrpass-auth-page .qrpass-auth-register-content {
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: safe center !important;
  box-sizing: border-box !important;
  width: 100% !important;
  min-height: 100vh !important;
  min-height: 100dvh !important;
  height: auto !important;
  padding: clamp(22px, 4vh, 45px) 16px !important;
  gap: 0 !important;
}
/* Matching card treatment, but keep separate desktop widths. */
#root .qrpass-auth-page .qrpass-auth-register-card,
#root .qrpass-auth-page .qrpass-auth-forgot-card {
  flex: 0 0 auto !important;
  width: 100% !important;
  min-width: 0 !important;
  border: 1px solid #d7e0ee !important;
  border-radius: 20px !important;
  background: #ffffff !important;
  box-shadow: 0 18px 44px rgba(26, 57, 115, .105) !important;
}
#root .qrpass-auth-page .qrpass-auth-register-card {
  max-width: 540px !important;
  overflow: visible !important; /* Allow the register form's custom popup/listbox to extend outside the card. */
}
#root .qrpass-auth-page .qrpass-auth-forgot-card {
  max-width: 400px !important;
  overflow: hidden !important;
}
/* One header accent, one divider, same left alignment. */
#root .qrpass-auth-page .qrpass-auth-register-card > .bg-primary,
#root .qrpass-auth-page .qrpass-auth-forgot-card > .bg-primary {
  background: #ffffff !important;
  /* Keep existing single navy-to-blue top accent; do not introduce a second line. */
  border-bottom: 1px solid #e4eaf4 !important;
  border-radius: 19px 19px 0 0 !important;
  padding: 19px 24px 17px !important;
  box-shadow: none !important;
}
#root .qrpass-auth-page .qrpass-auth-register-card > .bg-primary h2,
#root .qrpass-auth-page .qrpass-auth-forgot-card > .bg-primary h2 {
  color: #17336d !important;
  font-size: 21px !important;
  font-weight: 700 !important;
  line-height: 1.3 !important;
  letter-spacing: -.015em !important;
  margin: 0 !important;
}
/* Registration — readable labels and touch-sized controls without oversized gaps. */
#root .qrpass-auth-page .qrpass-auth-register-card > .p-5 {
  padding: 20px 24px 22px !important;
}
#root .qrpass-auth-page .qrpass-auth-register-card form label {
  color: #17336d !important;
  font-size: 13px !important;
  font-weight: 600 !important;
  line-height: 1.3 !important;
  margin-bottom: 6px !important;
}
#root .qrpass-auth-page .qrpass-auth-register-card form input:not([type="checkbox"]),
#root .qrpass-auth-page .qrpass-auth-register-card form select,
#root .qrpass-auth-page .qrpass-auth-register-card form button[role="combobox"] {
  min-height: 46px !important;
  box-sizing: border-box !important;
  width: 100%;
  font-size: 14px !important;
  border-radius: 12px !important;
}
#root .qrpass-auth-page .qrpass-auth-register-card form input:not([type="checkbox"]):focus,
#root .qrpass-auth-page .qrpass-auth-register-card form select:focus {
  background-color: #fff !important;
  border-color: #3563c8 !important;
  outline: none !important;
  box-shadow: 0 0 0 3px rgba(53,99,200,.12) !important;
}
#root .qrpass-auth-page .qrpass-auth-register-card form button[type="submit"],
#root .qrpass-auth-page .qrpass-auth-forgot-card form button[type="submit"] {
  min-height: 46px !important;
  border-radius: 12px !important;
  background-image: linear-gradient(180deg,#294c90 0%,#1c335b 100%) !important;
  background-color: #294c90 !important;
  color: #fff !important;
  transition: filter .16s ease, transform .16s ease, box-shadow .16s ease !important;
}
#root .qrpass-auth-page .qrpass-auth-register-card form button[type="submit"]:hover:not(:disabled),
#root .qrpass-auth-page .qrpass-auth-forgot-card form button[type="submit"]:hover:not(:disabled) {
  filter: brightness(1.055) !important;
  transform: translateY(-1px) !important;
}
#root .qrpass-auth-page .qrpass-auth-register-card form button[type="submit"]:active:not(:disabled),
#root .qrpass-auth-page .qrpass-auth-forgot-card form button[type="submit"]:active:not(:disabled) {
  transform: translateY(0) !important;
}
/* Registration footer controls retain room to breathe on narrow screens. */
#root .qrpass-auth-page .qrpass-auth-register-card form > .flex.gap-3.mt-5.justify-end {
  display: flex !important;
  align-items: center !important;
  justify-content: flex-end !important;
  flex-wrap: wrap !important;
  gap: 10px !important;
  margin-top: 16px !important;
}
#root .qrpass-auth-page .qrpass-auth-register-card form > .flex.gap-3.mt-5.justify-end button {
  min-height: 44px !important;
  white-space: nowrap !important;
}
/* Forgot Password — card stays centered vertically even on tall phones. */
#root .qrpass-auth-page .qrpass-auth-forgot-card > form {
  display: flex !important;
  flex-direction: column !important;
  gap: 16px !important;
  padding: 23px 24px 24px !important;
}
#root .qrpass-auth-page .qrpass-auth-forgot-card > form > * + * {
  margin-top: 0 !important;
}
#root .qrpass-auth-page .qrpass-auth-forgot-card form label {
  font-size: 13px !important;
  font-weight: 600 !important;
  margin-bottom: 8px !important;
  text-transform: none !important;
}
#root .qrpass-auth-page .qrpass-auth-forgot-card form input[type="email"] {
  height: 48px !important;
  min-height: 48px !important;
  font-size: 14px !important;
  border-radius: 12px !important;
}
#root .qrpass-auth-page .qrpass-auth-forgot-card form button[type="submit"] {
  min-height: 48px !important;
}
#root .qrpass-auth-page .qrpass-auth-forgot-card form .bg-blue-50 {
  font-size: 13px !important;
  line-height: 1.5 !important;
  padding: 12px 13px !important;
  border-radius: 12px !important;
}
#root .qrpass-auth-page .qrpass-auth-forgot-card form button[type="button"] {
  min-height: 43px !important;
  padding: 10px 16px !important;
}
@media (max-width: 640px) {
  #root .qrpass-auth-page .qrpass-auth-content:has(.qrpass-auth-forgot-card),
  #root .qrpass-auth-page .qrpass-auth-register-content {
    justify-content: safe center !important;
    padding: 18px 14px !important;
  }
  #root .qrpass-auth-page .qrpass-auth-register-card,
  #root .qrpass-auth-page .qrpass-auth-forgot-card {
    max-width: min(100%, 400px) !important;
    border-radius: 19px !important;
  }
  #root .qrpass-auth-page .qrpass-auth-register-card > .bg-primary,
  #root .qrpass-auth-page .qrpass-auth-forgot-card > .bg-primary {
    border-radius: 18px 18px 0 0 !important;
    padding: 16px 18px 14px !important;
  }
  #root .qrpass-auth-page .qrpass-auth-register-card > .bg-primary h2,
  #root .qrpass-auth-page .qrpass-auth-forgot-card > .bg-primary h2 {
    font-size: 19px !important;
  }
  #root .qrpass-auth-page .qrpass-auth-register-card > .p-5 {
    padding: 17px 17px 18px !important;
  }
  #root .qrpass-auth-page .qrpass-auth-register-card form label {
    font-size: 12px !important;
    margin-bottom: 5px !important;
  }
  #root .qrpass-auth-page .qrpass-auth-register-card form input:not([type="checkbox"]),
  #root .qrpass-auth-page .qrpass-auth-register-card form select,
  #root .qrpass-auth-page .qrpass-auth-register-card form button[role="combobox"] {
    min-height: 44px !important;
    font-size: 13px !important;
  }
  #root .qrpass-auth-page .qrpass-auth-register-card form > .flex.gap-3.mt-5.justify-end {
    flex-wrap: nowrap !important;
    gap: 8px !important;
  }
  #root .qrpass-auth-page .qrpass-auth-register-card form > .flex.gap-3.mt-5.justify-end button {
    min-width: 0 !important;
    flex: 1 1 0 !important;
    padding-inline: 8px !important;
    font-size: 12px !important;
  }
  #root .qrpass-auth-page .qrpass-auth-forgot-card > form {
    padding: 20px 19px 22px !important;
    gap: 15px !important;
  }
  #root .qrpass-auth-page .qrpass-auth-forgot-card form input[type="email"],
  #root .qrpass-auth-page .qrpass-auth-forgot-card form button[type="submit"] {
    height: 48px !important;
    min-height: 48px !important;
  }
}
@media (max-width: 360px) {
  #root .qrpass-auth-page .qrpass-auth-content:has(.qrpass-auth-forgot-card),
  #root .qrpass-auth-page .qrpass-auth-register-content { padding: 12px 10px !important; }
  #root .qrpass-auth-page .qrpass-auth-register-card > .p-5 { padding: 14px !important; }
  #root .qrpass-auth-page .qrpass-auth-forgot-card > form { padding: 17px !important; }
}
@media (prefers-reduced-motion: reduce) {
  #root .qrpass-auth-page .qrpass-auth-register-card *,
  #root .qrpass-auth-page .qrpass-auth-forgot-card * { transition: none !important; }
}

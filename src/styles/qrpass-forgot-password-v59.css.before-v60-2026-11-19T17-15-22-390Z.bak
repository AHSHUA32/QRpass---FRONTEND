/* QRPass v59 — Forgot Password only. Matches Create Account card styling. */
#root .qrpass-auth-forgot-card {
  width: 100% !important;
  max-width: 540px !important;
  background: #fff !important;
  border: 1px solid #d7e0ee !important;
  border-radius: 20px !important;
  box-shadow: 0 18px 42px rgba(23, 55, 113, .11) !important;
  overflow: hidden !important;
}
/* Use the same clean title-only header as Create Account; keep the existing blue accent. */
#root .qrpass-auth-forgot-card > .bg-primary,
#root .qrpass-auth-forgot-card > .px-6.pb-4.pt-5 {
  padding: 20px 24px 17px !important;
  border-bottom: 1px solid #e8edf5 !important;
}
#root .qrpass-auth-forgot-card > .bg-primary h2,
#root .qrpass-auth-forgot-card > .px-6.pb-4.pt-5 h2 {
  margin: 0 !important;
  color: #17336d !important;
  font-size: 22px !important;
  font-weight: 700 !important;
  line-height: 1.25 !important;
  letter-spacing: -.02em !important;
}
#root .qrpass-auth-forgot-card > form {
  padding: 24px 26px 25px !important;
  display: flex !important;
  flex-direction: column !important;
  gap: 18px !important;
}
#root .qrpass-auth-forgot-card > form > * + * { margin-top: 0 !important; }
#root .qrpass-auth-forgot-card form label {
  margin-bottom: 9px !important;
  text-transform: none !important;
  letter-spacing: normal !important;
  color: #17336d !important;
  font-size: 14px !important;
  font-weight: 600 !important;
}
#root .qrpass-auth-forgot-card input[type="email"] {
  width: 100% !important;
  height: 54px !important;
  min-height: 54px !important;
  padding-left: 43px !important;
  border-radius: 12px !important;
  background-color: #eef2ff !important;
  border: 1px solid #c7d2fe !important;
  color: #17336d !important;
  font-size: 16px !important;
  box-shadow: none !important;
  transition: background-color .16s ease, border-color .16s ease, box-shadow .16s ease !important;
}
#root .qrpass-auth-forgot-card input[type="email"]:focus {
  background-color: #fff !important;
  border-color: #5278e7 !important;
  outline: none !important;
  box-shadow: 0 0 0 3px rgba(82, 120, 231, .15) !important;
}
#root .qrpass-auth-forgot-card .bg-blue-50 {
  background-color: #edf5ff !important;
  border: 1px solid #bdd7ff !important;
  border-radius: 12px !important;
  padding: 13px 15px !important;
  color: #174baf !important;
  font-size: 13px !important;
  line-height: 1.6 !important;
}
#root .qrpass-auth-forgot-card button[type="submit"] {
  width: 100% !important;
  min-height: 52px !important;
  border: 0 !important;
  border-radius: 12px !important;
  background-color: #294c90 !important;
  background-image: linear-gradient(180deg, #294c90 0%, #1c335b 100%) !important;
  color: #fff !important;
  font-size: 15px !important;
  font-weight: 700 !important;
  box-shadow: 0 8px 18px rgba(26, 54, 111, .14) !important;
  transition: filter .16s ease, box-shadow .16s ease, transform .16s ease !important;
}
#root .qrpass-auth-forgot-card button[type="submit"]:hover:not(:disabled) {
  filter: brightness(1.055) !important;
  box-shadow: 0 11px 22px rgba(26, 54, 111, .19) !important;
  transform: translateY(-1px);
}
#root .qrpass-auth-forgot-card button[type="submit"]:active:not(:disabled) { transform: none; filter: brightness(.98) !important; }
/* Create Account-inspired, subtle outlined Back to Login button. */
#root .qrpass-auth-forgot-card button[type="button"] {
  align-self: center !important;
  width: auto !important;
  min-height: 46px !important;
  padding: 11px 20px !important;
  border: 1px solid #cfd8e6 !important;
  border-radius: 12px !important;
  background-color: #fff !important;
  background-image: none !important;
  color: #536c96 !important;
  font-size: 13px !important;
  font-weight: 600 !important;
  transition: background-color .16s ease, border-color .16s ease !important;
}
#root .qrpass-auth-forgot-card button[type="button"]:hover { background-color: #f2f5ff !important; border-color: #b6c8ef !important; }
#root .qrpass-auth-forgot-card button:focus-visible { outline: 2px solid #5278e7 !important; outline-offset: 3px !important; }
@media (max-width: 580px) {
  #root .qrpass-auth-forgot-card { max-width: 100% !important; }
  #root .qrpass-auth-forgot-card > form { padding: 20px 18px 22px !important; gap: 15px !important; }
  #root .qrpass-auth-forgot-card > .bg-primary,
  #root .qrpass-auth-forgot-card > .px-6.pb-4.pt-5 { padding: 19px 20px 15px !important; }
  #root .qrpass-auth-forgot-card input[type="email"] { height: 52px !important; min-height: 52px !important; }
}
@media (prefers-reduced-motion: reduce) {
  #root .qrpass-auth-forgot-card input, #root .qrpass-auth-forgot-card button { transition: none !important; }
}

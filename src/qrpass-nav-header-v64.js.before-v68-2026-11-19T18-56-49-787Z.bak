/* QRPass v64 — dashboard navbar/header polish; no App.tsx replacement. */
(() => {
  if (typeof document === 'undefined' || window.__qrpassNavHeaderV64) return;
  window.__qrpassNavHeaderV64 = true;
  const styleId = 'qrpass-nav-header-v64-style';
  const css = "/* QRPass v64 — polished navigation and header, scoped to Dashboard only */\n/* Sidebar: preserve the app's own navigation state, React click handlers and role links. */\n#root .qrpass-dashboard-root .qrpass-sidebar {\n  box-shadow: 5px 0 20px rgba(13, 30, 65, .11);\n}\n#root .qrpass-dashboard-root .qrpass-sidebar .qrpass-side-nav {\n  padding: 10px 0 18px !important;\n  scrollbar-width: thin;\n  scrollbar-color: rgba(163,192,245,.35) transparent;\n}\n#root .qrpass-dashboard-root .qrpass-sidebar .qrpass-nav-link {\n  position: relative;\n  display: flex;\n  width: calc(100% - 16px) !important;\n  min-width: 0;\n  min-height: 45px;\n  margin: 4px 8px !important;\n  padding: 11px 12px !important;\n  border: 1px solid transparent !important;\n  border-left: 3px solid transparent !important;\n  border-radius: 11px !important;\n  background: transparent !important;\n  background-image: none !important;\n  color: rgba(234,242,255,.85) !important;\n  box-shadow: none !important;\n  font-weight: 550;\n  letter-spacing: .005em;\n  transform: translateX(0);\n  filter: none !important;\n  transition: background-color 165ms ease, color 165ms ease, border-color 165ms ease, box-shadow 165ms ease, transform 165ms ease !important;\n  -webkit-tap-highlight-color: transparent;\n}\n#root .qrpass-dashboard-root .qrpass-sidebar .qrpass-nav-link:hover:not([aria-current='page']) {\n  background: rgba(130,165,236,.15) !important;\n  background-image: none !important;\n  color: #ffffff !important;\n  border-color: rgba(161,191,247,.18) !important;\n  border-left-color: #7ba5f9 !important;\n  transform: translateX(2px);\n}\n#root .qrpass-dashboard-root .qrpass-sidebar .qrpass-nav-link[aria-current='page'] {\n  color: #ffffff !important;\n  background: linear-gradient(110deg, #2b518f 0%, #1b3b73 100%) !important;\n  border-color: rgba(170,203,255,.14) !important;\n  border-left-color: #8bb2ff !important;\n  box-shadow: 0 5px 14px rgba(5,15,38,.19), inset 0 1px 0 rgba(255,255,255,.065) !important;\n  transform: none !important;\n}\n#root .qrpass-dashboard-root .qrpass-sidebar .qrpass-nav-link[aria-current='page']:hover {\n  background: linear-gradient(110deg, #365fa4 0%, #244784 100%) !important;\n  border-left-color: #b0caff !important;\n}\n#root .qrpass-dashboard-root .qrpass-sidebar .qrpass-nav-link:active {\n  transform: scale(.986) !important;\n  filter: brightness(.98) !important;\n}\n#root .qrpass-dashboard-root .qrpass-sidebar .qrpass-nav-link:focus-visible {\n  outline: 2px solid #a8c7ff !important;\n  outline-offset: 2px !important;\n}\n#root .qrpass-dashboard-root .qrpass-sidebar .qrpass-nav-link > span:first-child {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 19px;\n  transition: opacity 165ms ease, transform 165ms ease;\n}\n#root .qrpass-dashboard-root .qrpass-sidebar .qrpass-nav-link:hover > span:first-child,\n#root .qrpass-dashboard-root .qrpass-sidebar .qrpass-nav-link[aria-current='page'] > span:first-child {\n  opacity: 1 !important;\n  transform: scale(1.05);\n}\n#root .qrpass-dashboard-root .qrpass-sidebar .qrpass-nav-link > span:nth-child(2) {\n  min-width: 0;\n  text-overflow: ellipsis;\n  overflow: hidden;\n}\n\n/* Clean top header: desktop has a little breathing room, mobile keeps 48px\n   to match the existing fixed sidebar/backdrop offset in App.tsx. */\n#root .qrpass-dashboard-root .qrpass-topbar {\n  position: relative;\n  height: 56px !important;\n  min-height: 56px !important;\n  padding-left: 13px !important;\n  padding-right: 13px !important;\n  gap: 10px !important;\n  background: rgba(255,255,255,.98) !important;\n  border-bottom: 1px solid #dbe5f4 !important;\n  box-shadow: 0 3px 16px rgba(24,52,104,.085) !important;\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n}\n#root .qrpass-dashboard-root .qrpass-topbar::after {\n  content: '';\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: -1px;\n  height: 2px;\n  background: linear-gradient(90deg, rgba(26,58,123,.30), rgba(90,137,230,.13) 55%, transparent);\n  pointer-events: none;\n}\n#root .qrpass-dashboard-root .qrpass-header-brand {\n  min-width: 0;\n  gap: 6px !important;\n}\n#root .qrpass-dashboard-root .qrpass-header-brand img {\n  width: 62px !important;\n  height: auto !important;\n  max-height: 51px !important;\n  object-fit: contain !important;\n}\n#root .qrpass-dashboard-root .qrpass-header-brand > span {\n  font-size: 14px !important;\n  font-weight: 750 !important;\n  letter-spacing: .02em;\n  white-space: nowrap;\n}\n#root .qrpass-dashboard-root .qrpass-header-actions {\n  flex-shrink: 0;\n  gap: 6px !important;\n}\n#root .qrpass-dashboard-root .qrpass-header-toggle,\n#root .qrpass-dashboard-root .qrpass-header-actions > button,\n#root .qrpass-dashboard-root .qrpass-header-actions > .relative > button {\n  min-width: 36px;\n  min-height: 36px;\n  border-radius: 10px !important;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: background-color 170ms ease, color 170ms ease, box-shadow 170ms ease, transform 170ms ease !important;\n}\n#root .qrpass-dashboard-root .qrpass-header-toggle:hover,\n#root .qrpass-dashboard-root .qrpass-header-actions > button:hover,\n#root .qrpass-dashboard-root .qrpass-header-actions > .relative > button:hover {\n  background-color: #eef3fe !important;\n  box-shadow: inset 0 0 0 1px #e0e9fb;\n  transform: translateY(-1px);\n}\n#root .qrpass-dashboard-root .qrpass-header-toggle:active,\n#root .qrpass-dashboard-root .qrpass-header-actions > button:active,\n#root .qrpass-dashboard-root .qrpass-header-actions > .relative > button:active {\n  transform: scale(.95) !important;\n}\n#root .qrpass-dashboard-root .qrpass-header-toggle:focus-visible,\n#root .qrpass-dashboard-root .qrpass-header-actions > button:focus-visible,\n#root .qrpass-dashboard-root .qrpass-header-actions > .relative > button:focus-visible {\n  outline: 2px solid #3a69d2 !important;\n  outline-offset: 2px !important;\n}\n#root .qrpass-dashboard-root .qrpass-header-actions > .relative > button[title='Account'] {\n  gap: 8px !important;\n  padding: 3px 8px 3px 4px !important;\n  max-width: min(220px, 32vw);\n}\n#root .qrpass-dashboard-root .qrpass-header-actions > .relative > button[title='Account'] > span {\n  min-width: 0;\n  max-width: 135px;\n}\n\n/* The account and notification panels should open below the taller desktop bar. */\n@media (min-width: 768px) {\n  #root .qrpass-dashboard-root .qrpass-header-actions > .relative > div[class*='sm:absolute'] {\n    top: calc(100% + 8px) !important;\n  }\n}\n@media (min-width: 768px) and (max-width: 1000px) {\n  #root .qrpass-dashboard-root .qrpass-header-actions > .relative > button[title='Account'] > span { max-width: 85px; }\n}\n@media (max-width: 767px) {\n  #root .qrpass-dashboard-root .qrpass-topbar {\n    height: 48px !important;\n    min-height: 48px !important;\n    padding-left: 7px !important;\n    padding-right: 7px !important;\n    gap: 5px !important;\n  }\n  #root .qrpass-dashboard-root .qrpass-header-brand img {\n    width: 49px !important;\n    max-height: 41px !important;\n  }\n  #root .qrpass-dashboard-root .qrpass-header-brand > span { font-size: 13px !important; }\n  #root .qrpass-dashboard-root .qrpass-header-actions { gap: 2px !important; }\n  #root .qrpass-dashboard-root .qrpass-header-toggle,\n  #root .qrpass-dashboard-root .qrpass-header-actions > button,\n  #root .qrpass-dashboard-root .qrpass-header-actions > .relative > button {\n    min-width: 36px;\n    min-height: 36px;\n  }\n  #root .qrpass-dashboard-root .qrpass-header-actions > .relative > button[title='Account'] { padding: 3px !important; }\n  #root .qrpass-dashboard-root .qrpass-sidebar { max-width: calc(100vw - 34px); }\n  #root .qrpass-dashboard-root .qrpass-sidebar .qrpass-nav-link { min-height: 48px; }\n}\n@media (max-width: 370px) {\n  #root .qrpass-dashboard-root .qrpass-header-brand > span { display: none !important; }\n}\n\n/* Keep the dark-mode choice consistent with QRPass Lights Out. */\nhtml.dark #root .qrpass-dashboard-root .qrpass-topbar {\n  background: rgba(13,21,35,.98) !important;\n  border-color: #293b56 !important;\n  box-shadow: 0 3px 16px rgba(0,0,0,.22) !important;\n}\nhtml.dark #root .qrpass-dashboard-root .qrpass-header-toggle:hover,\nhtml.dark #root .qrpass-dashboard-root .qrpass-header-actions > button:hover,\nhtml.dark #root .qrpass-dashboard-root .qrpass-header-actions > .relative > button:hover {\n  background-color: #1b2b46 !important;\n  box-shadow: inset 0 0 0 1px #355177 !important;\n}\nhtml.dark #root .qrpass-dashboard-root .qrpass-sidebar .qrpass-nav-link:hover:not([aria-current='page']) {\n  background-color: rgba(105,147,225,.18) !important;\n  color: white !important;\n}\n@media (prefers-reduced-motion: reduce) {\n  #root .qrpass-dashboard-root .qrpass-nav-link,\n  #root .qrpass-dashboard-root .qrpass-nav-link > span:first-child,\n  #root .qrpass-dashboard-root .qrpass-header-toggle,\n  #root .qrpass-dashboard-root .qrpass-header-actions button {\n    transition: none !important;\n    transform: none !important;\n  }\n}\n";
  if (!document.getElementById(styleId)) {
    const style = document.createElement('style');
    style.id = styleId;
    style.textContent = css;
    document.head.appendChild(style);
  }
  let scheduled = false;
  function selectedButton(btn) {
    const left = String(btn.style.borderLeftColor || '').toLowerCase().replace(/\s/g, '');
    const bg = String(btn.style.backgroundColor || '').toLowerCase().replace(/\s/g, '');
    return left === '#2f5fd6' || left === 'rgb(47,95,214)' ||
      (bg.includes('47,95,214') && !bg.endsWith(',0)')) ||
      (!left && !bg && btn.getAttribute('aria-current') === 'page');
  }
  function decorate() {
    const root = document.querySelector('#root .qrpass-dashboard-root');
    if (!root) return;
    const header = root.querySelector('header');
    if (header) {
      header.classList.add('qrpass-topbar');
      const headerChildren = Array.from(header.children);
      const brand = headerChildren.find(n => n.classList?.contains('gap-1.5') && n.classList?.contains('items-center'));
      const actions = headerChildren.find(n => n.classList?.contains('sm:gap-2') && n.classList?.contains('items-center'));
      if (brand) brand.classList.add('qrpass-header-brand');
      if (actions) actions.classList.add('qrpass-header-actions');
      const toggle = header.querySelector('button');
      if (toggle) {
        toggle.classList.add('qrpass-header-toggle');
        if (!toggle.hasAttribute('aria-label')) toggle.setAttribute('aria-label', 'Toggle navigation');
      }
    }
    const nav = root.querySelector('aside nav');
    if (!nav) return;
    const sidebar = nav.closest('aside');
    if (sidebar) sidebar.classList.add('qrpass-sidebar');
    nav.classList.add('qrpass-side-nav');
    if (!nav.hasAttribute('aria-label')) nav.setAttribute('aria-label', 'Main navigation');
    const buttons = Array.from(nav.children).filter(n => n.tagName === 'BUTTON');
    const active = buttons.find(selectedButton);
    for (const btn of buttons) {
      btn.classList.add('qrpass-nav-link');
      // Earlier blue-button polish treats the current nav as a filled blue button.
      // Keep navigational buttons separate from normal blue ACTION buttons.
      btn.setAttribute('data-qrpass-keep-style', 'true');
      btn.classList.remove('qrp-v57-blue-action');
      if (btn === active) btn.setAttribute('aria-current', 'page');
      else btn.removeAttribute('aria-current');
    }
  }
  function schedule() {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(() => {
      scheduled = false;
      decorate();
    });
  }
  function init() {
    const host = document.getElementById('root');
    if (!host) {
      document.addEventListener('DOMContentLoaded', init, { once: true });
      return;
    }
    const observer = new MutationObserver(schedule);
    // React changes the nav button's style when a different page is selected.
    // Watching style and children avoids a feedback loop from our own classes.
    observer.observe(host, { subtree: true, childList: true, attributes: true, attributeFilter: ['style'] });
    schedule();
  }
  init();
  console.info('[QRPass] v64 navbar/header styling active.');
})();

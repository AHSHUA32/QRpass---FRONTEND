// QRPass Manage Logs API client. Uses the existing login token.
export type QRLogPeriod = 'today' | 'yesterday' | '7' | '30' | 'custom';
export const qrpassLogApiBase = (import.meta.env.VITE_API_URL || 'http://127.0.0.1:8000/api').replace(/\/$/, '');
export async function qrpassManageLogsRequest(endpoint: string, method: 'GET'|'POST', payload?: Record<string,string>) {
  const token = localStorage.getItem('token');
  if (!token) throw new Error('Please log in again.');
  let url = `${qrpassLogApiBase}/sysadmin/manage-audit-logs/${endpoint}`;
  if (method==='GET' && payload) url += '?' + new URLSearchParams(payload).toString();
  const res = await fetch(url, { method, headers: {Authorization:`Bearer ${token}`, Accept:'application/json', ...(method==='POST'?{'Content-Type':'application/json'}:{})}, ...(method==='POST'?{body:JSON.stringify(payload||{})}:{}) });
  if (!res.ok) { const error=await res.json().catch(()=>({})); throw new Error(error.message || `Manage Logs API error ${res.status}`); }
  return res;
}

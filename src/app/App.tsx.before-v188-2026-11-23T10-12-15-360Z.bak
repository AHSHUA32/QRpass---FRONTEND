function RegistrationField({
  label,
  field,
  value,
  onChange,
  placeholder,
  optional = false,
  type = "text",
}: {
  label: string;
  field: string;
  value: string;
  onChange: (field: string, value: string) => void;
  placeholder?: string;
  optional?: boolean;
  type?: string;
}) {
  const fieldClass =
    "w-full px-3 py-2.5 text-sm border border-[#c7d2fe] rounded-lg !bg-white hover:!bg-[#eef2ff] focus:!bg-white focus:outline-none focus:border-[#2f5fd6] focus:ring-2 focus:ring-[#2f5fd6]/15";

  return (
    <div>
      <label className="block text-xs font-semibold text-foreground mb-1.5">
        {label}
        {optional && (
          <span className="ml-1 text-[11px] font-normal text-muted-foreground">
            (Optional)
          </span>
        )}
      </label>

      <input
        type={type}
        value={value}
        onChange={(e) =>
          onChange(field, e.target.value)
        }
        placeholder={placeholder}
        className={fieldClass}
        ref={(element) => { if (element) element.style.setProperty("background-color", "#ffffff", "important"); }}
        onMouseEnter={(event) => { if (document.activeElement !== event.currentTarget) event.currentTarget.style.setProperty("background-color", "#eef2ff", "important"); }}
        onMouseLeave={(event) => event.currentTarget.style.setProperty("background-color", "#ffffff", "important")}
        onFocus={(event) => event.currentTarget.style.setProperty("background-color", "#ffffff", "important")}
        onBlur={(event) => event.currentTarget.style.setProperty("background-color", "#ffffff", "important")}
      />
    </div>
  );
}

/* QRPASS_QUANTITY_INPUT_V135 */
function RegistrationQuantityField({
  value,
  onChange,
}: {
  value: string;
  onChange: (value: string) => void;
}) {
  const currentValue =
    Math.max(
      1,
      Number.parseInt(
        value || "1",
        10
      ) || 1
    );

  function handleChange(
    rawValue: string
  ) {
    if (
      rawValue === ""
    ) {
      onChange("");
      return;
    }

    const digitsOnly =
      rawValue.replace(
        /\D/g,
        ""
      );

    if (
      digitsOnly === ""
    ) {
      onChange("");
      return;
    }

    onChange(
      String(
        Math.max(
          1,
          Number.parseInt(
            digitsOnly,
            10
          ) || 1
        )
      )
    );
  }

  function increaseQuantity() {
    onChange(
      String(
        currentValue + 1
      )
    );
  }

  function decreaseQuantity() {
    onChange(
      String(
        Math.max(
          1,
          currentValue - 1
        )
      )
    );
  }

  return (
    <div>
      <label className="block text-xs font-semibold text-foreground mb-1.5">
        Quantity
      </label>

      <div /* QRPASS_STUDENT_QUANTITY_WHITE_V134 */
      ref={(element) => {
        if (element) {
          element.style.setProperty("background", "#ffffff", "important");
          element.style.setProperty("background-color", "#ffffff", "important");
        }
      }}
      onMouseEnter={(event) => {
        if (!event.currentTarget.contains(document.activeElement)) {
          event.currentTarget.style.setProperty("background", "#eef2ff", "important");
          event.currentTarget.style.setProperty("background-color", "#eef2ff", "important");
        }
      }}
      onMouseLeave={(event) => {
        event.currentTarget.style.setProperty("background", "#ffffff", "important");
        event.currentTarget.style.setProperty("background-color", "#ffffff", "important");
      }}
      onFocusCapture={(event) => {
        event.currentTarget.style.setProperty("background", "#ffffff", "important");
        event.currentTarget.style.setProperty("background-color", "#ffffff", "important");
      }}
      onBlurCapture={(event) => {
        if (!event.currentTarget.contains(event.relatedTarget as Node | null)) {
          event.currentTarget.style.setProperty("background", "#ffffff", "important");
          event.currentTarget.style.setProperty("background-color", "#ffffff", "important");
        }
      }}
      className="flex h-[42px] w-full items-center overflow-hidden rounded-lg border border-[#c7d2fe] !bg-white hover:!bg-[#eef2ff] focus-within:!bg-white transition-colors focus-within:border-[#2f5fd6] focus-within:ring-2 focus-within:ring-[#2f5fd6]/15">
        <input
          type="text"
          inputMode="numeric"
          pattern="[0-9]*"
          value={value}
          onChange={(e) => handleChange(e.target.value)}
          onKeyDown={(e) => {
            if (e.key === "ArrowUp") {
              e.preventDefault();
              increaseQuantity();
            } else if (e.key === "ArrowDown") {
              e.preventDefault();
              decreaseQuantity();
            } else if (e.key.length === 1 && !/[0-9]/.test(e.key) && !(e.ctrlKey || e.metaKey || e.altKey)) {
              e.preventDefault();
            }
          }}
          onBlur={() => {
            if (value === "" || Number(value) < 1) onChange("1");
          }}
          className="min-w-0 flex-1 !bg-white hover:!bg-[#eef2ff] focus:!bg-white px-3 py-2.5 text-sm text-[#111827] outline-none transition-colors"
          placeholder="1"
          aria-label="Quantity"
          ref={(element) => {
            if (element) {
              element.style.setProperty("background", "#ffffff", "important");
              element.style.setProperty("background-color", "#ffffff", "important");
            }
          }}
          onMouseEnter={(event) => {
            if (document.activeElement !== event.currentTarget) {
              event.currentTarget.style.setProperty("background", "#eef2ff", "important");
              event.currentTarget.style.setProperty("background-color", "#eef2ff", "important");
            }
          }}
          onMouseLeave={(event) => {
            event.currentTarget.style.setProperty("background", "#ffffff", "important");
            event.currentTarget.style.setProperty("background-color", "#ffffff", "important");
          }}
          onFocus={(event) => {
            event.currentTarget.style.setProperty("background", "#ffffff", "important");
            event.currentTarget.style.setProperty("background-color", "#ffffff", "important");
          }}
        />
        <div className="mr-1.5 flex h-[34px] w-9 shrink-0 flex-col overflow-hidden rounded-md border border-[#c7d2fe] bg-white shadow-sm">
          {/* QRPASS_BUTTON_HOVER_DIRECT_V158 */}
          <button
            type="button"
            onClick={increaseQuantity}
            className="flex h-1/2 items-center justify-center border-b border-[#dce3ee] text-[#1a3a7b] transition-colors hover:bg-[#e6edff] active:bg-[#d6e3ff] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#2f5fd6]"
            aria-label="Increase quantity"
            title="Increase quantity"
          >
            <span className="text-[12px] font-bold leading-none">▲</span>
          </button>
          <button
            type="button"
            onClick={decreaseQuantity}
            disabled={currentValue <= 1}
            className="flex h-1/2 items-center justify-center text-[#1a3a7b] transition-colors hover:bg-[#e6edff] active:bg-[#d6e3ff] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#2f5fd6] disabled:cursor-not-allowed disabled:opacity-35"
            aria-label="Decrease quantity"
            title="Decrease quantity"
          >
            <span className="text-[12px] font-bold leading-none">▼</span>
          </button>
        </div>
      </div>

      <p className="mt-1 text-[11px] text-muted-foreground">
        Numbers only. Minimum quantity is 1.
      </p>
    </div>
  );
}


// PDF-based choices for the four specified registration groups.
// A custom value is stored directly in the existing form field when Others is chosen.
const COMMON_ITEM_COLORS = [
  "Black", "White", "Gray", "Silver", "Blue", "Red",
  "Green", "Yellow", "Orange", "Pink", "Purple", "Brown",
  "Gold", "Beige", "Multicolor",
];

// QRPASS_INLINE_OTHER_V80: one field for choosing or typing Others (Specify).
// QRPASS_INLINE_OTHER_V80 — same field for Others, preserved from v80/v81.
// QRPASS_INLINE_OTHER_ONE_CLICK_V82 — open existing choices on first arrow click.
function QRPassInlineOtherSelect({
  label, value, options, onChange, placeholder, specifyPlaceholder,
  required = false, maxLength = 255,
  className = "w-full min-h-[44px] rounded-lg border border-[#c7d2fe] bg-[#eef2ff] px-3 py-2.5 text-sm text-[#17336d] outline-none transition-[background-color,border-color,box-shadow] duration-150 focus:border-[#5278e7] focus:bg-white focus:ring-2 focus:ring-[#5278e7]/20",
}: {
  label: string;
  value: string;
  options: string[];
  onChange: (value: string) => void;
  placeholder?: string;
  specifyPlaceholder?: string;
  required?: boolean;
  maxLength?: number;
  className?: string;
}) {
  /* QRPASS_REGISTER_WHITE_V132 - student registration only; no other callers changed */
  const registrationWhiteV132 = className.includes("qrpass-register-white-v132");
  const registerBgV132 = (element: HTMLElement | null, hover: boolean) => {
    if (!element || !registrationWhiteV132) return;
    element.style.setProperty("background-color", hover ? "#eef2ff" : "#ffffff", "important");
  };
  const isCustom = value === "__OTHER__" || (value !== "" && !options.includes(value));
  const inputRef = React.useRef<HTMLInputElement>(null);
  const wrapperRef = React.useRef<HTMLDivElement>(null);
  const [choicesOpen, setChoicesOpen] = React.useState(false);

  // Keep the typing cursor in the same field when Others is first selected.
  React.useEffect(() => {
    if (isCustom && value === "__OTHER__") inputRef.current?.focus();
  }, [isCustom, value === "__OTHER__"]);

  // Clicking elsewhere or pressing Escape closes the floating list.
  React.useEffect(() => {
    if (!choicesOpen) return;
    const outside = (event: PointerEvent) => {
      if (wrapperRef.current && !wrapperRef.current.contains(event.target as Node)) {
        setChoicesOpen(false);
      }
    };
    const escape = (event: KeyboardEvent) => {
      if (event.key === "Escape") setChoicesOpen(false);
    };
    document.addEventListener("pointerdown", outside);
    document.addEventListener("keydown", escape);
    return () => {
      document.removeEventListener("pointerdown", outside);
      document.removeEventListener("keydown", escape);
    };
  }, [choicesOpen]);

  React.useEffect(() => {
    if (!isCustom) setChoicesOpen(false);
  }, [isCustom]);

  if (isCustom) {
    return (
      <div ref={wrapperRef} className="relative w-full min-w-0" style={{ zIndex: choicesOpen ? 90 : undefined }}>
        <input
          ref={(element) => { inputRef.current = element; registerBgV132(element, false); }}
          type="text"
          value={value === "__OTHER__" ? "" : value}
          onChange={e => onChange(e.target.value || "__OTHER__")}
          placeholder={specifyPlaceholder || `Specify ${label.toLowerCase()}`}
          aria-label={`Specify ${label}`}
          required={required}
          maxLength={maxLength}
          className={`${className} !pr-12 focus:!bg-white`}
          onMouseEnter={(event) => registerBgV132(event.currentTarget, document.activeElement !== event.currentTarget)}
          onMouseLeave={(event) => registerBgV132(event.currentTarget, false)}
          onFocus={(event) => registerBgV132(event.currentTarget, false)}
          onBlur={(event) => registerBgV132(event.currentTarget, false)}
        />
        <button
          type="button"
          aria-label={`Show ${label} choices`}
          aria-haspopup="menu"
          aria-expanded={choicesOpen}
          title="Show choices"
          onClick={() => setChoicesOpen(open => !open)}
          className="absolute right-1.5 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-lg !border-0 !bg-transparent !shadow-none text-[#31539b] transition-[background-color,transform] duration-150 hover:!bg-[#e5edff] active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5278e7]"
          >
          <ChevronRight size={17} className={`transition-transform duration-150 ${choicesOpen ? "-rotate-90" : "rotate-90"}`} aria-hidden="true" />
        </button>

        {choicesOpen && (
          <div
            role="menu"
            aria-label={`${label} choices`}
            data-qrpass-others-menu="v82"
            className="absolute left-0 right-0 top-[calc(100%+8px)] z-[100] flex min-w-0 flex-col gap-2 overflow-y-auto rounded-2xl border border-[#c7d2fe] bg-white p-2 shadow-[0_12px_26px_rgba(23,51,109,0.14)]"
            style={{ maxHeight: "min(280px, 48vh)", overscrollBehavior: "contain" }}
          >
            {options.map(option => (
              <button
                key={option}
                type="button"
                role="menuitem"
                onClick={() => { onChange(option); setChoicesOpen(false); }}
                className="min-h-[44px] w-full shrink-0 rounded-xl !border-0 !bg-[#f7f9ff] px-4 py-2.5 text-left text-sm font-medium !text-[#17336d] !shadow-none transition-colors duration-150 hover:!bg-[#dfe8ff] focus-visible:!bg-[#dfe8ff] focus-visible:outline-none active:!bg-[#d6e3ff]"
          >
                {option}
              </button>
            ))}
            <button
              type="button"
              role="menuitem"
              onClick={() => { setChoicesOpen(false); inputRef.current?.focus(); }}
              className="min-h-[44px] w-full shrink-0 rounded-xl !border-0 !bg-[#dfe8ff] px-4 py-2.5 text-left text-sm font-semibold !text-[#17336d] !shadow-none transition-colors duration-150 hover:!bg-[#d6e3ff] focus-visible:outline-none active:!bg-[#c8d8f4]"
          >
              Others (Specify)
            </button>
          </div>
        )}
      </div>
    );
  }

  // When a predefined option is shown, keep the same QRPass dropdown
  // implementation and the original option values as before.
  return (
    <select
      value={value}
      onChange={e => onChange(e.target.value)}
      aria-label={label}
      required={required}
      className={className}
      ref={(element) => {
        if (element && className.includes("qrpass-register-white-v133")) {
          element.style.setProperty("background", "#ffffff", "important");
          element.style.setProperty("background-color", "#ffffff", "important");
          element.style.setProperty("background-image", "none", "important");
        }
      }}
      onPointerEnter={(event) => {
        if (className.includes("qrpass-register-white-v133") && document.activeElement !== event.currentTarget) {
          event.currentTarget.style.setProperty("background", "#eef2ff", "important");
          event.currentTarget.style.setProperty("background-color", "#eef2ff", "important");
        }
      }}
      onPointerLeave={(event) => {
        if (className.includes("qrpass-register-white-v133")) {
          event.currentTarget.style.setProperty("background", "#ffffff", "important");
          event.currentTarget.style.setProperty("background-color", "#ffffff", "important");
        }
      }}
      onFocus={(event) => {
        if (className.includes("qrpass-register-white-v133")) {
          event.currentTarget.style.setProperty("background", "#ffffff", "important");
          event.currentTarget.style.setProperty("background-color", "#ffffff", "important");
        }
      }}
      onBlur={(event) => {
        if (className.includes("qrpass-register-white-v133")) {
          event.currentTarget.style.setProperty("background", "#ffffff", "important");
          event.currentTarget.style.setProperty("background-color", "#ffffff", "important");
        }
      }}
    >
      <option value="" disabled hidden>{placeholder || `Select ${label}`}</option>
      {options.map(option => (
        <option key={option} value={option}>{option}</option>
      ))}
      <option value="__OTHER__">Others (Specify)</option>
    </select>
  );
}

/* QRPASS_REGISTER_DOWNWARD_CHOICES_V116: student Register Item dropdowns always expand BELOW the field.
 * Render list in normal document flow instead of browser-native select popup.
 * This allows the page to scroll downward even near its bottom edge.
 */
function QRPassDownwardRegistrationChoiceV116({
  label, value, options, onChange, specifyPlaceholder, className,
}: {
  label: string;
  value: string;
  options: string[];
  onChange: (value: string) => void;
  specifyPlaceholder?: string;
  className: string;
}) {
  const [open, setOpen] = React.useState(false);
  const [activeIndex, setActiveIndex] = React.useState(0);
  const rootRef = React.useRef<HTMLDivElement>(null);
  const triggerRef = React.useRef<HTMLButtonElement>(null);
  const inputRef = React.useRef<HTMLInputElement>(null);
  const menuRef = React.useRef<HTMLDivElement>(null);
  const listId = React.useId();
  const isCustom = value === "__OTHER__" || (value !== "" && !options.includes(value));
  const allOptions = [...options, "Others (Specify)"];

  React.useEffect(() => {
    if (!open) return;
    const outside = (event: PointerEvent) => {
      if (rootRef.current && !rootRef.current.contains(event.target as Node)) setOpen(false);
    };
    const escape = (event: KeyboardEvent) => {
      if (event.key === "Escape") setOpen(false);
    };
    document.addEventListener("pointerdown", outside);
    document.addEventListener("keydown", escape);
    return () => {
      document.removeEventListener("pointerdown", outside);
      document.removeEventListener("keydown", escape);
    };
  }, [open]);

  React.useEffect(() => {
    if (!open) return;
    const frame = window.requestAnimationFrame(() => {
      menuRef.current?.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });
    return () => window.cancelAnimationFrame(frame);
  }, [open]);

  React.useEffect(() => {
    if (value === "__OTHER__") inputRef.current?.focus();
  }, [value === "__OTHER__"]);

  const show = () => {
    setActiveIndex(Math.max(0, options.indexOf(value)));
    setOpen(true);
  };
  const pick = (option: string) => {
    onChange(option === "Others (Specify)" ? "__OTHER__" : option);
    setOpen(false);
    if (option !== "Others (Specify)") triggerRef.current?.focus();
  };
  const keyDown = (event: React.KeyboardEvent<HTMLButtonElement>) => {
    if (event.key === "ArrowDown" || event.key === "ArrowUp") {
      event.preventDefault();
      if (!open) { show(); return; }
      setActiveIndex(index => (index + (event.key === "ArrowDown" ? 1 : -1) + allOptions.length) % allOptions.length);
    } else if (event.key === "Enter" || event.key === " " ) {
      if (!open) { event.preventDefault(); show(); }
      else { event.preventDefault(); pick(allOptions[activeIndex]); }
    } else if (event.key === "Escape" && open) {
      event.preventDefault(); setOpen(false);
    }
  };

  return (
    <div ref={rootRef} className="w-full min-w-0">
      {isCustom ? (
        <div className="relative w-full min-w-0">
          <input
            ref={inputRef}
            type="text"
            value={value === "__OTHER__" ? "" : value}
            onChange={event => onChange(event.target.value || "__OTHER__")}
            aria-label={`Specify ${label}`}
            placeholder={specifyPlaceholder || `Specify ${label.toLowerCase()}`}
            className={`${className} !pr-12`}
          />
          <button
            type="button"
            aria-label={`Show ${label} choices`}
            aria-haspopup="listbox"
            aria-expanded={open}
            onClick={() => open ? setOpen(false) : show()}
            className="absolute right-1.5 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-lg border-0 bg-transparent text-[#244780] hover:bg-[#edf2ff]"
          >
            <ChevronRight size={16} aria-hidden="true" className={`transition-transform ${open ? "-rotate-90" : "rotate-90"}`} />
          </button>
        </div>
      ) : (
        <button
          ref={triggerRef}
          type="button"
          role="combobox"
          aria-label={label}
          aria-haspopup="listbox"
          aria-expanded={open}
          aria-controls={open ? listId : undefined}
          onClick={() => open ? setOpen(false) : show()}
          onKeyDown={keyDown}
          className={`${className} flex items-center justify-between gap-2 text-left`}
        >
          <span className={`min-w-0 flex-1 truncate ${value ? "" : "text-[#667d9e]"}`}>{value || `Select ${label}`}</span>
          <ChevronRight size={16} aria-hidden="true" className={`shrink-0 transition-transform ${open ? "-rotate-90" : "rotate-90"}`} />
        </button>
      )}

      {open && (
        <div
          id={listId}
          ref={menuRef}
          role="listbox"
          aria-label={`${label} choices`}
          data-qrpass-registration-downward-v116="true"
          className="relative z-[70] mt-2 max-h-[224px] w-full min-w-0 overflow-y-auto rounded-xl border border-[#c7d2fe] bg-white p-1.5 shadow-[0_10px_22px_rgba(23,51,109,0.1)]"
          style={{ overscrollBehavior: "contain" }}
        >
          {allOptions.map((option, index) => (
            <button
              key={option}
              type="button"
              role="option"
              aria-selected={option === value || (option === "Others (Specify)" && isCustom)}
              onMouseEnter={() => setActiveIndex(index)}
              onClick={() => pick(option)}
              className={`mb-1 flex min-h-[40px] w-full items-center rounded-lg border-0 px-3 py-2 text-left text-sm font-medium transition-colors last:mb-0 ${activeIndex === index ? "bg-[#e8efff] text-[#17336d]" : "bg-[#f7f9ff] text-[#17336d] hover:bg-[#e8efff]"}`}
            >
              {option}
            </button>
          ))}
        </div>
      )}
    </div>
  );
}

/* QRPASS_REGISTER_DROPDOWN_V133 */
function RegistrationDropdown({
  label, field, value, options, onChange, optional = false,
}: {
  label: string;
  field: string;
  value: string;
  options: string[];
  onChange: (field: string, value: string) => void;
  optional?: boolean;
}) {
  return (
    <div className="min-w-0">
      <label className="block text-xs font-semibold text-foreground mb-1.5">
        {label}
        {optional && (
          <span className="ml-1 text-[11px] font-normal text-muted-foreground">(Optional)</span>
        )}
      </label>
      <QRPassDownwardRegistrationChoiceV116
        label={label}
        value={value}
        options={options}
        onChange={next => onChange(field, next)}
        specifyPlaceholder={`Specify ${label.toLowerCase()}`}
        className="qrpass-register-white-v132 w-full min-h-[44px] rounded-lg border border-[#c7d2fe] !bg-white hover:!bg-white focus:!bg-white px-3 py-2.5 text-sm text-[#17336d] outline-none transition-colors duration-150 focus:border-[#5278e7] focus:ring-2 focus:ring-[#5278e7]/20 qrpass-register-white-v133"
      />
    </div>
  );
}

/* QRPASS_STUDENT_MOBILE_RESPONSIVE_V171 */
/* QRPASS_COMPUTER_ACCESSORIES_MULTISELECT_V117
 * Multi-select only for Student Register Item > Computer Equipment.
 * Value is a comma-separated string, preserving the existing registration API.
 * Empty optional values are not submitted as accessory descriptions.
 */
function QRPassComputerAccessoriesMultiSelectV117({
  value,
  onChange,
}: {
  value: string;
  onChange: (value: string) => void;
}) {
  const choices = [
    "Charger / Power Adapter",
    "Mouse",
    "Keyboard",
    "Laptop Bag / Sleeve",
    "Headset / Headphones",
    "USB Cable",
    "HDMI / Display Cable",
    "USB Flash Drive",
    "External Hard Drive / SSD",
    "Cooling Pad",
    "Laptop Stand",
  ];
  const [open, setOpen] = React.useState(false);
  const [otherOpen, setOtherOpen] = React.useState(false);
  const rootRef = React.useRef<HTMLDivElement>(null);
  const menuId = React.useId();
  const rawEntries = String(value || "").split(",");
  const entries = rawEntries.map(part => part.trim()).filter(Boolean);
  const known = choices.filter(choice => entries.includes(choice));
  // Preserve trailing spaces as the user types multiword custom accessories.
  const rawOther = rawEntries.find(part => part.trimStart().startsWith("Others: "));
  const extra = rawOther !== undefined
    ? rawOther.trimStart().slice("Others: ".length)
    : entries.filter(part => !choices.includes(part)).join("; ");
  const showOther = otherOpen || extra.length > 0;

  const save = (selected: string[], custom: string) => {
    const clean = custom.replace(/[,|]/g, ";");
    const parts = [...selected, ...(clean.trim() ? ["Others: " + clean] : [])];
    onChange(parts.join(", "));
  };

  React.useEffect(() => {
    if (!open) return;
    const outside = (event: PointerEvent) => {
      if (rootRef.current && !rootRef.current.contains(event.target as Node)) setOpen(false);
    };
    const escape = (event: KeyboardEvent) => {
      if (event.key === "Escape") setOpen(false);
    };
    document.addEventListener("pointerdown", outside);
    document.addEventListener("keydown", escape);
    return () => {
      document.removeEventListener("pointerdown", outside);
      document.removeEventListener("keydown", escape);
    };
  }, [open]);

  const toggle = (choice: string) => {
    save(known.includes(choice) ? known.filter(item => item !== choice) : [...known, choice], extra);
  };

  return (
    <div ref={rootRef} className="min-w-0">
      <label className="mb-1.5 block text-xs font-semibold text-foreground">
        Accessories Included
        <span className="ml-1 text-[11px] font-normal text-muted-foreground">(Optional)</span>
      </label>
      <button
        type="button"
        role="combobox"
        aria-label="Accessories Included"
        aria-haspopup="dialog"
        aria-expanded={open}
        aria-controls={open ? menuId : undefined}
        onClick={() => setOpen(previous => !previous)}
        className="qrpass-register-white-v132 qrpass-register-white-v133 flex min-h-[44px] w-full min-w-0 items-center justify-between gap-2 rounded-lg border border-[#c7d2fe] !bg-white px-3 py-2.5 text-left text-sm text-[#17336d] outline-none transition-colors hover:!bg-[#eef2ff] focus:!bg-white focus:border-[#5278e7] focus:ring-2 focus:ring-[#5278e7]/20"
          >
        <span className="min-w-0 flex-1 truncate">
          {entries.length ? entries.join(", ") : <span className="text-[#667d9e]">Select accessories</span>}
        </span>
        <ChevronRight size={16} aria-hidden="true" className={(open ? "-rotate-90" : "rotate-90") + " shrink-0 transition-transform"} />
      </button>

      {open && (
        <div
          id={menuId}
          role="dialog"
          aria-label="Choose accessories included"
          className="relative z-[70] mt-2 w-full min-w-0 rounded-xl border border-[#c7d2fe] bg-white p-2 shadow-[0_10px_22px_rgba(23,51,109,0.10)]"
        >
          <p className="px-2 pb-2 text-xs text-[#64748b]">Select all accessories included with the item.</p>
          <div className="max-h-[230px] space-y-1 overflow-y-auto" style={{overscrollBehavior:"contain"}}>
            {choices.map(choice => (
              <label
                key={choice}
                className="flex min-h-[38px] cursor-pointer items-center gap-2.5 rounded-lg bg-[#f7f9ff] px-3 py-2 text-sm font-medium text-[#17336d] hover:bg-[#e8efff]"
              >
                <input
                  type="checkbox"
                  checked={known.includes(choice)}
                  onChange={() => toggle(choice)}
                  className="h-4 w-4 shrink-0 accent-[#244780]"
                />
                <span>{choice}</span>
              </label>
            ))}
            <label className="flex min-h-[38px] cursor-pointer items-center gap-2.5 rounded-lg bg-[#f7f9ff] px-3 py-2 text-sm font-medium text-[#17336d] hover:bg-[#e8efff]">
              <input
                type="checkbox"
                checked={showOther}
                onChange={event => {
                  setOtherOpen(event.target.checked);
                  if (!event.target.checked) save(known, "");
                }}
                className="h-4 w-4 shrink-0 accent-[#244780]"
              />
              <span>Others (Specify)</span>
            </label>
          </div>
          {showOther && (
            <input
              type="text"
              value={extra}
              aria-label="Specify other accessory"
              placeholder="Specify other accessory"
              onChange={event => save(known, event.target.value)}
              className="mt-2 min-h-[40px] w-full rounded-lg border border-[#c7d2fe] bg-white px-3 py-2 text-sm text-[#17336d] outline-none focus:border-[#5278e7] focus:ring-2 focus:ring-[#5278e7]/20"
            />
          )}
          <div className="flex justify-end pt-2">
            <button
              type="button"
              onClick={() => setOpen(false)}
              className="rounded-lg border border-[#c7d2fe] bg-[#244780] px-4 py-2 text-xs font-semibold text-white hover:bg-[#17336d]"
          >
              Done
            </button>
          </div>
        </div>
      )}
    </div>
  );
}

function StudentRegisterItem() {
  type RegistrationGroupId =
    | "computer"
    | "highvalue"
    | "mobile"
    | "musical"
    | "sports"
    | "other";

  type RegistrationForm = {
    item_name: string;
    brand_model: string;
    serial_number: string;
    color: string;
    purpose: string;
    accessories_included: string;

    quantity: string;
    complete_description: string;

    computer_type: string;
    processor: string;
    motherboard: string;
    memory: string;
    hard_drive: string;
    monitor: string;
    casing: string;
    cd_dvd_rom: string;
    operating_system: string;

    unit_type: string;
    power_source: string;
    lens_attachment: string;

    storage_capacity: string;

    brand: string;
    model_no: string;
    material_body: string;
    size: string;

    equipment_type: string;
  };

  const registrationGroups: {
    id: RegistrationGroupId;
    name: string;
    description: string;
    types: string;
    color: string;
  }[] = [
    {
      id: "computer",
      name: "Computer Equipment",
      description:
        "For laptops, desktop computers, and similar computer equipment.",
      types: "Laptop / Computer",
      color: "#16224b",
    },
    {
      id: "highvalue",
      name: "High-Value Electronics",
      description:
        "For DSLR cameras, projectors, printers, and similar equipment.",
      types: "Camera (DSLR), Projector, Printer",
      color: "#16224b",
    },
    {
      id: "mobile",
      name: "Mobile / Personal Electronics",
      description:
        "For mobile phones, tablets, and personal audio equipment.",
      types: "Mobile Phone, Tablet, Audio Equipment",
      color: "#0f766e",
    },
    {
      id: "musical",
      name: "Musical Instrument",
      description:
        "For guitars, keyboards, and other musical instruments.",
      types: "Musical Instrument",
      color: "#7c3aed",
    },
    {
      id: "sports",
      name: "Sports Equipment",
      description:
        "For balls, rackets, training gear, and other sports equipment.",
      types: "Sports Equipment",
      color: "#15803d",
    },
    {
      id: "other",
      name: "Other Equipment",
      description:
        "For equipment that does not belong to the other registration groups.",
      types: "Other Equipment",
      color: "#475569",
    },
  ];

  function emptyForm(): RegistrationForm {
    return {
      item_name: "",
      brand_model: "",
      serial_number: "",
      color: "",
      purpose: "",
      accessories_included: "",

      quantity: "1",
      complete_description: "",

      computer_type: "",
      processor: "",
      motherboard: "",
      memory: "",
      hard_drive: "",
      monitor: "",
      casing: "",
      cd_dvd_rom: "",
      operating_system: "",

      unit_type: "",
      power_source: "",
      lens_attachment: "",

      storage_capacity: "",

      brand: "",
      model_no: "",
      material_body: "",
      size: "",

      equipment_type: "",
    };
  }

  const [selectedGroup, setSelectedGroup] =
    useState<RegistrationGroupId | null>(null);

  // Auto-scroll to the selected registration form
  useEffect(() => {
    if (!selectedGroup) return;

    const frame = requestAnimationFrame(() => {
      const form = document.getElementById(
        "qrpass-student-selected-form"
      );

      form?.scrollIntoView({
        behavior: "smooth",
        block: "start",
        inline: "nearest",
      });
    });

    return () => cancelAnimationFrame(frame);
  }, [selectedGroup]);

  const [showRegistrationGuide, setShowRegistrationGuide] = useState(false);

  const [submitting, setSubmitting] =
    useState(false);

  const [form, setForm] =
    useState<RegistrationForm>(emptyForm());

  const activeGroup =
    registrationGroups.find(
      (group) => group.id === selectedGroup
    ) ?? null;

  function getRegistrationGroupIcon(
    groupId: RegistrationGroupId,
    size = 18
  ) {
    switch (groupId) {
      case "computer":
        return <Monitor size={size} strokeWidth={1.8} />;

      case "highvalue":
        return <Camera size={size} strokeWidth={1.8} />;

      case "mobile":
        return <Smartphone size={size} strokeWidth={1.8} />;

      case "musical":
        return <Music2 size={size} strokeWidth={1.8} />;

      case "sports":
        return <Globe2 size={size} strokeWidth={1.8} />;

      case "other":
        return <Box size={size} strokeWidth={1.8} />;

      default:
        return <Package size={size} strokeWidth={1.8} />;
    }
  }

  function updateField(
    key: keyof RegistrationForm,
    value: string
  ) {
    setForm((current) => ({
      ...current,
      [key]: value,
    }));
  }

  function selectGroup(
    groupId: RegistrationGroupId
  ) {
    setSelectedGroup(groupId);
    setForm(emptyForm());
  }

  function backToSelection() {
    setSelectedGroup(null);
    setForm(emptyForm());
  }

  function missingRequiredFields() {
    const required: [string, string][] = [
      [
        "Purpose / Reason for Bringing",
        form.purpose,
      ],
    ];

    if (selectedGroup === "computer") {
      required.push(
        ["Item Name", form.item_name],
        ["Brand & Model", form.brand_model],
        ["Serial Number", form.serial_number],
        ["Color", form.color],
        [
          "Computer / Laptop Type",
          form.computer_type,
        ],
        ["Processor", form.processor],
        ["Motherboard", form.motherboard],
        ["Memory / RAM", form.memory],
        [
          "Hard Drive / Storage",
          form.hard_drive,
        ],
        ["Monitor", form.monitor],
        ["Casing", form.casing],
        [
          "Operating System",
          form.operating_system,
        ]
      );
    }

    if (selectedGroup === "highvalue") {
      required.push(
        ["Item Name", form.item_name],
        ["Brand & Model", form.brand_model],
        ["Serial Number", form.serial_number],
        ["Color", form.color],
        ["Unit Type", form.unit_type],
        [
          "Power Source / Cable",
          form.power_source,
        ],
      );
    }

    if (selectedGroup === "mobile") {
      required.push(
        ["Item Name", form.item_name],
        ["Brand & Model", form.brand_model],
        ["Color", form.color]
      );
    }

    if (selectedGroup === "musical") {
      required.push(
        ["Item Name", form.item_name],
        ["Brand", form.brand],
        ["Model No.", form.model_no],
        [
          "Material / Body",
          form.material_body,
        ]
      );
    }

    if (selectedGroup === "sports") {
      required.push(
        [
          "Equipment Type",
          form.equipment_type,
        ],
        ["Quantity", form.quantity],
      );
    }

    if (selectedGroup === "other") {
      required.push(
        [
          "Item/s with Complete Description",
          form.complete_description,
        ],
        ["Quantity", form.quantity]
      );
    }

    return required
      .filter(
        ([, value]) =>
          (!String(value ?? "").trim() || value === "__OTHER__")
      )
      .map(([label]) => label);
  }

  function buildPayload() {
    const detailParts: string[] = [];

    let itemName =
      form.item_name.trim();

    let brandModel =
      form.brand_model.trim();

    let serialNumber =
      form.serial_number.trim();

    let color =
      form.color.trim();

    let itemType =
      "Other Equipment";

    let quantity =
      String(
        Math.max(
          1,
          Number.parseInt(
            form.quantity.replace(
              /\D/g,
              ""
            ),
            10
          ) || 1
        )
      );

    let computerType = "";
    let processor = "";
    let motherboard = "";
    let memory = "";
    let hardDrive = "";
    let monitor = "";
    let casing = "";
    let cdDvdRom = "";
    let operatingSystem = "";

    if (selectedGroup === "computer") {
      itemType = "Laptop";

      computerType =
        form.computer_type.trim();

      processor =
        form.processor.trim();

      motherboard =
        form.motherboard.trim();

      memory =
        form.memory.trim();

      hardDrive =
        form.hard_drive.trim();

      monitor =
        form.monitor.trim();

      casing =
        form.casing.trim();

      cdDvdRom =
        form.cd_dvd_rom.trim();

      operatingSystem =
        form.operating_system.trim();
    }

    if (selectedGroup === "highvalue") {
      itemType =
        form.unit_type.trim() ||
        "High-Value Electronics";

      detailParts.push(
        `Unit Type: ${form.unit_type.trim()}`,
        `Power Source / Cable: ${form.power_source.trim()}`
      );

      if (
        form.lens_attachment.trim()
      ) {
        detailParts.push(
          `Lens / Attachment Included: ${form.lens_attachment.trim()}`
        );
      }
    }

    if (selectedGroup === "mobile") {
      itemType =
        form.item_name.trim() ||
        "Mobile / Personal Electronics";

      if (
        form.storage_capacity.trim()
      ) {
        detailParts.push(
          `Storage / Capacity: ${form.storage_capacity.trim()}`
        );
      }
    }

    if (selectedGroup === "musical") {
      itemType =
        "Musical Instrument";

      brandModel = [
        form.brand.trim(),
        form.model_no.trim(),
      ]
        .filter(Boolean)
        .join(" ");

      color = "N/A";

      detailParts.push(
        `Material / Body: ${form.material_body.trim()}`
      );

      if (form.size.trim()) {
        detailParts.push(
          `Size: ${form.size.trim()}`
        );
      }
    }

    if (selectedGroup === "sports") {
      itemName =
        form.equipment_type.trim();

      itemType =
        "Sports Equipment";

      brandModel =
        form.brand.trim() || "N/A";

      serialNumber = "";
      color = "N/A";

    }

    if (selectedGroup === "other") {
      itemName =
        form.complete_description.trim();

      itemType =
        "Other Equipment";

      brandModel = "N/A";
      serialNumber = "";
      color = "N/A";
    }

    // Include all PDF dropdown specifications in the existing description payload.
    // This keeps the original form fields and API request format intact.
    if (selectedGroup === "computer") {
      detailParts.push(
        `Computer / Laptop Type: ${form.computer_type.trim()}`,
        `Processor: ${form.processor.trim()}`,
        `Motherboard: ${form.motherboard.trim()}`,
        `Memory / RAM: ${form.memory.trim()}`,
        `Hard Drive / Storage: ${form.hard_drive.trim()}`,
        `Monitor: ${form.monitor.trim()}`,
        `Casing: ${form.casing.trim()}`,
        `Operating System: ${form.operating_system.trim()}`
      );
      // Preserve only filled optional computer fields in the existing description.
      if (form.cd_dvd_rom.trim()) {
        detailParts.push(`CD / DVD ROM: ${form.cd_dvd_rom.trim()}`);
      }
    }

    // The backend stores complete_description but may not save
    // standalone accessories_included. Keep it with the request.
    if (selectedGroup !== "other" && form.accessories_included.trim()) {
      detailParts.push(`Accessories Included: ${form.accessories_included.trim()}`);
    }

    if (
      form.complete_description.trim() &&
      selectedGroup !== "other"
    ) {
      detailParts.push(
        form.complete_description.trim()
      );
    }

    const completeDescription =
      selectedGroup === "other"
        ? form.complete_description.trim()
        : detailParts.join(" | ");

    return {
      item_name: itemName,
      brand_model: brandModel,
      serial_number: serialNumber,
      color,
      item_type: itemType,
      purpose: form.purpose.trim(),

      quantity,
      complete_description:
        completeDescription,

      computer_type: computerType,
      processor,
      motherboard,
      memory,
      hard_drive: hardDrive,
      monitor,
      casing,
      cd_dvd_rom: cdDvdRom,
      operating_system:
        operatingSystem,

      accessories_included:
        form.accessories_included.trim(),

    };
  }

  async function handleItemSubmit(
    e: React.FormEvent
  ) {
    e.preventDefault();

    if (!selectedGroup) {
      return;
    }

    const missing =
      missingRequiredFields();

    if (missing.length > 0) {
      alert(
        `Please complete all required fields before submitting:\n\n${missing
          .map(
            (field) => `• ${field}`
          )
          .join("\n")}`
      );

      return;
    }

    try {
      setSubmitting(true);

      const payload =
        buildPayload();

      await createItem(payload);

      alert(
        "Item registration submitted successfully!"
      );

      setForm(emptyForm());
      setSelectedGroup(null);
    } catch (error) {
      alert(
        error instanceof Error
          ? error.message
          : "Item registration failed."
      );
    } finally {
      setSubmitting(false);
    }
  }


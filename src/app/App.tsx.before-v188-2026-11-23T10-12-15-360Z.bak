    <div
      className={`bg-white border border-[#dce3ee] flex min-h-[92px] w-full items-center gap-4 p-4 ${className}`}
      style={{borderRadius: "14px", boxShadow: "0 6px 18px rgba(16, 26, 51, 0.08)"}}

</span>
          <span data-qrpass-users-dropdown-v53="sort" className="qrpass-users-dd-wrap-v53 qrpass-users-dd-sort-v53">
<select aria-label="Sort user accounts" value={qrpassSortOrder}
            onChange={(e) => setQrpassSortOrder(e.target.value as "newest" | "oldest")}
            className="h-12 w-f!bgw!bg-white hover:!bg-ble-50 focus:!bg-white transition-colorshite hover:!bg-blue-50 focus:!bg-white transition-colorsull shrink-0 rounded-xl border border-[#c7d2fe] bg-[#eef2ff] px-3 text-sm font-medium text-[#17336d] outline-none focus:border-[#5278e7] sm:w-[150px]">
            <option value="newest">Newest first</option>
            <option value="oldest">Oldest first</option>
          </select>
<svg className="qrpass-users-dd-chevron-v53" aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="m4 6 4 4 4-4" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" /></svg>
</span>
          {/* QRPASS_USER_TOOLBAR_HOVER_V142 */}
{/* QRPASS_MANAGE_BUTTONS_V145 */}
<div data-qrpass-users-toolbar-v49="true" className="qrpass-users-toolbar-actions-v49 inline-flex shrink-0 items-center gap-3">
<button type="button"
            onClick={() => {
              setShowAddUser(
                !showAddUser
              );

              setEditUser(null);
              setError("");
              setSuccess("");
            }}
            data-qrpass-hover-uniform-v141="true"  
            onMouseEnter={(e) => {
              const s = e.currentTarget.style;
              s.setProperty("background", "#eef2ff", "important");
              s.setProperty("background-color", "#eef2ff", "important");
              s.setProperty("border-color", "#a8bde4", "important");
              s.setProperty("box-shadow", "none", "important");
              s.setProperty("outline", "none", "important");
            }}
            onMouseLeave={(e) => {
              const s = e.currentTarget.style;
              const focused = document.activeElement === e.currentTarget;
              s.setProperty("background", "#ffffff", "important");
              s.setProperty("background-color", "#ffffff", "important");
              s.setProperty("border-color", focused ? "#a8bde4" : "#cbd5e1", "important");
              s.setProperty("box-shadow", "none", "important");
              s.setProperty("outline", "none", "important");
            }}
            onFocus={(e) => {
              const s = e.currentTarget.style;
              s.setProperty("box-shadow", "none", "important");
              s.setProperty("outline", "none", "important");
              s.setProperty("border-color", "#a8bde4", "important");
            }}
            onBlur={(e) => {
              const s = e.currentTarget.style;
              s.setProperty("background", "#ffffff", "important");
              s.setProperty("background-color", "#ffffff", "important");
              s.setProperty("border-color", "#cbd5e1", "important");
              s.setProperty("box-shadow", "none", "important");
              s.setProperty("outline", "none", "important");
            }}

            className="qrpass-users-add-v49 inline-flex h-12 shrink-0 items-center justify-center gap-2 rounded-xl px-4 text-sm font-semibold"
          >
            <Plus size={14} />

            {showAddUser
              ? "Close Form"
              : "Add User"}
          </button>

          </div>
          <button type="button" onClick={loadUsers} disabled={loading}
            className="inline-flex h-12 shrink-0 items-center justify-center gap-2 rounded-xl px-3 text-sm font-medium text-[#17336d] hover:bg-[#edf2ff] disabled:opacity-50"
          >
            <RefreshCw size={15} className={loading ? "animate-spin" : ""}/> Refresh
          </button>
        </div>
        <div data-qrpass-users-table-v57="true" data-qrpass-users-responsive-v95="true" className="w-full min-w-0 overflow-hidden">
          <table data-qrpass-user-accounts-fit-v95="true" data-qrpass-user-accounts-v94="true" className="w-full min-w-0 table-fixed">
            <colgroup>
              <col />
              <col />
              <col />
              <col />
              <col />
              <col />
              <col />
            </colgroup>
            <thead>
              <tr className="bg-[#fafbfc]">
                {[
                  "Name",
                  "User ID",
                  "Email",
                  "Role",
                  "Created",
                  "Status",
                  "Actions",
                ].map((heading) => (
                  <th
                    key={heading}
                    className="text-left py-3 px-3 text-xs text-muted-foreground font-semibold"
                  >
                    {heading}
                  </th>
                ))}
              </tr>
            </thead>

            <tbody className="divide-y divide-border">
              {loading ? (
                <tr>
                  <td
                    colSpan={7}
                    className="py-12 text-center text-sm text-muted-foreground"
                  >
                    Loading user
                    accounts...
                  </td>
                </tr>
              ) : filteredUsers.length ===
                0 ? (
                <tr>
                  <td
                    colSpan={7}
                    className="py-12 text-center text-sm text-muted-foreground"
                  >
                    No user accounts
                    found.
                  </td>
                </tr>
              ) : (
                filteredUsers.map(
                  (user: any) => {
                    const isActive =
                      String(
                        user.status ??
                          ""
                      ).toLowerCase() ===
                      "approved";
                    const isRevoked = Boolean(user.qrpass_revoked_at); // QRPASS_PERMANENT_ACCESS_V91

                    const isUpdating =
                      updatingId ===
                      user.id;

                    return (
                      <tr
                        key={user.id}
                        className="hover:bg-[#eef2fc] transition-colors"
                      >
                        {/* NAME */}
                        <td className="py-3 px-3">
                          <div className="text-sm font-semibold">
                            {user.name ??
                              "Unknown User"}
                          </div>

                        </td>

                        {/* USER ID */}
                        <td className="py-3 px-3 text-xs font-mono text-muted-foreground">
                          {String(user.username ?? "").trim() || "—"}
                        </td>

                        {/* EMAIL */}
                        <td className="py-3 px-3 text-xs text-muted-foreground">
                          {user.email ??
                            "—"}
                        </td>

                        {/* ROLE */}
                        <td className="py-3 px-3">
                          <span className="inline-flex px-2.5 py-1 bg-blue-50 text-blue-700 rounded-full text-[11px] font-semibold">
                            {getRoleLabel(
                              user.role
                            )}
                          </span>
                        </td>

                        {/* CREATED */}
                        <td className="py-3 px-3 text-xs text-muted-foreground whitespace-nowrap">
                          {formatDate(
                            user.created_at
                          )}
                        </td>

                        {/* STATUS */}
                        <td className="py-3 px-3">
                          <span
                            className={`inline-flex px-2.5 py-1 rounded-full text-[11px] font-semibold ${
                              isRevoked ? "bg-slate-200 text-slate-700" : isActive
                                ? "bg-green-100 text-green-700"
                                : "bg-red-100 text-red-700"
                            }`}
                          >
                            {isRevoked ? "Revoked" : isActive ? "Active" : "Disabled"}
                          </span>
                        </td>

                        {/* ACTIONS */}
                        <td className="py-3 px-3">
                          <div className="flex flex-wrap items-center gap-2">
                            <button type="button" data-qrpass-user-action-v92="edit" onClick={() => handleStartEdit(user)}
                              className="rounded-lg border border-[#cfd8e6] bg-white px-3 py-1.5 text-xs font-semibold text-[#17336d] transition-colors hover:bg-[#eef2fc]"
          >
                              Edit
                            </button>
                            <button type="button" data-qrpass-user-action-v92={user?.qrpass_revoked_at ? "revoked" : isActive ? "disable" : "enable"} onClick={() => handleToggleStatus(user)} disabled={isUpdating || isRevoked}
                              className={`rounded-lg border px-3 py-1.5 text-xs font-semibold transition-colors disabled:opacity-50 ${isActive
                                ? "border-red-200 bg-red-50 text-red-700 hover:bg-red-100"
                                : "border-green-200 bg-green-50 text-green-700 hover:bg-green-100"}`}>
                              {isRevoked ? "Revoked" : isUpdating ? "Updating..." : isActive ? "Disable" : "Enable"}
                            </button>
                            {!isRevoked && (<button type="button" data-qrpass-user-action-v92="revoke"
                              onClick={() => { void handleRevokeUserSessions(user); }}
                              disabled={isUpdating || isRevoked || revokingUserId !== null}
                              title="Permanently revoke access while retaining the account and records"
                              className="rounded-lg border border-[#c7d2fe] bg-white px-3 py-1.5 text-xs font-semibold text-[#17336d] transition-colors hover:bg-[#eef2ff] focus:border-[#5278e7] disabled:opacity-50">
                              {isRevoked ? 'Revoked' : revokingUserId === Number(user.id) ? 'Revoking...' : 'Revoke'}
                            </button>)}
                          </div>
                        </td>
                      </tr>
                    );
                  }
                )
              )}
            </tbody>
          </table>
        </div>

        {!loading &&
          users.length > 0 && (
            <div data-qrpass-users-footer-v57="true" className="px-4 py-3 border-t border-[#cfd8e6] flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between">
              <p className="text-xs text-muted-foreground">
                Showing{" "}
                {filteredUsers.length}{" "}
                of {users.length} user
                accounts
              </p>


            </div>
          )}
      </Card>

      {/* QRPASS_REVOKE_PURGE_NOTIFY_V181: floating success after confirmed backend response */}
      {revokeSuccessV181 && (
        <div className="fixed inset-0 z-[350] flex items-center justify-center bg-[#0f172a]/45 p-4" role="presentation">
          <div role="alertdialog" aria-modal="true" aria-label="Revoke Successfully" className="w-full max-w-sm rounded-2xl bg-white p-6 text-center shadow-2xl">
            <div className="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-green-50 text-green-700 text-2xl">✓</div>
            <h3 className="text-lg font-bold text-[#17336d]">Revoke Successfully</h3>
            <p className="mt-2 text-sm text-slate-600">The account has been removed. Its ID and email are blocked, and CSU and PCO have been notified.</p>
            <button type="button" onClick={() => setRevokeSuccessV181(false)}
              className="mt-5 rounded-xl bg-[#17336d] px-6 py-2.5 text-sm font-semibold text-white">OK</button>
          </div>
        </div>
      )}
      
      {/* QRPASS_DISABLE_FLOATING_CONFIRM_V183: Disable User confirmation only. Revoke modal remains untouched. */}
      {pendingDisableUserV183 && (
        <div
          className="fixed inset-0 z-[330] flex items-center justify-center bg-[#0f172a]/50 p-4"
          role="presentation"
          onMouseDown={(event) => {
            if(event.target===event.currentTarget && !disablingV183){
              setPendingDisableUserV183(null);
              setDisableErrorV183("");
            }
          }}
        >
          <div role="alertdialog" aria-modal="true"
            aria-labelledby="qrpass-disable-title-v183"
            aria-describedby="qrpass-disable-desc-v183"
            className="w-full max-w-[410px] rounded-2xl border border-[#dce3ee] bg-white p-6 text-center shadow-2xl">
            <h3 id="qrpass-disable-title-v183" className="text-lg font-bold text-[#17336d]">
              Disable Account?
            </h3>
            
            {/* QRPASS_DISABLE_DESCRIPTION_UP_V186: reminder 10px below title, 20px before buttons */}
            <div
              id="qrpass-disable-desc-v183"
              className="mx-auto max-w-[340px] text-center"
              style={{
                display: 'block',
                visibility: 'visible',
                opacity: 1,
                color: '#475569',
                fontSize: '14px',
                lineHeight: '24px',
                marginTop: '10px',
                marginBottom: '20px',
                padding: '0 4px',
              }}
            >
              Are you sure you want to disable the account of{' '}
              <strong style={{ color: '#17336d', fontWeight: 600 }}>
                {String(pendingDisableUserV183?.name || 'this user')}
              </strong>?
              {' '}This user will not be able to log in until the account is enabled again.
            </div>
            {disableErrorV183 && (
              <p role="alert" className="mt-4 rounded-lg border border-red-200 bg-red-50 p-3 text-left text-xs text-red-700">{disableErrorV183}</p>
            )}
            <div className="mt-7 flex flex-wrap items-center justify-center gap-3">
              <button type="button" disabled={disablingV183}
                onClick={() => {setPendingDisableUserV183(null);setDisableErrorV183("");}}
                className="min-w-[100px] rounded-xl border border-[#cbd5e1] bg-white px-5 py-2.5 text-sm font-semibold text-[#17336d] hover:bg-[#eef2ff] disabled:opacity-50">
                No
              </button>
              <button type="button" disabled={disablingV183}
                onClick={() => {void confirmDisableV183();}}
                className="min-w-[125px] rounded-xl border border-[#17336d] bg-[#17336d] px-5 py-2.5 text-sm font-semibold text-white disabled:opacity-50">
                {disablingV183 ? "Disabling..." : "Yes, Disable"}
              </button>
            </div>
          </div>
        </div>
      )}

      {/* QRPASS_REVOKE_WHITE_CENTERED_V119 */}
      {pendingRevokeUserV118 && (
        <div
          role="presentation"
          className="fixed inset-0 z-[300] flex items-center justify-center bg-[#0f172a]/50 p-4"
          onMouseDown={(e) => {
            if (e.target === e.currentTarget && revokingUserId === null) {
              setPendingRevokeUserV118(null);
            }
          }}
        >
          <div
            role="alertdialog"
            aria-modal="true"
            aria-labelledby="qrpass-revoke-title-v118"
            aria-describedby="qrpass-revoke-description-v118"
            className="w-full max-w-[410px] rounded-2xl border border-[#dce3ee] bg-white p-6 text-center shadow-2xl" style={{ backgroundColor: "#ffffff" }}
          >
            <h3 id="qrpass-revoke-title-v118" className="text-center text-lg font-bold text-[#17336d]">
              Revoke Account?
            </h3>
                        {/* QRPASS_VISIBLE_REVOKE_DESCRIPTION_V124 */}
            <div
              id="qrpass-revoke-description-v118"
              style={{
                display: "block",
                visibility: "visible",
                opacity: 1,
                color: "#475569",
                fontSize: "14px",
                lineHeight: "24px",
                textAlign: "center",
                marginTop: "12px",
                marginBottom: "0",
                width: "100%",
              }}
            >
              Permanently revoke this account, block its ID and email, remove linked operational records and notify CSU/PCO? This action cannot be undone.
            </div>
            <label htmlFor="qrpass-revoke-reason-v91" className="mt-5 block text-left text-xs font-semibold text-[#17336d]">Reason for revocation (required)</label>
            <textarea id="qrpass-revoke-reason-v91" rows={3} maxLength={500} value={revokeReasonV91}
              onChange={(e) => setRevokeReasonV91(e.target.value)}
              placeholder="e.g. Access terminated after leaving university"
              className="mt-2 w-full rounded-xl border border-[#cbd5e1] bg-white p-3 text-sm text-[#17336d] focus:border-[#5278e7]" />
            <p className="mt-1 text-left text-[11px] text-[#64748b]">At least 5 characters. This permanently deletes related operational records.</p>
            {error && <p role="alert" className="mt-3 text-left text-xs text-red-700">{error}</p>}
            <div className="mt-7 flex flex-wrap items-center justify-center gap-3">
              <button
                type="button"
                onClick={() => setPendingRevokeUserV118(null)}
                className="min-w-[90px] rounded-xl border border-[#cbd5e1] bg-white px-4 py-2.5 text-sm font-semibold text-[#17336d] transition-colors hover:bg-[#eef2ff]"
          >
                No
              </button>
              <button
                type="button"
                onClick={() => { void confirmRevokeV118(); }} disabled={revokingUserId !== null || revokeReasonV91.trim().length < 5}
                className="min-w-[90px] rounded-xl border border-[#17336d] bg-[#17336d] px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[#244e9c]"
              >
                {revokingUserId !== null ? "Revoking..." : "Yes, Revoke"}
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
// QRPASS_QTY_STYLE_SECURITY_V2

function QRPassNumberStepper({
  label,
  value,
  min,
  max,
  onChange,
}: {
  label: string;
  value: number;
  min: number;
  max: number;
  onChange: (value: number) => void;
}) {
  const safeValue = Number.isFinite(Number(value))
    ? Number(value)
    : 0;

  const setClamped = (v: number) =>
    onChange(Math.min(max, Math.max(min, v)));

  // QRPASS_STEPPER_FOCUS_WHITE_V11: white must win on click for BOTH wrapper and child input.
  // Scoped to this numeric stepper; do not change the System Name input or other controls.
  const setQrpassV11Surface = (field: HTMLDivElement, engaged: boolean) => {
    const input = field.querySelector<HTMLInputElement>('input[inputmode="numeric"]');
    if (engaged) {
      // Inline important declarations override legacy Admin/QRPass theme rules.
      field.style.setProperty("background", "#ffffff", "important");
      field.style.setProperty("background-color", "#ffffff", "important");
      if (input) {
        input.style.setProperty("background", "transparent", "important");
        input.style.setProperty("background-color", "transparent", "important");
        input.style.setProperty("box-shadow", "none", "important");
      }
    } else {
      // Remove only our temporary overrides: existing light-blue hover still works.
      field.style.removeProperty("background");
      field.style.removeProperty("background-color");
      if (input) {
        input.style.removeProperty("background");
        input.style.removeProperty("background-color");
        input.style.removeProperty("box-shadow");
      }
    }
  };

  return (
    <div
      data-qrpass-segmented-stepper="v9"
      onPointerDownCapture={event => setQrpassV11Surface(event.currentTarget, true)}
      onFocusCapture={event => setQrpassV11Surface(event.currentTarget, true)}
      onBlurCapture={event => {
        const next = event.relatedTarget;
        if (!(next instanceof Node) || !event.currentTarget.contains(next)) {
          setQrpassV11Surface(event.currentTarget, false);
        }
      }}
      onPointerLeave={event => {
        if (!event.currentTarget.contains(document.activeElement)) {
          setQrpassV11Surface(event.currentTarget, false);
        }
      }}
      className="flex h-12 w-full min-w-0 items-center overflow-hidden rounded-xl border border-[#c7d2fe] !bg-white hover:!bg-[#eef2ff] focus-within:!bg-white focus-within:!border-[#5278e7] focus-within:ring-2 focus-within:ring-[#5278e7]/20 transition-colors"
    >
      <input
        type="text"
        data-qrpass-keep-style
        inputMode="numeric"
        pattern="[0-9]*"
        autoComplete="off"
        aria-label={label}
        value={safeValue === 0 ? "" : String(safeValue)}
        onChange={(e) => {
          const digits = e.target.value.replace(/\D/g, "");

          onChange(
            digits
              ? Math.min(max, Number(digits))
              : 0
          );
        }}
        onBlur={() => {
          if (safeValue < min || safeValue > max) {
            setClamped(safeValue);
          }
        }}
        className="h-full min-w-0 flex-1 !bg-transparent px-4 text-sm text-[#17336d] outline-none"
      />

      <div className="mr-1.5 flex h-9 w-9 shrink-0 flex-col overflow-hidden rounded-md border border-[#c7d2fe] bg-white shadow-sm">
        <button
          type="button"
          title={"Increase " + label}
          aria-label={"Increase " + label}
          disabled={safeValue >= max}
          onClick={() => setClamped(safeValue + 1)}
          className="flex h-1/2 items-center justify-center border-b border-[#c7d2fe] text-[#17336d] transition-colors hover:bg-[#eef2ff] disabled:cursor-not-allowed disabled:opacity-35"
          >
          <span aria-hidden="true" className="inline-flex items-center justify-center"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round"><path d="m6 15 6-6 6 6" /></svg></span>
        </button>

        <button
          type="button"
          title={"Decrease " + label}
          aria-label={"Decrease " + label}
          disabled={safeValue <= min}
          onClick={() => setClamped(safeValue - 1)}
          className="flex h-1/2 items-center justify-center text-[#17336d] transition-colors hover:bg-[#eef2ff] disabled:cursor-not-allowed disabled:opacity-35"
          >
          <span aria-hidden="true" className="inline-flex items-center justify-center"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round"><path d="m6 9 6 6 6-6" /></svg></span>
        </button>
      </div>
    </div>
  );
}


function SysAdminSettings() {
  // QRPASS_INPUT_ONLY_V2
  const [settings, setSettings] = useState({
    system_name: "QRpass",
    institution: "University of Cebu Main Campus",
    academic_year: "2026-2027",
    semester: "1st Semester",
    session_timeout: 30,
    max_login_attempts: 5,
    qr_code_validity_months: 6,
    two_factor_enabled: false,
  });

  // QRPASS_SETTINGS_STRICT_V1
  const onlyLettersAndSpaces = (value: string) => value.replace(/[^A-Za-z ]/g, "").replace(/ {2,}/g, " ");
  const validName = (value: string, max: number) => value.trim().length > 0 && value.trim().length <= max && /^[A-Za-z ]+$/.test(value.trim());
  const validAcademicYear = (value: string) => {
    const match = /^(\d{4})-(\d{4})$/.exec(value);
    return !!match && Number(match[2]) === Number(match[1]) + 1;
  };
  const validInteger = (value: number, low: number, high: number) => Number.isInteger(value) && value >= low && value <= high;
  const validateGeneral = () => {
    if (!validName(settings.system_name, 100)) return "System Name: letters and spaces only (maximum 100).";
    if (!validName(settings.institution, 150)) return "Institution: letters and spaces only (maximum 150).";
    if (!validAcademicYear(settings.academic_year)) return "Academic Year must be consecutive years (example: 2026-2027).";
    if (!["1st Semester", "2nd Semester", "Summer"].includes(settings.semester)) return "Select a valid semester.";
    return "";
  };
  const validatePolicy = () => {
    if (!validInteger(settings.session_timeout, 5, 1440)) return "Session Timeout must be a whole number from 5 to 1440.";
    if (!validInteger(settings.max_login_attempts, 1, 20)) return "Max Login Attempts must be a whole number from 1 to 20.";
    if (!validInteger(settings.qr_code_validity_months, 1, 60)) return "QR Code Validity must be a whole number from 1 to 60.";
    return "";
  };

  // QRPASS_SETTINGS_LEGACY_INSTITUTION_FIX_V1
  // Older database values can contain a hyphen (e.g. University of Cebu - Main Campus).
  // Keep existing values editable while allowing current letters/spaces-only validation.
  useEffect(() => {
    setSettings((current) => {
      const cleanName = String(current.system_name ?? "")
        .replace(/[^A-Za-z\s]/g, "").replace(/\s+/g, " " ).trimStart();
      const cleanInstitution = String(current.institution ?? "")
        .replace(/[^A-Za-z\s]/g, "").replace(/\s+/g, " " ).trimStart();
      if (cleanName === current.system_name && cleanInstitution === current.institution) return current;
      return { ...current, system_name: cleanName, institution: cleanInstitution };
    });
  }, [settings.system_name, settings.institution]);

  const [loading, setLoading] = useState(true);
  const [settingsReady, setSettingsReady] = useState(false);
  const [savingGeneral, setSavingGeneral] = useState(false);
  const [savingPolicy, setSavingPolicy] = useState(false);
  const [error, setError] = useState("");
  const [success, setSuccess] = useState("");

  useEffect(() => {
    loadSettings();
  }, []);

  async function loadSettings() {
    try {
      setLoading(true);
      setSettingsReady(false);
      setError("");

      const data = await getSystemSettings();

      if (data?.settings) {
        setSettingsReady(true);
        setSettings({
          system_name:
            data.settings.system_name ?? "QRpass",

          institution:
            data.settings.institution ??
            "University of Cebu - Main Campus",

          academic_year:
            data.settings.academic_year ?? "2026-2027",

          semester:
            data.settings.semester ?? "1st Semester",

          session_timeout:
            Number(data.settings.session_timeout) || 30,

          max_login_attempts:
            Number(data.settings.max_login_attempts) || 5,

          qr_code_validity_months:
            Number(data.settings.qr_code_validity_months) || 6,

          two_factor_enabled:
            Boolean(data.settings.two_factor_enabled),
        });
      }
    } catch (err) {
      console.error(
        "Failed to load system settings:",
        err
      );

      setError(
        err instanceof Error
          ? err.message
          : "Failed to load system settings."
      );
    } finally {
      setLoading(false);
    }
  }

  async function saveGeneralSettings() {
    const validationError = validateGeneral() || validatePolicy();
    if (validationError) { setError(validationError); setSuccess(""); return; }
    try {
      setSavingGeneral(true);
      setError("");
      setSuccess("");

      const data = await updateSystemSettings(settings);

      if (data?.settings) {
        setSettings({
          ...settings,
          ...data.settings,

          session_timeout:
            Number(data.settings.session_timeout) ||
            settings.session_timeout,

          max_login_attempts:
            Number(data.settings.max_login_attempts) ||
            settings.max_login_attempts,

          qr_code_validity_months:
            Number(data.settings.qr_code_validity_months) ||
            settings.qr_code_validity_months,

          two_factor_enabled:
            Boolean(data.settings.two_factor_enabled),
        });
      }

      localStorage.setItem("qrpass-footer-brand", JSON.stringify({
        institution: String(data?.settings?.institution || settings.institution),
        system_name: String(data?.settings?.system_name || settings.system_name),
      }));
      document.title = String(data?.settings?.system_name || settings.system_name).trim() || "QRpass";
      window.dispatchEvent(new Event("qrpass-settings-updated"));
      setSuccess(
        "General settings saved. System name, page title and footer branding updated."
      );
    } catch (err) {
      console.error(
        "Failed to save general settings:",
        err
      );

      setError(
        err instanceof Error
          ? err.message
          : "Failed to save general settings."
      );
    } finally {
      setSavingGeneral(false);
    }
  }

  async function saveSecurityPolicy() {
    const validationError = validateGeneral() || validatePolicy();
    if (validationError) { setError(validationError); setSuccess(""); return; }
    try {
      setSavingPolicy(true);
      setError("");
      setSuccess("");

      const data = await updateSystemSettings(settings);

      if (data?.settings) {
        setSettings({
          ...settings,
          ...data.settings,

          session_timeout:
            Number(data.settings.session_timeout) ||
            settings.session_timeout,

          max_login_attempts:
            Number(data.settings.max_login_attempts) ||
            settings.max_login_attempts,

          qr_code_validity_months:
            Number(data.settings.qr_code_validity_months) ||
            settings.qr_code_validity_months,

          two_factor_enabled:
            Boolean(data.settings.two_factor_enabled),
        });
      }

      setSuccess(
        "Security policy saved successfully."
      );
    } catch (err) {
      console.error(
        "Failed to save security policy:",
        err
      );

      setError(
        err instanceof Error
          ? err.message
          : "Failed to save security policy."
      );
    } finally {
      setSavingPolicy(false);
    }
  }

  // QRPASS_SETTINGS_INSTANT_RENDER_V17: render forms immediately; fetch saved settings asynchronously.

  return (
    <div className="space-y-5 qrpass-sysadmin-settings-v31">
      <PageHeader
        title="System Settings"
        subtitle="Configure QRpass portal settings and security policies."
      />

      {error && !/^Institution: letters and spaces only/i.test(error.trim()) && (
        <div className="p-3 border border-red-200 bg-red-50 rounded-md text-sm text-red-700">
          {error}
        </div>
      )}

      {success && (
        <div className="p-3 border border-green-200 bg-green-50 rounded-md text-sm text-green-700">
          {success}
        </div>
      )}

      <div className="grid md:grid-cols-2 gap-5" data-qrpass-settings-report-skin="v7">
        <Card title="General Settings">
          <div className="p-4 space-y-4">
            <div>
              <label className="block text-xs font-semibold text-foreground mb-1">
                System Name
              </label>

             
<input
  type="text"
  data-qrpass-keep-style
  title="Letters and spaces only"
  value={settings.system_name}
  maxLength={100}
  onChange={(e) =>
    setSettings((prev) => ({
      ...prev,
      system_name: e.target.value.replace(/[^a-zA-Z\s]/g, ""),
    }))
  }
  className="h-12 w-full rounded-xl border border-[#c7d2fe] !bg-white hover:!bg-[#eef2ff] focus:!bg-white px-4 text-sm text-[#17336d] outline-none transition-colors focus:border-[#5278e7] focus:ring-2 focus:ring-[#5278e7]/20"
/>

            </div>

            <div>
              <label className="block text-xs font-semibold text-foreground mb-1">
                Institution
              </label>

              
<input
  type="text"
  data-qrpass-keep-style
  title="Letters and spaces only"
  value={settings.institution}
  maxLength={150}
  onChange={(e) =>
    setSettings((prev) => ({
      ...prev,
      institution: e.target.value.replace(/[^a-zA-Z\s]/g, ""),
    }))
  }
  className="h-12 w-full rounded-xl border border-[#c7d2fe] !bg-white hover:!bg-[#eef2ff] focus:!bg-white px-4 text-sm text-[#17336d] outline-none transition-colors focus:border-[#5278e7] focus:ring-2 focus:ring-[#5278e7]/20"
/>

            </div>

            <div>
              <label className="block text-xs font-semibold text-foreground mb-1">
                Academic Year
              </label>

              
<select
  data-qrpass-keep-style
  aria-label="Academic Year"
  value={settings.academic_year}
  onChange={(e) =>
    setSettings((prev) => ({
      ...prev,
      academic_year: e.target.value,
    }))
  }
  className="h-12 w-full rounded-xl border border-[#c7d2fe] !bg-white hover:!bg-[#eef2ff] focus:!bg-white px-4 text-sm text-[#17336d] outline-none transition-colors focus:border-[#5278e7] focus:ring-2 focus:ring-[#5278e7]/20"
>

                {(() => {
                  const base = 2024;
                  const count = Math.max(10, new Date().getFullYear() - base + 6);
                  const years = Array.from({length: count}, (_, i) => {
                    const y = base + i;
                    return String(y) + '-' + String(y + 1);
                  });
                  if (settings.academic_year && !years.includes(settings.academic_year)) years.unshift(settings.academic_year);
                  return years.map(year => <option key={year} value={year}>{year}</option>);
                })()}
              </select>
            </div>

            <div>
              <label className="block text-xs font-semibold text-foreground mb-1">
                Semester
              </label>

              
<select
  data-qrpass-keep-style
  aria-label="Semester"
  value={settings.semester}
  onChange={(e) =>
    setSettings((prev) => ({
      ...prev,
      semester: e.target.value,
    }))
  }
  className="h-12 w-full rounded-xl border border-[#c7d2fe] !bg-white hover:!bg-[#eef2ff] focus:!bg-white px-4 text-sm text-[#17336d] outline-none transition-colors focus:border-[#5278e7] focus:ring-2 focus:ring-[#5278e7]/20"
>

                <option value="1st Semester">
                  1st Semester
                </option>

                <option value="2nd Semester">
                  2nd Semester
                </option>

                <option value="Summer">
                  Summer
                </option>
              </select>
            </div>

            <button
              type="button"
              data-qrpass-save-v31="true"
              onClick={saveGeneralSettings}
              disabled={loading || !settingsReady || savingGeneral}
              className="qrpass-settings-save-registration-v72"
                data-qrpass-uniform-v75="true"
                ref={qrpassUniformSysadminActionButtonV75}
            >
              {savingGeneral
                ? "Saving..."
                : "Save Settings"}
            </button>
          </div>
        </Card>

        <Card title="QR & Security Policy">
          <div className="p-4 space-y-4">
            <div>
              <label className="block text-xs font-semibold text-foreground mb-1">
                Session Timeout (minutes)
              </label>

              <QRPassNumberStepper label="Session Timeout (minutes)" value={settings.session_timeout} min={5} max={1440} onChange={(value) => setSettings((prev) => ({ ...prev, session_timeout: value }))} />
            </div>

            <div>
              <label className="block text-xs font-semibold text-foreground mb-1">
                Max Login Attempts
              </label>

              <QRPassNumberStepper label="Max Login Attempts" value={settings.max_login_attempts} min={1} max={20} onChange={(value) => setSettings((prev) => ({ ...prev, max_login_attempts: value }))} />
            </div>

            <div>
              <label className="block text-xs font-semibold text-foreground mb-1">
                QR Code Validity (months)
              </label>

              <QRPassNumberStepper label="QR Code Validity (months)" value={settings.qr_code_validity_months} min={1} max={60} onChange={(value) => setSettings((prev) => ({ ...prev, qr_code_validity_months: value }))} />
            </div>

            <div data-qrpass-two-factor-aligned="v12">
              <label className="block text-xs font-semibold text-foreground mb-1">
                Enable Two-Factor Auth
              </label>
              <div className="flex h-12 min-h-12 w-full min-w-0 items-center justify-between rounded-xl border border-[#cbd5e1] bg-white px-4 transition-colors hover:bg-[#eef2ff] focus-within:!bg-white focus-within:border-[#6b90c7] focus-within:ring-2 focus-within:ring-[#5278e7]/15">
                <span className="text-sm font-normal text-[#17336d]">
                  {settings.two_factor_enabled ? "Enabled" : "Disabled"}
                </span>
                <button
                  type="button"
                  onClick={() =>
                    setSettings((prev) => ({
                      ...prev,
                      two_factor_enabled:
                        !prev.two_factor_enabled,
                    }))
                  }
                  className={`w-10 h-5 rounded-full relative transition-colors ${
                    settings.two_factor_enabled
                      ? "bg-primary"
                      : "bg-gray-300"
                  }`}
                  aria-label="Toggle two-factor authentication"
                >
                  <div
                    className={`w-4 h-4 bg-white rounded-full absolute top-0.5 transition-all ${
                      settings.two_factor_enabled
                        ? "right-0.5"
                        : "left-0.5"
                    }`}
                  />
                </button>
              </div>
            </div>

            <button
              type="button"
              data-qrpass-save-v31="true"
              onClick={saveSecurityPolicy}
              disabled={loading || !settingsReady || savingPolicy}
              className="qrpass-settings-save-registration-v72"
                data-qrpass-uniform-v75="true"
                ref={qrpassUniformSysadminActionButtonV75}
            >
              {savingPolicy
                ? "Saving..."
                : "Save Policy"}
            </button>
          </div>
        </Card>
      </div>
    </div>
  );
}

function SysAdminAuditLogs() {
  const [logs, setLogs] = useState<any[]>([]);

  const [stats, setStats] = useState({
    logs_today: 0,
    qr_scan_events: 0,
    data_changes: 0,
    errors: 0,
  });

  const [search, setSearch] = useState("");
  // QRPASS_SYSTEMLOGS_SEARCH_SORT_V1
  const [sortOrder, setSortOrder] = useState<"newest" | "oldest">("newest");
  const [statusFilter, setStatusFilter] = useState("");
  const [dateFilter, setDateFilter] = useState("");
  const [actionFilter, setActionFilter] = useState("all");
  const [logsPeriod, setLogsPeriod] = useState<CSUDatePeriod>("all");
  const [logsStart, setLogsStart] = useState("");
  const [logsEnd, setLogsEnd] = useState("");

  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  /* QRPass Manage Logs functional v1 */
  const [manageMessage, setManageMessage] = useState("");
  const [manageBusy, setManageBusy] = useState(false);
  const [manageCount, setManageCount] = useState<number | null>(null);
  const [manageArchiveId, setManageArchiveId] = useState("");
  const [manageArchiveDownloaded, setManageArchiveDownloaded] = useState(false);
  const [manageConfirmDelete, setManageConfirmDelete] = useState(false);
  const [manageShowArchives, setManageShowArchives] = useState(false);
  const [manageArchives, setManageArchives] = useState<Array<{archive_id:string;count:number;created_at:string;moved:boolean;restored_at:string|null}>>([]);
  const manageListArchives = async () => {
    try {const r=await qrpassManageLogsRequest("archives","GET");const j=await r.json();setManageArchives(Array.isArray(j.archives)?j.archives:[]);}
    catch(e){setManageMessage(e instanceof Error?e.message:"Could not load archives");}
  };
  const manageUnarchive = async (archiveId:string) => {
    if(manageBusy)return;
    if(!window.confirm("Restore this archive to active System Logs?"))return;
    setManageBusy(true);setManageMessage("");
    try {const r=await qrpassManageLogsRequest("unarchive","POST",{archive_id:archiveId});const j=await r.json();setManageMessage(String(j.restored_count)+" logs restored.");await loadAuditLogs();await manageListArchives();}
    catch(e){setManageMessage(e instanceof Error?e.message:"Unarchive failed");}
    finally{setManageBusy(false);}
  };
  // QRPass Archive Deletion v5: independently delete an archive from storage, not from active audit logs.
  const manageDeleteArchive = async (archiveId:string, count:number) => {
    if(manageBusy)return;
    if(!window.confirm('Permanently delete this archive of '+count+' logs? Archived copy cannot be restored after deletion. Active logs are unaffected.'))return;
    setManageBusy(true);setManageMessage('');
    try {
      const response=await qrpassManageLogsRequest('delete-archive','POST',{archive_id:archiveId,confirmation:'DELETE ARCHIVE'});
      const data=await response.json();
      setManageMessage(data.message || 'Archive permanently deleted.');
      if(manageArchiveId===archiveId){setManageArchiveId('');setManageArchiveDownloaded(false);}
      await manageListArchives();
    }catch(error){setManageMessage(error instanceof Error?error.message:'Could not delete archive');}
    finally{setManageBusy(false);}
  };
  // QRPass Restore & Export v6: allow choosing verified Excel or PDF, not the raw JSON archive.
  const manageDownloadById = async (archiveId:string, format:'xlsx'|'pdf') => {
    if(manageBusy)return;
    setManageBusy(true);setManageMessage('');
    try {
      const r=await qrpassManageLogsRequest('archive/'+archiveId+'/export/'+format,'GET');
      const blob=await r.blob();const url=URL.createObjectURL(blob);
      const link=document.createElement('a');link.href=url;
      link.download='QRPass-audit-archive-'+archiveId+'.'+format;
      document.body.appendChild(link);link.click();link.remove();
      setTimeout(()=>URL.revokeObjectURL(url),1000);
      setManageArchiveDownloaded(true);
    }catch(error){setManageMessage(error instanceof Error?error.message:'Export failed');}
    finally{setManageBusy(false);}
  };
  const [manageStart, setManageStart] = useState("");
  const [manageEnd, setManageEnd] = useState("");
  const manageArgs = () => ({period: (["all","today","yesterday","7","30","custom"].includes(cleanupAge) ? cleanupAge : "today"), ...(cleanupAge === "custom" ? {start:manageStart,end:manageEnd} : {})});
  const managePreview = async () => {
    setManageBusy(true); setManageMessage("");
    try {const r=await qrpassManageLogsRequest("preview","GET",manageArgs()); const j=await r.json();setManageCount(Number(j.count));}
    catch(e){setManageMessage(e instanceof Error?e.message:"Preview failed");}finally{setManageBusy(false);}
  };
  // QRPass Manage Logs archive-unarchive v4: move selected active records into a recoverable archive.
  const manageArchive = async () => {
    if(manageBusy)return;
    setManageBusy(true);setManageMessage("");
    try {
      const r=await qrpassManageLogsRequest("archive-move","POST",manageArgs());
      const j=await r.json();
      setManageArchiveId(j.archive_id);
      setManageMessage(String(j.count)+" logs archived. Use View Archives to download or unarchive.");
      setManageCount(null);
      await loadAuditLogs();
      await manageListArchives();
    }catch(e){setManageMessage(e instanceof Error?e.message:"Archive failed");}
    finally{setManageBusy(false);}
  };  const manageDownload = async (format:'xlsx'|'pdf') => {
    if(manageArchiveId)await manageDownloadById(manageArchiveId,format);
  };
  // QRPass Manage Logs independent delete v3: direct, date-scoped deletion does NOT require an archive.
  const manageDelete = async () => {
    if (manageBusy) return;
    setManageBusy(true);
    setManageMessage("");
    try {
      const r = await qrpassManageLogsRequest("delete-selection", "POST", { ...manageArgs(), confirmation: "DELETE LOGS" });
      const j = await r.json();
      setManageMessage(String(j.deleted_count ?? 0) + " logs permanently deleted for the selected date range.");
      setManageCount(null);
      setManageConfirmDelete(false);
      await loadAuditLogs();
    } catch (e) {
      setManageMessage(e instanceof Error ? e.message : "Delete failed");
    } finally { setManageBusy(false); }
  };
  const [manageLogsOpen, setManageLogsOpen] = useState(false);
  const [cleanupAge, setCleanupAge] = useState("today");
  const [manageSearch, setManageSearch] = useState("");
  const [manageSelectedIds, setManageSelectedIds] = useState<number[]>([]);
  const manageVisibleRecords = logs.filter((log:any)=>{
    const q=manageSearch.trim().toLowerCase();
    return !q || [log.actor_name,log.actor_username,log.action,log.event_type,log.module,log.description,log.status].some(x=>String(x??"").toLowerCase().includes(q));
  }).slice(0,500);
  const manageDownloadSelected = () => {
    const selected=logs.filter((log:any)=>manageSelectedIds.includes(Number(log.id)));
    if(!selected.length)return;
    const sheet=XLSX.utils.json_to_sheet(selected.map((log:any)=>({
      ID:log.id,Actor:log.actor_name??"",User:log.actor_username??"",Action:log.action??"",Event:log.event_type??"",Module:log.module??"",Description:log.description??"",Status:log.status??"",Date:log.created_at??""
    })));
    const workbook=XLSX.utils.book_new();XLSX.utils.book_append_sheet(workbook,sheet,"System Logs");
    XLSX.writeFile(workbook,"QRPass-Selected-System-Logs-"+new Date().toISOString().slice(0,10)+".xlsx");
  };
  const manageArchiveSelected = async () => {
    if(manageBusy||!manageSelectedIds.length)return;
    setManageBusy(true);setManageMessage("");
    try{
      const response = await qrpassManageLogsRequest(
        "archive-ids",
        "POST",
        { ids: manageSelectedIds } as any
      );      const data=await response.json();
      setManageMessage(String(data.count??0)+" selected logs archived.");
      setManageSelectedIds([]);
      await loadAuditLogs("","","");
      await manageListArchives();
    }catch(e){setManageMessage(e instanceof Error?e.message:"Selected log archive failed");}
    finally{setManageBusy(false);}
  };

  const manageDisplayedLogs = logs.filter((log:any) => {
    const q = manageSearch.trim().toLowerCase();
    if (q && ![log.actor_name,log.actor_username,log.event_type,log.action,log.module,log.description,log.status].some(x => String(x ?? "").toLowerCase().includes(q))) return false;
    const date = new Date(log.created_at ?? log.date ?? 0);
    if (Number.isNaN(date.getTime())) return false;
    const localDay = (v:Date) => [v.getFullYear(),String(v.getMonth()+1).padStart(2,"0"),String(v.getDate()).padStart(2,"0")].join("-");
    const day = localDay(date), today = new Date(), todayStr = localDay(today);
    if (cleanupAge === "all") return true;
    if (cleanupAge === "today") return day === todayStr;
    if (cleanupAge === "yesterday") {const y=new Date(today);y.setDate(y.getDate()-1);return day === localDay(y);}
    if (cleanupAge === "7" || cleanupAge === "30") {const cutoff = new Date(today);cutoff.setDate(cutoff.getDate()-Number(cleanupAge)+1);return day >= localDay(cutoff) && day <= todayStr;}
    if (cleanupAge === "custom") return !!manageStart && !!manageEnd && day >= manageStart && day <= manageEnd;
    return true;
  });

  const [archiveBeforeCleanup, setArchiveBeforeCleanup] = useState(true);

  useEffect(() => {
    loadAuditLogs();
  }, []);

  /* QRPass Sysadmin audit auto-refresh v1 */
  useEffect(() => {
    const id = window.setInterval(() => {
      if (document.visibilityState === "visible") {
        loadAuditLogs(search, statusFilter, dateFilter, true);
      }
    }, 10000);
    return () => window.clearInterval(id);
  }, [search, statusFilter, dateFilter]);

  async function loadAuditLogs(
    customSearch = search,
    customStatus = statusFilter,
    customDate = dateFilter,
    silent = false
  ) {
    try {
      if (!silent) {
        setLoading(true);
        setError("");
      }

      const data = await getAuditLogs({
        search: customSearch || undefined,
        status: customStatus || undefined,
        date: customDate || undefined,
        limit: 500,
      });

      setLogs(
        Array.isArray(data?.logs)
          ? data.logs
          : []
      );

      setStats({
        logs_today:
          Number(data?.stats?.logs_today) || 0,

        qr_scan_events:
          Number(data?.stats?.qr_scan_events) || 0,

        data_changes:
          Number(data?.stats?.data_changes) || 0,

        errors:
          Number(data?.stats?.errors) || 0,
      });
    } catch (err) {
      console.error(
        "Failed to load audit logs:",
        err
      );

      if (!silent) {
        setError(
          err instanceof Error
            ? err.message
            : "Failed to load audit logs."
        );
      }
    } finally {
      if (!silent) setLoading(false);
    }
  }

  function handleSearch(
    event: React.FormEvent<HTMLFormElement>
  ) {
    event.preventDefault();

    loadAuditLogs();
  }

  function clearFilters() {
    setSearch("");
    setStatusFilter("");
    setActionFilter("all");
    setDateFilter("");

    loadAuditLogs("", "", "");
  }

  function formatAuditDate(
    value: string | null | undefined
  ) {
    if (!value) {
      return "—";
    }

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return "—";
    }

    return date.toLocaleDateString(
      "en-PH",
      {
        year: "numeric",
        month: "short",
        day: "numeric",
      }
    );
  }

  function formatAuditTime(
    value: string | null | undefined
  ) {
    if (!value) {
      return "—";
    }

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return "—";
    }

    return date.toLocaleTimeString(
      "en-PH",
      {
        hour: "2-digit",
        minute: "2-digit",
      }
    );
  }

  function getStatusClasses(
    status: string | null | undefined
  ) {
    const normalized =
      String(status ?? "").toLowerCase();

    if (
      normalized === "failed" ||
      normalized === "error"
    ) {
      return "bg-red-100 text-red-700";
    }

    if (
      normalized === "warning" ||
      normalized === "flagged"
    ) {
      return "bg-yellow-100 text-yellow-700";
    }

    if (
      normalized === "success" ||
      normalized === "resolved"
    ) {
      return "bg-green-100 text-green-700";
    }

    return "bg-blue-100 text-blue-700";
  }

  function getIconClasses(
    status: string | null | undefined
  ) {
    const normalized =
      String(status ?? "").toLowerCase();

    if (
      normalized === "failed" ||
      normalized === "error"
    ) {
      return "bg-red-100 text-red-600";
    }

    if (
      normalized === "warning" ||
      normalized === "flagged"
    ) {
      return "bg-yellow-100 text-yellow-600";
    }

    if (
      normalized === "success" ||
      normalized === "resolved"
    ) {
      return "bg-green-100 text-green-600";
    }

    return "bg-primary/10 text-primary";
  }

  const actionTabs = [
  {id:"all",label:"All Activity"},
  {id:"login",label:"Login"},
  {id:"logout",label:"Logout"},
  {id:"changes",label:"Data Changes"},
  {id:"errors",label:"Errors"},
];
  const periodAuditLogs = logs.filter((log:any) =>
    csuMatchesPeriod(log.created_at ?? log.date, logsPeriod, logsStart, logsEnd)
  );
  const periodAuditStats = {
    total: periodAuditLogs.length,
    scans: periodAuditLogs.filter((log:any) => `${log.event_type ?? ""} ${log.action ?? ""} ${log.module ?? ""}`.toLowerCase().includes("scan")).length,
    changes: periodAuditLogs.filter((log:any) => ["create", "update", "delete", "approval", "status_change"].some(x => `${log.event_type ?? ""} ${log.action ?? ""}`.toLowerCase().includes(x))).length,
    errors: periodAuditLogs.filter((log:any) => ["failed", "error", "warning"].includes(String(log.status ?? "").toLowerCase())).length,
  };
  const visibleAuditLogs = periodAuditLogs.filter((log:any) => {
    const event = String(log.event_type ?? "").toLowerCase();
    const action = String(log.action ?? "").toLowerCase();
    const text = `${event} ${action}`;
    const status = String(log.status ?? "").toLowerCase();
    if (actionFilter === "login" && !(text.includes("login") || text.includes("log in") || text.includes("sign in"))) return false;
    if (actionFilter === "logout" && !(text.includes("logout") || text.includes("log out") || text.includes("sign out"))) return false;
    if (actionFilter === "changes" && !["create","update","delete","approval","status_change"].some(x => text.includes(x))) return false;
    if (actionFilter === "qr_scan" && !(text.includes("qr_scan") || text.includes("qr scan") || text.includes("scan") || String(log.module ?? "").toLowerCase().includes("qr verification"))) return false;
    if (actionFilter === "errors" && !["error","failed","warning"].includes(status)) return false;
    const query = search.trim().toLowerCase();
    if (!query) return true;
    return [log.actor_name, log.actor_username, log.user?.name, log.user?.username, log.event_type, log.action, log.module, log.description, log.status, log.ip_address]
      .some(value => String(value ?? "").toLowerCase().includes(query));
  }).sort((a:any,b:any) => {
    const aTime = new Date(a.created_at ?? a.date ?? 0).getTime() || 0;
    const bTime = new Date(b.created_at ?? b.date ?? 0).getTime() || 0;
    return sortOrder === "newest" ? bTime - aTime : aTime - bTime;
  });

  function exportAuditLogsExcel() {
    if (visibleAuditLogs.length === 0) {
      alert(
        "There are no audit logs to export."
      );
      return;
    }

    const rows = visibleAuditLogs.map(
      (log: any) => ({
        Date: formatAuditDate(
          log.created_at
        ),

        Time: formatAuditTime(
          log.created_at
        ),

        "Actor Name":
          log.actor_name ??
          log.user?.name ??
          "System",

        Username:
          log.actor_username ??
          log.user?.username ??
          "",

        Role:
          log.user?.role ?? "",

        "Event Type":
          log.event_type ?? "activity",

        Action:
          log.action ?? "",

        Module:
          log.module ?? "",

        Description:
          log.description ?? "",

        Status:
          log.status ?? "",

        "IP Address":
          log.ip_address ?? "",
      })
    );

    const worksheet =
      XLSX.utils.json_to_sheet(rows);

    worksheet["!cols"] = [
      { wch: 15 },
      { wch: 12 },
      { wch: 24 },
      { wch: 20 },
      { wch: 16 },
      { wch: 18 },
      { wch: 24 },
      { wch: 22 },
      { wch: 55 },
      { wch: 15 },
      { wch: 18 },
    ];

    const workbook =
      XLSX.utils.book_new();

    XLSX.utils.book_append_sheet(
      workbook,
      worksheet,
      "Audit Logs"
    );

    const today = new Date()
      .toISOString()
      .slice(0, 10);

    XLSX.writeFile(
      workbook,
      `QRPass-Audit-Logs-${today}.xlsx`
    );
  }

  return (
    <div className="space-y-5">
      <div className="flex flex-wrap justify-between items-center gap-3" data-qrpass-audit-heading-v42="true" data-qrpass-audit-header-tight-v40="true">
        <PageHeader title="Audit Logs" />
        
      </div>
      {/* QRPASS_SYSTEMLOGS_WHITE_PORTAL_V23 */}
      {manageLogsOpen && createPortal(
        <div className="fixed inset-0 z-[150] flex items-center justify-center overflow-y-auto bg-black/65 p-4" style={{position:"fixed",inset:0,zIndex:2147483000,display:"flex",alignItems:"center",justifyContent:"center",padding:16,backgroundColor:"rgba(0,0,0,.65)",overflowY:"auto",isolation:"isolate"}} onMouseDown={e => {if(e.target===e.currentTarget&&!manageBusy)setManageLogsOpen(false)}}>
          <div data-qrpass-manage-v31="true" data-qrpass-manage-v32="true" role="dialog" aria-modal="true" aria-label="Manage System Logs" className="w-full max-w-[900px] overflow-hidden rounded-2xl border border-[#cbd5e1] bg-white shadow-2xl" style={{position:"relative",width:"100%",maxWidth:900,maxHeight:"90vh",display:"flex",flexDirection:"column",overflow:"hidden",backgroundColor:"#fff",color:"#17336d",border:"1px solid #cbd5e1",borderRadius:16,boxShadow:"0 20px 60px rgba(0,0,0,.28)",margin:"auto"}}>
            <div className="flex shrink-0 items-center justify-between gap-4 px-6 pt-5 pb-4" style={{display:"flex",alignItems:"center",justifyContent:"space-between",flexShrink:0,backgroundColor:"#fff"}}>
              <h3 className="text-xl font-bold" style={{color:"#142b54"}}>Manage Logs</h3>
              <button type="button" disabled={manageBusy} onClick={()=>setManageLogsOpen(false)} className="rounded-xl border border-[#cbd5e1] bg-white px-4 py-2 text-sm font-medium hover:bg-[#eef2ff]"
           data-qrpass-neutral-v169="true">Close</button>
            </div>
            <div className="min-h-0 flex-1 space-y-3 overflow-y-auto px-6 pb-5" style={{display:"block",overflowY:"auto",minHeight:0,backgroundColor:"#fff",color:"#17336d",paddingTop:4}}>
              <div className="flex flex-col gap-2 sm:flex-row sm:items-center">
                <button type="button" disabled={manageBusy} onClick={() => {setManageShowArchives(v=>!v);if(!manageShowArchives)void manageListArchives();setManageMessage("");setManageSelectedIds([])}} className="h-11 shrink-0 rounded-xl border border-[#cbd5e1] bg-white px-4 text-sm font-medium transition-colors !bg-white !text-[#17336d] !border-[#cbd5e1] transition-colors hover:!bg-[#eef2ff] hover:!border-[#a8bde4] hover:!text-[#17336d] focus-visible:!ring-0 focus-visible:!shadow-none focus-visible:!outline-none" 
            onMouseEnter={(e) => {
              const el=e.currentTarget;
              if(!el.dataset.qrpassV158Saved) {
                el.dataset.qrpassV158Saved=el.style.cssText || " ";
              }
              el.style.setProperty("background", "#eef2ff", "important");
              el.style.setProperty("background-color", "#eef2ff", "important");
              el.style.setProperty("background-image", "none", "important");
              el.style.setProperty("color", "#17336d", "important");
              el.style.setProperty("border-color", "#a8bde4", "important");
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onMouseLeave={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onFocus={(e) => {
              e.currentTarget.style.setProperty("box-shadow", "none", "important");
              e.currentTarget.style.setProperty("outline", "none", "important");
            }}
            onBlur={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}

          >
                  {manageShowArchives?"Back to Records":"View Archives"}
                </button>
                <div className="relative min-w-0 flex-1">
                  <Search size={16} className="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[#64748b]"/>
                  <input
  type="search"
  aria-label="Search managed logs"
  value={manageSearch}
  onChange={(e) => setManageSearch(e.target.value)}
  placeholder="Search records..."
  className="h-12 w-full min-w-0 rounded-xl border border-[#c7d2fe] !bg-white hover:!bg-[#eef2ff] focus:!bg-white pl-10 pr-4 text-sm text-[#17336d] outline-none transition-colors focus:border-[#5278e7] focus:ring-2 focus:ring-[#5278e7]/20"
/>                  </div>
              </div>
              {manageMessage && <div role="status" className="rounded-xl border border-[#cbd5e1] bg-[#f5f8ff] px-3 py-2 text-sm">{manageMessage}</div>}
              <div className="overflow-hidden rounded-xl border border-[#cbd5e1]" style={{backgroundColor:"#ffffff",color:"#17336d",border:"1px solid #cbd5e1"}}>
                <div className="max-h-[43vh] overflow-auto" style={{backgroundColor:"#ffffff",color:"#17336d"}}>
                  <table className="w-full border-collapse text-left text-sm" style={{width:"100%",borderCollapse:"collapse",backgroundColor:"#fff",color:"#17336d"}}>
                    <thead className="sticky top-0 z-10 bg-[#f8fafc] text-xs font-semibold text-[#64748b]" style={{backgroundColor:"#f8fafc",color:"#64748b"}}>
                      <tr>
                        <th className="border-b border-[#dbe3f0] px-3 py-3 w-[100px]">Select</th>
                        <th className="border-b border-[#dbe3f0] px-3 py-3">Record</th>
                        <th className="border-b border-[#dbe3f0] px-3 py-3">Status</th>
                        <th className="border-b border-[#dbe3f0] px-3 py-3">Date</th>
                      </tr>
                    </thead>
                    <tbody style={{backgroundColor:"#ffffff",color:"#17336d"}}>
                    {manageShowArchives ? (
                      manageArchives.filter(a=>!a.restored_at && a.moved && (String(a.archive_id)+" "+String(a.created_at)+" "+String(a.count)).toLowerCase().includes(manageSearch.toLowerCase())).length ?
                      manageArchives.filter(a=>!a.restored_at && a.moved && (String(a.archive_id)+" "+String(a.created_at)+" "+String(a.count)).toLowerCase().includes(manageSearch.toLowerCase())).map(a=>(
                        <tr key={a.archive_id} className="border-b border-[#e4eaf2]" style={{backgroundColor:"#ffffff",color:"#17336d"}}>
                          <td className="px-3 py-3 text-[#64748b]">Archive</td>
                          <td className="px-3 py-3"><div className="font-medium">{a.count} logs</div><div className="mt-1 flex flex-wrap gap-1">
                            <button type="button" disabled={manageBusy} onClick={()=>void manageDownloadById(a.archive_id,"xlsx")} className="rounded-lg border border-[#cbd5e1] bg-white px-2 py-1 text-xs hover:bg-[#eef2ff]"
          >Download</button>
                            <button type="button" disabled={manageBusy} onClick={()=>void manageUnarchive(a.archive_id)} className="rounded-lg border border-[#cbd5e1] bg-white px-2 py-1 text-xs hover:bg-[#eef2ff]"
          >Restore</button>
                            <button type="button" disabled={manageBusy} onClick={()=>void manageDeleteArchive(a.archive_id,a.count)} className="rounded-lg border border-red-200 bg-white px-2 py-1 text-xs text-red-700 hover:bg-red-50">Delete</button>
                          </div></td>
                          <td className="px-3 py-3">Archived</td>
                          <td className="px-3 py-3 text-xs">{a.created_at?new Date(a.created_at).toLocaleDateString():"—"}</td>
                        </tr>
                      )) : <tr><td colSpan={4} className="p-6 text-center font-semibold">No archived logs found.</td></tr>
                    ) : (
                      manageVisibleRecords.length ? manageVisibleRecords.map((log:any,index:number)=>{
                        const id=Number(log.id),checked=manageSelectedIds.includes(id);
                        return <tr key={String(log.id??index)} className={`cursor-pointer border-b border-[#e4eaf2] transition-colors hover:bg-[#f1f5ff] ${checked?"bg-[#eef2ff]":""}`} onClick={()=>{if(Number.isSafeInteger(id)&&id>0)setManageSelectedIds(prev=>prev.includes(id)?prev.filter(v=>v!==id):[...prev,id])}} style={{backgroundColor:checked?"#eef2ff":"#ffffff",color:"#17336d"}}>
                          <td className="px-3 py-3"><input type="checkbox" aria-label={`Select log ${id}`} checked={checked} onChange={()=>setManageSelectedIds(prev=>prev.includes(id)?prev.filter(v=>v!==id):[...prev,id])} onClick={e=>e.stopPropagation()} onMouseDown={e=>e.stopPropagation()}/></td>
                          <td className="px-3 py-3"><span className="font-medium">{String(log.actor_name??log.action??log.event_type??"System event")}</span><span className="block max-w-[380px] truncate text-xs text-[#64748b]" title={String(log.description??"")}>{String(log.description??log.action??"")}</span></td>
                          <td className="px-3 py-3 capitalize">{String(log.status??"recorded")}</td>
                          <td className="whitespace-nowrap px-3 py-3 text-xs">{log.created_at?new Date(log.created_at).toLocaleDateString():"—"}</td>
                        </tr>
                      }) : <tr><td colSpan={4} className="p-6 text-center font-semibold">No matching logs found.</td></tr>
                    )}
                    </tbody>
                  </table>
                </div>
              </div>
              {!manageShowArchives && <div className="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <p className="text-xs text-[#64748b]">{manageSelectedIds.length} selected · {manageVisibleRecords.length} shown (maximum 500 loaded)</p>
                <div className="flex flex-wrap items-center justify-end gap-2">
                  <button type="button" disabled={manageBusy||!manageVisibleRecords.length} onClick={()=>{const ids=manageVisibleRecords.map((log:any)=>Number(log.id)).filter((n:number)=>Number.isSafeInteger(n)&&n>0);setManageSelectedIds(ids.every(id=>manageSelectedIds.includes(id))?[]:ids)}} className="rounded-xl border border-[#cbd5e1] bg-white px-3 py-2 text-sm hover:bg-[#eef2ff]"
          >{manageVisibleRecords.length>0 && manageVisibleRecords.every((log:any)=>manageSelectedIds.includes(Number(log.id)))?"Deselect All":"Select All"}</button>
                  <button type="button" disabled={manageBusy||!manageSelectedIds.length} onClick={manageDownloadSelected} className="rounded-xl border border-[#cbd5e1] bg-white px-3 py-2 text-sm hover:bg-[#eef2ff] disabled:opacity-50"
          >Download</button>
                  <button type="button" disabled={manageBusy||!manageSelectedIds.length} onClick={()=>void manageArchiveSelected()} className="rounded-xl border border-[#cbd5e1] bg-white px-3 py-2 text-sm hover:bg-[#eef2ff] disabled:opacity-50">{manageBusy?"Processing...":"Archive"}</button>
                </div>
              </div>}
            </div>
          </div>
        </div>
      , document.body)}
      {error && (
        <div className="p-3 border border-red-200 bg-red-50 rounded-md text-sm text-red-700">
          {error}
        </div>
      )}

      {/* Search toolbar should appear above the activity buttons */}
      <div className="flex flex-col gap-3 sm:flex-row sm:items-center" data-qrpass-audit-toolbar-v42="true" data-qrpass-audit-toolbar-tight-v40="true">
        <form onSubmit={handleSearch} className="relative min-w-0 flex-1">
          <Search size={17} className="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-[#64748b]" />
          <input
            type="search"
            aria-label="Search system logs"
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            placeholder="Search user, action, module, description..."
            className="h-12 w-full min-w-0 rounded-xl border border-[#c7d2fe] !bg-white hover:!bg-[#eef2ff] focus:!bg-white pl-11 pr-4 text-sm text-[#17336d] outline-none transition-colors focus:border-[#5278e7] focus:ring-2 focus:ring-[#5278e7]/20"          />
        </form>
        <div data-qrpass-audit-dropdown-v28="activity" className="qrpass-audit-dropdown-v28 relative inline-flex max-w-full shrink-0">
<select data-qrpass-filter="activities" aria-label="Filter system log activity" value={actionFilter} onChange={e => setActionFilter(e.target.value)} className="h-12 min-w-[165px] max-w-full rounded-xl border border-[#c7d2fe] bg-[#eef2ff] px-3 text-sm font-medium text-[#17336d] outline-none focus:border-[#5278e7] dark:border-[#5278b8] dark:bg-[#19345f] dark:text-white">
            {actionTabs.map(tab => <option key={tab.id} value={tab.id}>{tab.label}</option>)}
          </select>
</div>
          <div data-qrpass-audit-dropdown-v28="sort" className="qrpass-audit-dropdown-v28 relative inline-flex w-full min-w-0 shrink-0 sm:w-[148px]">
<select
          aria-label="Sort system logs"
          value={sortOrder}
          onChange={(e) => setSortOrder(e.target.value as "newest" | "oldest")}
          className="h-[48px] w-full sm:w-[148px] shrink-0 rounded-xl border border-[#c7d2fe] bg-[#eef2ff] px-3 text-sm font-medium text-[#17336d] outline-none focus:border-[#5278e7] focus:ring-2 focus:ring-[#5278e7]/20"
        >
          <option value="newest">Newest first</option>
          <option value="oldest">Oldest first</option>
        </select>
</div>
                    <button
            type="button"
            aria-label="Manage Logs"
            title="Manage Logs"
            onClick={() => setManageLogsOpen(true)}
            data-qrpass-hover-uniform-v141="true"
            className="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#cbd5e1] bg-white text-[#31539b] transition-colors hover:bg-[#eef2ff] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5278e7]/20"
          
  onMouseEnter={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', '#eef2ff', 'important');
    s.setProperty('background-color', '#eef2ff', 'important');
    s.setProperty('border-color', '#a8bde4', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
  onMouseLeave={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', '#ffffff', 'important');
    s.setProperty('background-color', '#ffffff', 'important');
    s.setProperty('border-color', '#cbd5e1', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
  onFocus={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', e.currentTarget.matches(':hover') ? '#eef2ff' : '#ffffff', 'important');
    s.setProperty('border-color', e.currentTarget.matches(':hover') ? '#a8bde4' : '#cbd5e1', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
  onBlur={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', '#ffffff', 'important');
    s.setProperty('background-color', '#ffffff', 'important');
    s.setProperty('border-color', '#cbd5e1', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
>
            <SlidersHorizontal size={18} strokeWidth={1.8} aria-hidden="true" />
          </button>
<button type="button" data-qrpass-refresh-toolbar="v1" onClick={() => loadAuditLogs()} className="inline-flex h-12 shrink-0 items-center justify-center gap-2 rounded-xl px-3 text-sm font-medium text-[#17336d] hover:bg-[#edf2ff]" aria-label="Refresh records"
          ><RefreshCw size={15} />Refresh</button>
      </div>

      {/* QRPASS_AUDIT_GAP_V35_EMPTY_SPACER_REMOVED: no extra layout element */}
      {["item-registration", "transaction-scan", "security-incident", "lost-found"].includes(actionFilter)
        ? <AdminRecords embedded selectedType={actionFilter === "item-registration" ? "Item Registration" : actionFilter === "transaction-scan" ? "QR Scan" : actionFilter === "security-incident" ? "Security Incident" : "Lost & Found"} sharedPeriod={logsPeriod} sharedStart={logsStart} sharedEnd={logsEnd} />
        : <>


<Card
        title="Audit Activity Records"
        action={
          <span className="rounded-full bg-[#eef2fc] px-2.5 py-1 text-[10px] font-bold text-[#1a3a7b]" data-qrpass-audit-matching="QRPASS_AUDIT_MATCHING_BADGE_V33">
            {visibleAuditLogs.length} matching
          </span>
        }
      >

        {loading ? (
          <div className="p-8 text-center text-sm text-muted-foreground">
            Loading audit logs...
          </div>
        ) : visibleAuditLogs.length === 0 ? (
          <div className="p-8 text-center">
            <ClipboardList
              size={32}
              className="mx-auto mb-2 text-muted-foreground/50"
            />

            <p className="text-sm font-medium text-foreground">
              No audit logs found.
            </p>

            <p className="text-xs text-muted-foreground mt-1">
              New system activities will appear here once they are recorded.
            </p>
          </div>
        ) : (
          <div className="divide-y divide-border">
            {visibleAuditLogs.map(
              (log: any) => {
                const actor =
                  log.actor_name ??
                  log.user?.name ??
                  "System";

                const username =
                  log.actor_username ??
                  log.user?.username ??
                  "";

                return (
                  <div
                    key={log.id}
                    className="px-4 py-3 flex gap-3 hover:bg-[#eef2fc] transition-colors"
                  >
                    <div
                      className={`w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5 ${getIconClasses(
                        log.status
                      )}`}
                    >
                      <User size={14} />
                    </div>

                    <div className="flex-1 min-w-0">
                      <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-1">
                        <div className="flex flex-wrap items-center gap-2">
                          <p className="text-xs font-semibold text-foreground">
                            {actor}
                          </p>

                          {username && (
                            <span className="text-xs text-muted-foreground">
                              ({username})
                            </span>
                          )}

                          <span
                            className={`text-[10px] px-2 py-0.5 rounded-full font-semibold ${getStatusClasses(
                              log.status
                            )}`}
                          >
                            {String(
                              log.status ??
                                "activity"
                            ).toUpperCase()}
                          </span>
                        </div>

                        <p className="text-xs text-muted-foreground whitespace-nowrap">
                          {formatAuditDate(
                            log.created_at
                          )}{" "}
                          {formatAuditTime(
                            log.created_at
                          )}
                        </p>
                      </div>

                      <p className="text-sm text-foreground mt-1">
                        {log.description ??
                          "System activity"}
                      </p>

                      <div className="flex flex-wrap gap-x-4 gap-y-1 mt-1.5">
                        {log.module && (
                          <span className="text-xs text-muted-foreground">
                            Module:{" "}
                            <span className="font-medium">
                              {log.module}
                            </span>
                          </span>
                        )}

                        {log.action && (
                          <span className="text-xs text-muted-foreground">
                            Action:{" "}
                            <span className="font-medium">
                              {log.action}
                            </span>
                          </span>
                        )}

                        {log.event_type && (
                          <span className="text-xs text-muted-foreground">
                            Event:{" "}
                            <span className="font-medium">
                              {log.event_type}
                            </span>
                          </span>
                        )}
                      </div>
                    </div>
                  </div>
                );
              }
            )}
          </div>
        )}
      </Card>
      </>}
    </div>
  );
}

function SysAdminActiveSessions() {
  const [sessions, setSessions] = useState<any[]>([]);
  const [sessionAccounts, setSessionAccounts] = useState<any[]>([]);
  const [activeCount, setActiveCount] = useState(0);
  const [activeUsersCount, setActiveUsersCount] = useState(0);
  const [totalSessions, setTotalSessions] = useState(0);
  const [sessionTimeout, setSessionTimeout] = useState(30);

  const [loading, setLoading] = useState(true);
  const [sessionSearch, setSessionSearch] = useState('');
  const [sessionSort, setSessionSort] = useState<'newest' | 'oldest'>('newest');

  const [disablingId, setDisablingId] = useState<number | null>(null);
  const [revokingId, setRevokingId] =
    useState<number | null>(null);

  const [error, setError] = useState("");
  const [success, setSuccess] = useState("");


  /*
  |--------------------------------------------------------------------------
  | LOAD ACTIVE SESSIONS
  |--------------------------------------------------------------------------
  */

  async function loadSessions() {
    try {
      setLoading(true);
      setError("");

      const data =
        await getActiveSessions();

      const returnedSessions = Array.isArray(data.sessions) ? data.sessions : [];
      setSessions(returnedSessions);
      // Sanctum may create multiple active tokens for ONE account.
      // Count distinct user IDs, not tokens, to avoid displaying 3 users for 1 person.
      const distinctActiveUsers = new Set(
        returnedSessions
          .filter((session: any) => session.is_active === true)
          .map((session: any) => session.user_id ?? session.user?.id)
          .filter((id: any) => id !== null && id !== undefined && String(id).trim() !== "")
          .map((id: any) => String(id))
      );
      setActiveUsersCount(distinctActiveUsers.size);

      // Use the same user directory as User Accounts for accurate user ID and email.
      // This is supplementary: session listing must still work if user directory fails.
      try {
        const accountData = await getUsers();
        setSessionAccounts(Array.isArray(accountData?.users) ? accountData.users : []);
      } catch (accountError) {
        console.warn("Session user directory unavailable:", accountError);
        setSessionAccounts([]);
      }

      setActiveCount(
        Number(
          data.active_count ?? 0
        )
      );

      setTotalSessions(
        Number(
          data.total_sessions ?? 0
        )
      );

      setSessionTimeout(
        Number(
          data.session_timeout_minutes ??
            30
        )
      );
    } catch (err) {
      console.error(
        "Failed to load active sessions:",
        err
      );

      setError(
        err instanceof Error
          ? err.message
          : "Failed to load active sessions."
      );
    } finally {
      setLoading(false);
    }
  }


  /*
  |--------------------------------------------------------------------------
  | LOAD ON PAGE OPEN
  |--------------------------------------------------------------------------
  */

  useEffect(() => {
    loadSessions();
    // Refresh session activity automatically. This is recent-token activity,
    // not a guaranteed live presence signal (closing a tab doesn't log out).
    const refreshInterval = window.setInterval(() => { void loadSessions(); }, 20000);
    return () => window.clearInterval(refreshInterval);
  }, []);


  /*
  |--------------------------------------------------------------------------
  | REVOKE SESSION
  |--------------------------------------------------------------------------
  */

  async function handleRevoke(
    session: any
  ) {
    if (session.is_current) {
      setError(
        "You cannot revoke your current administrator session from this page."
      );

      return;
    }

    const confirmed =
      window.confirm(
        `Revoke the session for ${
          session.name ??
          session.username ??
          "this user"
        }?`
      );

    if (!confirmed) {
      return;
    }

    try {
      setRevokingId(
        Number(session.id)
      );

      setError("");
      setSuccess("");

      const result =
        await revokeActiveSession(
          Number(session.id)
        );

      setSuccess(
        result?.message ||
          "Session revoked successfully."
      );

      await loadSessions();

      setTimeout(() => {
        setSuccess("");
      }, 4000);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Failed to revoke session."
      );
    } finally {
      setRevokingId(null);
    }
  }


  /*
  |--------------------------------------------------------------------------
  | FORMAT DATE / TIME
  |--------------------------------------------------------------------------
  */

  // Disable the entire account, rather than only one token.
  async function handleDisable(session: any) {
    const account = linkedAccount(session);
    const userId = account?.id ?? session.user_id ?? session.user?.id;
    if (session.is_current) {
      setError('You cannot disable your current administrator account.');
      return;
    }
    if (!userId || !account) {
      setError('Cannot safely identify this user account. Open User Accounts to disable it.');
      return;
    }
    const accountStatus = String(account.status ?? account.account_status ?? '').toLowerCase();
    if (accountStatus === 'inactive' || accountStatus === 'disabled') {
      setError('This user account is already disabled.');
      return;
    }
    if (!window.confirm(`Disable the account of ${sessionDisplayName(session)}? This affects account access, not just this session.`)) return;
    try {
      setDisablingId(Number(userId));
      setError(''); setSuccess('');
      const result = await updateUserStatus(Number(userId), 'inactive');
      setSuccess(result?.message || 'User account disabled successfully.');
      await loadSessions();
    } catch(err) {
      setError(err instanceof Error ? err.message : 'Failed to disable account.');
    } finally { setDisablingId(null); }
  }

  function formatDateTime(
    value?: string | null
  ) {
    if (!value) {
      return "Never";
    }

    const date =
      new Date(value);

    if (
      Number.isNaN(
        date.getTime()
      )
    ) {
      return "—";
    }

    return date.toLocaleString(
      "en-PH",
      {
        year: "numeric",
        month: "short",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
      }
    );
  }


  /*
  |--------------------------------------------------------------------------
  | ROLE LABEL
  |--------------------------------------------------------------------------
  */

  function roleLabel(
    role?: string
  ) {
    switch (
      String(role ?? "").toLowerCase()
    ) {
      case "student":
        return "Student";

      case "security":
        return "Security (CSU)";

      case "pco":
        return "PCO Staff";

      case "sysadmin":
        return "System Administrator";

      default:
        return role || "Unknown";
    }
  }


  function linkedAccount(session: any) {
    const sessionUser = session.user ?? {};
    const sessionId = session.user_id ?? sessionUser.id;
    if (sessionId !== undefined && sessionId !== null && String(sessionId).trim()) {
      const found = sessionAccounts.find((user: any) => String(user.id) === String(sessionId));
      if (found) return found;
    }
    const email = String(session.email ?? sessionUser.email ?? "").trim().toLowerCase();
    if (email) {
      const found = sessionAccounts.find((user: any) => String(user.email ?? "").trim().toLowerCase() === email);
      if (found) return found;
    }
    const username = String(session.username ?? sessionUser.username ?? "").trim().toLowerCase();
    if (username) {
      const found = sessionAccounts.find((user: any) => String(user.username ?? "").trim().toLowerCase() === username);
      if (found) return found;
    }
    return null;
  }

  function sessionDisplayName(session: any) {
    const account = linkedAccount(session);
    const accountUser = account?.user ?? {};
    const completeName = [account?.first_name ?? account?.firstname ?? accountUser.first_name,
      account?.middle_name ?? accountUser.middle_name,
      account?.last_name ?? account?.lastname ?? accountUser.last_name]
      .map(value => String(value ?? "").trim()).filter(Boolean).join(" ");
    const candidates = [completeName, account?.full_name, accountUser.full_name, account?.name,
      session.user?.full_name, session.user?.name, session.name];
    return candidates.map(value => String(value ?? "").trim()).find(Boolean) || "Name unavailable";
  }

  /*
  |--------------------------------------------------------------------------
  | PAGE
  |--------------------------------------------------------------------------
  */

  // QRPASS_SESSIONS_TABLE_V1 — match User Accounts toolbar and layout.
  const visibleSessions = sessions.filter((session: any) => {
    const account = linkedAccount(session);
    const term = sessionSearch.trim().toLowerCase();
    const haystack = [sessionDisplayName(session), account?.id, session.user_id,
      account?.email, session.email, session.user?.email,
      account?.username, session.username, roleLabel(account?.role || session.role),
      session.id, session.token_name].join(' ').toLowerCase();
    return !term || haystack.includes(term);
  }).sort((a: any, b: any) => {
    const aTime = new Date(a.last_activity || a.created_at || 0).getTime() || 0;
    const bTime = new Date(b.last_activity || b.created_at || 0).getTime() || 0;
    return sessionSort === 'newest' ? bTime - aTime : aTime - bTime;
  });

  return (
    <div className="space-y-5">
      <PageHeader
        title="Active Sessions"
        subtitle="Monitor authenticated QRPass sessions and revoke access when necessary."
      />


      {/* STATUS MESSAGES */}

      {error && (
        <div className="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          <div className="flex items-start gap-2">
            <AlertCircle
              size={16}
              className="mt-0.5 shrink-0"
            />

            <span>{error}</span>
          </div>
        </div>
      )}

      {success && (
        <div className="rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700">
          <div className="flex items-start gap-2">
            <CheckCircle
              size={16}
              className="mt-0.5 shrink-0"
            />

            <span>
              {success}
            </span>
          </div>
        </div>
      )}


      {/* STAT CARDS */}


      {/* SESSION TABLE */}
      <div className="flex flex-col gap-2 sm:flex-row sm:items-center">
        <div className="relative min-w-0 flex-1">
          <Search size={17} className="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-[#64748b]" />
          <input type="search" aria-label="Search active sessions" value={sessionSearch}
            onChange={(e) => setSessionSearch(e.target.value)}
            placeholder="Search name, user ID, email, role, session..."
            className="h-12 w-full rounded-xl border border-[#c7d2fe] bg-[#eef2ff] pl-11 pr-4 text-sm text-[#17336d] outline-none placeholder:text-[#8196b9] focus:border-[#2f5fd6] focus:bg-white focus:ring-2 focus:ring-[#2f5fd6]/15" />
        </div>
        <select aria-label="Sort active sessions" value={sessionSort}
          onChange={(e) => setSessionSort(e.target.value as 'newest' | 'oldest')}
          className="h-12 w-full rounded-xl border border-[#c7d2fe] bg-[#eef2ff] px-3 text-sm font-medium text-[#17336d] outline-none focus:border-[#2f5fd6] sm:w-[150px]">
          <option value="newest">Newest first</option>
          <option value="oldest">Oldest first</option>
        </select>
        <button type="button" onClick={loadSessions} disabled={loading}
          className="inline-flex h-12 items-center justify-center gap-2 rounded-lg px-3 text-sm font-medium text-[#17336d] hover:bg-[#eef2ff] disabled:opacity-50"
          >
          <RefreshCw size={15} className={loading ? 'animate-spin' : ''} /> Refresh
        </button>
      </div>
      <Card title="Authenticated Sessions">
        <div className="overflow-x-auto">
          <table className="w-full min-w-[950px] text-sm">
            <thead>
              <tr className="border-b border-[#dce3ee] bg-[#fafbfc] text-left text-xs text-[#64748b]">
                {['Name', 'User ID', 'Email', 'Role', 'Session', 'Last Activity', 'Status', 'Actions'].map((heading) => (
                  <th key={heading} className="px-4 py-3 font-medium">{heading}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {loading && sessions.length === 0 ? (
                <tr><td colSpan={8} className="px-4 py-10 text-center text-[#64748b]">Loading active sessions...</td></tr>
              ) : visibleSessions.length === 0 ? (
                <tr><td colSpan={8} className="px-4 py-10 text-center text-[#64748b]">No matching sessions found.</td></tr>
              ) : visibleSessions.map((session: any) => {
                const account = linkedAccount(session);
                const accountStatus = String(account?.status ?? account?.account_status ?? '').toLowerCase();
                const accountDisabled = accountStatus === 'inactive' || accountStatus === 'disabled';
                const userId = account?.id ?? session.user_id ?? session.user?.id;
                return (
                  <tr key={session.id} className="border-b border-[#e8edf5] hover:bg-[#f5f7fc]">
                    <td className="px-4 py-3 font-semibold text-[#172b50]">
                      {sessionDisplayName(session)}
                      {session.is_current && <span className="ml-2 rounded-full bg-blue-50 px-2 py-0.5 text-[10px] text-blue-700">Current</span>}
                    </td>
                    <td className="px-4 py-3 text-xs">{userId ?? '—'}</td>
                    <td className="px-4 py-3 text-xs text-[#64748b]">{account?.email || session.email || session.user?.email || '—'}</td>
                    <td className="px-4 py-3"><span className="rounded-full bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700">{roleLabel(account?.role || session.role)}</span></td>
                    <td className="px-4 py-3 text-xs text-[#64748b]">#{session.id}</td>
                    <td className="whitespace-nowrap px-4 py-3 text-xs text-[#64748b]">{formatDateTime(session.last_activity)}</td>
                    <td className="px-4 py-3"><span className={`rounded-full px-2.5 py-1 text-xs font-semibold ${session.is_active ? 'bg-green-100 text-green-700' : 'bg-slate-100 text-slate-600'}`}>{session.is_active ? 'Active' : 'Inactive'}</span></td>
                    <td className="px-4 py-3">
                      <div className="flex items-center gap-2">
                        <button type="button" onClick={() => handleRevoke(session)}
                          disabled={session.is_current || revokingId === Number(session.id)}
                          className="rounded-lg border border-[#cfd8e6] bg-white px-3 py-1.5 text-xs font-semibold text-[#17336d] hover:bg-[#eef2ff] disabled:cursor-not-allowed disabled:opacity-40">
                          {revokingId === Number(session.id) ? 'Revoking...' : 'Revoke'}
                        </button>
                        <button type="button" onClick={() => handleDisable(session)}
                          disabled={session.is_current || accountDisabled || !account || disablingId === Number(userId)}
                          title={session.is_current ? 'Cannot disable your current account' : accountDisabled ? 'Already disabled' : !account ? 'Account not found in User Accounts' : 'Disable user account'}
                          className="rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-100 disabled:cursor-not-allowed disabled:opacity-40">
                          {disablingId === Number(userId) ? 'Disabling...' : accountDisabled ? 'Disabled' : 'Disable'}
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <div className="flex justify-between gap-2 border-t border-[#dce3ee] px-4 py-3 text-xs text-[#64748b]">
          <span>Showing {visibleSessions.length} of {sessions.length} stored sessions</span>
        </div>
      </Card>
    </div>
  );
}

function SysAdminPerformance() {
  type PerformanceMetrics = {
    server_uptime_seconds: number | null;
    active_sessions: number;
    qr_response_ms: number | null;
    errors_today: number;
    session_timeout_minutes: number;
  };

  type PerformanceService = {
    name: string;
    status: string;
    response_ms: number | null;
    last_run?: string | null;
  };

  type PerformanceResponse = {
    metrics: PerformanceMetrics;
    services: PerformanceService[];
  };

  const [metrics, setMetrics] =
    useState<PerformanceMetrics>({
      server_uptime_seconds: null,
      active_sessions: 0,
      qr_response_ms: null,
      errors_today: 0,
      session_timeout_minutes: 30,
    });

  const [services, setServices] =
    useState<PerformanceService[]>([]);

  const [loading, setLoading] =
    useState(true);

  const [error, setError] =
    useState("");

  /*
  |--------------------------------------------------------------------------
  | LOAD PERFORMANCE
  |--------------------------------------------------------------------------
  */

  async function loadPerformance() {
    try {
      setLoading(true);
      setError("");

      const data =
        (await getPerformance()) as PerformanceResponse;

      setMetrics({
        server_uptime_seconds:
          data.metrics?.server_uptime_seconds ??
          null,

        active_sessions:
          Number(
            data.metrics?.active_sessions ??
              0
          ),

        qr_response_ms:
          data.metrics?.qr_response_ms ??
          null,

        errors_today:
          Number(
            data.metrics?.errors_today ??
              0
          ),

        session_timeout_minutes:
          Number(
            data.metrics
              ?.session_timeout_minutes ??
              30
          ),
      });

      setServices(
        Array.isArray(data.services)
          ? data.services
          : []
      );
    } catch (err) {
      console.error(
        "Failed to load performance data:",
        err
      );

      setError(
        err instanceof Error
          ? err.message
          : "Failed to load performance data."
      );

      setServices([]);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadPerformance();
  }, []);

  /*
  |--------------------------------------------------------------------------
  | FORMAT UPTIME
  |--------------------------------------------------------------------------
  */

  function formatUptime(
    seconds: number | null
  ) {
    if (
      seconds === null ||
      seconds === undefined
    ) {
      return "—";
    }

    const totalSeconds =
      Number(seconds);

    if (
      Number.isNaN(totalSeconds)
    ) {
      return "—";
    }

    const days =
      Math.floor(
        totalSeconds / 86400
      );

    const hours =
      Math.floor(
        (totalSeconds % 86400) /
          3600
      );

    const minutes =
      Math.floor(
        (totalSeconds % 3600) /
          60
      );

    if (days > 0) {
      return `${days}d ${hours}h ${minutes}m`;
    }

    if (hours > 0) {
      return `${hours}h ${minutes}m`;
    }

    return `${minutes}m`;
  }

  /*
  |--------------------------------------------------------------------------
  | FORMAT RESPONSE TIME
  |--------------------------------------------------------------------------
  */

  function formatResponseTime(
    value: number | null | undefined
  ) {
    if (
      value === null ||
      value === undefined
    ) {
      return "—";
    }

    const numberValue =
      Number(value);

    if (
      Number.isNaN(numberValue)
    ) {
      return "—";
    }

    return `${numberValue.toFixed(
      2
    )}ms`;
  }

  /*
  |--------------------------------------------------------------------------
  | FORMAT LAST RUN
  |--------------------------------------------------------------------------
  */

  function formatLastRun(
    value?: string | null
  ) {
    if (!value) {
      return "—";
    }

    const date =
      new Date(value);

    if (
      Number.isNaN(
        date.getTime()
      )
    ) {
      return value;
    }

    return date.toLocaleString(
      "en-PH",
      {
        year: "numeric",
        month: "short",
        day: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      }
    );
  }

  /*
  |--------------------------------------------------------------------------
  | STATUS COLOR
  |--------------------------------------------------------------------------
  */

  function statusColor(
    status: string
  ) {
    const normalized =
      String(status)
        .trim()
        .toLowerCase();

    if (
      normalized === "online" ||
      normalized === "available"
    ) {
      return "bg-green-500";
    }

    if (
      normalized === "offline"
    ) {
      return "bg-red-500";
    }

    return "bg-yellow-500";
  }

  return (
    <div className="space-y-5">
      <PageHeader
        title="Performance"
        subtitle="Real-time QRPass system health and resource monitoring."
        action={
          <button
            type="button"
            onClick={
              loadPerformance
            }
            disabled={loading}
            className="text-xs flex items-center gap-1 text-primary font-medium disabled:opacity-50 inline-flex items-center justify-center gap-1.5 !border-0 !bg-transparent !shadow-none !text-[#17336d] !px-2 !py-1 hover:!bg-[#edf2ff] rounded-lg"
          >
            <RefreshCw
              size={12}
              className={
                loading
                  ? "animate-spin"
                  : ""
              }
            />

            {loading
              ? "Refreshing..."
              : "Refresh"}
          </button>
        }
      />

      {error && (
        <div className="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          {error}
        </div>
      )}

      <Card title="System Status">
        {loading ? (
          <div className="p-8 text-center text-sm text-muted-foreground">
            Loading system
            performance...
          </div>
        ) : services.length ===
          0 ? (
          <div className="p-8 text-center text-sm text-muted-foreground">
            No service information
            available.
          </div>
        ) : (
          <div className="p-4 space-y-4">
            {services.map(
              (
                service,
                index
              ) => (
                <div
                  key={`${service.name}-${index}`}
                  className="flex items-center justify-between gap-4 p-3 bg-muted/40 rounded-md"
                >
                  <div className="flex items-center gap-2.5">
                    <span
                      className={`w-2.5 h-2.5 rounded-full ${statusColor(
                        service.status
                      )}`}
                    />

                    <div>
                      <p className="text-sm text-foreground font-medium">
                        {
                          service.name
                        }
                      </p>

                      {service.last_run && (
                        <p className="text-[11px] text-muted-foreground mt-0.5">
                          Last run:{" "}
                          {formatLastRun(
                            service.last_run
                          )}
                        </p>
                      )}
                    </div>
                  </div>

                  <div className="flex items-center gap-4">
                    {service.response_ms !==
                      null &&
                      service.response_ms !==
                        undefined && (
                        <span className="text-xs text-muted-foreground font-mono">
                          {formatResponseTime(
                            service.response_ms
                          )}
                        </span>
                      )}

                    <span className="text-xs text-muted-foreground">
                      {
                        service.status
                      }
                    </span>
                  </div>
                </div>
              )
            )}
          </div>
        )}
      </Card>

      <Card title="Session Policy">
        <div className="p-4">
          <div className="flex items-center justify-between p-3 bg-muted/40 rounded-md">
            <div>
              <p className="text-sm font-medium text-foreground">
                Session Timeout
              </p>

              <p className="text-xs text-muted-foreground mt-1">
                Current inactivity
                timeout configured
                in System Settings.
              </p>
            </div>

            <span className="text-sm font-semibold text-primary">
              {
                metrics.session_timeout_minutes
              }{" "}
              minutes
            </span>
          </div>
        </div>
      </Card>
    </div>
  );
}

function SysAdminSecurityConfig() {
  type PermissionKey =
    | "register_items"
    | "view_qr_codes"
    | "approve_requests"
    | "scan_verify"
    | "view_reports"
    | "manage_users";

  type RolePermission = {
    id?: number;
    role: string;
    register_items: boolean;
    view_qr_codes: boolean;
    approve_requests: boolean;
    scan_verify: boolean;
    view_reports: boolean;
    manage_users: boolean;
  };

  const [permissions, setPermissions] =
    useState<RolePermission[]>([]);

  const [loading, setLoading] =
    useState(true);

  const [error, setError] =
    useState("");

  /*
  |--------------------------------------------------------------------------
  | FIXED QRPass ROLE PERMISSION MATRIX
  |--------------------------------------------------------------------------
  */

  const fixedPermissionMatrix: Record<
    string,
    Omit<RolePermission, "id" | "role">
  > = {
    student: {
      register_items: true,
      view_qr_codes: true,
      approve_requests: false,
      scan_verify: false,
      view_reports: false,
      manage_users: false,
    },

    security: {
      register_items: false,
      view_qr_codes: false,
      approve_requests: false,
      scan_verify: true,
      view_reports: true,
      manage_users: false,
    },

    pco: {
      register_items: false,
      view_qr_codes: true,
      approve_requests: true,
      scan_verify: false,
      view_reports: true,
      manage_users: false,
    },

    sysadmin: {
      register_items: false,
      view_qr_codes: false,
      approve_requests: false,
      scan_verify: false,
      view_reports: true,
      manage_users: true,
    },
  };


  /*
  |--------------------------------------------------------------------------
  | PERMISSION COLUMNS
  |--------------------------------------------------------------------------
  */

  const permissionColumns: {
    key: PermissionKey;
    label: string;
  }[] = [
    {
      key: "register_items",
      label: "Register Items",
    },
    {
      key: "view_qr_codes",
      label: "View QR Codes",
    },
    {
      key: "approve_requests",
      label: "Approve Requests",
    },
    {
      key: "scan_verify",
      label: "Scan & Verify",
    },
    {
      key: "view_reports",
      label: "View Reports",
    },
    {
      key: "manage_users",
      label: "Manage Users",
    },
  ];


  /*
  |--------------------------------------------------------------------------
  | ROLE LABEL
  |--------------------------------------------------------------------------
  */

  function getRoleLabel(
    role: string
  ) {
    switch (role) {
      case "student":
        return "Student";

      case "security":
        return "Security (CSU)";

      case "pco":
        return "PCO Staff";

      case "sysadmin":
        return "System Administrator";

      default:
        return role;
    }
  }


  /*
  |--------------------------------------------------------------------------
  | LOAD PERMISSIONS
  |--------------------------------------------------------------------------
  */

  async function loadPermissions() {
    try {
      setLoading(true);
      setError("");

      const data =
        await getRolePermissions();

      const rows =
        Array.isArray(
          data.permissions
        )
          ? data.permissions
          : [];

      const roleOrder = [
        "student",
        "security",
        "pco",
        "sysadmin",
      ];

      const fixedRows =
        roleOrder.map(
          (role) => {
            const databaseRow =
              rows.find(
                (row: any) =>
                  String(
                    row.role ?? ""
                  ) === role
              );

            return {
              id:
                databaseRow?.id,

              role,

              ...fixedPermissionMatrix[
                role
              ],
            };
          }
        );

      setPermissions(
        fixedRows
      );
    } catch (err) {
      console.error(
        "Failed to load role permissions:",
        err
      );

      setError(
        err instanceof Error
          ? err.message
          : "Failed to load role permissions."
      );
    } finally {
      setLoading(false);
    }
  }


  /*
  |--------------------------------------------------------------------------
  | LOAD PAGE
  |--------------------------------------------------------------------------
  */

  useEffect(() => {
    loadPermissions();
  }, []);


  /*
  |--------------------------------------------------------------------------
  | PAGE
  |--------------------------------------------------------------------------
  */

  return (
    <div className="space-y-5">
      <PageHeader
        title="Security Config"
        subtitle="View the fixed QRPass role-based access permissions."
      />


      {/* ERROR MESSAGE */}

      {error && (
        <div className="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          <div className="flex items-start gap-2">
            <AlertCircle
              size={16}
              className="mt-0.5 shrink-0"
            />

            <span>
              {error}
            </span>
          </div>
        </div>
      )}


      {/* INFORMATION */}

      <div className="rounded-lg border border-blue-200 bg-blue-50 px-4 py-3">
        <div className="flex gap-3">
          <Shield
            size={18}
            className="text-[#1a3a7b] mt-0.5 shrink-0"
          />

          <div>
            <p className="text-sm font-semibold text-[#1a3a7b]">
              Fixed Role-Based Access Control
            </p>

            <p className="text-xs text-[#52637a] mt-1 leading-relaxed">
              QRPass permissions are predefined for each role and cannot be edited.
              This prevents accidental changes to the system's access-control rules.
            </p>
          </div>
        </div>
      </div>


      {/* PERMISSION MATRIX */}

      <Card title="Role Permissions">
        <div className="p-4 border-b border-[#dce3ee] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div>
            <p className="text-sm font-semibold">
              Permission Matrix
            </p>

            <p className="text-xs text-muted-foreground mt-1">
              All permissions are fixed and synchronized with the QRPass database.
            </p>
          </div>

          <button
            type="button"
            onClick={
              loadPermissions
            }
            disabled={
              loading
            }
            className="inline-flex items-center justify-center gap-2 rounded-md border border-[#cfd8e6] bg-white px-3 py-2 text-sm font-medium text-[#1a3a7b] hover:bg-[#eef2fc] disabled:opacity-50 inline-flex items-center justify-center gap-1.5 !border-0 !bg-transparent !shadow-none !text-[#17336d] !px-2 !py-1 hover:!bg-[#edf2ff] rounded-lg"
          >
            <RefreshCw
              size={15}
              className={
                loading
                  ? "animate-spin"
                  : ""
              }
            />

            Refresh
          </button>
        </div>


        <div className="overflow-x-auto">
          <table className="w-full">
            <thead>
              <tr className="bg-[#fafbfc] border-b border-[#dce3ee]">
                <th className="text-left py-3 px-4 text-xs text-muted-foreground font-medium min-w-[180px]">
                  Role
                </th>

                {permissionColumns.map(
                  (permission) => (
                    <th
                      key={
                        permission.key
                      }
                      className="text-center py-3 px-3 text-xs text-muted-foreground font-medium min-w-[125px]"
                    >
                      {
                        permission.label
                      }
                    </th>
                  )
                )}

                <th className="text-right py-3 px-4 text-xs text-muted-foreground font-medium min-w-[110px]">
                  Status
                </th>
              </tr>
            </thead>


            <tbody>
              {loading &&
              permissions.length ===
                0 ? (
                <tr>
                  <td
                    colSpan={
                      permissionColumns.length +
                      2
                    }
                    className="py-12 text-center text-sm text-muted-foreground"
                  >
                    Loading role permissions...
                  </td>
                </tr>
              ) : permissions.length ===
                0 ? (
                <tr>
                  <td
                    colSpan={
                      permissionColumns.length +
                      2
                    }
                    className="py-12 text-center text-sm text-muted-foreground"
                  >
                    No role permissions found.
                  </td>
                </tr>
              ) : (
                permissions.map(
                  (row) => (
                    <tr
                      key={
                        row.role
                      }
                      className="border-b border-[#edf0f5]"
                    >
                      <td className="py-3 px-4">
                        <div>
                          <p className="text-sm font-semibold text-foreground">
                            {getRoleLabel(
                              row.role
                            )}
                          </p>

                          <p className="text-xs text-muted-foreground mt-0.5">
                            Fixed role permissions
                          </p>
                        </div>
                      </td>


                      {permissionColumns.map(
                        (
                          permission
                        ) => {
                          const enabled =
                            Boolean(
                              row[
                                permission
                                  .key
                              ]
                            );

                          return (
                            <td
                              key={
                                permission.key
                              }
                              className="py-3 px-3 text-center"
                            >
                              <div
                                title={`${permission.label}: ${
                                  enabled
                                    ? "Enabled"
                                    : "Disabled"
                                } (Fixed)`}
                                className={`mx-auto inline-flex h-8 w-8 items-center justify-center rounded-md border cursor-default ${
                                  enabled
                                    ? "border-green-200 bg-green-50 text-green-600"
                                    : "border-[#dce3ee] bg-white text-muted-foreground"
                                }`}
                              >
                                {enabled ? (
                                  <CheckCircle
                                    size={
                                      16
                                    }
                                  />
                                ) : (
                                  <X
                                    size={
                                      16
                                    }
                                  />
                                )}
                              </div>
                            </td>
                          );
                        }
                      )}


                      <td className="py-3 px-4 text-right">
                        <span className="inline-flex items-center justify-center rounded-full border border-blue-200 bg-blue-50 px-3 py-1.5 text-xs font-semibold text-blue-700">
                          Fixed
                        </span>
                      </td>
                    </tr>
                  )
                )
              )}
            </tbody>
          </table>
        </div>
      </Card>


      {/* ROLE GUIDE */}

      <Card title="Role Access Guide">
        <div className="p-4 grid grid-cols-1 md:grid-cols-2 gap-3">
          <div className="rounded-md border border-[#dce3ee] p-3">
            <p className="text-sm font-semibold">
              Student
            </p>

            <p className="text-xs text-muted-foreground mt-1">
              Can register personal items and view approved QR codes.
            </p>
          </div>

          <div className="rounded-md border border-[#dce3ee] p-3">
            <p className="text-sm font-semibold">
              Security (CSU)
            </p>

            <p className="text-xs text-muted-foreground mt-1">
              Can scan and verify QR codes and view security reports.
            </p>
          </div>

          <div className="rounded-md border border-[#dce3ee] p-3">
            <p className="text-sm font-semibold">
              PCO Staff
            </p>

            <p className="text-xs text-muted-foreground mt-1">
              Can view QR codes, approve item-registration requests,
              and view reports.
            </p>
          </div>

          <div className="rounded-md border border-[#dce3ee] p-3">
            <p className="text-sm font-semibold">
              System Administrator
            </p>

            <p className="text-xs text-muted-foreground mt-1">
              Can view reports and manage user accounts.
            </p>
          </div>
        </div>
      </Card>
    </div>
  );
}

// ── Page registry ─────────────────────────────────────────────────────────────

// ══════════════════════════════════════════════════════════════════════════════
// CSU READ-ONLY ITEM REGISTRY - approved items only
// Data is returned by the role-restricted /security-reports endpoint.
// =========================================================
function SecurityItemRegistry() {
  const openManageV147 = React.useContext(QRPassCSUManageContextV147);
  const [csuListSort, setCsuListSort] =
    useState<"newest" | "oldest">("newest");
  const [items, setItems] = useState<any[]>([]);
  const [search, setSearch] = useState("");
  const [statusFilter, setStatusFilter] = useState("all");
  const [registeredPeriod, setRegisteredPeriod] = useState<CSUDatePeriod>("all");
  const [registeredStart, setRegisteredStart] = useState("");
  const [registeredEnd, setRegisteredEnd] = useState("");
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  async function refresh() {
    try {
      setLoading(true);
      setError("");
      const response = await getSecurityReports();
      if (!Array.isArray(response?.registered_items)) {
        setItems([]);
        setError("The CSU item registry is not enabled in the backend. Install the provided ReportController.php update.");
        return;
      }
      setItems(response.registered_items);
    } catch (err) {
      setItems([]);
      setError(err instanceof Error ? err.message : "Failed to load the CSU registry.");
    } finally {
      setLoading(false);
    }
  }
  useEffect(() => { void refresh(); }, []);

  const itemStatus = (item: any) => {
    if (item.is_flagged) return "Flagged";
    const expired = item.qr_expires_at && new Date(item.qr_expires_at).getTime() < Date.now();
    return expired ? "Expired" : item.qr_code ? "Active" : "No QR";
  };
  // Date is based on the date the item was first registered.
  const periodItems = items.filter(item =>
    csuMatchesPeriod(item.created_at ?? item.registered_at, registeredPeriod, registeredStart, registeredEnd)
  );
  const visible = periodItems.filter(item => {
    if (statusFilter !== "all" && itemStatus(item).toLowerCase() !== statusFilter) return false;
    const haystack = [item.item_name, item.item_type, item.serial_number, item.qr_code, item.brand_model, item.user?.name, item.user?.username].map(value => String(value ?? "").toLowerCase()).join(" ");
    return haystack.includes(search.trim().toLowerCase());
  });

  const shownRegistryItems = [...visible].sort((a, b) => {
    const x = new Date(a.created_at ?? a.registered_at ?? 0).getTime() || 0;
    const y = new Date(b.created_at ?? b.registered_at ?? 0).getTime() || 0;
    return csuListSort === "newest" ? y - x : x - y;
  });
  function downloadCsv() {
    if (visible.length === 0) { alert("There are no registered items to export."); return; }
    const escape = (value: unknown) => {
      const raw = String(value ?? "").replace(/^([=+\-@])/, "'$1");
      return `"${raw.replace(/"/g, '""')}"`;
    };
    const data = [
      ["Item", "Category", "Brand / Model", "Serial No.", "Owner", "Owner ID", "QR ID", "Valid Until", "QR Status"],
      ...visible.map(item => [item.item_name, item.item_type, item.brand_model, item.serial_number, item.user?.name, item.user?.username, item.qr_code, item.qr_expires_at, itemStatus(item)]),
    ];
    const blob = new Blob(["\uFEFF" + data.map(row => row.map(escape).join(",")).join("\r\n")], {type: "text/csv;charset=utf-8;"});
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = `QRPass-CSU-Registered-Items-${new Date().toISOString().slice(0, 10)}.csv`;
    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
  }
  return (
    <div className="w-full min-w-0 space-y-5">
      <PageHeader title="Registered Items" subtitle="Read-only approved item registry for gate personnel. Pending and rejected applications remain restricted to PCO and System Admin."/>
      <StatisticalCardsSection>
      <div className="grid grid-cols-2 gap-3 lg:grid-cols-3">
        <StatCard label="Approved Items" value={loading ? "..." : String(periodItems.length)} icon={<Package size={20}/>} color="#1a3a7b"/>
        <StatCard label="Active QR" value={loading ? "..." : String(periodItems.filter(item => itemStatus(item) === "Active").length)} icon={<QrCode size={20}/>} color="#15803d"/>
        <div className="col-span-2 lg:col-span-1"><StatCard label="Expired QR" value={loading ? "..." : String(periodItems.filter(item => itemStatus(item) === "Expired").length)} icon={<Clock size={20}/>} color="#d97706"/></div>
      </div>
      </StatisticalCardsSection>
      <Card title="Approved Item Registry">
        <div className="flex min-w-0 flex-col gap-2 border-b border-border p-4 lg:flex-row lg:items-center">

          {/* SEARCH BAR */}
          <label className="relative block min-w-0 flex-1">
            <Search
              size={16}
              className="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground"
            />
            <input
              aria-label="Search approved items"
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              placeholder="Search item, owner, QR ID or serial..."
              className="h-12 w-full rounded-xl border border-[#bfceff] pl-10 pr-3 text-sm text-foreground outline-none focus:border-[#6488ff] focus:ring-2 focus:ring-[#6488ff]/15 dark:border-[#35537e] dark:bg-[#1b2b49] !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
            />
          </label>

          {/* DROPDOWNS AND REFRESH */}
          <div className="flex flex-wrap items-center gap-2 lg:shrink-0">

            <select
              aria-label="Filter QR status"
              value={statusFilter}
              onChange={(e) => setStatusFilter(e.target.value)}
              className="h-12 min-w-[145px] flex-1 rounded-xl border border-[#bfceff] px-3 text-sm text-foreground outline-none focus:border-[#6488ff] dark:border-[#35537e] dark:bg-[#1b2b49] sm:flex-none !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
            >
              <option value="all">All QR Statuses</option>
              <option value="active">Active</option>
              <option value="expired">Expired</option>
              <option value="flagged">Flagged</option>
              <option value="no qr">No QR</option>
            </select>

            <select
              aria-label="Sort records"
              value={csuListSort}
              onChange={(e) =>
                setCsuListSort(
                  e.target.value as "newest" | "oldest"
                )
              }
              className="h-12 min-w-[145px] flex-1 rounded-xl border border-[#bfceff] px-3 text-sm text-foreground outline-none focus:border-[#6488ff] dark:border-[#35537e] dark:bg-[#1b2b49] sm:flex-none !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
            >
              <option value="newest">Newest first</option>
              <option value="oldest">Oldest first</option>
            </select>
        {openManageV147 && (
          <button type="button" title="Manage Logs" aria-label="Manage Logs"
            onClick={openManageV147}
            data-qrpass-hover-uniform-v141="true"
            className="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#c7d2fe] bg-white text-[#17336d] transition-colors hover:bg-[#eef2ff]"
  onMouseEnter={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', '#eef2ff', 'important');
    s.setProperty('background-color', '#eef2ff', 'important');
    s.setProperty('border-color', '#a8bde4', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
  onMouseLeave={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', '#ffffff', 'important');
    s.setProperty('background-color', '#ffffff', 'important');
    s.setProperty('border-color', '#cbd5e1', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
  onFocus={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', e.currentTarget.matches(':hover') ? '#eef2ff' : '#ffffff', 'important');
    s.setProperty('border-color', e.currentTarget.matches(':hover') ? '#a8bde4' : '#cbd5e1', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
  onBlur={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', '#ffffff', 'important');
    s.setProperty('background-color', '#ffffff', 'important');
    s.setProperty('border-color', '#cbd5e1', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
>
            <SlidersHorizontal size={18} strokeWidth={1.8}/>
          </button>
        )}

            <button
              type="button"
              onClick={() => { void refresh(); }}
              disabled={loading}
              className="inline-flex h-12 items-center justify-center gap-1.5 rounded-xl px-3 text-xs font-semibold text-primary hover:bg-muted disabled:opacity-50 md:!hidden"
            >
              <RefreshCw size={14} />
              {loading ? "Refreshing..." : "Refresh"}
            </button>

          </div>
        </div>

        {error && <p role="alert" className="m-4 rounded-lg border border-red-200 bg-red-50 p-3 text-xs text-red-700">{error}</p>}
        <div className="w-full overflow-x-auto"><table className="w-full min-w-[900px] text-sm"><thead className="bg-muted/40 text-left text-xs text-muted-foreground"><tr>{["Item", "Owner", "Serial No.", "QR ID", "Expiration", "Status"].map(label => <th key={label} className="px-4 py-3">{label}</th>)}</tr></thead><tbody className="divide-y divide-border">
          {shownRegistryItems.map(item => <tr key={item.id} className="hover:bg-muted/30"><td className="px-4 py-3"><span className="font-semibold">{item.item_name ?? "—"}</span><p className="text-xs text-muted-foreground">{item.item_type ?? "—"}</p></td><td className="px-4 py-3">{item.user?.name ?? "—"}<p className="text-xs text-muted-foreground">{item.user?.username ?? ""}</p></td><td className="px-4 py-3 font-mono text-xs">{item.serial_number ?? "—"}</td><td className="px-4 py-3 font-mono text-xs">{item.qr_code ?? "—"}</td><td className="px-4 py-3 whitespace-nowrap">{item.qr_expires_at ? new Date(item.qr_expires_at).toLocaleDateString("en-PH") : "—"}</td><td className="px-4 py-3"><span className={`rounded-full border px-2.5 py-1 text-xs font-semibold ${itemStatus(item) === "Active" ? "border-green-200 bg-green-50 text-green-700" : "border-amber-200 bg-amber-50 text-amber-700"}`}>{itemStatus(item)}</span></td></tr>)}
          {!loading && visible.length === 0 && <tr><td colSpan={6} className="p-8 text-center text-sm text-muted-foreground">No approved items match your search.</td></tr>}
          {loading && <tr><td colSpan={6} className="p-8 text-center text-sm text-muted-foreground">Loading approved item registry...</td></tr>}
        </tbody></table></div>
      </Card>
    </div>
  );
}

// QRPass centralized Sysadmin-only report generator (page access follows Sysadmin navigation).

/* QRPASS_SYSADMIN_FOUR_UNIFORM_BUTTONS_V75 */
/* QRPASS_COMPACT_ROUNDED_BUTTONS_V76 */
/**
 * The four System Administrator save/download buttons use identical geometry.
 * Inline-important values deliberately outrank all prior QRPass CSS patches.
 * Downloading/saving handlers, disabled/loading states and card layout are unchanged.
 */
function qrpassUniformSysadminActionButtonV75(button: HTMLButtonElement | null): void {
  if (!button) return;
  const rules: ReadonlyArray<readonly [string, string]> = [
    ['box-sizing', 'border-box'],
    ['display', 'inline-flex'],
    ['align-items', 'center'],
    ['justify-content', 'center'],
    ['vertical-align', 'middle'],
    ['width', '176px'],
    ['min-width', '0'],
    ['max-width', '100%'],
    ['height', '48px'],
    ['min-height', '48px'],
    ['max-height', '48px'],
    ['padding', '0 14px'],
    ['border', '1px solid transparent'],
    ['border-radius', '18px'],
    ['font-size', '14px'],
    ['font-weight', '600'],
    ['line-height', '20px'],
    ['letter-spacing', 'normal'],
    ['white-space', 'nowrap'],
    ['gap', '8px'],
    ['text-align', 'center'],
    ['background', 'linear-gradient(180deg, #294c90 0%, #1c335b 100%)'],
    ['background-color', '#294c90'],
    ['background-image', 'linear-gradient(180deg, #294c90 0%, #1c335b 100%)'],
    ['color', '#ffffff'],
    ['box-shadow', 'none'],
    ['text-shadow', 'none'],
  ];
  for (const [name, value] of rules) button.style.setProperty(name, value, 'important');
  const icon = button.querySelector('svg');
  if (icon) {
    icon.style.setProperty('width', '16px', 'important');
    icon.style.setProperty('height', '16px', 'important');
    icon.style.setProperty('flex-shrink', '0', 'important');
    icon.style.setProperty('color', '#ffffff', 'important');
    icon.style.setProperty('stroke', '#ffffff', 'important');
  }
}

function SysAdminDownloadableReports() {
  type ReportKey = "items" | "users" | "audit" | "entryexit" | "lostfound" | "incidents" | "sessions";
  type ReportFormat = "xlsx" | "pdf" | "csv";
  type Period = "day" | "week" | "month" | "all" | "custom";
  const definitions: {key: ReportKey; name: string; description: string}[] = [
    {key:"items", name:"Registered Items Report", description:"Registered inventory, QR codes, owners and approval status"},
    {key:"users", name:"User Accounts Report", description:"User directory, roles and account statuses"},
    {key:"audit", name:"System Activity Logs Report", description:"Logins, logouts, changes and audit events"},
    {key:"entryexit", name:"Entry & Exit Transactions Report", description:"QR verification and IN/OUT gate activity"},
    {key:"lostfound", name:"Lost & Found Report", description:"Reported, found, recovered and claimed items"},
    {key:"incidents", name:"Security Incidents Report", description:"Flagged incidents, outcomes and resolution"},
    {key:"sessions", name:"Active Sessions Report", description:"Authentication sessions and most recent activity"},
  ];
  const [report, setReport] = useState<ReportKey>("items");
  const [period, setPeriod] = useState<Period>("day");
  const [fromDate, setFromDate] = useState("");
  const [toDate, setToDate] = useState("");
  const [busy, setBusy] = useState(false);
  const [message, setMessage] = useState("");

  const getPeriodBounds = () => {
    if (period === "all") return {start:null as Date | null, end:null as Date | null};
    const now = new Date();
    const start = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const end = new Date(start);
    if (period === "custom") {
      if (!fromDate || !toDate || fromDate > toDate) throw new Error("Select a valid start and end date.");
      // Parse local midnight, not UTC, to avoid a one-day shift in Philippine time.
      const beginning = new Date(`${fromDate}T00:00:00`);
      const ending = new Date(`${toDate}T00:00:00`);
      ending.setDate(ending.getDate() + 1);
      return {start:beginning, end:ending};
    }
    if (period === "week") start.setDate(start.getDate() - (start.getDay() + 6) % 7);
    if (period === "month") start.setDate(1);
    if (period === "day") end.setDate(end.getDate() + 1);
    if (period === "week") { end.setTime(start.getTime()); end.setDate(end.getDate() + 7); }
    if (period === "month") { end.setTime(start.getTime()); end.setMonth(end.getMonth() + 1); }
    return {start, end};
  };

  const value = (input: any) => input === null || input === undefined ? "" : String(input);
  const displayDate = (input: any) => {
    if (!input) return "";
    const parsed = new Date(input);
    return Number.isNaN(parsed.getTime()) ? value(input) : parsed.toLocaleString("en-PH");
  };

  async function generate(format: ReportFormat) {
    if (busy) return;
    setBusy(true); setMessage("");
    try {
      const bounds = getPeriodBounds();
      let source: any;
      if (report === "items") source = await getAllItems();
      else if (report === "users") source = await getUsers();
      else if (report === "audit") source = await getAuditLogs({limit:500});
      else if (report === "entryexit") source = await getScanLogs();
      else if (report === "lostfound") source = await getSystemRecords();
      else if (report === "incidents") source = await getSecurityIncidents();
      else source = await getActiveSessions();

      const raw: any[] = report === "items" ? (source?.items ?? []) :
        report === "users" ? (source?.users ?? []) :
        report === "audit" ? (source?.logs ?? []) :
        report === "entryexit" ? (source?.logs ?? []) :
        report === "lostfound" ? (source?.lost_found_items ?? (source?.records ?? []).filter((r: any) => r.record_type === "Lost & Found")) :
        report === "incidents" ? (source?.incidents ?? []) : (source?.sessions ?? []);
      if (!Array.isArray(raw)) throw new Error("Report records were not returned in the expected format.");
      const timestamp = (r: any) => report === "entryexit" ? (r.scanned_at ?? r.created_at) :
        report === "lostfound" ? (r.reported_at ?? r.created_at ?? r.date) :
        report === "incidents" ? (r.reported_at ?? r.created_at) :
        report === "sessions" ? (r.last_used_at ?? r.created_at) : r.created_at;
      const records = raw.filter(r => {
        if (report === "entryexit" && !["IN", "OUT"].includes(value(r.direction).toUpperCase())) return false;
        if (!bounds.start && !bounds.end) return true;
        const stamp = timestamp(r);
        const d = stamp ? new Date(stamp) : null;
        return !!d && !Number.isNaN(d.getTime()) && (!bounds.start || d >= bounds.start) && (!bounds.end || d < bounds.end);
      });
      if (!records.length) { setMessage("No records found for this report and period."); return; }
      let headers: string[] = [];
      let rows: string[][] = [];
      if (report === "items") {
        headers = ["Date", "Item", "Category", "Owner", "Owner ID", "QR ID", "Serial", "Status"];
        rows = records.map(r => [displayDate(timestamp(r)),value(r.item_name),value(r.item_type),value(r.user?.name),value(r.user?.username),value(r.qr_code),value(r.serial_number),value(r.status)]);
      } else if (report === "users") {
        headers = ["Created", "User ID", "Name", "Role", "Status", "Department"];
        rows = records.map(r => [displayDate(timestamp(r)),value(r.id),value(r.name),value(r.role),value(r.account_status ?? r.status),value(r.department)]);
      } else if (report === "audit") {
        headers = ["Date", "Actor", "Username", "Action", "Module", "Description", "Status"];
        rows = records.map(r => [displayDate(timestamp(r)),value(r.actor_name ?? r.user?.name),value(r.actor_username ?? r.user?.username),value(r.action),value(r.module),value(r.description),value(r.status)]);
      } else if (report === "entryexit") {
        headers = ["Date", "QR ID", "Item", "Owner", "Gate", "Direction", "Result", "Scanner"];
        rows = records.map(r => [displayDate(timestamp(r)),value(r.qr_code ?? r.scanned_code),value(r.item?.item_name ?? r.item_name),value(r.item?.user?.name ?? r.owner_name),value(r.gate),value(r.direction),value(r.result),value(r.scanner?.name)]);
      } else if (report === "lostfound") {
        headers = ["Date", "Item", "Category", "Type", "Location", "Reporter", "Claimant", "Status"];
        rows = records.map(r => [displayDate(timestamp(r)),value(r.item_name ?? r.title),value(r.category ?? r.details?.category),value(r.report_type ?? r.type),value(r.location_found ?? r.location_lost ?? r.details?.location_found),value(r.reporter?.name ?? r.user_name),value(r.claimant?.name ?? r.details?.claimed_by),value(r.status)]);
      } else if (report === "incidents") {
        headers = ["Date", "Incident", "Item", "QR Code", "Gate", "Description", "Status"];
        rows = records.map(r => [displayDate(timestamp(r)),value(r.incident_type),value(r.item_name),value(r.scanned_code),value(r.gate ?? r.location),value(r.description ?? r.reason),value(r.status)]);
      } else {
        headers = ["Last Activity", "User", "Role", "Session ID", "Active", "Current"];
        rows = records.map(r => [displayDate(timestamp(r)),value(r.name ?? r.user?.name),value(r.role ?? r.user?.role),value(r.id),r.is_active ? "Yes" : "No",r.is_current ? "Yes" : "No"]);
      }

      const label = definitions.find(item => item.key === report)?.name ?? "QRPass Report";
      const filename = `QRPass-${report}-${period}-${new Date().toISOString().slice(0,10)}`;
      if (format === "xlsx") {
        const worksheet = XLSX.utils.aoa_to_sheet([headers, ...rows]);
        const workbook = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(workbook, worksheet, "QRPass Report");
        XLSX.writeFile(workbook, `${filename}.xlsx`);
      } else if (format === "csv") {
        const escape = (cell: string) => `"${cell.replace(/"/g,'""')}"`;
        const csv = "\uFEFF" + [headers, ...rows].map(row => row.map(escape).join(",")).join("\r\n");
        const url = URL.createObjectURL(new Blob([csv], {type:"text/csv;charset=utf-8"}));
        const anchor = document.createElement("a");
        anchor.href = url; anchor.download = `${filename}.csv`;
        document.body.appendChild(anchor); anchor.click(); anchor.remove();
        URL.revokeObjectURL(url);
      } else {
        const pdf = new jsPDF({orientation:"landscape"});
        pdf.setFontSize(16); pdf.text(label, 14, 18);
        pdf.setFontSize(9); pdf.text("University of Cebu - Main Campus", 14, 26);
        pdf.text(`Period: ${period}   Records: ${records.length}`, 14, 33);
        autoTable(pdf, {startY:40, head:[headers], body:rows, styles:{fontSize:7,cellPadding:2}, headStyles:{fillColor:[26,58,123]}});
        pdf.save(`${filename}.pdf`);
      }
      setMessage(`${label}: ${records.length} records prepared.`);
    } catch (error) {
      setMessage(error instanceof Error ? error.message : "Could not generate the report.");
    } finally {
      setBusy(false);
    }
  }

  return (
    <div id="qrpass-sysadmin-reports-v4" className="space-y-4">
      <PageHeader title="Downloadable Reports" subtitle="Generate and export official QRPass system reports." />
      <div className="overflow-hidden rounded-2xl border border-[#dce3ee] bg-white shadow-sm">
        <div className="border-b border-[#e6ebf2] px-5 py-4 sm:px-6">
          <h3 className="text-lg font-semibold leading-none text-[#17336d]">Generate a report</h3>
        </div>
        <div className="grid gap-5 px-5 py-5 sm:px-6 lg:grid-cols-2">
          <div>
            <label className="mb-2 block text-sm font-semibold leading-6 text-[#17336d]">Report Type</label>
            <select data-qrpass-report-select="true"
              aria-label="Report type"
              value={report}
              onChange={e => {setReport(e.target.value as ReportKey); setMessage("");}}
              className="h-14 w-full rounded-xl border px-4 text-base font-medium text-[#17336d] outline-none transition border-[#cbd5e1] bg-white hover:border-[#9fb8e4] hover:bg-[#eef2ff] focus:border-[#80a4df] focus:bg-white focus:hover:bg-white focus:ring-2 focus:ring-[#dbe7ff] active:bg-white duration-150 ease-in-out"
            >
              {definitions.map(d => <option key={d.key} value={d.key}>{d.name}</option>)}
            </select>
          </div>
          <div>
            <label className="mb-2 block text-sm font-semibold leading-6 text-[#17336d]">Filter by Date</label>
            <select data-qrpass-report-select="true"
              aria-label="Filter reports by date"
              value={period}
              onChange={e => {setPeriod(e.target.value as Period); setMessage("");}}
              className="h-14 w-full rounded-xl border px-4 text-base font-medium text-[#17336d] outline-none transition border-[#cbd5e1] bg-white hover:border-[#9fb8e4] hover:bg-[#eef2ff] focus:border-[#80a4df] focus:bg-white focus:hover:bg-white focus:ring-2 focus:ring-[#dbe7ff] active:bg-white duration-150 ease-in-out"
            >
              <option value="day">Today</option>
              <option value="week">This Week</option>
              <option value="month">This Month</option>
            </select>
          </div>
        </div>
        <div className="border-t border-[#e6ebf2] px-5 py-4 sm:px-6">
          <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-end">
            {([
              {key:"pdf", label:"Download PDF"},
              {key:"xlsx", label:"Download Excel"},
            ] as const).map(({key, label}) => (
              <button
                key={key}
                type="button"
                disabled={busy}
                onClick={() => void generate(key)}
                className="qrpass-report-download-registration-v71"
                data-qrpass-uniform-v75="true"
                ref={qrpassUniformSysadminActionButtonV75}
              >
                <Download size={17} />
                {label}
              </button>
            ))}
          </div>
        </div>
        {message && (
          <div className="border-t border-[#e6ebf2] px-5 py-3 sm:px-6">
            <p role="status" className="text-sm text-[#17336d]">{message}</p>
          </div>
        )}
      </div>
    </div>
  );
}

// System Records and Audit Activity share one navigation page, while retaining their own APIs.
function SysAdminSystemLogs() {
  return <SysAdminAuditLogs />;
}

// =========================================================
// CSU NOTIFICATIONS - same authenticated notifications API as header
// =========================================================
function SysAdminRegisteredItemsPage() {
  return <PCOItemRegistry adminView />;
}


/* qrpass-sysadmin-manage-ui-v4: targeted page manager controls */
function QrpassPageManager({ module, onClose }: { module: 'items' | 'lost-found' | 'users'; onClose: () => void }) {
  const [view, setView] = React.useState<'active' | 'archived'>('active');
  const [rows, setRows] = React.useState<any[]>([]);
  const [chosen, setChosen] = React.useState<number[]>([]);
  const [query, setQuery] = React.useState('');
  const [busy, setBusy] = React.useState(false);
  const [message, setMessage] = React.useState('');
  const [error, setError] = React.useState('');
  const [confirmAction, setConfirmAction] = React.useState('');
  const titles: Record<string,string> = {items:'Manage Items','lost-found':'Manage Reports',users:'Manage Users'};

  /* QRPASS_MANAGE_USERS_STATUS_MATCH_USER_LIST_V50 */
  const renderManageUserStatusV50 = (value: unknown) => {
    const normalized = String(value ?? "").trim().toLowerCase();
    const active = normalized === "approved" || normalized === "active";
    const disabled = ["disabled", "inactive", "revoked", "blocked", "suspended"].includes(normalized);
    const label = active
      ? "Active"
      : disabled
        ? "Disabled"
        : normalized
          ? normalized.charAt(0).toUpperCase() + normalized.slice(1)
          : "—";
    const badge = active
      ? "bg-green-100 text-green-700"
      : disabled
        ? "bg-red-100 text-red-700"
        : "bg-slate-100 text-slate-700";
    return (
      <span className={`inline-flex px-2.5 py-1 rounded-full text-[11px] font-semibold ${badge}`}>
        {label}
      </span>
    );
  };

  const base = 'http://localhost:8000/api/sysadmin/page-manage/' + module;
  const request = React.useCallback(async (url: string, options: RequestInit = {}) => {
    const token = localStorage.getItem('token');
    const res = await fetch(url, { ...options, headers: { Accept: 'application/json', Authorization: `Bearer ${token ?? ''}`, ...(options.body ? {'Content-Type':'application/json'} : {}), ...(options.headers || {}) } });
    const json = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(json.message || `HTTP ${res.status}`);
    return json;
  }, []);
  const reload = React.useCallback(async () => {
    setBusy(true); setError('');
    try {
      const data = await request(base + '?view=' + view);
      setRows(Array.isArray(data.data) ? data.data : []);
      setChosen([]);
    } catch (e) { setError(e instanceof Error ? e.message : 'Could not load records.'); }
    finally { setBusy(false); }
  }, [base, view, request]);
  React.useEffect(() => { void reload(); }, [reload]);
  const filtered = rows.filter(r => JSON.stringify(r).toLowerCase().includes(query.toLowerCase()));
  const label = (r: any) => String(r.item_name || r.name || r.title || r.email || `Record #${r.id}`);
  async function change(action: string) {
    if (chosen.length === 0) { setError('Select at least one record.'); return; }
    if (action === 'delete' && confirmAction !== 'DELETE') { setError('Type DELETE to confirm permanent deletion.'); return; }
    setBusy(true); setError(''); setMessage('');
    try {
      const data = await request(base, { method:'POST', body:JSON.stringify({action, ids:chosen, confirmation:confirmAction}) });
      setMessage(`${data.affected ?? 0} record(s) updated.`);
      setConfirmAction('');
      await reload();
      window.dispatchEvent(new CustomEvent('qrpass-page-records-changed', {detail:{module}}));
    } catch(e) { setError(e instanceof Error ? e.message : 'Management action failed.'); }
    finally { setBusy(false); }
  }
  async function download() {
    setBusy(true); setError('');
    try {
      const token = localStorage.getItem('token');
      const response = await fetch(base + '/export?view=' + view, {headers:{Authorization:`Bearer ${token ?? ''}`,Accept:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'}});
      if (!response.ok) {
        const err = await response.json().catch(() => ({}));
        throw new Error(err.message || `Download failed: HTTP ${response.status}`);
      }
      const blob = await response.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href=url; a.download=`qrpass-${module}-${view}.xlsx`;
      document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
    } catch (e) { setError(e instanceof Error ? e.message : 'Download failed.'); }
    finally {setBusy(false);}
  }

  return (
    <div className="qrpass-page-manager-v4 fixed inset-0 z-[250] flex items-center justify-center bg-black/70 p-3 sm:p-6" data-qrpass-manage-v31="true" data-qrpass-manage-v32="true" role="dialog" aria-modal="true" aria-label={titles[module]}>
      <div className="w-full max-w-4xl max-h-[90vh] overflow-y-auto rounded-2xl border border-[#385785] bg-white p-4 text-slate-900 shadow-2xl dark:bg-[#0d1830] dark:text-white sm:p-6">
        <div className="flex items-center justify-between gap-3 mb-5">
          <h2 className="text-xl font-bold">{titles[module]}</h2>
          <button type="button" onClick={onClose} className="rounded-lg border px-3 py-2" data-qrpass-neutral-v169="true">Close</button>
        </div>
        <div className="flex flex-wrap items-center gap-2 mb-4">
          
          <button type="button" onClick={()=>{ setChosen([]); setView(v => v === 'active' ? 'archived' : 'active'); }} className="border rounded-lg px-3 py-2 !bg-white !text-[#17336d] !border-[#cbd5e1] transition-colors hover:!bg-[#eef2ff] hover:!border-[#a8bde4] hover:!text-[#17336d] focus-visible:!ring-0 focus-visible:!shadow-none focus-visible:!outline-none" 
            onMouseEnter={(e) => {
              const el=e.currentTarget;
              if(!el.dataset.qrpassV158Saved) {
                el.dataset.qrpassV158Saved=el.style.cssText || " ";
              }
              el.style.setProperty("background", "#eef2ff", "important");
              el.style.setProperty("background-color", "#eef2ff", "important");
              el.style.setProperty("background-image", "none", "important");
              el.style.setProperty("color", "#17336d", "important");
              el.style.setProperty("border-color", "#a8bde4", "important");
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onMouseLeave={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onFocus={(e) => {
              e.currentTarget.style.setProperty("box-shadow", "none", "important");
              e.currentTarget.style.setProperty("outline", "none", "important");
            }}
            onBlur={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}

          >{view === 'active' ? 'View Archives' : 'Back to Records'}</button>
          <input className="min-w-[160px] flex-1 border rounded-lg px-3 py-2" placeholder="Search records..." value={query} onChange={e=>setQuery(e.target.value)}/>
          
        </div>
        {error && <p className="p-3 mb-3 rounded bg-red-100 text-red-800">{error}</p>}
        {message && <p className="p-3 mb-3 rounded bg-green-100 text-green-800">{message}</p>}
        <div className="border rounded-xl overflow-auto max-h-[42vh]">
          {filtered.length===0 ? <p className="p-7 text-center font-semibold">No matching records</p> : (
            <table className="w-full text-left text-sm"><thead><tr><th className="p-3">Select</th><th className="p-3">Record</th><th className="p-3">Status</th><th className="p-3">Date</th></tr></thead>
            <tbody>{filtered.map(r => {
              const id = Number(r.id);
              const selected = chosen.includes(id);
              const toggleRow = () => { if (!busy && Number.isFinite(id)) setChosen(ids => ids.includes(id) ? ids.filter(x => x !== id) : [...ids, id]); };
              return <tr key={r.id} role="checkbox" aria-checked={selected} aria-label={`Select ${label(r)}`}
                tabIndex={busy ? -1 : 0} onClick={toggleRow}
                onKeyDown={e => { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); toggleRow(); } }}
                className={`border-t cursor-pointer transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-500 ${selected ? 'bg-[#eaf0ff] dark:bg-[#1d355e]' : 'hover:bg-[#f2f6ff] dark:hover:bg-[#172b4b]'}`}>
                <td className="p-3"><input type="checkbox" aria-label={`Select ${label(r)}`} disabled={busy} checked={selected} onClick={e => e.stopPropagation()} onChange={e => {setChosen(ids => e.target.checked ? Array.from(new Set([...ids, id])) : ids.filter(n => n !== id));}} /></td>
                <td className="p-3">{label(r)}</td><td className="p-3">{module === "users" ? renderManageUserStatusV50(r.status) : String(r.status ?? '—')}</td><td className="p-3">{String(r.created_at ?? '—')}</td>
              </tr>;
            })}</tbody></table>
          )}
        </div>
        <div className="mt-4 flex flex-wrap gap-2 items-center">
          <span className="text-sm opacity-75 mr-auto">{chosen.length} selected · {filtered.length} shown (maximum 1000 loaded)</span>
          {/* qrpass-manageusers-selectall-v2: visible search-filtered rows only */}
          <button type="button"
            disabled={busy || filtered.length === 0}
            onClick={() => {
              const visibleIds = filtered.map(r => Number(r.id)).filter(Number.isFinite);
              const allSelected = visibleIds.every(id => chosen.includes(id));
              setChosen(ids => allSelected
                ? ids.filter(id => !visibleIds.includes(id))
                : Array.from(new Set([...ids, ...visibleIds])));
            }}
            className="border rounded-lg px-3 py-2 disabled:opacity-50"
          >{filtered.length > 0 && filtered.every(r => chosen.includes(Number(r.id))) ? 'Deselect All' : 'Select All'}</button>
          <button type="button" onClick={download} className="border rounded-lg px-3 py-2">Download</button>
          
          {view==='active' ? <button type="button" disabled={busy || !chosen.length} onClick={()=>void change('archive')} className="border rounded-lg px-3 py-2">Archive</button> :
            <button type="button" disabled={busy || !chosen.length} onClick={()=>void change('restore')} className="border rounded-lg px-3 py-2">Restore</button>}
          {module!=='users' && <button type="button" disabled={busy || !chosen.length} onClick={()=>setConfirmAction('pending')} className="border border-red-500 text-red-500 rounded-lg px-3 py-2">Delete</button>}
        </div>
        {confirmAction && module!=='users' && <div className="mt-4 border border-red-400 rounded-xl p-4">
          <p className="font-semibold">Permanently delete {chosen.length} selected record(s)? This cannot be undone.</p>
          <p className="text-xs mt-1 mb-3">Type DELETE to confirm. Existing relationships may prevent deletion.</p>
          <input className="border rounded-lg px-3 py-2 mr-2" value={confirmAction==='pending'?'':confirmAction} onChange={e=>setConfirmAction(e.target.value)} placeholder="Type DELETE" />
          <button type="button" disabled={busy || confirmAction!=='DELETE'} onClick={()=>void change('delete')} className="border border-red-500 rounded-lg px-3 py-2">Confirm Delete</button>
          <button type="button" onClick={()=>setConfirmAction('')} className="border rounded-lg px-3 py-2 ml-2 !bg-white !text-[#17336d] !border-[#cbd5e1] transition-colors hover:!bg-[#eef2ff] hover:!border-[#a8bde4] hover:!text-[#17336d] focus-visible:!ring-0 focus-visible:!shadow-none focus-visible:!outline-none" 
            onMouseEnter={(e) => {
              const el=e.currentTarget;
              if(!el.dataset.qrpassV158Saved) {
                el.dataset.qrpassV158Saved=el.style.cssText || " ";
              }
              el.style.setProperty("background", "#eef2ff", "important");
              el.style.setProperty("background-color", "#eef2ff", "important");
              el.style.setProperty("background-image", "none", "important");
              el.style.setProperty("color", "#17336d", "important");
              el.style.setProperty("border-color", "#a8bde4", "important");
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onMouseLeave={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onFocus={(e) => {
              e.currentTarget.style.setProperty("box-shadow", "none", "important");
              e.currentTarget.style.setProperty("outline", "none", "important");
            }}
            onBlur={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}

           data-qrpass-neutral-v169="true">Cancel</button>
        </div>}
      </div>
    </div>
  );
}


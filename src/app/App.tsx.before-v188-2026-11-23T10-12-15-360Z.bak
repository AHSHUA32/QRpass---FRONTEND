                type="button"
                onClick={backToSelection}
                className="text-xs px-4 py-2 border border-[#cfd8e6] rounded-md text-muted-foreground !bg-white !text-[#17336d] !border-[#cbd5e1] transition-colors hover:!bg-[#eef2ff] hover:!border-[#a8bde4] hover:!text-[#17336d] focus-visible:!ring-0 focus-visible:!shadow-none focus-visible:!outline-none"
               
            onMouseEnter={(e) => {
              const el=e.currentTarget;
              if(!el.dataset.qrpassV158Saved) {
                el.dataset.qrpassV158Saved=el.style.cssText || " ";
              }
              el.style.setProperty("background", "#eef2ff", "important");
              el.style.setProperty("background-color", "#eef2ff", "important");
              el.style.setProperty("background-image", "none", "important");
              el.style.setProperty("color", "#17336d", "important");
              el.style.setProperty("border-color", "#a8bde4", "important");
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onMouseLeave={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onFocus={(e) => {
              e.currentTarget.style.setProperty("box-shadow", "none", "important");
              e.currentTarget.style.setProperty("outline", "none", "important");
            }}
            onBlur={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}

           data-qrpass-neutral-v169="true">
                Cancel
              </button>

              <button
                type="submit"
                disabled={submitting}
                className="text-xs bg-primary text-white px-4 py-2 rounded-md font-semibold disabled:opacity-50 transition-colors hover:!bg-[#eef2ff] hover:!text-[#17336d] hover:!border-[#a8bde4] focus-visible:!ring-0 focus-visible:!shadow-none"
          >
                {submitting
                  ? "Submitting..."
                  : "Submit for Approval"}
              </button>
            </div>
          </form>
        </div>
      </div>
    );
  }

  return (
    <div className="space-y-5 min-w-0 w-full max-w-full overflow-x-clip">
      <PageHeader
        title="Register Item"
        subtitle="Register an item for campus entry and exit verification. PCO approval is required before a QR code is issued."
      />
      {/* QRPASS_STUDENT_CATEGORY_ONLY_GUIDE_V127 */}
      {/* Student How It Works button */}
      {!selectedGroup && (
      <div className="flex justify-end">
        <button
          type="button"
          onClick={() => setShowRegistrationGuide(v => !v)}
          aria-expanded={showRegistrationGuide}
          aria-controls="student-registration-guide"
          className="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-[#cfd8e6] bg-card px-4 py-2 text-sm font-semibold text-primary transition-colors hover:bg-muted"
        >
          <BookOpen size={16} />
          How it works
          <ChevronRight size={14} />
        </button>
      </div>
      )}

      {/* Student floating registration guide */}
      {!selectedGroup && showRegistrationGuide && (
        <div
          id="student-registration-guide"
          className="fixed inset-0 z-[100] flex items-center justify-center bg-black/55 p-4 sm:p-6"
          role="dialog"
          aria-modal="true"
          aria-label="How Registration Works"
          onMouseDown={e => {
            if (e.target === e.currentTarget) {
              setShowRegistrationGuide(false);
            }
          }}
        >
          <div className="relative w-full max-w-5xl max-h-[90vh] overflow-y-auto rounded-[26px] border border-[#cfd8e6] bg-card p-6 shadow-2xl sm:p-8">

            <button
              type="button"
              aria-label="Close guide"
              onClick={() => setShowRegistrationGuide(false)}
              className="absolute right-4 top-4 rounded-xl border border-border p-2.5 hover:bg-muted"
            >
              <X size={20} />
            </button>

            <div className="mb-6 pr-12">
              <h3 className="text-lg font-bold text-foreground sm:text-xl">
                How Registration Works
              </h3>

              <p className="mt-2 max-w-3xl text-sm leading-7 text-muted-foreground">
                Register your item, wait for PCO approval, and receive your QR code for campus entry and exit verification.
              </p>
            </div>

            <div className="grid grid-cols-1 gap-4 md:grid-cols-3">
              {[
                [
                  "1",
                  "Register",
                  "Select a category, complete the required details, and submit your request."
                ],
                [
                  "2",
                  "PCO Approval",
                  "Your request appears in Permit Status while PCO reviews the submitted information."
                ],
                [
                  "3",
                  "QR Code",
                  "Once approved, the active permit becomes available in QR Codes for campus verification."
                ]
              ].map(([number, title, description]) => (
                <div
                  key={number}
                  className="rounded-2xl border border-[#dce3ee] bg-[#f8fafc] p-5 dark:bg-muted/40 sm:p-6"
                >
                  <div className="flex items-start gap-4">
                    <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-white">
                      {number}
                    </div>

                    <div className="min-w-0">
                      <p className="text-sm font-semibold text-foreground">
                        {title}
                      </p>

                      <p className="mt-2 text-xs leading-6 text-muted-foreground sm:text-sm">
                        {description}
                      </p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}

      {selectedGroup ? (
        renderSelectedForm()
      ) : (
        <div className="space-y-5">
          <div className="w-full rounded-xl border border-[#cfd8e6] bg-card overflow-hidden">
            <div className="border-b border-[#cfd8e6] px-5 py-3">
              <h3 className="text-sm font-semibold text-foreground">
                Select an Item Category
              </h3>

            </div>

            <div className="divide-y divide-[#dce3ee]">
              {[
                {
                  key: "computer",
                  title: "Computer Equipment",
                  description:
                    "Laptops, desktop computers, and similar computer equipment.",
                  icon: <Monitor size={18} />,
                },
                {
                  key: "highvalue",
                  title: "High-Value Electronics",
                  description:
                    "DSLR cameras, projectors, printers, and similar electronics.",
                  icon: <Camera size={18} />,
                },
                {
                  key: "musical",
                  title: "Musical Instrument",
                  description:
                    "Guitars, keyboards, and other musical instruments.",
                  icon: <Music2 size={18} />,
                },
                {
                  key: "sports",
                  title: "Sports Equipment",
                  description:
                    "Balls, rackets, training gear, and other sports equipment.",
                  icon: <Globe2 size={18} />,
                },
                {
                  key: "other",
                  title: "Other Equipment",
                  description:
                    "Equipment that does not belong to the other registration groups.",
                  icon: <Package size={18} />,
                },
              ].map((category) => (
                <button
                  key={category.key}
                  type="button"
                  onClick={() =>
                    setSelectedGroup(
                      category.key as RegistrationGroupId
                    )
                  }
                  className="group flex w-full min-w-0 items-center gap-3 px-3 py-3.5 text-left transition-colors hover:bg-[#eef2fc]/10 sm:gap-4 sm:px-5"
          >
                  <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-[#d6dde8] bg-white text-[#1a3a7b]">
                    {category.icon}
                  </div>

                  <div className="min-w-0 flex-1">
                    <p className="text-sm font-semibold text-foreground">
                      {category.title}
                    </p>

                  </div>

                  <ChevronRight
                    size={17}
                    className="shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5 group-hover:text-primary"
                  />
                </button>
              ))}
            </div>
          </div>

        </div>
      )}
    </div>
  );
}


/* QRPASS_STUDENT_DIRECT_CONTROLS_V131 */
/* QRPASS_STUDENT_PAGE_MANAGER_V141 */
function StudentPageManagerV141({
  title, records, onClose, onView, downloadName,
}: {
  title: string;
  records: any[];
  onClose: () => void;
  onView: (record: any) => void;
  downloadName: string;
}) {
  const [query, setQuery] = React.useState("");
  const [selectedIds, setSelectedIds] = React.useState<string[]>([]);
  const safeRecords = Array.isArray(records) ? records : [];
  const filtered = safeRecords.filter((record) =>
    [record.id, record.item_name, record.item_type, record.category,
      record.brand_model, record.serial_number, record.status, record.qr_code,
      record.created_at]
      .filter((v) => v !== null && v !== undefined)
      .join(" ").toLowerCase().includes(query.trim().toLowerCase())
  );
  const keyFor = (item: any, index: number) => String(item.id ?? `local-${index}`);
  const visibleIds = filtered.map(keyFor);
  const allSelected = visibleIds.length > 0 && visibleIds.every(id => selectedIds.includes(id));
  const toggleOne = (id: string) => setSelectedIds(current =>
    current.includes(id) ? current.filter(x => x !== id) : [...current, id]);
  const csvCell = (value: unknown) => {
    let text = String(value ?? "");
    // Keep spreadsheet applications from interpreting untrusted cells as formulas.
    if (/^[\s]*[=+\-@]/.test(text)) text = "'" + text;
    return '"' + text.replace(/"/g,'""') + '"';
  };
  const download = () => {
    const chosen = selectedIds.length
      ? filtered.filter((item,index) => selectedIds.includes(keyFor(item,index)))
      : filtered;
    if (!chosen.length) return;
    const columns = ['id','item_name','item_type','category','brand_model','serial_number','status','qr_code','created_at'];
    const csv = [columns.map(csvCell).join(','),
      ...chosen.map(record => columns.map(key => csvCell(record[key])).join(','))].join('\r\n');
    const blob = new Blob(['\uFEFF',csv], {type:'text/csv;charset=utf-8'});
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `${downloadName}.csv`;
    document.body.appendChild(link);
    link.click();
    link.remove();
    setTimeout(() => URL.revokeObjectURL(url),1000);
  };
  return (
    <div className="fixed inset-0 z-[250] flex items-center justify-center bg-black/70 p-3 sm:p-6" role="presentation" onMouseDown={event => { if(event.target===event.currentTarget) onClose(); }}>
      <div role="dialog" aria-modal="true" aria-label={title} className="flex max-h-[90vh] w-full max-w-4xl flex-col overflow-hidden rounded-2xl border border-[#385785] bg-white p-4 text-[#17336d] shadow-2xl sm:p-5">
        <div className="mb-5 flex items-center justify-between gap-3">
          <h2 className="text-lg font-bold">{title}</h2>
          <button type="button" onClick={onClose} className="rounded-xl border border-[#c7d2fe] bg-white px-4 py-2 text-sm font-medium hover:bg-[#eef2ff]"
           data-qrpass-neutral-v169="true">Close</button>
        </div>
        <div className="mb-3 flex flex-wrap items-center gap-2">
          <button type="button" disabled title="Student archive API is not available" className="shrink-0 rounded-xl border border-[#c7d2fe] bg-white px-4 py-2.5 text-sm opacity-55">View Archives</button>
          <input value={query} onChange={event => setQuery(event.target.value)} placeholder="Search records..." aria-label={`Search ${title} records`} className="min-w-[180px] flex-1 rounded-xl border border-[#c7d2fe] bg-white px-4 py-2.5 text-sm outline-none hover:bg-[#eef2ff] focus:bg-white"/>
        </div>
        <div className="min-h-[68px] flex-1 overflow-y-auto rounded-xl border border-[#d8e1ee]">
          {filtered.length===0 ? <p className="p-7 text-center text-sm font-semibold">No matching records</p> : (
            <div className="divide-y divide-[#e5eaf2]">
              {filtered.map((item,index) => {
                const id=keyFor(item,index), selected=selectedIds.includes(id);
                return (
                  <div key={id} className={`flex items-center gap-3 p-3 ${selected?'bg-[#eef2ff]':'bg-white hover:bg-[#f8faff]'}`}>
                    <input type="checkbox" checked={selected} onChange={()=>toggleOne(id)} aria-label={`Select ${item.item_name || id}`}/>
                    <div className="min-w-0 flex-1">
                      <p className="truncate text-sm font-semibold">{item.item_name || `Record #${id}`}</p>
                      <p className="truncate text-xs text-[#64748b]">{String(item.status ?? 'â€”')} Â· {String(item.serial_number ?? 'No serial number')}</p>
                    </div>
                    <button type="button" onClick={()=>onView(item)} className="shrink-0 rounded-lg border border-[#c7d2fe] bg-white px-3 py-2 text-sm font-medium hover:bg-[#eef2ff]"
          >View</button>
                  </div>
                );
              })}
            </div>
          )}
        </div>
        <div className="mt-3 flex flex-wrap items-center gap-2">
          <span className="mr-auto text-xs text-[#64748b]">{selectedIds.length} selected Â· {filtered.length} shown</span>
          <button type="button" disabled={!visibleIds.length} onClick={()=>setSelectedIds(current=>allSelected?current.filter(id=>!visibleIds.includes(id)):Array.from(new Set([...current,...visibleIds])))} className="rounded-xl border border-[#c7d2fe] bg-white px-3 py-2 text-sm hover:bg-[#eef2ff] disabled:opacity-50"
          >{allSelected?'Deselect All':'Select All'}</button>
          <button type="button" disabled={!filtered.length} onClick={download} className="rounded-xl border border-[#c7d2fe] bg-white px-3 py-2 text-sm font-medium hover:bg-[#eef2ff] disabled:opacity-50"
          >Download</button>
          <button type="button" disabled title="Archive requires an authorized Student API" className="rounded-xl border border-[#c7d2fe] bg-white px-3 py-2 text-sm opacity-50">Archive</button>
          <button type="button" disabled title="Bulk permanent deletion is not supported for Student records" className="rounded-xl border border-red-200 bg-white px-3 py-2 text-sm text-red-600 opacity-50">Delete</button>
        </div>
        <p className="mt-2 text-xs text-[#64748b]">Archive and bulk Delete require Student-authorized backend support. Search, Select, View, and Download work with this pageâ€™s records.</p>
      </div>
    </div>
  );
}
function StudentMyQRCodes() {
  const [items, setItems] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [qrSearch, setQrSearch] = useState("");
  const [qrSortOrder, setQrSortOrder] = useState<"newest" | "oldest">("newest");
  const [qrModalItem, setQrModalItem] = useState<any | null>(null);
  /* QRPASS_STUDENT_QR_PERMIT_MANAGE_V139 */
  const [qrManageOpenV139, setQrManageOpenV139] = useState(false);
  const [downloadingQrId, setDownloadingQrId] =
    useState<number | string | null>(null);

  async function loadMyItems() {
    try {
      setLoading(true);

      const data = await getMyQRCodes();

      const loadedItems = Array.isArray(data?.items)
        ? data.items
        : [];

      setItems(
        [...loadedItems]
          .filter((item) => {
            const expiresAt =
              item.qr_expires_at
                ? new Date(
                    item.qr_expires_at
                  ).getTime()
                : null;

            const expired =
              expiresAt !== null &&
              !Number.isNaN(
                expiresAt
              ) &&
              expiresAt <=
                Date.now();

            return (
              item.status ===
                "approved" &&
              Boolean(
                item.qr_code
              ) &&
              !expired
            );
          })
          .sort(
            (a, b) =>
              Number(b?.id ?? 0) -
              Number(a?.id ?? 0)
          )
      );
    } catch (error) {
      console.error("Failed to load QR codes:", error);

      alert(
        error instanceof Error
          ? error.message
          : "Failed to load QR codes."
      );

      setItems([]);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadMyItems();
  }, []);

  const approvedItems = items.filter(
    (item) =>
      item.status === "approved" &&
      item.qr_code &&
      !isExpired(item)
  );

  const visibleQrItems = approvedItems
    .filter((item) => {
      const query = qrSearch.trim().toLowerCase();
      if (!query) return true;
      return [item.item_name, item.item_type, item.serial_number, item.qr_code,
        item.brand_model, item.id ? `ITEM-${String(item.id).padStart(3, "0")}` : ""]
        .filter(Boolean).join(" ").toLowerCase().includes(query);
    })
    .sort((a, b) => {
      const aTime = new Date(a.created_at || 0).getTime() || 0;
      const bTime = new Date(b.created_at || 0).getTime() || 0;
      return qrSortOrder === "newest" ? bTime - aTime : aTime - bTime;
    });

  function isExpired(item: any) {
    return Boolean(
      item.qr_expires_at &&
        new Date(item.qr_expires_at).getTime() <
          Date.now()
    );
  }

  function formatDate(value?: string | null) {
    if (!value) {
      return "Not set";
    }

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return value;
    }

    return date.toLocaleDateString("en-PH", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
  }

  function safeFileName(value: string) {
    return value
      .replace(/[^a-zA-Z0-9-_]+/g, "-")
      .replace(/-+/g, "-")
      .replace(/^-|-$/g, "");
  }

  async function downloadQRCode(item: any) {
    try {
      setDownloadingQrId(item.id);

      const wrapper =
        document.getElementById(
          `qr-source-${item.id}`
        );

      const svg =
        wrapper?.querySelector(
          "svg"
        ) as SVGSVGElement | null;

      if (!svg) {
        throw new Error(
          "QR code image could not be found."
        );
      }

      const clonedSvg =
        svg.cloneNode(true) as SVGSVGElement;

      clonedSvg.setAttribute("width", "1024");
      clonedSvg.setAttribute("height", "1024");
      clonedSvg.setAttribute(
        "xmlns",
        "http://www.w3.org/2000/svg"
      );

      const serializer = new XMLSerializer();

      const svgString =
        serializer.serializeToString(
          clonedSvg
        );

      const svgBlob = new Blob(
        [svgString],
        {
          type: "image/svg+xml;charset=utf-8",
        }
      );

      const svgUrl =
        URL.createObjectURL(svgBlob);

      const image = new Image();

      image.onload = () => {
        const canvas =
          document.createElement("canvas");

        canvas.width = 1024;
        canvas.height = 1024;

        const ctx =
          canvas.getContext("2d");

        if (!ctx) {
          URL.revokeObjectURL(svgUrl);
          setDownloadingQrId(null);
          alert(
            "Unable to prepare the QR code for download."
          );
          return;
        }

        ctx.fillStyle = "#ffffff";
        ctx.fillRect(
          0,
          0,
          canvas.width,
          canvas.height
        );

        ctx.drawImage(
          image,
          0,
          0,
          canvas.width,
          canvas.height
        );

        canvas.toBlob(
          (blob) => {
            URL.revokeObjectURL(svgUrl);

            if (!blob) {
              setDownloadingQrId(null);
              alert(
                "Unable to create QR image."
              );
              return;
            }

            const pngUrl =
              URL.createObjectURL(blob);

            const link =
              document.createElement("a");

            const itemName =
              safeFileName(
                String(
                  item.item_name ?? "item"
                )
              ) || "item";

            const qrCode =
              safeFileName(
                String(
                  item.qr_code ?? "qr"
                )
              ) || "qr";

            link.href = pngUrl;
            link.download =
              `${itemName}-${qrCode}.png`;

            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            URL.revokeObjectURL(pngUrl);
            setDownloadingQrId(null);
          },
          "image/png"
        );
      };

      image.onerror = () => {
        URL.revokeObjectURL(svgUrl);
        setDownloadingQrId(null);
        alert(
          "Unable to prepare the QR code for download."
        );
      };

      image.src = svgUrl;
    } catch (error) {
      console.error(
        "Failed to download QR code:",
        error
      );

      setDownloadingQrId(null);

      alert(
        error instanceof Error
          ? error.message
          : "Failed to download QR code."
      );
    }
  }

  return (
    <div className="space-y-5 min-w-0 w-full max-w-full overflow-x-clip">
      <PageHeader
        title="QR Codes"
        subtitle="Approved items with their QR codes. Present these to security during inspection or exit."
      />

      {/* Same search and sort controls as Lost & Found */}
      <div className="flex flex-col gap-3 lg:flex-row">
        <div className="relative flex-1">
          <Search size={17} className="absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground" />
          <input
            type="search"
            aria-label="Search QR codes"
            value={qrSearch}
            onChange={(e) => setQrSearch(e.target.value)}
            placeholder="Search item, category, serial number, QR ID..."
            className="w-full rounded-xl border border-border bg-white py-3 pl-11 pr-4 text-sm text-foreground outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/15 !bg-white hover:!bg-[#eef2ff] focus:!bg-white max-w-full min-w-0"
    ref={(element) => { if (element) element.style.setProperty("background-color", "#ffffff", "important"); }}
    onMouseEnter={(event) => { if (document.activeElement !== event.currentTarget) event.currentTarget.style.setProperty("background-color", "#eef2ff", "important"); }}
    onMouseLeave={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
    onFocus={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
    onBlur={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
          />
        </div>
        <select
          aria-label="Sort QR codes"
          value={qrSortOrder}
          onChange={(e) => setQrSortOrder(e.target.value as "newest" | "oldest")}
          className="rounded-xl border border-border bg-white px-4 py-3 text-sm font-medium text-foreground outline-none focus:border-primary !bg-white hover:!bg-[#eef2ff] focus:!bg-white max-w-full min-w-0 w-full sm:w-auto"
    ref={(element) => { if (element) element.style.setProperty("background-color", "#ffffff", "important"); }}
    onMouseEnter={(event) => { if (document.activeElement !== event.currentTarget) event.currentTarget.style.setProperty("background-color", "#eef2ff", "important"); }}
    onMouseLeave={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
    onFocus={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
    onBlur={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
          >
          <option value="newest">Newest first</option>
          <option value="oldest">Oldest first</option>
        </select>
        <button
          type="button"
          aria-label="Manage QR Codes"
          title="Manage QR Codes"
          onClick={() => setQrManageOpenV139(true)}
          className="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#c7d2fe] bg-white text-[#17336d] transition-colors hover:bg-[#eef2ff] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5278e7]/20"
          >
          <SlidersHorizontal size={18} strokeWidth={1.8} aria-hidden="true" />
        </button>
        <button type="button" onClick={loadMyItems} disabled={loading}
          className="rounded-xl border border-border bg-card px-5 py-3 text-sm font-medium text-foreground transition hover:bg-muted disabled:opacity-50 inline-flex items-center justify-center gap-1.5 !border-0 !bg-transparent !shadow-none !text-[#17336d] !px-2 !py-1 hover:!bg-[#edf2ff] rounded-lg md:!hidden"
          > <RefreshCw size={13} className="shrink-0" />
          {loading ? "Refreshing..." : "Refresh"}
        </button>
      </div>

      {qrManageOpenV139 && (
        <StudentPageManagerV141
          title="Manage QR Codes"
          records={visibleQrItems}
          onClose={() => setQrManageOpenV139(false)}
          onView={(item) => { setQrManageOpenV139(false); setQrModalItem(item); }}
          downloadName="qrpass-my-qr-codes"
        />
      )}
      {false && qrManageOpenV139 && (
        <div
          className="fixed inset-0 z-[240] flex items-center justify-center bg-[#0f172a]/50 p-4"
          onClick={(event) => { if (event.target === event.currentTarget) setQrManageOpenV139(false); }}
        >
          <div role="dialog" aria-modal="true" aria-label="Manage QR Codes" className="flex max-h-[85vh] w-full max-w-xl flex-col overflow-hidden rounded-2xl border border-[#dce3ee] bg-white shadow-2xl">
            <div className="flex items-center justify-between border-b border-[#dce3ee] p-4">
              <div>
                <h3 className="font-bold text-[#17336d]">Manage QR Codes</h3>
                <p className="text-xs text-[#64748b]">Review your registered QR codes</p>
              </div>
              <button type="button" aria-label="Close Manage QR Codes" onClick={() => setQrManageOpenV139(false)} className="rounded-lg border border-[#c7d2fe] bg-white p-2 text-[#17336d] hover:bg-[#eef2ff]"
          ><X size={18} /></button>
            </div>
            <div className="min-h-0 flex-1 space-y-2 overflow-y-auto p-4">
              {visibleQrItems.length === 0 ? (
                <p className="py-8 text-center text-sm text-[#64748b]">No QR codes match the current search.</p>
              ) : visibleQrItems.map((item) => (
                <div key={String(item.id)} className="flex items-center justify-between gap-3 rounded-xl border border-[#dce3ee] bg-white p-3">
                  <div className="min-w-0">
                    <p className="truncate text-sm font-semibold text-[#17336d]">{item.item_name || "Unnamed Item"}</p>
                    <p className="text-xs text-[#64748b]">#{item.id} Â· {item.serial_number || "No serial number"}</p>
                  </div>
                  <button type="button" onClick={() => { setQrManageOpenV139(false); setQrModalItem(item); }} className="shrink-0 rounded-lg border border-[#c7d2fe] bg-white px-3 py-2 text-sm font-medium text-[#17336d] hover:bg-[#eef2ff]"
          >View</button>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}
      {loading ? (
        <div className="text-center py-10 text-sm text-muted-foreground">
          Loading QR codes...
        </div>
      ) : (
        <div className="grid min-w-0 grid-cols-1 gap-3 md:grid-cols-2 md:gap-4">
          {visibleQrItems.map((item) => {
            return (
              <div
                key={item.id}
                className="min-w-0 overflow-hidden rounded-xl border border-border bg-card transition hover:shadow-md sm:rounded-lg sm:border-[#dce3ee]"
              >
                <div className="flex min-w-0 items-start gap-3 p-3 sm:gap-4 sm:p-4">
                  <div
                    id={`qr-source-${item.id}`}
                    className="flex-shrink-0"
                  >
                    <QRCodeDisplay
                      value={item.qr_code}
                      size={88}
                    />
                  </div>

                  <div className="flex-1 min-w-0">
                    <p className="font-bold text-sm text-foreground">
                      {item.item_name}
                    </p>

                    <p className="text-xs text-muted-foreground mt-0.5">
                      {item.item_type}
                    </p>

                    <div className="mt-2 space-y-1">
                      <div className="flex gap-2 text-xs">
                        <span className="text-muted-foreground">
                          Serial:
                        </span>

                        <span className="break-all font-mono text-foreground">
                          {item.serial_number || "—"}
                        </span>
                      </div>

                      <div className="flex gap-2 text-xs">
                        <span className="text-muted-foreground">
                          QR ID:
                        </span>

                        <span className="break-all font-mono text-foreground">
                          {item.qr_code}
                        </span>
                      </div>

                      <div className="flex gap-2 text-xs">
                        <span className="text-muted-foreground">
                          Registered:
                        </span>

                        <span className="text-foreground">
                          {formatDate(item.created_at)}
                        </span>
                      </div>

                      <div className="flex gap-2 text-xs">
                        <span className="text-muted-foreground">
                          Expires:
                        </span>

                        <span
                          className={
                            isExpired(item)
                              ? "font-medium text-red-600"
                              : "text-foreground"
                          }
                        >
                          {formatDate(
                            item.qr_expires_at
                          )}
                        </span>
                      </div>
                    </div>

                    <div className="mt-2">
                      <StatusBadge
                        status="Approved"
                      />
                    </div>
                  </div>
                </div>

                <div className="flex min-w-0 flex-wrap items-center justify-between gap-3 border-t border-border bg-muted/30 px-3 py-3 sm:px-4">
                  <p className="text-xs text-muted-foreground">
                    QR ID:
                    <span className="font-mono text-primary ml-2">
                      {item.qr_code}
                    </span>
                  </p>

                  <div className="flex min-w-0 flex-wrap items-center gap-2">
                    <button
                      type="button"
                      onClick={() =>
                        setQrModalItem(item)
                      }
                      className="inline-flex items-center gap-1.5 rounded-md border border-[#cfd8e6] bg-white px-3 py-1.5 text-xs font-semibold text-primary hover:bg-[#eef2fc]"
          >
                      <Eye size={13} />
                      View QR
                    </button>

                    <button
                      type="button"
                      onClick={() =>
                        downloadQRCode(item)
                      }
                      disabled={
                        downloadingQrId ===
                        item.id
                      }
                      className="inline-flex items-center gap-1.5 rounded-md bg-primary px-3 py-1.5 text-xs font-semibold text-white disabled:opacity-50 transition-colors hover:!bg-[#eef2ff] hover:!text-[#17336d] hover:!border-[#a8bde4] focus-visible:!ring-0 focus-visible:!shadow-none"
          >
                      <Download size={13} />

                      {downloadingQrId ===
                      item.id
                        ? "Preparing..."
                        : "Download QR"}
                    </button>
                  </div>
                </div>
              </div>
            );
          })}

          {visibleQrItems.length === 0 && (
              <div className="md:col-span-2 text-center py-10 text-sm text-muted-foreground">
                {qrSearch.trim() ? "No QR codes match your search." : "You don't have any approved QR codes yet."}
              </div>
            )}
        </div>
      )}

      {qrModalItem && (
        <div
          className="fixed inset-0 z-[9999] bg-black/55 flex items-center justify-center p-4"
          onClick={() =>
            setQrModalItem(null)
          }
        >
          <div
            className="w-full max-w-md bg-white rounded-2xl shadow-2xl overflow-hidden"
            onClick={(e) =>
              e.stopPropagation()
            }
          >
            <div className="px-5 py-4 border-b border-[#dce3ee] bg-[#fafbfc] flex items-center justify-between gap-3">
              <div>
                <h2 className="text-lg font-bold text-foreground">
                  {qrModalItem.item_name}
                </h2>

                <p className="text-xs text-muted-foreground mt-0.5">
                  Present this QR code to CSU for scanning.
                </p>
              </div>

              <button
                type="button"
                onClick={() =>
                  setQrModalItem(null)
                }
                className="h-8 w-8 rounded-md flex items-center justify-center text-muted-foreground hover:bg-[#eef2fc] hover:text-primary"
          >
                <X size={18} />
              </button>
            </div>

            <div className="p-6">
              <div className="mx-auto w-fit rounded-2xl border border-[#dce3ee] bg-white p-5 shadow-sm">
                <QRCodeDisplay
                  value={qrModalItem.qr_code}
                  size={300}
                />
              </div>

              <div className="mt-5 text-center">
                <p className="text-xs text-muted-foreground">
                  QR ID
                </p>

                <p className="font-mono text-sm font-semibold text-primary mt-1">
                  {qrModalItem.qr_code}
                </p>

                <p className="text-xs text-muted-foreground mt-3">
                  {qrModalItem.item_type}
                  {qrModalItem.serial_number
                    ? ` • Serial: ${qrModalItem.serial_number}`
                    : ""}
                </p>

                {isExpired(qrModalItem) && (
                  <div className="mt-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-700">
                    This QR code is expired.
                  </div>
                )}
              </div>
            </div>

            <div className="px-5 py-4 border-t border-[#dce3ee] bg-[#fafbfc] flex items-center justify-end gap-2">
              <button
                type="button"
                onClick={() =>
                  setQrModalItem(null)
                }
                className="px-4 py-2 border border-[#cfd8e6] rounded-md text-xs font-semibold text-muted-foreground hover:bg-white"
               data-qrpass-neutral-v169="true">
                Close
              </button>

              <button
                type="button"
                onClick={() =>
                  downloadQRCode(
                    qrModalItem
                  )
                }
                disabled={
                  downloadingQrId ===
                  qrModalItem.id
                }
                className="inline-flex items-center gap-1.5 bg-primary text-white px-4 py-2 rounded-md text-xs font-semibold disabled:opacity-50 transition-colors hover:!bg-[#eef2ff] hover:!text-[#17336d] hover:!border-[#a8bde4] focus-visible:!ring-0 focus-visible:!shadow-none"
          >
                <Download size={14} />

                {downloadingQrId ===
                qrModalItem.id
                  ? "Preparing..."
                  : "Download QR"}
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

function StudentPermitStatus() {
  type PermitFilter =
    | "all"
    | "approved"
    | "pending"
    | "expired";

  const [items, setItems] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [permitSearch, setPermitSearch] = useState("");
  const [permitSortOrder, setPermitSortOrder] = useState<"newest" | "oldest">("newest");
  const [selectedItem, setSelectedItem] =
    useState<any | null>(null);
  const [permitManageOpenV139, setPermitManageOpenV139] = useState(false);
  const [permitFilter, setPermitFilter] =
    useState<PermitFilter>("all");
  const [deletingItemId, setDeletingItemId] =
    useState<number | null>(null);

  async function loadItems() {
    try {
      setLoading(true);

      const data = await getItems();

      setItems(data.items ?? []);
    } catch (error) {
      console.error(
        "Failed to load permit status:",
        error
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadItems();
  }, []);

  async function handleDeletePermit(
    item: any
  ) {
    const displayStatus =
      permitDisplayStatus(
        item
      );

    if (
      displayStatus !==
        "Pending" &&
      displayStatus !==
        "Expired"
    ) {
      window.alert(
        "Only Pending or Expired permits can be deleted."
      );
      return;
    }

    const confirmed =
      window.confirm(
        displayStatus ===
          "Pending"
          ? `Delete the pending request for "${item.item_name}"? This cannot be undone.`
          : `Delete the expired permit for "${item.item_name}"? This cannot be undone.`
      );

    if (!confirmed) {
      return;
    }

    try {
      setDeletingItemId(
        item.id
      );

      await deleteRegisteredItem(
        item.id
      );

      if (
        selectedItem?.id ===
        item.id
      ) {
        setSelectedItem(
          null
        );
      }

      await loadItems();
    } catch (error) {
      window.alert(
        error instanceof Error
          ? error.message
          : "Failed to delete permit."
      );
    } finally {
      setDeletingItemId(
        null
      );
    }
  }

  function isPermitExpired(item: any) {
    if (
      item.status !== "approved" ||
      !item.qr_expires_at
    ) {
      return false;
    }

    const expiresAt =
      new Date(
        item.qr_expires_at
      ).getTime();

    return (
      !Number.isNaN(
        expiresAt
      ) &&
      expiresAt <=
        Date.now()
    );
  }

  function permitDisplayStatus(
    item: any
  ):
    | "Approved"
    | "Pending"
    | "Expired" {
    if (
      isPermitExpired(
        item
      )
    ) {
      return "Expired";
    }

    if (
      item.status ===
      "approved"
    ) {
      return "Approved";
    }

    return "Pending";
  }

  const approvedCount =
    items.filter(
      (item) =>
        item.status ===
          "approved" &&
        !isPermitExpired(
          item
        )
    ).length;

  const pendingCount =
    items.filter(
      (item) =>
        item.status ===
        "pending"
    ).length;

  const expiredCount =
    items.filter(
      (item) =>
        isPermitExpired(
          item
        )
    ).length;

  const visibleItems =
    items.filter(
      (item) => {
        const query = permitSearch.trim().toLowerCase();
        if (query) {
          const searchableText = [
            item.item_name, item.item_type, item.serial_number, item.qr_code,
            item.brand_model, item.status, permitDisplayStatus(item),
            item.id ? `ITEM-${String(item.id).padStart(3, "0")}` : "",
          ].filter(Boolean).join(" ").toLowerCase();
          if (!searchableText.includes(query)) return false;
        }

        if (
          permitFilter ===
          "all"
        ) {
          return true;
        }

        if (
          permitFilter ===
          "approved"
        ) {
          return (
            item.status ===
              "approved" &&
            !isPermitExpired(
              item
            )
          );
        }

        if (
          permitFilter ===
          "pending"
        ) {
          return (
            item.status ===
            "pending"
          );
        }

        return isPermitExpired(
          item
        );
      }
    ).sort((a, b) => {
      const aTime = new Date(a.created_at || 0).getTime() || 0;
      const bTime = new Date(b.created_at || 0).getTime() || 0;
      return permitSortOrder === "newest" ? bTime - aTime : aTime - bTime;
    });

  function formatDate(
    value: string | null | undefined
  ) {
    if (!value) {
      return "—";
    }

    const date =
      new Date(value);

    if (
      Number.isNaN(
        date.getTime()
      )
    ) {
      return "—";
    }

    return date.toLocaleDateString(
      "en-PH",
      {
        year: "numeric",
        month: "short",
        day: "numeric",
      }
    );
  }

  function formatDateTime(
    value: string | null | undefined
  ) {
    if (!value) {
      return "—";
    }

    const date =
      new Date(value);

    if (
      Number.isNaN(
        date.getTime()
      )
    ) {
      return "—";
    }

    return date.toLocaleString(
      "en-PH",
      {
        year: "numeric",
        month: "short",
        day: "numeric",
        hour: "numeric",
        minute: "2-digit",
      }
    );
  }

  return (
    <div className="space-y-5 min-w-0 w-full max-w-full overflow-x-clip">
      <PageHeader
        title="Permit Status"
        subtitle="Track all of your item registration requests and permit details."
      />

      {/* SUMMARY */}
      <div className="qr-student-summary grid grid-cols-2 gap-3 lg:grid-cols-4 max-[430px]:[&>div]:gap-2 max-[430px]:[&>div]:p-3 max-[430px]:[&>div>div:first-child]:h-9 max-[430px]:[&>div>div:first-child]:w-9">
        <StatCard
          label="All"
          value={String(
            items.length
          )}
          icon={
            <Package
              size={20}
            />
          }
          color="#1a3a7b"
        />

        <StatCard
          label="Approved"
          value={String(
            approvedCount
          )}
          icon={
            <CheckCircle
              size={20}
            />
          }
          color="#2ecc71"
        />

        <StatCard
          label="Pending"
          value={String(
            pendingCount
          )}
          icon={
            <Clock
              size={20}
            />
          }
          color="#2f5fd6"
        />

        <StatCard
          label="Expired"
          value={String(
            expiredCount
          )}
          icon={
            <AlertCircle
              size={20}
            />
          }
          color="#64748b"
        />
      </div>

      {/* Search and sorting use the same design as Lost & Found */}
      <div className="flex flex-col gap-3 lg:flex-row">
        <div className="relative flex-1">
          <Search size={17} className="absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground" />
          <input
            type="search"
            aria-label="Search permit requests"
            value={permitSearch}
            onChange={(e) => setPermitSearch(e.target.value)}
            placeholder="Search item, category, serial number, QR ID..."
            className="w-full rounded-xl border border-border bg-white py-3 pl-11 pr-4 text-sm text-foreground outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/15 !bg-white hover:!bg-[#eef2ff] focus:!bg-white max-w-full min-w-0"
    ref={(element) => { if (element) element.style.setProperty("background-color", "#ffffff", "important"); }}
    onMouseEnter={(event) => { if (document.activeElement !== event.currentTarget) event.currentTarget.style.setProperty("background-color", "#eef2ff", "important"); }}
    onMouseLeave={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
    onFocus={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
    onBlur={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
          />
        </div>
        
        <div className="flex min-w-0 flex-wrap items-center gap-2">
          <select
            aria-label="Filter permit requests"
            value={permitFilter}
            onChange={(e) =>
              setPermitFilter(e.target.value as PermitFilter)
            }
            className="h-12 min-w-[165px] flex-1 rounded-xl border border-[#bfceff] bg-white px-3 text-sm font-medium text-foreground outline-none focus:border-[#6488ff]  focus:ring-2 focus:ring-[#6488ff]/15 sm:flex-none !bg-white hover:!bg-[#eef2ff] focus:!bg-white max-w-full min-w-0 w-full sm:w-auto"
    ref={(element) => { if (element) element.style.setProperty("background-color", "#ffffff", "important"); }}
    onMouseEnter={(event) => { if (document.activeElement !== event.currentTarget) event.currentTarget.style.setProperty("background-color", "#eef2ff", "important"); }}
    onMouseLeave={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
    onFocus={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
    onBlur={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
          >
            <option value="all">
              All Permits ({items.length})
            </option>
            <option value="approved">
              Approved ({approvedCount})
            </option>
            <option value="pending">
              Pending ({pendingCount})
            </option>
            <option value="expired">
              Expired ({expiredCount})
            </option>
          </select>

          <select
          aria-label="Sort permit requests"
          value={permitSortOrder}
          onChange={(e) => setPermitSortOrder(e.target.value as "newest" | "oldest")}
          className="rounded-xl border border-border bg-white px-4 py-3 text-sm font-medium text-foreground outline-none focus:border-primary !bg-white hover:!bg-[#eef2ff] focus:!bg-white max-w-full min-w-0 w-full sm:w-auto"
    ref={(element) => { if (element) element.style.setProperty("background-color", "#ffffff", "important"); }}
    onMouseEnter={(event) => { if (document.activeElement !== event.currentTarget) event.currentTarget.style.setProperty("background-color", "#eef2ff", "important"); }}
    onMouseLeave={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
    onFocus={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
    onBlur={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
          >
          <option value="newest">Newest first</option>
          <option value="oldest">Oldest first</option>
        </select>
          <button
            type="button"
            aria-label="Manage Permits"
            title="Manage Permits"
            onClick={() => setPermitManageOpenV139(true)}
            className="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#c7d2fe] bg-white text-[#17336d] transition-colors hover:bg-[#eef2ff] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5278e7]/20"
          >
            <SlidersHorizontal size={18} strokeWidth={1.8} aria-hidden="true" />
          </button>
        </div>
        <button type="button" onClick={loadItems} disabled={loading}
          className="rounded-xl border border-border bg-card px-5 py-3 text-sm font-medium text-foreground transition hover:bg-muted disabled:opacity-50 inline-flex items-center justify-center gap-1.5 !border-0 !bg-transparent !shadow-none !text-[#17336d] !px-2 !py-1 hover:!bg-[#edf2ff] rounded-lg md:!hidden"
          > <RefreshCw size={13} className="shrink-0" />
          {loading ? "Refreshing..." : "Refresh"}
        </button>
      </div>

      {/* FILTERS — four equal-width buttons on mobile; natural width on desktop */}
      

      {permitManageOpenV139 && (
        <StudentPageManagerV141
          title="Manage Permits"
          records={visibleItems}
          onClose={() => setPermitManageOpenV139(false)}
          onView={(item) => { setPermitManageOpenV139(false); setSelectedItem(item); }}
          downloadName="qrpass-my-permits"
        />
      )}
      {false && permitManageOpenV139 && (
        <div
          className="fixed inset-0 z-[240] flex items-center justify-center bg-[#0f172a]/50 p-4"
          onClick={(event) => { if (event.target === event.currentTarget) setPermitManageOpenV139(false); }}
        >
          <div role="dialog" aria-modal="true" aria-label="Manage Permits" className="flex max-h-[85vh] w-full max-w-xl flex-col overflow-hidden rounded-2xl border border-[#dce3ee] bg-white shadow-2xl">
            <div className="flex items-center justify-between border-b border-[#dce3ee] p-4">
              <div>
                <h3 className="font-bold text-[#17336d]">Manage Permits</h3>
                <p className="text-xs text-[#64748b]">Review your permit requests and their status</p>
              </div>
              <button type="button" aria-label="Close Manage Permits" onClick={() => setPermitManageOpenV139(false)} className="rounded-lg border border-[#c7d2fe] bg-white p-2 text-[#17336d] hover:bg-[#eef2ff]"
          ><X size={18} /></button>
            </div>
            <div className="min-h-0 flex-1 space-y-2 overflow-y-auto p-4">
              {visibleItems.length === 0 ? (
                <p className="py-8 text-center text-sm text-[#64748b]">No permits match the selected filters.</p>
              ) : visibleItems.map((item) => (
                <div key={String(item.id)} className="flex items-center justify-between gap-3 rounded-xl border border-[#dce3ee] bg-white p-3">
                  <div className="min-w-0">
                    <p className="truncate text-sm font-semibold text-[#17336d]">{item.item_name || "Unnamed Item"}</p>
                    <p className="text-xs text-[#64748b]">#{item.id} Â· {permitDisplayStatus(item)}</p>
                  </div>
                  <button type="button" onClick={() => { setPermitManageOpenV139(false); setSelectedItem(item); }} className="shrink-0 rounded-lg border border-[#c7d2fe] bg-white px-3 py-2 text-sm font-medium text-[#17336d] hover:bg-[#eef2ff]"
          >View</button>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}
      <Card
        title={
          permitFilter ===
          "all"
            ? "All Permit Requests"
            : permitFilter ===
              "approved"
            ? "Approved Permit Requests"
            : permitFilter ===
              "pending"
            ? "Pending Permit Requests"
            : "Expired Permit Requests"
        }
      >
        {/* Phones: readable request cards, not a cropped desktop table. */}
        <div className="min-w-0 divide-y divide-border lg:hidden">
          {loading ? (
            <p className="px-4 py-8 text-center text-sm text-muted-foreground">Loading permit requests...</p>
          ) : visibleItems.length === 0 ? (
            <div className="px-4 py-8 text-center">
              <FileText size={28} className="mx-auto mb-2 text-muted-foreground" />
              <p className="text-sm font-semibold text-foreground">No permit requests found.</p>
              <p className="mt-1 text-xs text-muted-foreground">Try another search or filter.</p>
            </div>
          ) : (
            visibleItems.map((item) => {
              const status = permitDisplayStatus(item);
              const pending = status === "Pending";
              return (
                <article key={item.id} className="min-w-0 space-y-3 p-4">
                  <div className="flex min-w-0 items-start justify-between gap-2">
                    <div className="min-w-0 flex-1">
                      <p className="break-words text-sm font-semibold text-foreground">{item.item_name || "Unnamed item"}</p>
                      <p className="mt-1 text-[11px] font-mono text-muted-foreground">ITEM-{String(item.id).padStart(3, "0")}</p>
                    </div>
                    <div className="shrink-0"><StatusBadge status={status} /></div>
                  </div>
                  <dl className="grid min-w-0 grid-cols-2 gap-x-3 gap-y-3 text-xs">
                    <div className="min-w-0">
                      <dt className="text-muted-foreground">Category</dt>
                      <dd className="mt-1 break-words font-medium text-foreground">{item.item_type || "—"}</dd>
                    </div>
                    <div className="min-w-0">
                      <dt className="text-muted-foreground">Submitted</dt>
                      <dd className="mt-1 font-medium text-foreground">{formatDate(item.created_at)}</dd>
                    </div>
                    <div className="min-w-0">
                      <dt className="text-muted-foreground">QR ID</dt>
                      <dd className="mt-1 break-all font-mono font-medium text-primary">{!pending && item.qr_code ? item.qr_code : "—"}</dd>
                    </div>
                    <div className="min-w-0">
                      <dt className="text-muted-foreground">Permit expiration</dt>
                      <dd className="mt-1 break-words font-medium text-foreground">{!pending ? formatDateTime(item.qr_expires_at) : "—"}</dd>
                    </div>
                  </dl>
                  <div className="flex min-w-0 flex-wrap gap-2 border-t border-border pt-3">
                    <button type="button" onClick={() => setSelectedItem(item)}
                      className="inline-flex min-h-9 flex-1 items-center justify-center gap-1.5 rounded-lg border border-border bg-card px-3 py-2 text-xs font-semibold text-primary hover:bg-muted">
                      <Eye size={14} /> View Details
                    </button>
                    {(status === "Pending" || status === "Expired") && (
                      <button type="button" onClick={() => handleDeletePermit(item)} disabled={deletingItemId === item.id}
                        className="inline-flex min-h-9 items-center justify-center gap-1.5 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-700 disabled:opacity-50 dark:border-red-900 dark:bg-red-950/30 dark:text-red-300">
                        <Trash2 size={14} /> {deletingItemId === item.id ? "Deleting..." : "Delete"}
                      </button>
                    )}
                  </div>
                </article>
              );
            })
          )}
        </div>
        {/* Tablets and desktop retain the full data table. */}
        <div className="hidden overflow-x-auto lg:block">
          <table className="w-full min-w-[900px]">
            <thead>
              <tr className="bg-[#fafbfc]">
                {[
                  "Item",
                  "Type",
                  "Date Submitted",
                  "Status",
                  "QR ID",
                  "Permit Expiration",
                  "Action",
                ].map(
                  (
                    heading
                  ) => (
                    <th
                      key={
                        heading
                      }
                      className="text-left py-2 px-3 text-xs text-muted-foreground font-medium"
                    >
                      {
                        heading
                      }
                    </th>
                  )
                )}
              </tr>
            </thead>

            <tbody>
              {loading ? (
                <tr>
                  <td
                    colSpan={
                      7
                    }
                    className="text-center py-8 text-sm text-muted-foreground"
                  >
                    Loading permit requests...
                  </td>
                </tr>
              ) : visibleItems.length ===
                0 ? (
                <tr>
                  <td
                    colSpan={
                      7
                    }
                    className="text-center py-10"
                  >
                    <FileText
                      size={
                        30
                      }
                      className="mx-auto mb-3 text-muted-foreground"
                    />

                    <p className="text-sm font-semibold text-foreground">
                      {permitSearch.trim()
                        ? "No permit requests match your search."
                        : permitFilter === "all"
                        ? "No permit requests found."
                        : permitFilter ===
                          "approved"
                        ? "No approved permit requests found."
                        : permitFilter ===
                          "pending"
                        ? "No pending permit requests found."
                        : "No expired permit requests found."}
                    </p>

                  </td>
                </tr>
              ) : (
                visibleItems.map(
                  (
                    item
                  ) => {
                    const displayStatus =
                      permitDisplayStatus(
                        item
                      );

                    const isPending =
                      displayStatus ===
                      "Pending";

                    return (
                      <tr
                        key={
                          item.id
                        }
                        className="border-t border-[#cfd8e6] hover:bg-[#eef2fc] transition-colors"
                      >
                        <td className="py-3 px-3 min-w-[170px]">
                          <div className="text-sm font-medium text-foreground">
                            {
                              item.item_name
                            }
                          </div>

                          <div className="mt-0.5 text-[11px] font-mono text-muted-foreground">
                            ITEM-
                            {String(
                              item.id
                            ).padStart(
                              3,
                              "0"
                            )}
                          </div>
                        </td>

                        <td className="py-3 px-3 text-xs text-muted-foreground whitespace-nowrap">
                          {item.item_type ||
                            "—"}
                        </td>

                        <td className="py-3 px-3 text-xs text-muted-foreground whitespace-nowrap">
                          {formatDate(
                            item.created_at
                          )}
                        </td>

                        <td className="py-3 px-3">
                          <StatusBadge
                            status={
                              displayStatus
                            }
                          />
                        </td>

                        <td className="py-3 px-3 text-xs font-mono whitespace-nowrap">
                          {!isPending &&
                          item.qr_code ? (
                            <span className="text-primary font-semibold">
                              {
                                item.qr_code
                              }
                            </span>
                          ) : (
                            <span className="text-muted-foreground">
                              —
                            </span>
                          )}
                        </td>

                        <td className="py-3 px-3 text-xs text-muted-foreground whitespace-nowrap">
                          {!isPending
                            ? formatDateTime(
                                item.qr_expires_at
                              )
                            : "—"}
                        </td>

                        <td className="py-3 px-3">
                          <div className="flex min-w-0 flex-wrap items-center gap-2">
                            <button
                              type="button"
                              onClick={() =>
                                setSelectedItem(
                                  item
                                )
                              }
                              className="inline-flex items-center gap-1.5 rounded-md border border-[#cfd8e6] bg-white px-2.5 py-1.5 text-xs font-semibold text-[#1a3a7b] hover:bg-[#eef2fc] transition-colors whitespace-nowrap"
          >
                              <Eye
                                size={
                                  13
                                }
                              />
                              View Details
                            </button>

                            {(displayStatus ===
                              "Pending" ||
                              displayStatus ===
                                "Expired") && (
                              <button
                                type="button"
                                onClick={() =>
                                  handleDeletePermit(
                                    item
                                  )
                                }
                                disabled={
                                  deletingItemId ===
                                  item.id
                                }
                                className="inline-flex items-center gap-1.5 rounded-md border border-red-300 bg-red-50 px-2.5 py-1.5 text-xs font-semibold text-red-600 transition-colors hover:bg-red-100 disabled:cursor-not-allowed disabled:opacity-50 whitespace-nowrap"
                              >
                                <Trash2
                                  size={
                                    13
                                  }
                                />
                                {deletingItemId ===
                                item.id
                                  ? "Deleting..."
                                  : "Delete"}
                              </button>
                            )}
                          </div>
                        </td>
                      </tr>
                    );
                  }
                )
              )}
            </tbody>
          </table>
        </div>
      </Card>

      {selectedItem && (
        <div
          className="fixed inset-0 z-[300] flex items-center justify-center p-4"
          style={{
            background:
              "rgba(15, 23, 42, 0.55)",
            backdropFilter:
              "blur(4px)",
          }}
          onMouseDown={(
            event
          ) => {
            if (
              event.target ===
              event.currentTarget
            ) {
              setSelectedItem(
                null
              );
            }
          }}
        >
          <div
            className="w-full max-w-2xl overflow-hidden rounded-2xl border border-[#dce3ee] bg-white"
            style={{
              boxShadow:
                "0 24px 70px rgba(16, 26, 51, 0.25)",
            }}
          >
            <div className="flex items-start justify-between gap-4 border-b border-[#e5eaf2] bg-[#fbfcfe] px-5 py-4">
              <div>
                <div className="flex items-center gap-2">
                  <FileText
                    size={
                      17
                    }
                    className="text-[#1a3a7b]"
                  />

                  <h2 className="text-base font-semibold text-foreground">
                    Permit Request Details
                  </h2>
                </div>

                <p className="mt-1 text-xs text-muted-foreground">
                  ITEM-
                  {String(
                    selectedItem.id
                  ).padStart(
                    3,
                    "0"
                  )}
                </p>
              </div>

              <button
                type="button"
                onClick={() =>
                  setSelectedItem(
                    null
                  )
                }
                className="flex h-8 w-8 items-center justify-center rounded-lg text-muted-foreground hover:bg-[#eef2fc] hover:text-foreground"
                title="Close"
           data-qrpass-neutral-v169="true">
                <X
                  size={
                    17
                  }
                />
              </button>
            </div>

            <div className="p-5">
              <div className="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p className="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">
                    Registered Item
                  </p>

                  <h3 className="mt-1 text-lg font-bold text-foreground">
                    {
                      selectedItem.item_name
                    }
                  </h3>

                  <p className="mt-0.5 text-xs text-muted-foreground">
                    {selectedItem.item_type ||
                      "—"}
                  </p>
                </div>

                <StatusBadge
                  status={permitDisplayStatus(
                    selectedItem
                  )}
                />
              </div>

              <div className="grid gap-3 sm:grid-cols-2">
                {[
                  [
                    "Brand / Model",
                    selectedItem.brand_model ||
                      "—",
                  ],
                  [
                    "Serial Number",
                    selectedItem.serial_number ||
                      "—",
                  ],
                  [
                    "Purpose / Reason",
                    selectedItem.purpose ||
                      "—",
                  ],
                  [
                    "Date Submitted",
                    formatDateTime(
                      selectedItem.created_at
                    ),
                  ],
                  [
                    "QR ID",
                    selectedItem.status ===
                      "approved"
                      ? selectedItem.qr_code ||
                        "—"
                      : "Not issued yet",
                  ],
                  [
                    "Permit Expiration",
                    selectedItem.status ===
                      "approved"
                      ? formatDateTime(
                          selectedItem.qr_expires_at
                        )
                      : "Assigned after approval",
                  ],
                ].map(
                  ([
                    label,
                    value,
                  ]) => (
                    <div
                      key={
                        label
                      }
                      className="rounded-lg border border-[#dce3ee] bg-[#fbfcfe] p-3"
                    >
                      <p className="text-[10px] font-semibold uppercase tracking-wide text-muted-foreground">
                        {
                          label
                        }
                      </p>

                      <p className="mt-1 text-sm text-foreground break-words">
                        {
                          value
                        }
                      </p>
                    </div>
                  )
                )}
              </div>

              {selectedItem.status ===
                "pending" && (
                <div className="mt-4 rounded-lg border border-[#d7e0f3] bg-[#eef2fc] px-3 py-2.5">
                  <p className="text-xs text-[#1a3a7b] leading-relaxed">
                    This request is waiting for PCO approval.
                    The QR ID and permit expiration will be generated only after approval.
                  </p>
                </div>
              )}

              {isPermitExpired(
                selectedItem
              ) && (
                <div className="mt-4 rounded-lg border border-[#e5e7eb] bg-[#f3f4f6] px-3 py-2.5">
                  <p className="text-xs text-[#6b7280] leading-relaxed">
                    This permit has expired and is no longer available in the QR Codes module.
                  </p>
                </div>
              )}
            </div>

            <div className="flex justify-end border-t border-[#e5eaf2] bg-[#fbfcfe] px-5 py-3">
              <button
                type="button"
                onClick={() =>
                  setSelectedItem(
                    null
                  )
                }
                className="rounded-lg border border-[#cfd8e6] bg-white px-4 py-2 text-xs font-semibold text-[#334155] hover:bg-[#eef2fc]"
           data-qrpass-neutral-v169="true">
                Close
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}


// ── Shared Lost & Found store (module-level for demo) ─────────────────────
type LFItem = {
  id: string;
  type: "lost" | "found";
  item: string;
  description: string;
  location: string;
  date: string;
  postedBy: string;
  postedByRole: "student" | "security";
  imageUrl?: string;
  status: "Open" | "Claimed" | "Recovered";
  inquiries: { name: string; message: string; time: string }[];
};
let _lfItems: LFItem[] = [
  { id: "LF-001", type: "found", item: "Laptop Bag (Black, Jansport)", description: "Found near the library entrance, has stickers on it.", location: "Library", date: "Jun 15, 2026", postedBy: "Guard Ramos", postedByRole: "security", status: "Open", inquiries: [] },
  { id: "LF-002", type: "lost", item: "Samsung Earbuds (White)", description: "Lost after lunch, last seen at the canteen table.", location: "Canteen", date: "Jun 14, 2026", postedBy: "John Dela Cruz", postedByRole: "student", status: "Open", inquiries: [] },
  { id: "LF-003", type: "found", item: "Laptop Charger (Dell, 65W)", description: "Left in Room 201 after class. Adapter included.", location: "Room 201", date: "Jun 12, 2026", postedBy: "Guard Santos", postedByRole: "security", status: "Open", inquiries: [] },
  { id: "LF-004", type: "found", item: "iPad with Blue Case", description: "Found at Gate 2 guardhouse. Screen has a small crack.", location: "Gate 2", date: "Jun 10, 2026", postedBy: "Guard Ramos", postedByRole: "security", status: "Claimed", inquiries: [{ name: "Maria Santos", message: "This is mine! I can show my receipt.", time: "Jun 11, 2026 – 9:00 AM" }] },
];
let _lfListeners: (() => void)[] = [];
function getLFItems() { return [..._lfItems]; }
function addLFItem(item: LFItem) { _lfItems = [item, ..._lfItems]; _lfListeners.forEach(fn => fn()); }
function updateLFItem(id: string, patch: Partial<LFItem>) { _lfItems = _lfItems.map(i => i.id === id ? { ...i, ...patch } : i); _lfListeners.forEach(fn => fn()); }
function useLFItems() {
  const [items, setItems] = useState(getLFItems);
  useEffect(() => {
    const refresh = () => setItems(getLFItems());
    _lfListeners.push(refresh);
    return () => { _lfListeners = _lfListeners.filter(fn => fn !== refresh); };
  }, []);
  return items;
}

// ── Shared notifications store ────────────────────────────────────────────────
type AppNotif = { id: string; role: "student" | "security"; type: "success" | "warning" | "info"; message: string; time: string };
let _notifs: AppNotif[] = [];
let _notifListeners: (() => void)[] = [];
function addNotif(n: Omit<AppNotif, "id">) { _notifs = [{ ...n, id: Date.now().toString() }, ..._notifs]; _notifListeners.forEach(fn => fn()); }
function getNotifsForRole(role: "student" | "security") { return _notifs.filter(n => n.role === role); }
function useNotifs(role: "student" | "security") {
  const [items, setItems] = useState(() => getNotifsForRole(role));
  useEffect(() => {
    const refresh = () => setItems(getNotifsForRole(role));
    _notifListeners.push(refresh);
    return () => { _notifListeners = _notifListeners.filter(fn => fn !== refresh); };
  }, [role]);
  return items;
}

function StudentLostAndFound() {
  const [items, setItems] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [success, setSuccess] = useState("");
  const [search, setSearch] = useState("");
  const [claimingId, setClaimingId] =
    useState<number | null>(null);

  const [statusFilter, setStatusFilter] =
    useState<"all" | "found" | "lost" | "pending" | "recovered">("all");

  const [sortOrder, setSortOrder] =
    useState<"newest" | "oldest">("newest");

  const [selectedItem, setSelectedItem] =
    useState<any | null>(null);  /* QRPASS_STUDENT_LF_MANAGE_V136 */
  const [studentManageLogsOpenV136, setStudentManageLogsOpenV136] = useState(false);

  async function loadItems() {
    try {
      setLoading(true);
      setError("");

      const data = await getLostFoundItems();

      setItems(
        Array.isArray(data)
          ? data
          : data?.items ?? []
      );
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Failed to load Lost & Found registry."
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadItems();
  }, []);

  async function handleClaim(id: number) {
    const confirmed = window.confirm(
      "Submit a claim request? Your claim will remain PENDING until CSU verifies your ownership at the Security office."
    );

    if (!confirmed) {
      return;
    }

    try {
      setClaimingId(id);
      setError("");
      setSuccess("");

      const result =
        await claimLostFoundItem(id);

      setSuccess(
        result?.message ||
          "Claim request submitted. Status: Pending CSU Verification."
      );

      await loadItems();

      setTimeout(() => {
        setSuccess("");
      }, 4000);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Failed to submit claim."
      );
    } finally {
      setClaimingId(null);
    }
  }

  function formatDate(
    value?: string | null
  ) {
    if (!value) {
      return "—";
    }

    const date = new Date(value);

    if (
      Number.isNaN(
        date.getTime()
      )
    ) {
      return value;
    }

    return date.toLocaleString(
      "en-PH",
      {
        year: "numeric",
        month: "short",
        day: "numeric",
        hour: "numeric",
        minute: "2-digit",
      }
    );
  }

  function getReportType(
    item: any
  ) {
    return String(
      item?.report_type ??
        "found"
    ).toLowerCase();
  }

  function getStatus(
    item: any
  ) {
    const reportType =
      getReportType(item);

    return String(
      item?.status ??
        (reportType === "lost"
          ? "Lost"
          : "Found")
    );
  }

  function getLocation(
    item: any
  ) {
    return (
      (getReportType(item) ===
      "lost"
        ? item.location_lost
        : item.location_found) ||
      item.location_found ||
      item.location_lost ||
      "Location not specified"
    );
  }

  function getEventDate(
    item: any
  ) {
    if (
      getReportType(item) ===
      "lost"
    ) {
      return (
        item.date_lost ||
        item.created_at
      );
    }

    return (
      item.date_found ||
      item.created_at
    );
  }

  const foundCount =
    items.filter((item) => {
      return (
        getReportType(item) ===
          "found" &&
        getStatus(item).toLowerCase() ===
          "found"
      );
    }).length;

  const lostCount =
    items.filter((item) => {
      return (
        getReportType(item) ===
          "lost" &&
        getStatus(item).toLowerCase() ===
          "lost"
      );
    }).length;

  const pendingCount = items.filter(
    (item) => getStatus(item).trim().toLowerCase() === "pending"
  ).length;

  const recoveredCount =
    items.filter(
      (item) =>
        getStatus(
          item
        ).toLowerCase() ===
        "recovered"
    ).length;

  const visibleItems =
    items
      .filter((item) => {
        const query =
          search
            .trim()
            .toLowerCase();

        if (query) {
          const searchableText = [
            item.id,
            item.report_type,
            item.item_name,
            item.category,
            item.brand_model,
            item.color,
            item.location_found,
            item.location_lost,
            item.description,
            item.status,
            item.finder?.name,
            item.finder?.username,
            item.lost_by?.name,
            item.lost_by?.username,
          ]
            .filter(Boolean)
            .join(" ")
            .toLowerCase();

          if (
            !searchableText.includes(
              query
            )
          ) {
            return false;
          }
        }

        const reportType =
          getReportType(item);

        const status =
          getStatus(
            item
          ).toLowerCase();

        if (
          statusFilter ===
          "found"
        ) {
          return (
            reportType ===
              "found" &&
            status === "found"
          );
        }

        if (
          statusFilter ===
          "lost"
        ) {
          return (
            reportType === "lost" &&
            status === "lost"
          );
        }

        if (statusFilter === "pending") {
          return status === "pending";
        }

        if (
          statusFilter ===
          "recovered"
        ) {
          return (
            status ===
            "recovered"
          );
        }

        return true;
      })
      .sort((a, b) => {
        const aTime =
          new Date(
            a.created_at ||
              getEventDate(a) ||
              0
          ).getTime();

        const bTime =
          new Date(
            b.created_at ||
              getEventDate(b) ||
              0
          ).getTime();

        return sortOrder ===
          "newest"
          ? bTime - aTime
          : aTime - bTime;
      });

  function renderStatusBadge(
    item: any
  ) {
    const status =
      getStatus(item);

    const statusLower =
      status.toLowerCase();

    if (
      statusLower ===
      "recovered"
    ) {
      return (
        <span className="rounded-full bg-slate-100 px-3 py-1 text-[11px] font-semibold text-slate-700 dark:bg-slate-700/60 dark:text-slate-200">
          Recovered
        </span>
      );
    }

    if (
      statusLower ===
      "lost"
    ) {
      return (
        <span className="rounded-full bg-red-100 px-3 py-1 text-[11px] font-semibold text-red-700 dark:bg-red-950/50 dark:text-red-300">
          Lost
        </span>
      );
    }

    if (
      statusLower ===
      "pending"
    ) {
      return (
        <span className="rounded-full bg-amber-100 px-3 py-1 text-[11px] font-semibold text-amber-800 dark:bg-amber-950/40 dark:text-amber-200">
          Pending Verification
        </span>
      );
    }

    if (
      statusLower ===
      "claimed"
    ) {
      return (
        <span className="rounded-full bg-green-100 px-3 py-1 text-[11px] font-semibold text-green-700 dark:bg-green-950/40 dark:text-green-300">
          Claimed
        </span>
      );
    }

    return (
      <span className="rounded-full bg-green-100 px-3 py-1 text-[11px] font-semibold text-green-700 dark:bg-green-950/40 dark:text-green-300">
        Found
      </span>
    );
  }

  return (
    <div className="space-y-5 min-w-0 w-full max-w-full overflow-x-clip">
      <PageHeader
        title="Lost & Found"
        subtitle="Browse found items and lost-item reports recorded by the Security office."
      />

      {error && (
        <div className="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-900/70 dark:bg-red-950/30 dark:text-red-300">
          {error}
        </div>
      )}

      {success && (
        <div className="rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700 dark:border-green-900/70 dark:bg-green-950/30 dark:text-green-300">
          {success}
        </div>
      )}

      {/* Summary cards match Permit Status on desktop and mobile. */}
      <div className="qr-student-summary grid grid-cols-2 gap-3 lg:grid-cols-5 max-[430px]:[&>div]:gap-2 max-[430px]:[&>div]:p-3 max-[430px]:[&>div>div:first-child]:h-9 max-[430px]:[&>div>div:first-child]:w-9">
        <StatCard
          label="All"
          value={String(items.length)}
          icon={<Package size={20} />}
          color="#1a3a7b"
        />
        <StatCard
          label="Found"
          value={String(foundCount)}
          icon={<CheckCircle size={20} />}
          color="#16a34a"
        />
        <StatCard
          label="Lost"
          value={String(lostCount)}
          icon={<AlertCircle size={20} />}
          color="#dc2626"
        />
        <StatCard
          label="Pending"
          value={String(pendingCount)}
          icon={<Clock size={20} />}
          color="#d97706"
        />
        <StatCard
          label="Recovered"
          value={String(recoveredCount)}
          icon={<CheckCircle size={20} />}
          color="#64748b"
          className="col-span-2 lg:col-span-1 min-w-0 w-[calc(50%_-_0.375rem)] max-[360px]:w-full lg:w-full justify-self-center"
        />
      </div>

      {/* SEARCH + SORT + REFRESH */}
      <div className="flex flex-col gap-3 lg:flex-row">
        <div className="relative flex-1">
          <Search
            size={17}
            className="absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground"
          />

          <input
            type="text"
            value={search}
            onChange={(e) =>
              setSearch(
                e.target.value
              )
            }
            placeholder="Search item, category, location..."
            className="w-full rounded-xl border border-border bg-white py-3 pl-11 pr-4 text-sm text-foreground outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/15 !bg-white hover:!bg-[#eef2ff] focus:!bg-white max-w-full min-w-0"
    ref={(element) => { if (element) element.style.setProperty("background-color", "#ffffff", "important"); }}
    onMouseEnter={(event) => { if (document.activeElement !== event.currentTarget) event.currentTarget.style.setProperty("background-color", "#eef2ff", "important"); }}
    onMouseLeave={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
    onFocus={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
    onBlur={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
          />
        </div>

        
        <div className="flex min-w-0 flex-wrap items-center gap-2">

          <select
            aria-label="Filter student Lost and Found reports"
            value={statusFilter}
            onChange={(e) =>
              setStatusFilter(
                e.target.value as typeof statusFilter
              )
            }
            className="h-12 min-w-[175px] flex-1 rounded-xl border border-[#bfceff] bg-white px-3 text-sm font-medium text-foreground outline-none focus:border-[#6488ff]  focus:ring-2 focus:ring-[#6488ff]/15 sm:flex-none !bg-white hover:!bg-[#eef2ff] focus:!bg-white max-w-full min-w-0 w-full sm:w-auto"
    ref={(element) => { if (element) element.style.setProperty("background-color", "#ffffff", "important"); }}
    onMouseEnter={(event) => { if (document.activeElement !== event.currentTarget) event.currentTarget.style.setProperty("background-color", "#eef2ff", "important"); }}
    onMouseLeave={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
    onFocus={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
    onBlur={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
          >
            <option value="all">
              All Reports ({items.length})
            </option>
            <option value="found">
              Found ({foundCount})
            </option>
            <option value="lost">
              Lost ({lostCount})
            </option>
            <option value="pending">
              Pending ({pendingCount})
            </option>
            <option value="recovered">
              Recovered ({recoveredCount})
            </option>
          </select>

          <select
            aria-label="Sort student Lost and Found records"
            value={sortOrder}
            onChange={(e) =>
              setSortOrder(
                e.target.value as typeof sortOrder
              )
            }
            className="h-12 min-w-[145px] flex-1 rounded-xl border border-[#bfceff] bg-white px-3 text-sm font-medium text-foreground outline-none focus:border-[#6488ff]  focus:ring-2 focus:ring-[#6488ff]/15 sm:flex-none !bg-white hover:!bg-[#eef2ff] focus:!bg-white max-w-full min-w-0 w-full sm:w-auto"
    ref={(element) => { if (element) element.style.setProperty("background-color", "#ffffff", "important"); }}
    onMouseEnter={(event) => { if (document.activeElement !== event.currentTarget) event.currentTarget.style.setProperty("background-color", "#eef2ff", "important"); }}
    onMouseLeave={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
    onFocus={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
    onBlur={(event) => { event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
          >
            <option value="newest">Newest first</option>
            <option value="oldest">Oldest first</option>
          </select>
          <button
            type="button"
            title="Manage Logs"
            aria-label="Manage Logs"
            onClick={() => setStudentManageLogsOpenV136(true)}
            data-qrpass-hover-uniform-v141="true"
            className="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#c7d2fe] !bg-white text-[#17336d] transition-colors hover:!bg-[#eef2ff] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5278e7]/20"
          
  onMouseEnter={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', '#eef2ff', 'important');
    s.setProperty('background-color', '#eef2ff', 'important');
    s.setProperty('border-color', '#a8bde4', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
  onMouseLeave={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', '#ffffff', 'important');
    s.setProperty('background-color', '#ffffff', 'important');
    s.setProperty('border-color', '#cbd5e1', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
  onFocus={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', e.currentTarget.matches(':hover') ? '#eef2ff' : '#ffffff', 'important');
    s.setProperty('border-color', e.currentTarget.matches(':hover') ? '#a8bde4' : '#cbd5e1', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
  onBlur={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', '#ffffff', 'important');
    s.setProperty('background-color', '#ffffff', 'important');
    s.setProperty('border-color', '#cbd5e1', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
>
            <SlidersHorizontal size={18} strokeWidth={1.8} aria-hidden="true" />
          </button>

          <button
          type="button"
          onClick={() => { void loadItems(); }}
          disabled={loading}
          className="rounded-xl border border-border bg-card px-5 py-3 text-sm font-medium text-foreground transition hover:bg-muted disabled:cursor-not-allowed disabled:opacity-50 inline-flex items-center justify-center gap-1.5 !border-0 !bg-transparent !shadow-none !text-[#17336d] !px-2 !py-1 hover:!bg-[#edf2ff] rounded-lg md:!hidden"
          > <RefreshCw size={13} className="shrink-0" />
          {loading
            ? "Refreshing..."
            : "Refresh"}
        </button>
        </div>

      </div>

      {studentManageLogsOpenV136 && (
        <div
          className="fixed inset-0 z-[240] flex items-center justify-center bg-[#0f172a]/50 p-4"
          onClick={(event) => {
            if (event.target === event.currentTarget) setStudentManageLogsOpenV136(false);
          }}
        >
          <div
            role="dialog"
            aria-modal="true"
            aria-label="Manage Logs"
            data-qrpass-hover-uniform-v141="true" onMouseEnter={(e) => e.currentTarget.style.setProperty("background-color", "#eef2ff", "important")} onMouseLeave={(e) => e.currentTarget.style.setProperty("background-color", "#ffffff", "important")}
            className="flex max-h-[85vh] w-full max-w-xl flex-col overflow-hidden rounded-2xl border border-[#dce3ee] bg-white shadow-2xl"
          >
            <div className="flex shrink-0 items-center justify-between border-b border-[#dce3ee] p-4">
              <div>
                <h3 className="font-bold text-[#17336d]">Manage Logs</h3>
                <p className="text-xs text-[#64748b]">Review your Lost & Found records</p>
              </div>
              <button
                type="button"
                aria-label="Close Manage Logs"
                onClick={() => setStudentManageLogsOpenV136(false)}
                data-qrpass-hover-uniform-v141="true" onMouseEnter={(e) => e.currentTarget.style.setProperty("background-color", "#eef2ff", "important")} onMouseLeave={(e) => e.currentTarget.style.setProperty("background-color", "#ffffff", "important")}
            className="rounded-lg border border-[#c7d2fe] bg-white p-2 text-[#17336d] hover:bg-[#eef2ff]"
               data-qrpass-neutral-v169="true"><X size={18} /></button>
            </div>
            <div className="min-h-0 flex-1 space-y-2 overflow-y-auto p-4">
              {visibleItems.length === 0 ? (
                <p className="py-8 text-center text-sm text-[#64748b]">No records match the selected filters.</p>
              ) : visibleItems.map((entry) => (
                <div key={String(entry.id)} className="flex items-center justify-between gap-3 rounded-xl border border-[#dce3ee] bg-white p-3">
                  <div className="min-w-0">
                    <p className="truncate text-sm font-semibold text-[#17336d]">{entry.item_name || "Unnamed Item"}</p>
                    <p className="text-xs text-[#64748b]">#{entry.id} Â· {getReportType(entry)} Â· {getStatus(entry)}</p>
                  </div>
                  <button
                    type="button"
                    onClick={() => {
                      setStudentManageLogsOpenV136(false);
                      setSelectedItem(entry);
                    }}
                    className="shrink-0 rounded-lg border border-[#c7d2fe] bg-white px-3 py-2 text-sm font-medium text-[#17336d] hover:bg-[#eef2ff]"
          >View</button>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}
      {/* FILTERS */}
      

      {loading && (
        <div className="rounded-xl border border-border bg-card p-10 text-center">
          <p className="text-sm text-muted-foreground">
            Loading Lost & Found records...
          </p>
        </div>
      )}

      {!loading &&
        visibleItems.length ===
          0 && (
          <div className="rounded-xl border border-border bg-card p-10 text-center">
            <BookOpen
              size={32}
              className="mx-auto mb-3 text-muted-foreground"
            />

            <p className="text-sm font-semibold text-foreground">
              No Lost & Found records found.
            </p>

          </div>
        )}

      {/* ITEM CARDS */}
      {!loading &&
        visibleItems.length >
          0 && (
          <div className="grid min-w-0 grid-cols-1 gap-3 md:grid-cols-2 md:gap-4 xl:grid-cols-3">
            {visibleItems.map(
              (item) => {
                const reportType =
                  getReportType(
                    item
                  );

                const status =
                  getStatus(item);

                const statusLower =
                  status.toLowerCase();

                const isFound =
                  reportType ===
                    "found" &&
                  statusLower ===
                    "found";

                const displayName =
                  item.item_name ||
                  "Unnamed Item";

                const detailLine = [
                  item.brand_model,
                  item.color,
                  item.category,
                ]
                  .filter(Boolean)
                  .join(" · ");

                return (
                  <div
                    key={
                      item.id
                    }
                    className="min-w-0 overflow-hidden rounded-2xl border border-border bg-card transition hover:shadow-lg sm:hover:-translate-y-0.5"
                  >
                    {/* PHOTO */}
                    <div className="relative flex h-36 items-center justify-center overflow-hidden bg-muted sm:h-44">
                      {item.photo_url ? (
                        <img
                          src={
                            item.photo_url
                          }
                          alt={
                            displayName
                          }
                          className="h-full w-full object-cover"
                        />
                      ) : (
                        <div className="flex h-full w-full items-center justify-center text-sm text-muted-foreground">
                          [Item photo]
                        </div>
                      )}
                    </div>

                    {/* CARD BODY */}
                    <div className="p-4">
                      <div className="flex items-start justify-between gap-3">
                        <h3 className="min-w-0 flex-1 truncate text-lg font-bold text-foreground">
                          {
                            displayName
                          }
                        </h3>

                        {renderStatusBadge(
                          item
                        )}
                      </div>

                      <p className="mt-2 min-h-[20px] text-sm text-muted-foreground">
                        {detailLine ||
                          "No additional item details"}
                      </p>

                      <p className="mt-1 text-sm text-muted-foreground">
                        {getLocation(
                          item
                        )}{" "}
                        ·{" "}
                        {formatDate(
                          getEventDate(
                            item
                          )
                        )}
                      </p>

                      <div className="mt-4">
                        {isFound ? (
                          <button
                            type="button"
                            disabled={
                              claimingId ===
                              Number(
                                item.id
                              )
                            }
                            onClick={() =>
                              handleClaim(
                                Number(
                                  item.id
                                )
                              )
                            }
                            className="w-full rounded-xl bg-primary px-4 py-3 text-sm font-semibold text-primary-foreground transition disabled:cursor-not-allowed disabled:opacity-50 transition-colors hover:!bg-[#eef2ff] hover:!text-[#17336d] hover:!border-[#a8bde4] focus-visible:!ring-0 focus-visible:!shadow-none"
          >
                            {claimingId ===
                            Number(
                              item.id
                            )
                              ? "Submitting..."
                              : "Claim Item"}
                          </button>
                        ) : (
                          <button
                            type="button"
                            onClick={() =>
                              setSelectedItem(
                                item
                              )
                            }
                            className="w-full rounded-xl border border-border bg-card px-4 py-3 text-sm font-semibold text-foreground transition hover:bg-muted"
                          >
                            View Details
                          </button>
                        )}
                      </div>
                    </div>
                  </div>
                );
              }
            )}
          </div>
        )}

      {/* DETAILS MODAL */}
      {selectedItem && (
        <div
          className="fixed inset-0 z-[200] flex items-center justify-center bg-black/55 p-4"
          onClick={() =>
            setSelectedItem(
              null
            )
          }
        >
          <div
            className="max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-2xl border border-border bg-card shadow-2xl"
            onClick={(e) =>
              e.stopPropagation()
            }
          >
            <div className="flex items-center justify-between border-b border-border px-5 py-4">
              <div>
                <p className="text-xs font-semibold uppercase tracking-wide text-muted-foreground">
                  Lost & Found Record
                </p>

                <h3 className="mt-1 text-lg font-bold text-foreground">
                  {selectedItem.item_name ||
                    "Item Details"}
                </h3>
              </div>

              <button
                type="button"
                onClick={() =>
                  setSelectedItem(
                    null
                  )
                }
                className="rounded-lg p-2 text-muted-foreground hover:bg-muted hover:text-foreground"
              >
                <X size={18} />
              </button>
            </div>

            {selectedItem.photo_url && (
              <div className="border-b border-border bg-muted">
                <img
                  src={
                    selectedItem.photo_url
                  }
                  alt={
                    selectedItem.item_name ||
                    "Lost and Found item"
                  }
                  className="max-h-80 w-full object-contain"
                />
              </div>
            )}

            <div className="grid gap-4 p-5 sm:grid-cols-2">
              <div>
                <p className="text-xs text-muted-foreground">
                  Status
                </p>
                <div className="mt-1">
                  {renderStatusBadge(
                    selectedItem
                  )}
                </div>
              </div>

              <div>
                <p className="text-xs text-muted-foreground">
                  Report #
                </p>
                <p className="mt-1 font-medium text-foreground">
                  {selectedItem.id}
                </p>
              </div>

              <div>
                <p className="text-xs text-muted-foreground">
                  Category
                </p>
                <p className="mt-1 font-medium text-foreground">
                  {selectedItem.category ||
                    "—"}
                </p>
              </div>

              <div>
                <p className="text-xs text-muted-foreground">
                  Brand / Model
                </p>
                <p className="mt-1 font-medium text-foreground">
                  {selectedItem.brand_model ||
                    "—"}
                </p>
              </div>

              <div>
                <p className="text-xs text-muted-foreground">
                  Color
                </p>
                <p className="mt-1 font-medium text-foreground">
                  {selectedItem.color ||
                    "—"}
                </p>
              </div>

              <div>
                <p className="text-xs text-muted-foreground">
                  Location
                </p>
                <p className="mt-1 font-medium text-foreground">
                  {getLocation(
                    selectedItem
                  )}
                </p>
              </div>

              <div>
                <p className="text-xs text-muted-foreground">
                  Date / Time
                </p>
                <p className="mt-1 font-medium text-foreground">
                  {formatDate(
                    getEventDate(
                      selectedItem
                    )
                  )}
                </p>
              </div>

              <div>
                <p className="text-xs text-muted-foreground">
                  Processed by Security
                </p>
                <p className="mt-1 font-medium text-foreground">
                  {selectedItem.processor?.name ||
                    "—"}
                </p>
              </div>

              {selectedItem.description && (
                <div className="sm:col-span-2">
                  <p className="text-xs text-muted-foreground">
                    Description
                  </p>
                  <p className="mt-1 rounded-xl bg-muted p-3 text-sm text-foreground">
                    {
                      selectedItem.description
                    }
                  </p>
                </div>
              )}
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

function StudentNotifications() {
  const [notifications, setNotifications] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [markingId, setMarkingId] = useState<number | null>(null);
  const [markingAll, setMarkingAll] = useState(false);
  const [error, setError] = useState("");

  async function loadNotifications(
    showLoading = true
  ) {
    try {
      if (showLoading) {
        setLoading(true);
      }

      setError("");

      const data =
        await getNotifications();

      setNotifications(
        Array.isArray(
          data?.notifications
        )
          ? data.notifications
          : []
      );
    } catch (err) {
      console.error(
        "Failed to load notifications:",
        err
      );

      setError(
        err instanceof Error
          ? err.message
          : "Failed to load notifications."
      );
    } finally {
      if (showLoading) {
        setLoading(false);
      }
    }
  }

  useEffect(() => {
    loadNotifications(true);

    const interval =
      window.setInterval(
        () => {
          loadNotifications(false);
        },
        15000
      );

    const handleFocus =
      () => {
        loadNotifications(false);
      };

    const handleVisibility =
      () => {
        if (
          document.visibilityState ===
          "visible"
        ) {
          loadNotifications(false);
        }
      };

    window.addEventListener(
      "focus",
      handleFocus
    );

    document.addEventListener(
      "visibilitychange",
      handleVisibility
    );

    return () => {
      window.clearInterval(
        interval
      );

      window.removeEventListener(
        "focus",
        handleFocus
      );

      document.removeEventListener(
        "visibilitychange",
        handleVisibility
      );
    };
  }, []);

  async function handleMarkRead(id: number) {
    try {
      setMarkingId(id);
      setError("");

      await markNotificationRead(id);

      setNotifications((previous) =>
        previous.map((notification) =>
          notification.id === id
            ? {
                ...notification,
                is_read: true,
                read_at: new Date().toISOString(),
              }
            : notification
        )
      );
    } catch (err) {
      console.error(
        "Failed to mark notification as read:",
        err
      );

      setError(
        err instanceof Error
          ? err.message
          : "Failed to mark notification as read."
      );
    } finally {
      setMarkingId(null);
    }
  }

  async function handleMarkAllRead() {
    const unreadExists = notifications.some(
      (notification) => !notification.is_read
    );

    if (!unreadExists) return;

    try {
      setMarkingAll(true);
      setError("");

      await markAllNotificationsRead();

      setNotifications((previous) =>
        previous.map((notification) => ({
          ...notification,
          is_read: true,
          read_at:
            notification.read_at ??
            new Date().toISOString(),
        }))
      );
    } catch (err) {
      console.error(
        "Failed to mark all notifications as read:",
        err
      );

      setError(
        err instanceof Error
          ? err.message
          : "Failed to mark all notifications as read."
      );
    } finally {
      setMarkingAll(false);
    }
  }

  function formatDate(dateString: string) {
    if (!dateString) return "—";

    const date = new Date(dateString);

    if (Number.isNaN(date.getTime())) {
      return "—";
    }

    return date.toLocaleDateString();
  }

  function formatTime(dateString: string) {
    if (!dateString) return "";

    const date = new Date(dateString);

    if (Number.isNaN(date.getTime())) {
      return "";
    }

    return date.toLocaleTimeString([], {
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  const unreadCount = notifications.filter(
    (notification) => !notification.is_read
  ).length;

  const readCount =
    notifications.length - unreadCount;

  return (
    <div className="space-y-6 min-w-0 w-full max-w-full overflow-x-clip">
      {/* HEADER */}
      <div className="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <h1 className="text-2xl font-bold text-gray-900">
            Notifications
          </h1>

          <p className="text-sm text-gray-500 mt-1">
            View updates about your registered items and
            QRPass activity.
          </p>
        </div>

        <div className="flex gap-2">
          <button
            onClick={() => loadNotifications(true)}
            disabled={loading}
            className="px-4 py-2 border border-gray-300 rounded-lg text-sm font-semibold hover:bg-gray-50 disabled:opacity-50 inline-flex items-center justify-center gap-1.5 !border-0 !bg-transparent !shadow-none !text-[#17336d] !px-2 !py-1 hover:!bg-[#edf2ff] rounded-lg md:!hidden"
          > <RefreshCw size={13} className="shrink-0" />
            {loading ? "Refreshing..." : "Refresh"}
          </button>

          <button
            onClick={handleMarkAllRead}
            disabled={
              markingAll ||
              unreadCount === 0
            }
            className="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold disabled:opacity-50 transition-colors hover:!bg-[#eef2ff] hover:!text-[#17336d] hover:!border-[#a8bde4] focus-visible:!ring-0 focus-visible:!shadow-none"
          >
            {markingAll
              ? "Updating..."
              : "Mark All as Read"}
          </button>
        </div>
      </div>

      {/* ERROR */}
      {error && (
        <div className="px-4 py-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700">
          {error}
        </div>
      )}

      {/* SUMMARY */}
      <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div className="bg-white border border-gray-200 rounded-xl p-5">
          <p className="text-sm text-gray-500">
            Total Notifications
          </p>

          <p className="text-3xl font-bold text-gray-900 mt-2">
            {notifications.length}
          </p>
        </div>

        <div className="bg-white border border-gray-200 rounded-xl p-5">
          <p className="text-sm text-gray-500">
            Unread
          </p>

          <p className="text-3xl font-bold text-blue-600 mt-2">
            {unreadCount}
          </p>
        </div>

        <div className="bg-white border border-gray-200 rounded-xl p-5">
          <p className="text-sm text-gray-500">
            Read
          </p>

          <p className="text-3xl font-bold text-green-600 mt-2">
            {readCount}
          </p>
        </div>
      </div>

      {/* NOTIFICATIONS */}
      <div className="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <div className="px-5 py-4 border-b border-gray-200">
          <h2 className="text-lg font-bold text-gray-900">
            Recent Notifications
          </h2>
        </div>

        {loading ? (
          <div className="py-14 text-center text-gray-500">
            Loading notifications...
          </div>
        ) : notifications.length === 0 ? (
          <div className="py-14 text-center">
            <p className="font-semibold text-gray-700">
              No notifications yet.
            </p>

            <p className="text-sm text-gray-500 mt-1">
              Item approval and other QRPass updates will
              appear here.
            </p>
          </div>
        ) : (
          <div className="divide-y divide-gray-100">
            {notifications.map((notification) => {
              const unread = !notification.is_read;

              return (
                <div
                  key={notification.id}
                  className={`p-5 ${
                    unread
                      ? "bg-blue-50/60"
                      : "bg-white"
                  }`}
                >
                  <div className="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                    <div className="flex-1">
                      <div className="flex items-center gap-2">
                        <h3 className="font-bold text-gray-900">
                          {notification.title}
                        </h3>

                        {unread && (
                          <span className="px-2 py-0.5 rounded-full bg-blue-600 text-white text-[10px] font-bold uppercase">
                            New
                          </span>
                        )}
                      </div>

                      <p className="text-sm text-gray-600 mt-2">
                        {notification.message}
                      </p>

                      <div className="flex flex-wrap gap-3 mt-3 text-xs text-gray-500">
                        <span>
                          {formatDate(
                            notification.created_at
                          )}
                        </span>

                        <span>
                          {formatTime(
                            notification.created_at
                          )}
                        </span>

                        <span className="capitalize">
                          {String(
                            notification.type ??
                              "system"
                          ).replace(/_/g, " ")}
                        </span>
                      </div>
                    </div>

                    {unread ? (
                      <button
                        onClick={() =>
                          handleMarkRead(
                            notification.id
                          )
                        }
                        disabled={
                          markingId === notification.id
                        }
                        className="px-3 py-2 border border-blue-200 text-blue-700 rounded-lg text-xs font-semibold hover:bg-blue-50 disabled:opacity-50 whitespace-nowrap"
                      >
                        {markingId ===
                        notification.id
                          ? "Updating..."
                          : "Mark as Read"}
                      </button>
                    ) : (
                      <span className="px-3 py-1.5 rounded-full bg-green-100 text-green-700 text-xs font-semibold whitespace-nowrap">
                        Read
                      </span>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>
    </div>
  );
}
// ══════════════════════════════════════════════════════════════════════════════
// SECURITY (CSU) PAGES
// ══════════════════════════════════════════════════════════════════════════════
/* QRPASS_CSU_DIRECT_INPUTS_V143 */
function SecurityScanVerify() {
  const [scanResult, setScanResult] = useState<any | null>(null);
  const [input, setInput] = useState("");
  const [verifying, setVerifying] = useState(false);
  const [verifyError, setVerifyError] = useState("");

  const [gate, setGate] = useState("Gate 2");
  const [logging, setLogging] = useState(false);



  const [incidentMessage, setIncidentMessage] = useState("");

  const [pendingIncident, setPendingIncident] = useState<{
    code: string;
    incidentType: string;
    errorMessage: string;
  } | null>(null);

  const [savingIncident, setSavingIncident] = useState(false);
  const [sameAsOwner, setSameAsOwner] = useState(false);

  const [flaggedForm, setFlaggedForm] = useState({
    item_name: "",
    owner_name: "",
    owner_id_number: "",
    carrier_name: "",
    carrier_id_number: "",
    direction: "OUT" as "IN" | "OUT",
  });

  // Keeps the latest selected gate available to the camera scanner
  const gateRef = React.useRef(gate);

  useEffect(() => {
    gateRef.current = gate;
  }, [gate]);

  function prepareSecurityIncident(
    code: string,
    errorMessage: string
  ) {
    const normalizedError = errorMessage.toLowerCase();

    let incidentType = "";

    if (normalizedError.includes("not found")) {
      incidentType = "Unregistered Item";
    } else if (normalizedError.includes("not approved")) {
      incidentType = "Unapproved Item";
    } else {
      // Network/server errors should not create a security incident.
      setPendingIncident(null);
      return;
    }

    setSameAsOwner(false);
    setFlaggedForm({
      item_name: "",
      owner_name: "",
      owner_id_number: "",
      carrier_name: "",
      carrier_id_number: "",
      direction: "OUT",
    });

    setPendingIncident({
      code,
      incidentType,
      errorMessage,
    });
  }

  function updateFlaggedForm(
    field: keyof typeof flaggedForm,
    value: string
  ) {
    const cleanedValue =
      field === "item_name" ||
      field === "owner_name" ||
      field === "carrier_name"
        ? value.replace(/[^\p{L} ]/gu, "")
        : field === "owner_id_number" ||
          field === "carrier_id_number"
        ? value.replace(/[^0-9]/g, "")
        : value;

    setFlaggedForm((current) => {
      const next = {
        ...current,
        [field]: cleanedValue,
      };

      if (sameAsOwner) {
        if (field === "owner_name") {
          next.carrier_name = cleanedValue;
        }

        if (field === "owner_id_number") {
          next.carrier_id_number = cleanedValue;
        }
      }

      return next;
    });
  }
  function handleSameAsOwner(checked: boolean) {
    setSameAsOwner(checked);

    if (checked) {
      setFlaggedForm((current) => ({
        ...current,
        carrier_name: current.owner_name,
        carrier_id_number: current.owner_id_number,
      }));
    }
  }

  async function submitSecurityIncident(
    event: React.FormEvent
  ) {
    event.preventDefault();

    if (!pendingIncident) {
      return;
    }

    const requiredFields = [
      ["Item Name", flaggedForm.item_name],
      ["Owner Name", flaggedForm.owner_name],
      ["Owner ID Number", flaggedForm.owner_id_number],
      ["Person Carrying Item", flaggedForm.carrier_name],
      ["Carrier ID Number", flaggedForm.carrier_id_number],
      ["Direction", flaggedForm.direction],
    ];

    const missingFields = requiredFields
      .filter(([, value]) => !String(value ?? "").trim())
      .map(([label]) => label);

    if (missingFields.length > 0) {
      alert(
        `Please complete all required flagged-item details:\n\n${missingFields
          .map((field) => `• ${field}`)
          .join("\n")}`
      );
      return;
    }

    // Strict validation before submitting the flagged item.
    const nameFields: Array<[string, string]> = [
      ["Item Name", flaggedForm.item_name],
      ["Owner Name", flaggedForm.owner_name],
      ["Person Carrying Item", flaggedForm.carrier_name],
    ];

    for (const [label, value] of nameFields) {
      if (!/^[\p{L} ]+$/u.test(value.trim())) {
        alert(`${label} must contain letters and spaces only.`);
        return;
      }
    }

    const idFields: Array<[string, string]> = [
      ["Owner Student ID", flaggedForm.owner_id_number],
      ["Carrier Student ID", flaggedForm.carrier_id_number],
    ];

    for (const [label, value] of idFields) {
      if (!/^[0-9]+$/.test(value)) {
        alert(`${label} must contain numbers only.`);
        return;
      }
    }
    try {
      setSavingIncident(true);

      await createSecurityIncident({
        registered_item_id: null,
        scanned_code: pendingIncident.code,
        incident_type: pendingIncident.incidentType,
        item_name: flaggedForm.item_name.trim(),
        serial_number: null,
        owner_name: flaggedForm.owner_name.trim(),
        owner_id_number: flaggedForm.owner_id_number.trim(),
        carrier_name: flaggedForm.carrier_name.trim(),
        carrier_id_number: flaggedForm.carrier_id_number.trim(),
        direction: flaggedForm.direction,
        gate: gateRef.current,
        description:
          pendingIncident.incidentType === "Unregistered Item"
            ? `Unregistered QR ID or serial number "${pendingIncident.code}" was presented at ${gateRef.current}.`
            : `An item that has not yet been approved was presented at ${gateRef.current}. Code: ${pendingIncident.code}.`,
      });

      setIncidentMessage(
        `${pendingIncident.incidentType} has been flagged and recorded at ${gateRef.current}.`
      );

      setPendingIncident(null);
      setSameAsOwner(false);
      setFlaggedForm({
        item_name: "",
        owner_name: "",
        owner_id_number: "",
        carrier_name: "",
        carrier_id_number: "",
        direction: "OUT",
      });
    } catch (incidentError) {
      console.error(
        "Failed to record security incident:",
        incidentError
      );

      setIncidentMessage(
        "The item could not be verified, but the security incident could not be saved."
      );
    } finally {
      setSavingIncident(false);
    }
  }

  async function verifyCode(code: string) {
    const cleanCode = code.trim();

    if (!cleanCode) {
      setVerifyError(
        "Please enter a QR ID or serial number."
      );
      setScanResult(null);
      setIncidentMessage("");
      setPendingIncident(null);
      return;
    }

    try {
      setVerifying(true);
      setVerifyError("");
      setIncidentMessage("");
      setScanResult(null);

      const data = await verifyItem(cleanCode);

      setInput(cleanCode);
      setScanResult(data.item);

      // Successful verification removes previous incident warning/form.
      setIncidentMessage("");
      setPendingIncident(null);
      setSameAsOwner(false);
    } catch (error) {
      setScanResult(null);
      setInput(cleanCode);

      const message =
        error instanceof Error
          ? error.message
          : "Item verification failed.";

      setVerifyError(message);

      // Ask CSU to complete the item/owner/carrier details before
      // the failed verification is officially recorded as flagged.
      prepareSecurityIncident(
        cleanCode,
        message
      );
    } finally {
      setVerifying(false);
    }
  }

  async function doScan() {
    await verifyCode(input);
  }

  async function handleLog(
    direction: "IN" | "OUT"
  ) {
    if (!scanResult) {
      alert("Please verify an item first.");
      return;
    }

    try {
      setLogging(true);

      if (verifying) {
        alert("Verification is still in progress. Please try again.");
        return;
      }

      await createScanLog(
        scanResult.id,
        gate,
        direction
      );

      

      // Clear the verified item after a successful IN / OUT log
      // so CSU is ready to scan the next item immediately.
      setScanResult(null);
      setInput("");
      setVerifyError("");
      setIncidentMessage("");
      setPendingIncident(null);
      setSameAsOwner(false);

      alert(`Item logged ${direction} successfully!`);
      resumeCamera();
    } catch (error) {
      alert(
        error instanceof Error
          ? error.message
          : "Failed to save scan log."
      );
    } finally {
      setLogging(false);
    }
  }

  

  // Start the camera directly when the CSU scanning page opens.
  // Manual QR ID / serial-number entry stays available if camera access is denied.
  const [cameraError, setCameraError] = useState("");
  const [cameraRetry, setCameraRetry] = useState(0);
  const scanBusyRef = useRef(false);

  useEffect(() => {
    let disposed = false;
    let started = false;
    const scanner = new Html5Qrcode("qr-reader");
    scanBusyRef.current = false;
    setCameraError("");

    const startCamera = async () => {
      try {
        await scanner.start(
          { facingMode: "environment" },
          { fps: 10, qrbox: { width: 220, height: 220 } },
          (decodedText) => {
            if (disposed || scanBusyRef.current) return;
            scanBusyRef.current = true;
            // Stop the live feed while checking and logging this item.
            try { scanner.pause(true); } catch (_) { /* scanner may be stopping */ }
            void verifyCode(decodedText);
          },
          () => { /* scanning frames without a QR is normal */ }
        );
        started = true;
        if (disposed) {
          await scanner.stop().catch(() => {});
          scanner.clear();
        }
      } catch (error) {
        if (!disposed) {
          setCameraError("Camera unavailable or permission denied. Allow camera access, then select Retry Camera, or enter a QR ID manually.");
        }
      }
    };
    void startCamera();

    return () => {
      disposed = true;
      if (started) {
        void scanner.stop().catch(() => {}).then(() => { try { scanner.clear(); } catch (_) {} });
      }
    };
  }, [cameraRetry]);

  // Re-enable scanning on demand, after the verification result has been handled.
  function resumeCamera() {
    scanBusyRef.current = false;
    setScanResult(null);
    setVerifyError("");
    setIncidentMessage("");
    setPendingIncident(null);
    setInput("");
    setCameraRetry(current => current + 1);
  }

  return (
    <div className="w-full min-w-0 space-y-5">
      <PageHeader
        title="Scan & Verify"
        subtitle="Scan an item's QR code or manually enter the QR ID or serial number."
      />

      {/* SCANNER */}
      <div className="mx-auto w-full max-w-[720px] min-w-0 rounded-xl border border-border bg-card p-4 shadow-sm sm:p-5">
        <div className="flex flex-col items-center gap-3">
          {/* GATE SELECTION */}
          <div className="w-full max-w-[420px]">
            <label className="block text-xs font-semibold text-foreground mb-1">
              Current Gate
            </label>

            <select
              value={gate}
              onChange={(e) =>
                setGate(e.target.value)
              }
              className="h-11 w-full rounded-xl border border-border px-3 text-sm text-foreground outline-none focus:border-primary focus:ring-2 focus:ring-primary/15 !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
            >

              <option value="Gate 2">
                Gate 2
              </option>

              <option value="Gate 3">
                Gate 3
              </option>

              <option value="Gate 4">
                Gate 4
              </option>
            </select>
          </div>

          {/* LIVE QR CAMERA - automatically starts on page entry */}
          <div className="w-full max-w-[420px] space-y-2">
            <div key={cameraRetry} id="qr-reader" className="w-full min-w-0 max-w-full overflow-hidden rounded-xl border border-border bg-slate-50" />
            {cameraError && <p role="alert" className="rounded-lg bg-amber-50 border border-amber-200 px-3 py-2 text-xs text-amber-800">{cameraError}</p>}
            <div className="flex w-full items-center justify-center">
              
              <button type="button" onClick={resumeCamera} className="inline-flex items-center gap-2 rounded-xl border border-border bg-card px-4 py-2 text-xs font-semibold hover:bg-muted">
                <RefreshCw size={14} /> {cameraError ? "Retry Camera" : "Scan Next Item"}
              </button>
            </div>
          </div>

          {/* MANUAL INPUT */}
          <div className="flex w-full max-w-[420px] min-w-0 flex-col gap-2 sm:flex-row sm:items-center">
            <div className="relative min-w-0 flex-1">
              <QrCode
                size={14}
                className="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground"
              />

              <input
                value={input}
                onChange={(e) =>
                  setInput(e.target.value)
                }
                onKeyDown={(e) => {
                  if (e.key === "Enter") {
                    doScan();
                  }
                }}
                placeholder="QR ID or serial number..."
                className="h-12 w-full min-w-0 rounded-xl border border-[#bfceff] pl-9 pr-3 text-sm text-foreground outline-none focus:border-[#6488ff] focus:ring-2 focus:ring-[#6488ff]/15 dark:border-[#35537e] dark:bg-[#1b2b49] !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
              />
            </div>

            <button
              onClick={doScan}
              disabled={verifying}
              className="h-12 w-full shrink-0 rounded-xl bg-primary px-5 text-sm font-semibold text-primary-foreground disabled:opacity-50 sm:w-auto transition-colors hover:!bg-[#eef2ff] hover:!text-[#17336d] hover:!border-[#a8bde4] focus-visible:!ring-0 focus-visible:!shadow-none"
          >
              {verifying
                ? "Verifying..."
                : "Verify"}
            </button>
          </div>

          {/* VERIFICATION ERROR */}
          {verifyError && (
            <div className="w-full max-w-md rounded-xl border border-red-200 bg-red-50 p-3 text-red-700">
              <div className="flex items-start gap-2">
                <AlertCircle
                  size={17}
                  className="mt-0.5 flex-shrink-0"
                />

                <div>
                  <p className="text-xs font-semibold">
                    Verification Failed
                  </p>

                  <p className="text-xs mt-0.5">
                    {verifyError}
                  </p>
                </div>
              </div>
            </div>
          )}

          {/* FLAGGED ITEM DETAILS FORM */}
          {pendingIncident && (
  <div
    className="fixed inset-0 z-[400] flex items-center justify-center bg-black/55 p-3 backdrop-blur-[2px] sm:p-6"
  >
    <form
      onSubmit={submitSecurityIncident}
      role="dialog"
      aria-modal="true"
      aria-labelledby="incident-modal-title"
      className="flex w-full max-w-3xl min-h-0 max-h-[calc(100dvh-1.5rem)] flex-col overflow-hidden rounded-[24px] border border-[#cfd8e6] bg-white shadow-2xl sm:max-h-[90dvh]"
    >
      <div className="flex shrink-0 items-start justify-between gap-3 border-b border-[#e5eaf2] px-4 py-4 sm:px-6">
        <div className="flex min-w-0 items-start gap-3">
          <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-orange-50 text-orange-600">
            <AlertTriangle size={20} />
          </span>
          <div className="min-w-0">
            <h2
              id="incident-modal-title"
              className="text-base font-bold text-[#111827] sm:text-lg"
            >
              {pendingIncident.incidentType.toUpperCase()} DETECTED
            </h2>
            <p className="mt-1 break-all text-xs text-[#64748b]">
              QR / Code:{" "}
              <span className="font-mono font-semibold text-orange-700">
                {pendingIncident.code}
              </span>
            </p>
            <p className="mt-2 text-xs leading-relaxed text-[#64748b]">
              Complete the details below before recording this item as a security incident.
            </p>
          </div>
        </div>

        <button
          type="button"
          aria-label="Close incident form"
          disabled={savingIncident}
          onClick={() => {
            setPendingIncident(null);
            setSameAsOwner(false);
            resumeCamera();
          }}
          className="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-[#dce3ee] text-[#64748b] hover:bg-[#f1f5f9] disabled:opacity-50"
          >
          <X size={18} />
        </button>
      </div>

      <div className="min-h-0 flex-1 overflow-y-auto overscroll-contain px-4 py-4 sm:px-6 sm:py-5"><div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
                {/* ITEM NAME */}
                <div className="sm:col-span-2">
                  <label className="block text-xs font-semibold text-gray-800 mb-1">
                    Item Name *
                  </label>

                  <input
                    type="text"
                    value={flaggedForm.item_name}
                    onChange={(e) =>
                      updateFlaggedForm(
                        "item_name",
                        e.target.value
                      )
                    }
                    placeholder="e.g. Laptop, Camera, Phone"
                    required
                    className="w-full px-3 py-2 text-sm border border-[#cfd8e6] rounded-md focus:outline-none focus:border-[#2f5fd6] focus:ring-2 focus:ring-[#2f5fd6]/15 !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
                  />
                </div>

                {/* OWNER NAME */}
                <div>
                  <label className="block text-xs font-semibold text-gray-800 mb-1">
                    Owner Name *
                  </label>

                  <input
                    type="text"
                    value={flaggedForm.owner_name}
                    onChange={(e) =>
                      updateFlaggedForm(
                        "owner_name",
                        e.target.value
                      )
                    }
                    placeholder="Full name of item owner"
                    required
                    className="w-full px-3 py-2 text-sm border border-[#cfd8e6] rounded-md focus:outline-none focus:border-[#2f5fd6] focus:ring-2 focus:ring-[#2f5fd6]/15 !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
                  />
                </div>

                {/* OWNER ID */}
                <div>
                  <label className="block text-xs font-semibold text-gray-800 mb-1">
                    Owner Student ID *
                  </label>

                  <input
                    type="text"
                    value={flaggedForm.owner_id_number}
                    inputMode="numeric"
                    pattern="[0-9]+"
                    onChange={(e) =>
                      updateFlaggedForm(
                        "owner_id_number",
                        e.target.value
                      )
                    }
                    placeholder="Student ID"
                    required
                    className="w-full px-3 py-2 text-sm border border-[#cfd8e6] rounded-md focus:outline-none focus:border-[#2f5fd6] focus:ring-2 focus:ring-[#2f5fd6]/15 !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
                  />
                </div>

                {/* SAME AS OWNER */}
                <div className="sm:col-span-2">
                  <label className="inline-flex items-center gap-2 text-xs font-semibold text-gray-700 cursor-pointer">
                    <input
                      type="checkbox"
                      checked={sameAsOwner}
                      onChange={(e) =>
                        handleSameAsOwner(e.target.checked)
                      }
                      className="rounded border-gray-300"
                    />
                    The owner is the same person carrying the item
                  </label>
                </div>

                {/* CARRIER NAME */}
                <div>
                  <label className="block text-xs font-semibold text-gray-800 mb-1">
                    Person Carrying the Item *
                  </label>

                  <input
                    type="text"
                    value={flaggedForm.carrier_name}
                    onChange={(e) =>
                      updateFlaggedForm(
                        "carrier_name",
                        e.target.value
                      )
                    }
                    placeholder="Full name of person carrying item"
                    disabled={sameAsOwner}
                    required
                    className="w-full px-3 py-2 text-sm border border-[#cfd8e6] rounded-md focus:outline-none focus:border-[#2f5fd6] focus:ring-2 focus:ring-[#2f5fd6]/15 disabled:bg-gray-100 !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
                  />
                </div>

                {/* CARRIER ID */}
                <div>
                  <label className="block text-xs font-semibold text-gray-800 mb-1">
                    Student ID (Carrier) *
                  </label>

                  <input
                    type="text"
                    value={flaggedForm.carrier_id_number}
                    inputMode="numeric"
                    pattern="[0-9]+"
                    onChange={(e) =>
                      updateFlaggedForm(
                        "carrier_id_number",
                        e.target.value
                      )
                    }
                    placeholder="Student ID of person carrying item"
                    disabled={sameAsOwner}
                    required
                    className="w-full px-3 py-2 text-sm border border-[#cfd8e6] rounded-md focus:outline-none focus:border-[#2f5fd6] focus:ring-2 focus:ring-[#2f5fd6]/15 disabled:bg-gray-100 !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
                  />
                </div>

                {/* DIRECTION */}
                <div>
                  <label className="block text-xs font-semibold text-gray-800 mb-1">
                    Direction *
                  </label>

                  <select
                    value={flaggedForm.direction}
                    onChange={(e) =>
                      setFlaggedForm((current) => ({
                        ...current,
                        direction: e.target.value as "IN" | "OUT",
                      }))
                    }
                    required
                    className="w-full px-3 py-2 text-sm border border-[#cfd8e6] rounded-md focus:outline-none focus:border-[#2f5fd6] focus:ring-2 focus:ring-[#2f5fd6]/15 !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
                  >
                    <option value="OUT">OUT</option>
                    <option value="IN">IN</option>
                  </select>
                </div>

                {/* GATE */}
                <div>
                  <label className="block text-xs font-semibold text-gray-800 mb-1">
                    Gate
                  </label>

                  <input
                    type="text"
                    value={gate}
                    readOnly
                    className="w-full px-3 py-2 text-sm border border-gray-200 rounded-md bg-gray-100 text-gray-600 !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
                  />
                </div>
              </div>

                    </div>

      <div className="flex shrink-0 flex-wrap items-center justify-end gap-2 border-t border-[#e5eaf2] bg-[#fbfcfe] px-4 py-3 sm:px-6">
                <button
                  type="button"
                  onClick={() => {
                    setPendingIncident(null);
                    setSameAsOwner(false);
                    resumeCamera();
                  }}
                  disabled={savingIncident}
                  className="h-11 rounded-xl border border-border bg-card px-4 text-xs font-semibold text-foreground disabled:opacity-50 !bg-white !text-[#17336d] !border-[#cbd5e1] transition-colors hover:!bg-[#eef2ff] hover:!border-[#a8bde4] hover:!text-[#17336d] focus-visible:!ring-0 focus-visible:!shadow-none focus-visible:!outline-none"
                 
            onMouseEnter={(e) => {
              const el=e.currentTarget;
              if(!el.dataset.qrpassV158Saved) {
                el.dataset.qrpassV158Saved=el.style.cssText || " ";
              }
              el.style.setProperty("background", "#eef2ff", "important");
              el.style.setProperty("background-color", "#eef2ff", "important");
              el.style.setProperty("background-image", "none", "important");
              el.style.setProperty("color", "#17336d", "important");
              el.style.setProperty("border-color", "#a8bde4", "important");
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onMouseLeave={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onFocus={(e) => {
              e.currentTarget.style.setProperty("box-shadow", "none", "important");
              e.currentTarget.style.setProperty("outline", "none", "important");
            }}
            onBlur={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}

           data-qrpass-neutral-v169="true">
                  Cancel
                </button>

                <button
                  type="submit"
                  disabled={savingIncident}
                  className="h-11 w-full shrink-0 rounded-xl bg-primary px-5 text-sm font-semibold text-primary-foreground disabled:opacity-50 sm:w-auto transition-colors hover:!bg-[#eef2ff] hover:!text-[#17336d] hover:!border-[#a8bde4] focus-visible:!ring-0 focus-visible:!shadow-none"
          >
                  {savingIncident
                    ? "Saving Flagged Item..."
                    : "Flag Item"}
                </button>
                    </div>
    </form>
  </div>
)}

          {/* FLAGGED INCIDENT */}
          {incidentMessage && (
            <div className="w-full max-w-md rounded-xl border border-red-300 bg-red-50 p-4">
              <div className="flex items-start gap-3">
                <AlertTriangle
                  size={20}
                  className="text-red-600 mt-0.5 flex-shrink-0"
                />

                <div>
                  <p className="text-sm font-bold text-red-700">
                    SECURITY ALERT — FLAGGED
                  </p>

                  <p className="text-xs text-red-700 mt-1">
                    {incidentMessage}
                  </p>

                  <p className="text-xs text-red-600 mt-2">
                    Security personnel should inspect
                    the item before allowing entry or
                    exit.
                  </p>
                </div>
              </div>
            </div>
          )}
        </div>
      </div>

      {/* VERIFIED ITEM */}
      {scanResult && (
        <div className="w-full min-w-0 rounded-xl border border-emerald-300 bg-card p-4 shadow-sm sm:p-6">
          <div className="flex min-w-0 flex-col items-center gap-4 sm:flex-row sm:items-start">
            <QRCodeDisplay
              value={scanResult.qr_code}
              size={90}
            />

            <div className="w-full min-w-0 flex-1">
              <div className="flex items-center gap-2 mb-3">
                <CheckCircle
                  size={18}
                  className="text-green-500"
                />

                <span className="font-bold text-base text-green-600">
                  ITEM VERIFIED ✓
                </span>
              </div>

              {/* ITEM INFORMATION */}
              <div className="grid grid-cols-1 gap-x-6 gap-y-3 text-xs sm:grid-cols-2">
                <div>
                  <span className="text-muted-foreground">
                    Item:{" "}
                  </span>

                  <span className="font-medium">
                    {scanResult.item_name}
                  </span>
                </div>

                <div>
                  <span className="text-muted-foreground">
                    Type:{" "}
                  </span>

                  <span className="font-medium">
                    {scanResult.item_type}
                  </span>
                </div>

                <div>
                  <span className="text-muted-foreground">
                    Brand / Model:{" "}
                  </span>

                  <span className="font-medium">
                    {scanResult.brand_model ||
                      "—"}
                  </span>
                </div>

                <div>
                  <span className="text-muted-foreground">
                    Color:{" "}
                  </span>

                  <span className="font-medium">
                    {scanResult.color || "—"}
                  </span>
                </div>

                <div>
                  <span className="text-muted-foreground">
                    Serial No.:{" "}
                  </span>

                  <span className="font-mono font-medium">
                    {scanResult.serial_number}
                  </span>
                </div>

                <div>
                  <span className="text-muted-foreground">
                    QR ID:{" "}
                  </span>

                  <span className="font-mono font-medium text-primary">
                    {scanResult.qr_code}
                  </span>
                </div>

                <div>
                  <span className="text-muted-foreground">
                    Registered Owner:{" "}
                  </span>

                  <span className="font-medium">
                    {scanResult.user?.name ??
                      "Unknown"}
                  </span>
                </div>

                <div>
                  <span className="text-muted-foreground">
                    Owner ID:{" "}
                  </span>

                  <span className="font-mono font-medium">
                    {scanResult.user?.username ??
                      "—"}
                  </span>
                </div>

                <div>
                  <span className="text-muted-foreground">
                    Date Registered:{" "}
                  </span>

                  <span className="font-medium">
                    {new Date(
                      scanResult.created_at
                    ).toLocaleDateString(
                      "en-PH",
                      {
                        year: "numeric",
                        month: "short",
                        day: "numeric",
                      }
                    )}
                  </span>
                </div>

                <div className="flex gap-1.5 items-center">
                  <span className="text-muted-foreground">
                    Status:
                  </span>

                  <StatusBadge status="Approved" />
                </div>
              </div>

              {/* ENTRY / EXIT */}
              <div className="mt-5 pt-4 border-t border-[#cfd8e6]">
                <p className="text-xs font-semibold text-foreground mb-2">
                  Entry / Exit Log
                </p>

                <div className="grid grid-cols-2 gap-2 sm:flex sm:flex-wrap">
                  <button
                    onClick={() =>
                      handleLog("IN")
                    }
                    disabled={logging || verifying}
                    className="h-10 w-full rounded-xl bg-blue-600 px-5 text-xs font-semibold text-white transition-colors disabled:opacity-50 sm:w-auto transition-colors hover:!bg-[#eef2ff] hover:!text-[#17336d] hover:!border-[#a8bde4] focus-visible:!ring-0 focus-visible:!shadow-none"
          >
                    {logging
                      ? "Saving..."
                      : "IN"}
                  </button>

                  <button
                    onClick={() =>
                      handleLog("OUT")
                    }
                    disabled={logging || verifying}
                    className="h-10 w-full rounded-xl bg-slate-500 px-5 text-xs font-semibold text-white transition-colors hover:bg-slate-600 disabled:opacity-50 sm:w-auto"
                  >
                    {logging
                      ? "Saving..."
                      : "OUT"}
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      
    </div>
  );
}



function SecurityRecentScanLogs() {
  const [csuListSearch, setCsuListSearch] = useState("");
  const [csuListSort, setCsuListSort] =
    useState<"newest" | "oldest">("newest");
  const [recentLogs, setRecentLogs] = useState<any[]>([]);
  const [loadingLogs, setLoadingLogs] = useState(true);

  async function loadRecentLogs() {
    try {
      setLoadingLogs(true);

      const data = await getScanLogs();

      setRecentLogs((data.logs ?? []).slice(0, 5));
    } catch (error) {
      console.error(
        "Failed to load recent scan logs:",
        error
      );
    } finally {
      setLoadingLogs(false);
    }
  }



  useEffect(() => {
    void loadRecentLogs();
  }, []);

  const shownRecentLogs = [...recentLogs].filter((row: any) =>
    [row.qr_code, row.item?.item_name,
      row.item?.user?.name, row.item?.user?.username,
      row.scanned_at, row.gate, row.direction, row.result]
      .join(" ").toLowerCase()
      .includes(csuListSearch.trim().toLowerCase())
  ).sort((a: any, b: any) => {
    const x = new Date(a.scanned_at ?? a.created_at ?? 0).getTime() || 0;
    const y = new Date(b.scanned_at ?? b.created_at ?? 0).getTime() || 0;
    return csuListSort === "newest" ? y - x : x - y;
  });

  return (
    <div className="w-full min-w-0 space-y-5">
      <PageHeader
        title="Recent Scan Logs"
        subtitle="Latest QR verification and gate scan records."
      />

      
      <CSURecordToolbar
        search={csuListSearch} onSearch={setCsuListSearch}
        sort={csuListSort} onSort={setCsuListSort}
        onRefresh={loadRecentLogs} loading={loadingLogs}
        placeholder="Search QR ID, item, owner, gate..."
      />
      <Card
        title="Recent Scan Logs"
        
      >
        <div className="w-full max-w-full overflow-x-auto overscroll-x-contain rounded-lg border border-border">
          <table className="w-full min-w-[760px]">
            <thead>
              <tr className="bg-[#fafbfc]">
                {[
                  "Date and Time",
                  "QR ID",
                  "Item",
                  "Owner",
                  "Gate",
                  "Direction",
                  "Result",
                ].map((heading) => (
                  <th
                    key={heading}
                    className="text-left py-2 px-3 text-xs text-muted-foreground font-medium whitespace-nowrap"
                  >
                    {heading}
                  </th>
                ))}
              </tr>
            </thead>

            <tbody>
              {loadingLogs ? (
                <tr>
                  <td
                    colSpan={7}
                    className="text-center py-6 text-sm text-muted-foreground"
                  >
                    Loading recent scans...
                  </td>
                </tr>
              ) : shownRecentLogs.length === 0 ? (
                <tr>
                  <td
                    colSpan={7}
                    className="text-center py-6 text-sm text-muted-foreground"
                  >
                    No scan records yet.
                  </td>
                </tr>
              ) : (
                shownRecentLogs.map((log) => (
                  <tr
                    key={log.id}
                    className="border-t border-[#cfd8e6] hover:bg-[#eef2fc] transition-colors"
                  >
                    <td className="py-2.5 px-3 text-xs text-muted-foreground whitespace-nowrap">
                      {new Date(
                        log.scanned_at
                      ).toLocaleString(
                        "en-PH",
                        {
                          month: "short",
                          day: "numeric",
                          hour: "2-digit",
                          minute: "2-digit",
                        }
                      )}
                    </td>

                    <td className="py-2.5 px-3 text-xs font-mono text-primary whitespace-nowrap">
                      {log.qr_code}
                    </td>

                    <td className="py-2.5 px-3 text-sm font-medium whitespace-nowrap">
                      {log.item?.item_name ??
                        "Unknown"}
                    </td>

                    <td className="py-2.5 px-3 text-xs text-muted-foreground whitespace-nowrap">
                      {log.item?.user?.name ??
                        "Unknown"}
                    </td>

                    <td className="py-2.5 px-3 text-xs text-muted-foreground whitespace-nowrap">
                      {log.gate}
                    </td>

                    <td className="py-2.5 px-3">
                      <QRpassDirectionBadge direction={log.direction} />
                    </td>

                    <td className="py-2.5 px-3">
                      <StatusBadge
                        status={log.result}
                      />
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </Card>
    </div>
  );
}

type CSUDatePeriod = "today" | "week" | "month" | "all" | "custom";

const CSU_PERIOD_OPTIONS: { value: CSUDatePeriod; label: string }[] = [
  { value: "today", label: "Today" },
  { value: "week", label: "This Week" },
  { value: "month", label: "This Month" },
  { value: "all", label: "All Time" },
  { value: "custom", label: "Custom Range" },
];

function csuMatchesPeriod(
  value: string | null | undefined,
  period: CSUDatePeriod,
  customStart = "",
  customEnd = ""
): boolean {
  if (period === "all") return true;
  if (!value) return false;
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return false;
  const now = new Date();
  if (period === "today") return date.toDateString() === now.toDateString();
  if (period === "month") return date.getFullYear() === now.getFullYear() && date.getMonth() === now.getMonth();
  if (period === "week") {
    const start = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    start.setDate(start.getDate() - ((start.getDay() + 6) % 7));
    const end = new Date(start);
    end.setDate(start.getDate() + 7);
    return date >= start && date < end;
  }
  if (period === "custom") {
    if (!customStart && !customEnd) return false;
    if (customStart) {
      const start = new Date(`${customStart}T00:00:00`);
      if (date < start) return false;
    }
    if (customEnd) {
      const end = new Date(`${customEnd}T23:59:59.999`);
      if (date > end) return false;
    }
  }
  return true;
}

function csuPeriodName(period: CSUDatePeriod, start = "", end = "") {
  if (period === "custom") return `${start || "Start"} to ${end || "End"}`;
  return CSU_PERIOD_OPTIONS.find(option => option.value === period)?.label || "All Time";
}

// Shared date selector for CSU statistic cards. Filters records by their creation date.
function CSUStatsPeriodFilter({
  value, onChange, start, onStartChange, end, onEndChange, description,
}: {
  value: CSUDatePeriod;
  onChange: (period: CSUDatePeriod) => void;
  start: string;
  onStartChange: (date: string) => void;
  end: string;
  onEndChange: (date: string) => void;
  description: string;
}) {
  return (
    <div className="rounded-xl border border-border bg-card p-3 shadow-sm sm:p-4">
      <div className="flex flex-wrap items-center gap-3">
        <label className="text-sm font-semibold text-foreground" htmlFor={`csu-stat-period-${description.replace(/[^a-z]/gi, "-").toLowerCase()}`}>
          Reporting Period
        </label>
        <select
          id={`csu-stat-period-${description.replace(/[^a-z]/gi, "-").toLowerCase()}`}
          value={value}
          onChange={event => onChange(event.target.value as CSUDatePeriod)}
          className="h-10 min-w-[160px] rounded-xl border border-border px-3 text-sm outline-none focus:ring-2 focus:ring-primary/20 !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
        >
          {CSU_PERIOD_OPTIONS.map(option => (
            <option key={option.value} value={option.value}>{option.label}</option>
          ))}
        </select>
        {value === "custom" && (
          <div className="flex flex-wrap items-center gap-2">
            <label className="text-xs text-muted-foreground">From
              <input type="date" value={start} max={end || undefined} onChange={event => onStartChange(event.target.value)}
                className="ml-2 h-10 rounded-xl border border-border px-2 text-sm !bg-white hover:!bg-[#eef2ff] focus:!bg-white" />
            </label>
            <label className="text-xs text-muted-foreground">To
              <input type="date" value={end} min={start || undefined} onChange={event => onEndChange(event.target.value)}
                className="ml-2 h-10 rounded-xl border border-border px-2 text-sm !bg-white hover:!bg-[#eef2ff] focus:!bg-white" />
            </label>
          </div>
        )}
        <span className="text-xs text-muted-foreground">{description}</span>
      </div>
    </div>
  );
}



/* QRPASS_CSU_PAGE_MANAGE_V147: CSU-only, page-scoped record manager */
const QRPassCSUManageContextV147 = React.createContext<(() => void) | null>(null);

function QRPassCSUPageManagerV147({ page, onClose }: { page: number; onClose: () => void }) {
  const [rows, setRows] = React.useState<any[]>([]);
  const [query, setQuery] = React.useState("");
  const [selected, setSelected] = React.useState<string[]>([]);
  const [loading, setLoading] = React.useState(true);
  const [error, setError] = React.useState("");
  const pageNames = ["Manage Scan Records", "Manage Recent Scan Logs", "Manage Entry / Exit Logs", "Manage Registered Items", "Manage Lost & Found"];
  const title = pageNames[page] ?? "Manage Records";
  const getKey = (row: any, i: number) => String(row.__qrpassManagerKey ?? row.id ?? `${page}-${i}`);
  const load = React.useCallback(async () => {
    setLoading(true); setError("");
    try {
      let data: any[] = [];
      if (page === 0 || page === 1) {
        const response = await getScanLogs();
        data = Array.isArray(response?.logs) ? response.logs : [];
        if (page === 1) data = data.slice(0,5);
      } else if (page === 2) {
        const [scans, incidents] = await Promise.all([getScanLogs(), getSecurityIncidents()]);
        const logRows = Array.isArray(scans?.logs) ? scans.logs : [];
        const incidentRows = Array.isArray(incidents?.incidents) ? incidents.incidents : [];
        data = [
          ...logRows.map((row: any,i: number) => ({...row,__qrpassKind:"Gate Entry / Exit",__qrpassManagerKey:`gate-${row.id ?? i}`})),
          ...incidentRows.map((row: any,i: number) => ({...row,__qrpassKind:"Incident",__qrpassManagerKey:`incident-${row.id ?? i}`})),
        ];
      } else if (page === 3) {
        const response = await getSecurityReports();
        if (!Array.isArray(response?.registered_items)) throw new Error("CSU registered-item data unavailable from backend.");
        data = response.registered_items;
      } else if (page === 4) {
        const response = await getLostFoundItems();
        data = Array.isArray(response) ? response : Array.isArray(response?.items) ? response.items : [];
      }
      setRows(data);
      setSelected([]);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Unable to load CSU records.");
      setRows([]);
    } finally {
      setLoading(false);
    }
  }, [page]);
  React.useEffect(() => { void load(); }, [load]);
  const searchable = (row: any) => [
    row.id,row.__qrpassKind,row.item_name,row.item?.item_name,row.item?.user?.name,
    row.item?.user?.username,row.user?.name,row.user?.username,row.qr_code,row.serial_number,
    row.report_type,row.status,row.result,row.direction,row.gate,row.location_found,
    row.location_lost,row.incident_type,row.created_at,row.scanned_at,
  ].filter(v => v!==undefined && v!==null).join(" ").toLowerCase();
  const filtered = rows.filter(row=>searchable(row).includes(query.trim().toLowerCase()));
  const ids = filtered.map((row,i)=>getKey(row,i));
  const allSelected = ids.length>0 && ids.every(id=>selected.includes(id));
  const esc = (value: unknown) => {
    let v = String(value ?? "");
    if (/^[\s]*[=+\-@]/.test(v)) v = "'" + v;
    return `"${v.replace(/"/g,'""')}"`;
  };
  const download = () => {
    const subset = selected.length ? filtered.filter((r,i)=>selected.includes(getKey(r,i))) : filtered;
    if (!subset.length) return;
    const cols = ["id","__qrpassKind","item_name","qr_code","serial_number","report_type","direction","gate","status","result","created_at","scanned_at"];
    const lines = [cols.map(esc).join(","),...subset.map(r=>cols.map(c=>esc(c==="item_name"?(r.item_name??r.item?.item_name):r[c])).join(","))].join("\r\n");
    const blob = new Blob(["\uFEFF",lines],{type:"text/csv;charset=utf-8"});
    const url=URL.createObjectURL(blob);
    const anchor=document.createElement("a");
    anchor.href=url;anchor.download=`qrpass-csu-${page}-${new Date().toISOString().slice(0,10)}.csv`;
    document.body.appendChild(anchor); anchor.click(); anchor.remove();
    window.setTimeout(()=>URL.revokeObjectURL(url),1000);
  };
  const label=(r:any)=>String(r.item_name??r.item?.item_name??r.incident_type??r.qr_code??`Record #${r.id}`);
  return (
    <div className="fixed inset-0 z-[260] flex items-center justify-center bg-black/65 p-3 sm:p-6"
      onMouseDown={e=>{if(e.target===e.currentTarget)onClose();}}>
      <div role="dialog" aria-modal="true" aria-label={title} className="flex max-h-[90vh] w-full max-w-4xl flex-col overflow-hidden rounded-2xl border border-[#385785] bg-white p-4 text-[#172b54] shadow-2xl sm:p-5">
        <div className="mb-5 flex items-center justify-between gap-3">
          <h2 className="text-lg font-bold">{title}</h2>
          <button type="button" onClick={onClose} className="rounded-xl border border-[#c7d2fe] bg-white px-4 py-2 text-sm hover:bg-[#eef2ff]"
           data-qrpass-neutral-v169="true">Close</button>
        </div>
        <div className="mb-3 flex items-center gap-2">
          <button disabled type="button" title="CSU archive endpoint not available" className="shrink-0 rounded-xl border border-[#c7d2fe] bg-white px-3 py-2.5 text-sm opacity-50">View Archives</button>
          <input aria-label={`Search ${title}`} type="search" value={query} onChange={e=>setQuery(e.target.value)} placeholder="Search records..."
            className="min-w-0 flex-1 rounded-xl border border-[#c7d2fe] bg-white px-4 py-2.5 text-sm outline-none hover:bg-[#eef2ff] focus:bg-white" />
        </div>
        {error&&<div role="alert" className="mb-3 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">{error}</div>}
        <div className="min-h-[70px] flex-1 overflow-y-auto rounded-xl border border-[#d8e1ee]">
          {loading?<p className="p-7 text-center text-sm">Loading records...</p>:
            filtered.length===0?<p className="p-7 text-center text-sm font-semibold">No matching records</p>:
            <div className="divide-y divide-[#e5eaf2]">
              {filtered.map((row,i)=>{
                const id=getKey(row,i),checked=selected.includes(id);
                return <label key={id} className={`flex cursor-pointer items-center gap-3 p-3 ${checked?"bg-[#eef2ff]":"bg-white hover:bg-[#f8faff]"}`}>
                  <input type="checkbox" checked={checked} onChange={()=>setSelected(a=>a.includes(id)?a.filter(x=>x!==id):[...a,id])}/>
                  <div className="min-w-0 flex-1">
                    <p className="truncate text-sm font-semibold">{label(row)}</p>
                    <p className="truncate text-xs text-[#64748b]">{String(row.__qrpassKind??row.report_type??row.direction??row.status??row.result??"Record")} Â· {String(row.scanned_at??row.created_at??"â€”")}</p>
                  </div>
                </label>;
              })}
            </div>
          }
        </div>
        <div className="mt-3 flex flex-wrap items-center gap-2">
          <span className="mr-auto text-xs text-[#64748b]">{selected.length} selected Â· {filtered.length} shown</span>
          <button type="button" disabled={loading||!ids.length} onClick={()=>setSelected(v=>allSelected?v.filter(id=>!ids.includes(id)):Array.from(new Set([...v,...ids])))} className="rounded-xl border border-[#c7d2fe] bg-white px-3 py-2 text-sm hover:bg-[#eef2ff] disabled:opacity-50"
          >{allSelected?"Deselect All":"Select All"}</button>
          <button type="button" onClick={download} disabled={loading||!filtered.length} className="rounded-xl border border-[#c7d2fe] bg-white px-3 py-2 text-sm hover:bg-[#eef2ff] disabled:opacity-50"
          >Download</button>
          <button type="button" disabled title="Requires CSU-authorized archive endpoint" className="rounded-xl border border-[#c7d2fe] bg-white px-3 py-2 text-sm opacity-50">Archive</button>
          <button type="button" disabled title="Bulk deletion is unavailable for CSU audit history" className="rounded-xl border border-red-200 bg-white px-3 py-2 text-sm text-red-600 opacity-50">Delete</button>
        </div>
        <p className="mt-2 text-xs text-[#64748b]">Archive/Delete require CSU-authorized backend support. Search, selection and download work on this page's records.</p>
      </div>
    </div>
  );
}

function CSURecordToolbar({
  search, onSearch, sort, onSort, onRefresh, loading, placeholder, filter
}: {
  search: string;
  onSearch: (v: string) => void;
  sort: "newest" | "oldest";
  onSort: (v: "newest" | "oldest") => void;
  onRefresh: () => void | Promise<void>;
  loading?: boolean;
  placeholder: string;
  filter?: React.ReactNode;
}) {
  const openManageV147 = React.useContext(QRPassCSUManageContextV147);
  return (
    <div className="flex min-w-0 flex-col gap-2 sm:flex-row sm:items-center">
      <label className="relative min-w-0 flex-1">
        <Search size={16}
          className="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground"/>
        <input
          aria-label="Search records"
          value={search}
          onChange={e => onSearch(e.target.value)}
          placeholder={placeholder}
          className="h-12 w-full rounded-xl border border-[#bfceff] pl-10 pr-3 text-sm text-foreground outline-none focus:border-[#6488ff] focus:ring-2 focus:ring-[#6488ff]/15 dark:border-[#35537e] dark:bg-[#1b2b49] !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
        />
      </label>
      <div className="flex flex-wrap items-center gap-2">
        {filter}
        <select aria-label="Sort records" value={sort}
          onChange={e => onSort(e.target.value as "newest" | "oldest")}
          className="h-12 min-w-[148px] flex-1 rounded-xl border border-[#bfceff] px-3 text-sm text-foreground outline-none focus:border-[#6488ff] dark:border-[#35537e] dark:bg-[#1b2b49] sm:flex-none !bg-white hover:!bg-[#eef2ff] focus:!bg-white">
          <option value="newest">Newest first</option>
          <option value="oldest">Oldest first</option>
        </select>
        {openManageV147 && (
          <button type="button" title="Manage Logs" aria-label="Manage Logs"
            onClick={openManageV147}
            data-qrpass-hover-uniform-v141="true"
            className="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#c7d2fe] bg-white text-[#17336d] transition-colors hover:bg-[#eef2ff]"
  onMouseEnter={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', '#eef2ff', 'important');
    s.setProperty('background-color', '#eef2ff', 'important');
    s.setProperty('border-color', '#a8bde4', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
  onMouseLeave={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', '#ffffff', 'important');
    s.setProperty('background-color', '#ffffff', 'important');
    s.setProperty('border-color', '#cbd5e1', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
  onFocus={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', e.currentTarget.matches(':hover') ? '#eef2ff' : '#ffffff', 'important');
    s.setProperty('border-color', e.currentTarget.matches(':hover') ? '#a8bde4' : '#cbd5e1', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
  onBlur={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', '#ffffff', 'important');
    s.setProperty('background-color', '#ffffff', 'important');
    s.setProperty('border-color', '#cbd5e1', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
>
            <SlidersHorizontal size={18} strokeWidth={1.8}/>
          </button>
        )}
        <button type="button"
          onClick={() => { void onRefresh(); }}
          disabled={loading}
          className="inline-flex h-12 items-center justify-center gap-1.5 rounded-xl px-3 text-xs font-semibold text-primary hover:bg-muted disabled:opacity-50 md:!hidden">
          <RefreshCw size={14}/>
          {loading ? "Refreshing..." : "Refresh"}
        </button>
      </div>
    </div>
  );
}

function QRpassDirectionBadge({
  direction,
}: {
  direction?: string | null;
}) {
  const value = String(direction ?? "").trim().toUpperCase();

  const colors =
    value === "IN"
      ? "border-blue-200 bg-blue-100 text-blue-700 hover:bg-blue-200 dark:border-blue-400/30 dark:bg-blue-500/20 dark:text-blue-200 dark:hover:bg-blue-500/30"
      : value === "OUT"
        ? "border-slate-200 bg-slate-100 text-slate-600 hover:bg-slate-200 dark:border-slate-500/30 dark:bg-slate-500/20 dark:text-slate-200 dark:hover:bg-slate-500/30"
        : "border-slate-200 bg-slate-50 text-slate-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300";

  return (
    <span
      className={`inline-flex min-w-10 items-center justify-center rounded-full border px-2.5 py-1 text-[11px] font-bold leading-4 transition-colors duration-150 ${colors}`}
    >
      {value || "—"}
    </span>
  );
}
function SecurityEntryExitLog() {
  const [csuListSearch, setCsuListSearch] = useState("");
  const [csuListSort, setCsuListSort] =
    useState<"newest" | "oldest">("newest");
  const [logs, setLogs] = useState<any[]>([]);
  const [incidents, setIncidents] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [scanPeriod, setScanPeriod] = useState<CSUDatePeriod>("all");
  const [scanStartDate, setScanStartDate] = useState("");
  const [scanEndDate, setScanEndDate] = useState("");

  // Show only the selected CSU entry / exit or incident section.
  const [entryExitTab, setEntryExitTab] = useState<
    "all" | "entry" | "exit" | "flagged" | "resolved"
  >("all");

  const [selectedIncident, setSelectedIncident] =
    useState<any | null>(null);

  const [resolvingIncident, setResolvingIncident] =
    useState<any | null>(null);

  const [resolutionType, setResolutionType] =
    useState("");

  const [resolutionDetails, setResolutionDetails] =
    useState("");

  const [resolutionError, setResolutionError] =
    useState("");

  const [savingResolution, setSavingResolution] =
    useState(false);

  /*
  |--------------------------------------------------------------------------
  | LOAD DATA
  |--------------------------------------------------------------------------
  */

  async function loadData() {
    setLoading(true);

    try {
      const logsData = await getScanLogs();
      setLogs(logsData.logs ?? []);
    } catch (error) {
      console.error(
        "Failed to load scan logs:",
        error
      );

      setLogs([]);
    }

    try {
      const incidentsData =
        await getSecurityIncidents();

      setIncidents(
        incidentsData.incidents ?? []
      );
    } catch (error) {
      console.error(
        "Failed to load security incidents:",
        error
      );

      setIncidents([]);
    }

    setLoading(false);
  }

  useEffect(() => {
    loadData();
  }, []);

  /*
  |--------------------------------------------------------------------------
  | RESOLVE INCIDENT
  |--------------------------------------------------------------------------
  */

  const resolutionTypeOptions = [
    "Ownership Verified",
    "Returned to Owner",
    "Authorized by Owner",
    "Item Held by Security",
    "Registration Required",
    "Invalid QR / Manual Verification",
    "Other",
  ];

  function suggestedResolutionNote(
    type: string
  ) {
    switch (type) {
      case "Ownership Verified":
        return "Owner presented a valid University ID and proof of ownership. CSU verified the information and cleared the item.";

      case "Returned to Owner":
        return "The item was returned to the registered owner after CSU verified the owner's identity and ownership.";

      case "Authorized by Owner":
        return "The registered owner confirmed that the person carrying the item had permission. CSU verified the identities before clearing the item.";

      case "Item Held by Security":
        return "Ownership could not be verified. The item was held by Security and the person was advised to coordinate with the appropriate university office.";

      case "Registration Required":
        return "The item was not properly registered. CSU advised the owner to complete item registration and secure an approved QR permit before the item can pass through the gate.";

      case "Invalid QR / Manual Verification":
        return "The QR code was invalid or could not be verified. CSU performed manual verification and confirmed the item information before resolving the incident.";

      default:
        return "";
    }
  }

  function openResolveIncident(
    incident: any
  ) {
    setResolutionType("");
    setResolutionDetails("");
    setResolutionError("");
    setResolvingIncident(incident);
  }

  async function handleResolveIncident(
  event: React.FormEvent
) {
  event.preventDefault();

  if (!resolvingIncident) {
    return;
  }

  const type =
    resolutionType.trim();

  const details =
    resolutionDetails.trim();

  if (!type) {
    setResolutionError(
      "Please select a resolution type."
    );
    return;
  }

  if (!details) {
    setResolutionError(
      "Please explain how this security incident was resolved."
    );
    return;
  }

  try {
    setSavingResolution(true);
    setResolutionError("");

    /*
    |--------------------------------------------------------------------------
    | SAVE TO BACKEND
    |--------------------------------------------------------------------------
    */

    await resolveSecurityIncident(
      resolvingIncident.id,
      type,
      details
    );

    /*
    |--------------------------------------------------------------------------
    | UPDATE UI IMMEDIATELY
    |--------------------------------------------------------------------------
    |
    | No loadData() here.
    | React updates this incident locally and it automatically moves
    | from the Flagged table to the Resolved table.
    |
    */

    setIncidents((currentIncidents) =>
      currentIncidents.map(
        (incident) =>
          Number(incident.id) ===
          Number(resolvingIncident.id)
            ? {
                ...incident,

                status:
                  "Resolved",

                resolution_type:
                  type,

                resolution_details:
                  details,

                resolved_at:
                  new Date().toISOString(),
              }
            : incident
      )
    );

    /*
    |--------------------------------------------------------------------------
    | CLOSE RESOLUTION MODAL
    |--------------------------------------------------------------------------
    */

    setResolvingIncident(null);
    setSelectedIncident(null);

    setResolutionType("");
    setResolutionDetails("");
    setResolutionError("");

    alert(
      "Security incident resolved successfully."
    );
  } catch (error) {
    console.error(
      "Failed to resolve incident:",
      error
    );

    setResolutionError(
      error instanceof Error
        ? error.message
        : "Failed to resolve security incident."
    );
  } finally {
    setSavingResolution(false);
  }
}

  /*
  |--------------------------------------------------------------------------
  | DATE HELPERS
  |--------------------------------------------------------------------------
  */

  function isToday(dateString: string) {
    if (!dateString) {
      return false;
    }

    const date = new Date(dateString);
    const today = new Date();

    return (
      date.getFullYear() === today.getFullYear() &&
      date.getMonth() === today.getMonth() &&
      date.getDate() === today.getDate()
    );
  }

  function formatDate(
    dateString?: string | null
  ) {
    if (!dateString) {
      return "—";
    }

    const date = new Date(dateString);

    if (Number.isNaN(date.getTime())) {
      return dateString;
    }

    return date.toLocaleDateString(
      "en-PH",
      {
        month: "short",
        day: "numeric",
        year: "numeric",
      }
    );
  }

  function formatTime(
    dateString?: string | null
  ) {
    if (!dateString) {
      return "—";
    }

    const date = new Date(dateString);

    if (Number.isNaN(date.getTime())) {
      return "—";
    }

    return date.toLocaleTimeString(
      "en-PH",
      {
        hour: "2-digit",
        minute: "2-digit",
      }
    );
  }

  /*
  |--------------------------------------------------------------------------
  | SUMMARY COUNTS
  |--------------------------------------------------------------------------
  */

  const periodLogs = logs.filter((log) =>
    csuMatchesPeriod(log.scanned_at, scanPeriod, scanStartDate, scanEndDate)
  );
  const periodIncidents = incidents.filter((incident) =>
    csuMatchesPeriod(incident.reported_at, scanPeriod, scanStartDate, scanEndDate)
  );

  const verifiedCount = periodLogs.filter((log) =>
    String(log.result ?? "").toLowerCase() === "verified"
  ).length;
  const flaggedCount = periodIncidents.filter((incident) =>
    String(incident.status ?? "").toLowerCase() !== "resolved"
  ).length;
  const uniqueStudents = new Set(periodLogs.map((log) =>
    log.item?.user?.id ?? log.item?.user?.username ?? null
  ).filter(Boolean)).size;
  const scanCount = periodLogs.length;

/*
|--------------------------------------------------------------------------
| FLAGGED / RESOLVED INCIDENT GROUPS
|--------------------------------------------------------------------------
*/

const flaggedIncidents = periodIncidents.filter((incident) =>
  String(incident.status ?? "").toLowerCase() !== "resolved"
);
const resolvedIncidents = periodIncidents.filter((incident) =>
  String(incident.status ?? "").toLowerCase() === "resolved"
);
const entryLogs = periodLogs.filter((log) => String(log.direction ?? "").toUpperCase() === "IN");
const exitLogs = periodLogs.filter((log) => String(log.direction ?? "").toUpperCase() === "OUT");
const visibleLogs = entryExitTab === "entry" ? entryLogs : entryExitTab === "exit" ? exitLogs : periodLogs;
  const csuFilterRow = (row: any) =>
    [row.qr_code, row.scanned_code, row.item_name,
      row.item?.item_name, row.item?.user?.name,
      row.item?.user?.username, row.owner_name,
      row.owner_id_number, row.carrier_name,
      row.gate, row.direction, row.status, row.result]
      .join(" ").toLowerCase()
      .includes(csuListSearch.trim().toLowerCase());

  const csuOrderRows = (arr: any[]) =>
    [...arr].filter(csuFilterRow).sort((a, b) => {
      const x = new Date(a.scanned_at ?? a.reported_at ?? a.created_at ?? 0).getTime() || 0;
      const y = new Date(b.scanned_at ?? b.reported_at ?? b.created_at ?? 0).getTime() || 0;
      return csuListSort === "newest" ? y - x : x - y;
    });

  const shownEntryLogs = csuOrderRows(visibleLogs);
  const shownFlaggedIncidents = csuOrderRows(flaggedIncidents);
  const shownResolvedIncidents = csuOrderRows(resolvedIncidents);


// CSV export follows both the selected period and the selected tab.
const exportLogs = entryExitTab === "flagged" || entryExitTab === "resolved" ? [] : visibleLogs;
const exportIncidents = entryExitTab === "flagged" ? flaggedIncidents : entryExitTab === "resolved" ? resolvedIncidents : [];

/*
|--------------------------------------------------------------------------
| EXPORT CSV
|--------------------------------------------------------------------------
*/

  function exportCSV() {
    if (
      exportLogs.length === 0 &&
      exportIncidents.length === 0
    ) {
      alert(
        "There are no records in the selected tab to export."
      );

      return;
    }

    const headers = [
      "Record Type",
      "Date",
      "Time",
      "Owner",
      "Owner ID",
      "Person Carrying Item",
      "Carrier ID",
      "Item",
      "Serial Number",
      "QR / Scanned Code",
      "Gate",
      "Direction",
      "Result / Status",
      "Incident Type",
      "Scanned / Reported By",
    ];

    const scanRows = exportLogs.map((log) => [
      "Entry/Exit Scan",
      formatDate(log.scanned_at),
      formatTime(log.scanned_at),
      log.item?.user?.name ?? "",
      log.item?.user?.username ?? "",
      log.item?.user?.name ?? "",
      log.item?.user?.username ?? "",
      log.item?.item_name ?? "",
      log.item?.serial_number ?? "",
      log.qr_code ?? "",
      log.gate ?? "",
      log.direction ?? "",
      log.result ?? "Verified",
      "",
      log.scanner?.name ?? "",
    ]);

    const incidentRows = exportIncidents.map(
      (incident) => [
        "Security Incident",
        formatDate(incident.reported_at),
        formatTime(incident.reported_at),

        incident.owner_name ??
          incident.item?.user?.name ??
          "",

        incident.owner_id_number ??
          incident.item?.user?.username ??
          "",

        incident.carrier_name ?? "",
        incident.carrier_id_number ?? "",

        incident.item?.item_name ??
          incident.item_name ??
          "Unknown Item",

        incident.item?.serial_number ??
          incident.serial_number ??
          "",

        incident.scanned_code ?? "",
        incident.gate ?? "",
        incident.direction ?? "",

        String(
          incident.status ?? "Flagged"
        ),

        incident.incident_type ??
          "Security Incident",

        incident.reporter?.name ??
          "Security Personnel",
      ]
    );

    const rows = [
      ...scanRows,
      ...incidentRows,
    ];

    const csvContent = [
      headers,
      ...rows,
    ]
      .map((row) =>
        row
          .map((value) => {
            const cell =
              String(value ?? "").replace(
                /"/g,
                '""'
              );

            return `"${cell}"`;
          })
          .join(",")
      )
      .join("\n");

    const blob = new Blob(
      [csvContent],
      {
        type: "text/csv;charset=utf-8;",
      }
    );

    const url =
      URL.createObjectURL(blob);

    const link =
      document.createElement("a");

    link.href = url;

    link.download =
      `qrpass-${entryExitTab}-records-${new Date()
        .toISOString()
        .slice(0, 10)}.csv`;

    document.body.appendChild(link);

    link.click();

    document.body.removeChild(link);

    URL.revokeObjectURL(url);
  }


  /*
  |--------------------------------------------------------------------------
  | SECURITY INCIDENT TABLE ROWS
  |--------------------------------------------------------------------------
  */

  function renderIncidentRows(
    incidentList: any[],
    resolvedTable = false
  ) {
    if (loading) {
      return (
        <tr>
          <td
            colSpan={10}
            className="py-10 text-center text-sm text-slate-500 dark:text-slate-400"
          >
            Loading security incidents...
          </td>
        </tr>
      );
    }

    if (incidentList.length === 0) {
      return (
        <tr>
          <td
            colSpan={10}
            className="py-10 text-center text-sm text-slate-500 dark:text-slate-400"
          >
            {resolvedTable
              ? "No resolved incidents found."
              : "No flagged incidents found."}
          </td>
        </tr>
      );
    }

    return incidentList.map(
      (incident) => {
        const ownerName =
          incident.owner_name ??
          incident.item?.user?.name ??
          "Unknown Owner";

        const ownerId =
          incident.owner_id_number ??
          incident.item?.user?.username ??
          "—";

        const carrierName =
          incident.carrier_name ??
          "Unknown";

        const carrierId =
          incident.carrier_id_number ??
          "—";

        const itemName =
          incident.item?.item_name ??
          incident.item_name ??
          "Unknown Item";

        const serialNumber =
          incident.item?.serial_number ??
          incident.serial_number ??
          "—";

        return (
          <tr
            key={incident.id}
            className={
              resolvedTable
                ? "border-t border-blue-100 bg-white transition-colors hover:bg-blue-50/70 dark:border-[#29415f] dark:bg-transparent dark:hover:bg-[#142b49]"
                : "border-t border-red-100 bg-white transition-colors hover:bg-red-50/70 dark:border-[#65414e] dark:bg-transparent dark:hover:bg-[#4a202a]"
            }
          >
            {/* DATE / TIME */}
            <td className="px-3 py-3 whitespace-nowrap">
              <div className="text-sm font-medium text-slate-800 dark:text-slate-100">
                {formatDate(
                  incident.reported_at
                )}
              </div>

              <div className="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
                {formatTime(
                  incident.reported_at
                )}
              </div>
            </td>

            {/* CODE */}
            <td className="px-3 py-3">
              <div className="font-mono text-xs text-slate-700 dark:text-slate-200">
                {incident.scanned_code ??
                  "—"}
              </div>

              <div
                className={`mt-1 text-xs font-semibold ${
                  resolvedTable
                    ? "text-blue-600 dark:text-blue-300"
                    : "text-red-600 dark:text-red-300"
                }`}
              >
                {incident.incident_type ??
                  "Security Incident"}
              </div>
            </td>

            {/* ITEM */}
            <td className="px-3 py-3">
              <div className="text-sm font-semibold text-slate-900 dark:text-slate-100">
                {itemName}
              </div>

              <div className="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
                Serial: {serialNumber}
              </div>
            </td>

            {/* OWNER */}
            <td className="px-3 py-3">
              <div className="text-sm font-semibold text-slate-900 dark:text-slate-100">
                {ownerName}
              </div>

              <div className="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
                ID: {ownerId}
              </div>
            </td>

            {/* PERSON CARRYING */}
            <td className="px-3 py-3">
              <div className="text-sm font-semibold text-slate-900 dark:text-slate-100">
                {carrierName}
              </div>

              <div className="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
                ID: {carrierId}
              </div>
            </td>

            {/* DIRECTION */}
            <td className="px-3 py-3">
              {incident.direction ? (
                <QRpassDirectionBadge direction={incident.direction} />
              ) : (
                <span className="text-slate-400 dark:text-slate-500">
                  —
                </span>
              )}
            </td>

            {/* GATE */}
            <td className="px-3 py-3 text-sm text-slate-700 dark:text-slate-200 whitespace-nowrap">
              {incident.gate ?? "—"}
            </td>

            {/* REPORTED BY */}
            <td className="px-3 py-3 text-sm text-slate-700 dark:text-slate-200">
              {incident.reporter?.name ??
                "Security Personnel"}
            </td>

            {/* STATUS */}
            <td className="px-3 py-3">
              {resolvedTable ? (
                <span className="inline-flex rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 dark:border-emerald-400/20 dark:bg-emerald-500/15 dark:text-emerald-300">
                  Resolved
                </span>
              ) : (
                <span className="inline-flex rounded-full border border-red-200 bg-red-50 px-2.5 py-1 text-xs font-semibold text-red-700 dark:border-red-400/20 dark:bg-red-500/15 dark:text-red-300">
                  Flagged
                </span>
              )}
            </td>

            {/* ACTION */}
            <td className="px-3 py-3">
              <div className="flex items-center gap-2">
                <button
                  type="button"
                  onClick={() =>
                    setSelectedIncident(
                      incident
                    )
                  }
                  className="inline-flex h-9 items-center justify-center gap-1.5 whitespace-nowrap rounded-xl border border-border bg-card px-3 text-xs font-semibold text-primary transition-colors hover:bg-muted"
                >
                  <Eye size={13} />
                  View
                </button>

                {!resolvedTable && (
                  <button
                    type="button"
                    onClick={() =>
                      openResolveIncident(
                        incident
                      )
                    }
                    className="h-9 whitespace-nowrap rounded-xl border border-emerald-600 bg-emerald-600 px-3 text-xs font-semibold text-white transition-colors hover:bg-emerald-700"
                  >
                    Resolve
                  </button>
                )}
              </div>
            </td>
          </tr>
        );
      }
    );
  }

  return (
    <div className="w-full min-w-0 space-y-5 sm:space-y-6">
      {/* HEADER */}
      <div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h1 className="text-2xl font-bold text-foreground">
            Entry / Exit Log
          </h1>

          
        </div>

        
      </div>

      {/* SUMMARY */}
      <div className="grid grid-cols-2 gap-3 xl:grid-cols-4">
        <StatCard
          label={`Scans (${csuPeriodName(scanPeriod, scanStartDate, scanEndDate)})`}
          value={String(scanCount)}
          icon={<ScanLine size={20} />}
          color="#1a3a7b"
        />

        <StatCard
          label="Verified"
          value={String(verifiedCount)}
          icon={<CheckCircle size={20} />}
          color="#15803d"
        />

        <StatCard
          label="Flagged"
          value={String(flaggedCount)}
          icon={<AlertTriangle size={20} />}
          color="#d97706"
        />

        <StatCard
          label="Unique Students"
          value={String(uniqueStudents)}
          icon={<Users size={20} />}
          color="#2f5fd6"
        />
      </div>

      
      <CSURecordToolbar
        search={csuListSearch} onSearch={setCsuListSearch}
        sort={csuListSort} onSort={setCsuListSort}
        onRefresh={loadData} loading={loading}
        placeholder="Search QR ID, owner, item, gate..."

        filter={
          <select
            aria-label="Filter Entry / Exit records"
            value={entryExitTab}
            onChange={(e) =>
              setEntryExitTab(
                e.target.value as
                  "all" | "entry" | "exit" | "flagged" | "resolved"
              )
            }
            className="h-12 min-w-[180px] max-w-full rounded-xl border border-[#bfceff] px-3 text-sm text-foreground outline-none focus:border-[#6488ff] dark:border-[#35537e] dark:bg-[#1b2b49] !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
          >
            <option value="all">
              All Records ({periodLogs.length})
            </option>

            <option value="entry">
              Entry ({entryLogs.length})
            </option>

            <option value="exit">
              Exit ({exitLogs.length})
            </option>

            <option value="flagged">
              Flagged ({flaggedIncidents.length})
            </option>

            <option value="resolved">
              Resolved ({resolvedIncidents.length})
            </option>
          </select>
        }
      />


      {/* SUCCESSFUL ENTRY / EXIT */}
      {(entryExitTab === "all" || entryExitTab === "entry" || entryExitTab === "exit") && (
      <div className="w-full min-w-0 overflow-hidden rounded-xl border border-border bg-card shadow-sm">
        <div className="px-5 py-4 border-b border-gray-200">
          <h2 className="text-lg font-bold text-gray-900">
            {entryExitTab === "entry"
              ? "Entry Records"
              : entryExitTab === "exit"
                ? "Exit Records"
                : "Entry / Exit Records"}
          </h2>
        </div>

        <div className="w-full max-w-full overflow-x-auto overscroll-x-contain">
          <table className="w-full min-w-[1050px]">
            <thead className="bg-gray-50">
              <tr>
                {[
                  "Date",
                  "Time",
                  "Owner",
                  "Item",
                  "QR Code",
                  "Gate",
                  "Direction",
                  "Result",
                  "Scanned By",
                ].map((heading) => (
                  <th
                    key={heading}
                    className="py-3 px-3 text-left text-xs font-semibold text-gray-600"
                  >
                    {heading}
                  </th>
                ))}
              </tr>
            </thead>

            <tbody className="divide-y divide-gray-100">
              {loading ? (
                <tr>
                  <td
                    colSpan={9}
                    className="py-10 text-center text-gray-500"
                  >
                    Loading entry / exit records...
                  </td>
                </tr>
              ) : shownEntryLogs.length === 0 ? (
                <tr>
                  <td
                    colSpan={9}
                    className="py-10 text-center text-gray-500"
                  >
                    No entry / exit records found.
                  </td>
                </tr>
              ) : (
                shownEntryLogs.map((log) => (
                  <tr
                    key={log.id}
                    className="hover:bg-gray-50"
                  >
                    <td className="py-3 px-3 text-sm text-gray-700 whitespace-nowrap">
                      {formatDate(
                        log.scanned_at
                      )}
                    </td>

                    <td className="py-3 px-3 text-sm text-gray-700 whitespace-nowrap">
                      {formatTime(
                        log.scanned_at
                      )}
                    </td>

                    <td className="py-3 px-3">
                      <div className="text-sm font-semibold text-gray-900">
                        {log.item?.user?.name ??
                          "Unknown"}
                      </div>

                      <div className="text-xs text-gray-500">
                        {log.item?.user?.username ??
                          ""}
                      </div>
                    </td>

                    <td className="py-3 px-3">
                      <div className="text-sm font-semibold text-gray-900">
                        {log.item?.item_name ??
                          "Unknown Item"}
                      </div>

                      <div className="text-xs text-gray-500">
                        {log.item?.serial_number ??
                          ""}
                      </div>
                    </td>

                    <td className="py-3 px-3 text-sm font-mono text-gray-700">
                      {log.qr_code ??
                        "—"}
                    </td>

                    <td className="py-3 px-3 text-sm text-gray-700">
                      {log.gate ??
                        "—"}
                    </td>

                    <td className="py-3 px-3">
                      <QRpassDirectionBadge direction={log.direction} />
                    </td>

                    <td className="py-3 px-3">
                      <span className="inline-flex px-2.5 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-700">
                        {log.result ??
                          "Verified"}
                      </span>
                    </td>

                    <td className="py-3 px-3 text-sm text-gray-700">
                      {log.scanner?.name ??
                        "—"}
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </div>
      )}

      {/* =========================================================
          FLAGGED ITEMS
      ========================================================= */}

      {entryExitTab === "flagged" && (
      <div className="w-full min-w-0 overflow-hidden rounded-xl border border-red-200 bg-card shadow-sm dark:border-red-700/40">
        <div className="border-b border-red-200 bg-red-50 px-5 py-4 dark:border-[#7c3b49] dark:bg-[#421d25]">
          <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div className="min-w-0">
              <h2 className="text-lg font-bold text-red-800 dark:text-red-200">
                Flagged / Unregistered Items
              </h2>
            </div>

            <span className="rounded-full border border-red-200 bg-red-100 px-3 py-1 text-xs font-bold text-red-700 dark:border-red-400/20 dark:bg-red-500/15 dark:text-red-300">
              {flaggedIncidents.length} Flagged
            </span>
          </div>
        </div>

        <div className="w-full max-w-full overflow-x-auto overscroll-x-contain">
          <table className="w-full min-w-[1450px]">
            <thead className="bg-red-50 dark:bg-[#122642]">
              <tr>
                {[
                  "Date / Time",
                  "Code",
                  "Item",
                  "Owner",
                  "Person Carrying",
                  "Direction",
                  "Gate",
                  "Reported By",
                  "Status",
                  "Action",
                ].map(
                  (heading) => (
                    <th
                      key={heading}
                      className="px-3 py-3 text-left text-xs font-semibold text-red-800 dark:text-blue-100"
                    >
                      {heading}
                    </th>
                  )
                )}
              </tr>
            </thead>

            <tbody>
              {renderIncidentRows(
                shownFlaggedIncidents,
                false
              )}
            </tbody>
          </table>
        </div>
      </div>
      )}

      {/* =========================================================
          RESOLVED ITEMS
      ========================================================= */}

      {entryExitTab === "resolved" && (
      <div className="w-full min-w-0 overflow-hidden rounded-xl border border-blue-200 bg-card shadow-sm dark:border-blue-700/40">
        <div className="border-b border-blue-200 bg-blue-50 px-5 py-4 dark:border-[#28466f] dark:bg-[#10294a]">
          <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div className="min-w-0">
              <h2 className="text-lg font-bold text-blue-900 dark:text-blue-100">
                Resolved Items
              </h2>
            </div>

            <span className="rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700 dark:border-emerald-400/20 dark:bg-emerald-500/15 dark:text-emerald-300">
              {resolvedIncidents.length} Resolved
            </span>
          </div>
        </div>

        <div className="w-full max-w-full overflow-x-auto overscroll-x-contain">
          <table className="w-full min-w-[1450px]">
            <thead className="bg-blue-50 dark:bg-[#132c4c]">
              <tr>
                {[
                  "Date / Time",
                  "Code",
                  "Item",
                  "Owner",
                  "Person Carrying",
                  "Direction",
                  "Gate",
                  "Reported By",
                  "Status",
                  "Action",
                ].map(
                  (heading) => (
                    <th
                      key={heading}
                      className="px-3 py-3 text-left text-xs font-semibold text-blue-900 dark:text-blue-100"
                    >
                      {heading}
                    </th>
                  )
                )}
              </tr>
            </thead>

            <tbody>
              {renderIncidentRows(
                shownResolvedIncidents,
                true
              )}
            </tbody>
          </table>
        </div>
      </div>
      )}

      {/* =========================================================
          INCIDENT / RESOLVED ITEM DETAILS MODAL
      ========================================================= */}

      {selectedIncident && (
        <div className="fixed inset-0 z-[9999] overflow-y-auto bg-black/70 p-4">
          <div className="flex min-h-full items-center justify-center">
            <div className="flex max-h-[calc(100dvh-2rem)] w-full max-w-2xl min-w-0 flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-2xl">

              {/* MODAL HEADER */}
              <div
                className={`flex flex-shrink-0 items-start justify-between gap-4 border-b px-5 py-4 ${
                  String(
                    selectedIncident.status ?? ""
                  ).toLowerCase() === "resolved"
                    ? "border-emerald-200 bg-emerald-50 dark:border-[#285749] dark:bg-[#12382f]"
                    : "border-red-200 bg-red-50 dark:border-[#713744] dark:bg-[#421d25]"
                }`}
              >
                <div className="flex gap-3">
                  <div
                    className={`flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full ${
                      String(
                        selectedIncident.status ?? ""
                      ).toLowerCase() === "resolved"
                        ? "bg-emerald-100 dark:bg-emerald-500/15"
                        : "bg-red-100 dark:bg-red-500/15"
                    }`}
                  >
                    {String(
                      selectedIncident.status ?? ""
                    ).toLowerCase() === "resolved" ? (
                      <CheckCircle
                        size={20}
                        className="text-emerald-700 dark:text-emerald-300"
                      />
                    ) : (
                      <AlertTriangle
                        size={20}
                        className="text-red-700 dark:text-red-300"
                      />
                    )}
                  </div>

                  <div>
                    <h2
                      className={`text-lg font-bold ${
                        String(
                          selectedIncident.status ?? ""
                        ).toLowerCase() === "resolved"
                          ? "text-emerald-800 dark:text-emerald-200"
                          : "text-red-800 dark:text-red-200"
                      }`}
                    >
                      {String(
                        selectedIncident.status ?? ""
                      ).toLowerCase() === "resolved"
                        ? "Resolved Item Details"
                        : "Security Incident Details"}
                    </h2>

                    <p
                      className={`mt-0.5 text-xs ${
                        String(
                          selectedIncident.status ?? ""
                        ).toLowerCase() === "resolved"
                          ? "text-emerald-700 dark:text-emerald-300/80"
                          : "text-red-700 dark:text-red-300/80"
                      }`}
                    >
                      {selectedIncident.incident_type ??
                        "Unregistered Item"}
                    </p>
                  </div>
                </div>

                <button
                  type="button"
                  onClick={() =>
                    setSelectedIncident(null)
                  }
                  className="flex h-8 w-8 items-center justify-center rounded-md text-slate-500 transition-colors hover:bg-black/5 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white"
                >
                  <X size={18} />
                </button>
              </div>


              {/* SCROLLABLE MODAL BODY */}
              <div className="flex-1 space-y-5 overflow-y-auto p-5">

                {/* ITEM INFORMATION */}
                <div>
                  <h3 className="mb-2 text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-blue-200">
                    Item Information
                  </h3>

                  <div className="grid gap-3 md:grid-cols-2">
                    <div className="rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-[#29415f] dark:bg-[#13243c]">
                      <p className="text-xs text-slate-500 dark:text-slate-400">
                        Item Name
                      </p>

                      <p className="mt-1 text-sm font-semibold text-slate-900 dark:text-slate-100">
                        {selectedIncident.item?.item_name ??
                          selectedIncident.item_name ??
                          "Unknown Item"}
                      </p>
                    </div>

                    <div className="rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-[#29415f] dark:bg-[#13243c]">
                      <p className="text-xs text-slate-500 dark:text-slate-400">
                        Serial Number
                      </p>

                      <p className="mt-1 text-sm font-mono font-semibold text-slate-900 dark:text-slate-100">
                        {selectedIncident.item?.serial_number ??
                          selectedIncident.serial_number ??
                          "—"}
                      </p>
                    </div>

                    <div className="rounded-lg border border-slate-200 bg-slate-50 p-3 md:col-span-2 dark:border-[#29415f] dark:bg-[#13243c]">
                      <p className="text-xs text-slate-500 dark:text-slate-400">
                        Scanned Code
                      </p>

                      <p className="mt-1 text-sm font-mono font-semibold text-blue-700 dark:text-blue-200">
                        {selectedIncident.scanned_code ??
                          "—"}
                      </p>
                    </div>
                  </div>
                </div>


                {/* REGISTERED / CLAIMED OWNER */}
                <div>
                  <h3 className="mb-2 text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-blue-200">
                    Registered / Claimed Owner
                  </h3>

                  <div className="grid gap-3 md:grid-cols-2">
                    <div className="rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-[#29415f] dark:bg-[#13243c]">
                      <p className="text-xs text-slate-500 dark:text-slate-400">
                        Owner Name
                      </p>

                      <p className="mt-1 text-sm font-semibold text-slate-900 dark:text-slate-100">
                        {selectedIncident.owner_name ??
                          selectedIncident.item?.user?.name ??
                          "Unknown Owner"}
                      </p>
                    </div>

                    <div className="rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-[#29415f] dark:bg-[#13243c]">
                      <p className="text-xs text-slate-500 dark:text-slate-400">
                        Owner ID Number
                      </p>

                      <p className="mt-1 text-sm font-mono font-semibold text-slate-900 dark:text-slate-100">
                        {selectedIncident.owner_id_number ??
                          selectedIncident.item?.user?.username ??
                          "—"}
                      </p>
                    </div>
                  </div>
                </div>


                {/* PERSON CARRYING ITEM */}
                <div>
                  <h3 className="mb-2 text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-blue-200">
                    Person Carrying Item
                  </h3>

                  <div className="grid gap-3 md:grid-cols-2">
                    <div className="rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-[#29415f] dark:bg-[#13243c]">
                      <p className="text-xs text-slate-500 dark:text-slate-400">
                        Name
                      </p>

                      <p className="mt-1 text-sm font-semibold text-slate-900 dark:text-slate-100">
                        {selectedIncident.carrier_name ??
                          "Unknown"}
                      </p>
                    </div>

                    <div className="rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-[#29415f] dark:bg-[#13243c]">
                      <p className="text-xs text-slate-500 dark:text-slate-400">
                        Student / Employee ID
                      </p>

                      <p className="mt-1 text-sm font-mono font-semibold text-slate-900 dark:text-slate-100">
                        {selectedIncident.carrier_id_number ??
                          "—"}
                      </p>
                    </div>
                  </div>
                </div>


                {/* INCIDENT INFORMATION */}
                <div>
                  <h3 className="mb-2 text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-blue-200">
                    Incident Information
                  </h3>

                  <div className="grid gap-3 md:grid-cols-2">
                    <div className="rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-[#29415f] dark:bg-[#13243c]">
                      <p className="text-xs text-slate-500 dark:text-slate-400">
                        Direction
                      </p>

                      <div className="mt-1"><QRpassDirectionBadge direction={selectedIncident.direction} /></div>
                    </div>

                    <div className="rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-[#29415f] dark:bg-[#13243c]">
                      <p className="text-xs text-slate-500 dark:text-slate-400">
                        Gate
                      </p>

                      <p className="mt-1 text-sm font-semibold text-slate-900 dark:text-slate-100">
                        {selectedIncident.gate ??
                          "—"}
                      </p>
                    </div>

                    <div className="rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-[#29415f] dark:bg-[#13243c]">
                      <p className="text-xs text-slate-500 dark:text-slate-400">
                        Reported By
                      </p>

                      <p className="mt-1 text-sm font-semibold text-slate-900 dark:text-slate-100">
                        {selectedIncident.reporter?.name ??
                          "Security Personnel"}
                      </p>
                    </div>

                    <div className="rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-[#29415f] dark:bg-[#13243c]">
                      <p className="text-xs text-slate-500 dark:text-slate-400">
                        Date & Time
                      </p>

                      <p className="mt-1 text-sm font-semibold text-slate-900 dark:text-slate-100">
                        {formatDate(
                          selectedIncident.reported_at
                        )}{" "}
                        {formatTime(
                          selectedIncident.reported_at
                        )}
                      </p>
                    </div>
                  </div>
                </div>


                {/* DESCRIPTION */}
                <div>
                  <h3 className="mb-2 text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-blue-200">
                    Description
                  </h3>

                  <div className="rounded-lg border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700 dark:border-[#29415f] dark:bg-[#13243c] dark:text-slate-200">
                    {selectedIncident.description ||
                      "No additional description provided."}
                  </div>
                </div>


                {/* RESOLUTION INFORMATION */}
                {String(
                  selectedIncident.status ?? ""
                ).toLowerCase() === "resolved" && (
                  <div>
                    <h3 className="mb-2 text-xs font-bold uppercase tracking-wide text-emerald-700 dark:text-emerald-300">
                      Resolution Information
                    </h3>

                    <div className="rounded-xl border border-emerald-200 bg-emerald-50 p-4 dark:border-emerald-400/30 dark:bg-emerald-950/30">
                      <div className="grid gap-3 md:grid-cols-2">
                        <div className="rounded-lg border border-emerald-200 bg-white p-3 dark:border-emerald-400/20 dark:bg-[#132b2b]">
                          <p className="text-xs text-slate-500 dark:text-emerald-200/70">
                            Resolution Type
                          </p>

                          <p className="mt-1 text-sm font-semibold text-emerald-800 dark:text-emerald-200">
                            {selectedIncident.resolution_type ||
                              "Not recorded"}
                          </p>
                        </div>

                        <div className="rounded-lg border border-emerald-200 bg-white p-3 dark:border-emerald-400/20 dark:bg-[#132b2b]">
                          <p className="text-xs text-slate-500 dark:text-emerald-200/70">
                            Resolution Status
                          </p>

                          <p className="mt-1 text-sm font-semibold text-emerald-700 dark:text-emerald-300">
                            Resolved
                          </p>
                        </div>
                      </div>

                      <div className="mt-4">
                        <p className="text-xs font-semibold text-emerald-700 dark:text-emerald-300">
                          How the incident was resolved
                        </p>

                        <p className="mt-2 whitespace-pre-wrap rounded-lg border border-emerald-200 bg-white p-3 text-sm leading-relaxed text-emerald-900 dark:border-emerald-400/20 dark:bg-[#132b2b] dark:text-emerald-100">
                          {selectedIncident.resolution_details ||
                            "No resolution details were recorded for this older incident."}
                        </p>
                      </div>

                      <div className="mt-4 grid gap-3 md:grid-cols-2">
                        <div className="rounded-lg border border-emerald-200 bg-white p-3 dark:border-emerald-400/20 dark:bg-[#132b2b]">
                          <p className="text-xs text-slate-500 dark:text-emerald-200/70">
                            Resolved By
                          </p>

                          <p className="mt-1 text-sm font-semibold text-slate-800 dark:text-emerald-100">
                            {selectedIncident.resolver?.name ??
                              "Security Personnel"}
                          </p>
                        </div>

                        <div className="rounded-lg border border-emerald-200 bg-white p-3 dark:border-emerald-400/20 dark:bg-[#132b2b]">
                          <p className="text-xs text-slate-500 dark:text-emerald-200/70">
                            Date & Time Resolved
                          </p>

                          <p className="mt-1 text-sm font-semibold text-slate-800 dark:text-emerald-100">
                            {selectedIncident.resolved_at ? (
                              <>
                                {formatDate(
                                  selectedIncident.resolved_at
                                )}{" "}
                                {formatTime(
                                  selectedIncident.resolved_at
                                )}
                              </>
                            ) : (
                              "Not recorded"
                            )}
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                )}
              </div>


              {/* MODAL FOOTER */}
              <div className="flex flex-shrink-0 items-center justify-between gap-3 border-t border-slate-200 bg-slate-50 px-5 py-4 dark:border-[#29415f] dark:bg-[#13243c]">
                <div>
                  {String(
                    selectedIncident.status ?? ""
                  ).toLowerCase() === "resolved" ? (
                    <span className="inline-flex rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700 dark:border-emerald-400/20 dark:bg-emerald-500/15 dark:text-emerald-300">
                      Resolved
                    </span>
                  ) : (
                    <span className="inline-flex rounded-full border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 dark:border-red-400/20 dark:bg-red-500/15 dark:text-red-300">
                      Flagged
                    </span>
                  )}
                </div>

                <div className="flex gap-2">
                  <button
                    type="button"
                    onClick={() =>
                      setSelectedIncident(null)
                    }
                    className="rounded-md border border-slate-300 bg-white px-4 py-2 text-xs font-semibold text-slate-700 transition-colors hover:bg-slate-100 dark:border-[#35506f] dark:bg-[#172a45] dark:text-slate-200 dark:hover:bg-[#1d3556]"
           data-qrpass-neutral-v169="true">
                    Close
                  </button>

                  {String(
                    selectedIncident.status ?? ""
                  ).toLowerCase() === "flagged" && (
                    <button
                      type="button"
                      onClick={() =>
                        openResolveIncident(
                          selectedIncident
                        )
                      }
                      className="rounded-md bg-emerald-600 px-4 py-2 text-xs font-semibold text-white transition-colors hover:bg-emerald-700 dark:hover:bg-emerald-500"
                    >
                      Resolve Incident
                    </button>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* RESOLVE INCIDENT MODAL */}
      {resolvingIncident && (
        <div
          className="fixed inset-0 z-[10000] flex items-start justify-center overflow-y-auto bg-black/55 p-3 sm:items-center sm:p-4"
          onClick={() => {
            if (!savingResolution) {
              setResolvingIncident(null);
              setResolutionType("");
              setResolutionError("");
              setResolutionDetails("");
            }
          }}
        >
          <form
            onSubmit={handleResolveIncident}
            onClick={(event) =>
              event.stopPropagation()
            }
            className="my-auto flex max-h-[calc(100dvh-1.5rem)] w-full max-w-lg flex-col overflow-y-auto rounded-2xl bg-card shadow-2xl sm:max-h-[calc(100dvh-2rem)]"
          >
            <div className="flex items-start justify-between gap-4 border-b border-green-200 bg-green-50 px-5 py-4">
              <div className="flex gap-3">
                <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-green-100">
                  <CheckCircle
                    size={20}
                    className="text-green-700"
                  />
                </div>

                <div>
                  <h2 className="text-lg font-bold text-green-800">
                    Resolve Security Incident
                  </h2>

                  <p className="mt-0.5 text-xs text-green-700">
                    Record how this flagged item was resolved before closing the incident.
                  </p>
                </div>
              </div>

              <button
                type="button"
                disabled={savingResolution}
                onClick={() => {
                  setResolvingIncident(null);
                  setResolutionError("");
                  setResolutionDetails("");
                }}
                className="flex h-8 w-8 items-center justify-center rounded-md text-gray-500 hover:bg-green-100 disabled:opacity-50"
              >
                <X size={18} />
              </button>
            </div>

            <div className="space-y-4 p-5">
              <div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <div className="rounded-lg border border-gray-200 p-3">
                  <p className="text-xs text-gray-500">
                    Item
                  </p>

                  <p className="mt-1 text-sm font-semibold">
                    {resolvingIncident.item?.item_name ??
                      resolvingIncident.item_name ??
                      "Unknown Item"}
                  </p>
                </div>

                <div className="rounded-lg border border-gray-200 p-3">
                  <p className="text-xs text-gray-500">
                    Code
                  </p>

                  <p className="mt-1 font-mono text-sm font-semibold">
                    {resolvingIncident.scanned_code ??
                      "—"}
                  </p>
                </div>

                <div className="rounded-lg border border-gray-200 p-3">
                  <p className="text-xs text-gray-500">
                    Owner
                  </p>

                  <p className="mt-1 text-sm font-semibold">
                    {resolvingIncident.owner_name ??
                      resolvingIncident.item?.user?.name ??
                      "Unknown Owner"}
                  </p>
                </div>

                <div className="rounded-lg border border-gray-200 p-3">
                  <p className="text-xs text-gray-500">
                    Person Carrying
                  </p>

                  <p className="mt-1 text-sm font-semibold">
                    {resolvingIncident.carrier_name ??
                      "Unknown"}
                  </p>
                </div>
              </div>

              <div>
                <label className="mb-1 block text-xs font-semibold text-foreground">
                  Resolution Type *
                </label>

                <select
                  value={resolutionType}
                  onChange={(event) => {
                    const nextType =
                      event.target.value;

                    setResolutionType(
                      nextType
                    );

                    setResolutionDetails(
                      suggestedResolutionNote(
                        nextType
                      )
                    );

                    if (resolutionError) {
                      setResolutionError("");
                    }
                  }}
                  className={`w-full rounded-lg border bg-background px-3 py-2 text-sm outline-none focus:ring-2 ${
                    resolutionError &&
                    !resolutionType
                      ? "border-red-300 focus:ring-red-200"
                      : "border-[#cfd8e6] focus:ring-primary/20"
                  }`}
                >
                  <option value="">
                    Select resolution type
                  </option>

                  {resolutionTypeOptions.map(
                    (option) => (
                      <option
                        key={option}
                        value={option}
                      >
                        {option}
                      </option>
                    )
                  )}
                </select>

                <p className="mt-1 text-[11px] text-muted-foreground">
                  Selecting a type will suggest a resolution note that CSU can still edit.
                </p>
              </div>

              <div>
                <label className="mb-1 block text-xs font-semibold text-foreground">
                  Additional Resolution Details *
                </label>

                <textarea
                  value={resolutionDetails}
                  onChange={(event) => {
                    setResolutionDetails(
                      event.target.value
                    );

                    if (resolutionError) {
                      setResolutionError("");
                    }
                  }}
                  rows={5}
                  maxLength={2000}
                  placeholder="Explain what CSU verified, what action was taken, and why the incident can now be closed."
                  className={`w-full resize-none rounded-lg border bg-background px-3 py-2 text-sm outline-none focus:ring-2 ${
                    resolutionError
                      ? "border-red-300 focus:ring-red-200"
                      : "border-[#cfd8e6] focus:ring-primary/20"
                  }`}
                  autoFocus
                />

                <div className="mt-1 flex items-center justify-between gap-3">
                  <p className="text-[11px] text-muted-foreground">
                    This note will be stored permanently with the incident.
                  </p>

                  <p className="text-[11px] text-muted-foreground">
                    {resolutionDetails.length}/2000
                  </p>
                </div>
              </div>

              {resolutionError && (
                <div className="rounded-lg border border-red-200 bg-red-50 px-4 py-3">
                  <div className="flex items-start gap-2">
                    <AlertCircle
                      size={16}
                      className="mt-0.5 shrink-0 text-red-600"
                    />

                    <p className="text-xs font-medium text-red-700">
                      {resolutionError}
                    </p>
                  </div>
                </div>
              )}
            </div>

            <div className="flex flex-wrap justify-end gap-2 border-t border-border bg-muted/30 px-4 py-4 sm:px-5">
              <button
                type="button"
                disabled={savingResolution}
                onClick={() => {
                  setResolvingIncident(null);
                  setResolutionError("");
                  setResolutionDetails("");
                }}
                className="rounded-md border border-gray-300 bg-white px-4 py-2 text-xs font-semibold text-gray-700 disabled:opacity-50 !bg-white !text-[#17336d] !border-[#cbd5e1] transition-colors hover:!bg-[#eef2ff] hover:!border-[#a8bde4] hover:!text-[#17336d] focus-visible:!ring-0 focus-visible:!shadow-none focus-visible:!outline-none"
               
            onMouseEnter={(e) => {
              const el=e.currentTarget;
              if(!el.dataset.qrpassV158Saved) {
                el.dataset.qrpassV158Saved=el.style.cssText || " ";
              }
              el.style.setProperty("background", "#eef2ff", "important");
              el.style.setProperty("background-color", "#eef2ff", "important");
              el.style.setProperty("background-image", "none", "important");
              el.style.setProperty("color", "#17336d", "important");
              el.style.setProperty("border-color", "#a8bde4", "important");
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onMouseLeave={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onFocus={(e) => {
              e.currentTarget.style.setProperty("box-shadow", "none", "important");
              e.currentTarget.style.setProperty("outline", "none", "important");
            }}
            onBlur={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}

           data-qrpass-neutral-v169="true">
                Cancel
              </button>

              <button
                type="submit"
                disabled={savingResolution}
                className="inline-flex items-center gap-1.5 rounded-md bg-green-600 px-4 py-2 text-xs font-semibold text-white hover:bg-green-700 disabled:opacity-50"
              >
                <CheckCircle size={14} />

                {savingResolution
                  ? "Saving..."
                  : "Confirm Resolution"}
              </button>
            </div>
          </form>
        </div>
      )}
    </div>
  );
}

function QRpassReportDownloadButtons({
  onPdf,
  onExcel,
  disabled = false,
}: {
  onPdf: () => void;
  onExcel: () => void;
  disabled?: boolean;
}) {
  return (
    <div className="flex w-full shrink-0 items-center gap-2 border-t border-border pt-3 sm:w-auto sm:border-l sm:border-t-0 sm:pl-4 sm:pt-0">
      <button
        type="button"
        onClick={onPdf}
        disabled={disabled}
        className="inline-flex h-9 min-w-0 flex-1 items-center justify-center gap-2 rounded-xl border border-border bg-card px-3 text-xs font-semibold text-primary transition-colors hover:bg-muted disabled:cursor-not-allowed disabled:opacity-50 sm:w-[104px] sm:flex-none"
      >
        <Download size={13} />
        PDF
      </button>

      <button
        type="button"
        onClick={onExcel}
        disabled={disabled}
        className="inline-flex h-9 min-w-0 flex-1 items-center justify-center gap-2 rounded-xl border border-border bg-card px-3 text-xs font-semibold text-primary transition-colors hover:bg-muted disabled:cursor-not-allowed disabled:opacity-50 sm:w-[104px] sm:flex-none"
      >
        <Download size={13} />
        Excel
      </button>
    </div>
  );
}

function QRpassWriteReport(
  name: string,
  rows: Array<Record<string, unknown>>,
  format: "PDF" | "Excel",
  period: string
) {
  if (!rows.length) {
    alert("No records available for this report.");
    return;
  }

  const columns = Object.keys(rows[0]);
  const date = new Date().toISOString().slice(0, 10);
  const slug = name.replace(/[^a-z0-9]+/gi, "-");
  const filename = `QRpass-${slug}-${date}`;

  if (format === "PDF") {
    const doc = new jsPDF({ orientation: "landscape" });

    doc.setFontSize(16);
    doc.setTextColor(23, 51, 109);
    doc.text(`QRpass - ${name}`, 14, 18);

    doc.setFontSize(10);
    doc.setTextColor(80, 95, 115);
    doc.text(`Period: ${period}`, 14, 27);
    doc.text(`Total Records: ${rows.length}`, 14, 33);

    autoTable(doc, {
      startY: 40,
      head: [columns],
      body: rows.map(row =>
        columns.map(key => String(row[key] ?? "—"))
      ),
      styles: { fontSize: 7, cellPadding: 2 },
      headStyles: {
        fillColor: [26, 58, 123],
        textColor: [255, 255, 255],
      },
      alternateRowStyles: {
        fillColor: [245, 247, 250],
      },
    });

    doc.save(`${filename}.pdf`);
    return;
  }

  const safeRows = rows.map(row =>
    Object.fromEntries(
      Object.entries(row).map(([key, value]) => {
        const text = String(value ?? "—");
        return [
          key,
          /^[=+\-@]/.test(text) ? "'" + text : text,
        ];
      })
    )
  );

  const workbook = XLSX.utils.book_new();
  const sheet = XLSX.utils.json_to_sheet(safeRows);

  sheet["!cols"] = columns.map(() => ({ wch: 24 }));

  XLSX.utils.book_append_sheet(
    workbook,
    sheet,
    "Report"
  );

  XLSX.writeFile(workbook, `${filename}.xlsx`);
}
/* QRPass CSU reports v149: page-scoped real PDF and Excel exports */
function SecurityReports() {
  type CSUReportKindV149 = "registration" | "scans" | "entryexit" | "incidents";
  const reportOptionsV149: { key: CSUReportKindV149; label: string }[] = [
    {key: "registration", label: "Registered Items Report"},
    {key: "scans", label: "QR Scan Activity Report"},
    {key: "entryexit", label: "Entry & Exit Transactions Report"},
    {key: "incidents", label: "Security Incidents Report"},
  ];
  const [reportTypeV149, setReportTypeV149] = useState<CSUReportKindV149>("registration");
  const [periodV149, setPeriodV149] = useState<CSUDatePeriod>("today");
  const [busyV149, setBusyV149] = useState(false);
  const [messageV149, setMessageV149] = useState("");
  const [errorV149, setErrorV149] = useState(false);
  const styleButtonV149 = (element: HTMLButtonElement | null, color: string) => {
    if (element) {
      element.style.setProperty("background-color", color, "important");
      element.style.setProperty("background", color, "important");
    }
  };
  async function generateV149(format: "pdf" | "xlsx") {
    if (busyV149) return;
    setBusyV149(true); setMessageV149(""); setErrorV149(false);
    try {
      const response = await getSecurityReports();
      let list: any[];
      let columns: string[];
      let rows: string[][];
      let dateOf: (record: any) => string | null | undefined;
      if (reportTypeV149 === "registration") {
        if (!Array.isArray(response?.registered_items)) {
          throw new Error("CSU registered-item records are not available from the backend.");
        }
        list = response.registered_items;
        dateOf = item => item.created_at ?? item.registered_at;
        columns = ["Date", "Item", "Category", "Owner", "Owner ID", "Brand / Model", "Serial Number", "QR ID", "Status"];
        rows = list.filter(item => csuMatchesPeriod(dateOf(item), periodV149)).map(item => [
          String(dateOf(item) ?? ""), String(item.item_name ?? ""), String(item.item_type ?? ""),
          String(item.user?.name ?? ""), String(item.user?.username ?? ""),
          String(item.brand_model ?? ""), String(item.serial_number ?? ""),
          String(item.qr_code ?? ""), String(item.status ?? "")
        ]);
      } else if (reportTypeV149 === "scans" || reportTypeV149 === "entryexit") {
        if (!Array.isArray(response?.logs)) {
          throw new Error("CSU scan logs are not available from the backend.");
        }
        list = response.logs;
        dateOf = row => row.scanned_at ?? row.created_at;
        columns = ["Date", "QR ID", "Item", "Owner", "Gate", "Direction", "Result", "Scanned By"];
        rows = list.filter(row => csuMatchesPeriod(dateOf(row), periodV149) &&
          (reportTypeV149 !== "entryexit" || ["IN","OUT"].includes(String(row.direction ?? "").toUpperCase()))
        ).map(row => [
          String(dateOf(row) ?? ""), String(row.qr_code ?? ""),
          String(row.item?.item_name ?? row.item_name ?? ""),
          String(row.item?.user?.name ?? ""), String(row.gate ?? ""),
          String(row.direction ?? ""), String(row.result ?? ""),
          String(row.scanner?.name ?? "")
        ]);
      } else {
        if (!Array.isArray(response?.incidents)) {
          throw new Error("CSU security incidents are not available from the backend.");
        }
        list = response.incidents;
        dateOf = row => row.reported_at ?? row.created_at;
        columns = ["Date", "Incident", "Item", "QR Code", "Location", "Description", "Status"];
        rows = list.filter(row => csuMatchesPeriod(dateOf(row), periodV149)).map(row => [
          String(dateOf(row) ?? ""), String(row.incident_type ?? ""),
          String(row.item_name ?? ""), String(row.scanned_code ?? ""),
          String(row.gate ?? row.location ?? ""),
          String(row.description ?? row.reason ?? ""), String(row.status ?? "")
        ]);
      }
      if (rows.length === 0) {
        setMessageV149("No records found for the selected report and date.");
        return;
      }
      const reportTitle = reportOptionsV149.find(item => item.key === reportTypeV149)?.label ?? "CSU Report";
      const filename = `QRPass-CSU-${reportTypeV149}-${periodV149}-${new Date().toISOString().slice(0,10)}`;
      if (format === "pdf") {
        const pdf = new jsPDF({orientation: "landscape"});
        pdf.setFontSize(16);
        pdf.text(reportTitle, 14, 18);
        pdf.setFontSize(9);
        pdf.text("University of Cebu - Main Campus", 14, 26);
        pdf.text(`Period: ${csuPeriodName(periodV149)}     Records: ${rows.length}`, 14, 32);
        autoTable(pdf, {
          startY: 39, head: [columns], body: rows,
          styles: {fontSize: 7, cellPadding: 2},
          headStyles: {fillColor: [26,58,123], textColor: [255,255,255]}
        });
        pdf.save(`${filename}.pdf`);
      } else {
        const safeRows = rows.map(row => row.map(cell => /^[\s]*[=+\-@]/.test(cell) ? "'" + cell : cell));
        const workbook = XLSX.utils.book_new();
        const worksheet = XLSX.utils.aoa_to_sheet([columns,...safeRows]);
        worksheet["!cols"] = columns.map(()=>({wch:24}));
        XLSX.utils.book_append_sheet(workbook,worksheet,"CSU Report");
        XLSX.writeFile(workbook,`${filename}.xlsx`);
      }
      setMessageV149(`${reportTitle}: ${rows.length} record(s) exported.`);
    } catch (error) {
      setErrorV149(true);
      setMessageV149(error instanceof Error ? error.message : "Report generation failed.");
    } finally {
      setBusyV149(false);
    }
  }
  return (
    <div className="space-y-4">
      <PageHeader title="Downloadable Reports" subtitle="Generate CSU reports using authorized records."/>
      <div className="overflow-hidden rounded-2xl border border-[#dce3ee] bg-white shadow-sm">
        <div className="border-b border-[#e6ebf2] px-5 py-4 sm:px-6">
          <h3 className="text-lg font-semibold text-[#17336d]">Generate a report</h3>
        </div>
        <div className="grid gap-5 px-5 py-5 sm:px-6 lg:grid-cols-2">
          <div>
            <label className="mb-2 block text-sm font-semibold text-[#17336d]">Report Type</label>
            <select aria-label="CSU report type" value={reportTypeV149}
              onChange={event => {setReportTypeV149(event.target.value as CSUReportKindV149);setMessageV149("");}}
              className="h-12 w-full rounded-xl border border-[#cbd5e1] !bg-white px-4 text-sm text-[#17336d] outline-none transition-colors hover:!bg-[#eef2ff] focus:!bg-white">
              {reportOptionsV149.map(option => <option key={option.key} value={option.key}>{option.label}</option>)}
            </select>
          </div>
          <div>
            <label className="mb-2 block text-sm font-semibold text-[#17336d]">Filter by Date</label>
            <select aria-label="CSU report date" value={periodV149}
              onChange={event => {setPeriodV149(event.target.value as CSUDatePeriod);setMessageV149("");}}
              className="h-12 w-full rounded-xl border border-[#cbd5e1] !bg-white px-4 text-sm text-[#17336d] outline-none transition-colors hover:!bg-[#eef2ff] focus:!bg-white">
              <option value="today">Today</option>
              <option value="week">This Week</option>
              <option value="month">This Month</option>
            </select>
          </div>
        </div>
        <div className="flex flex-wrap justify-end gap-2 px-5 pb-4 sm:px-6">
          {([
            {format: "pdf", name: "Download PDF"},
            {format: "xlsx", name: "Download Excel"}
          ] as const).map(({format,name}) => (
            <button key={format} type="button" disabled={busyV149}
              onClick={() => void generateV149(format)}
              className="qrpass-report-download-registration-v71">
              <Download size={15} />{busyV149 ? "Generating..." : name}
            </button>
          ))}
        </div>
        {messageV149 && <div className="border-t border-[#e6ebf2] px-5 py-3 sm:px-6"><p role={errorV149?"alert":"status"} className={`text-sm ${errorV149?"text-red-700":"text-[#17336d]"}`}>{messageV149}</p></div>}
      </div>
    </div>
  );
}

// Campus location picker shared by CSU Lost, Found, Edit, and Recovery forms.
// Values remain strings to match existing Laravel location_found/location_lost fields.
const QR_CAMPUS_FLOORS: Record<string, string[]> = {
  "Engineering Building": ["Main Ground", ...Array.from({length: 12}, (_, i) => `${i+1}${i===0?'st':i===1?'nd':i===2?'rd':'th'} Floor`)],
  "Main Building": Array.from({length: 7}, (_, i) => `${i+1}${i===0?'st':i===1?'nd':i===2?'rd':'th'} Floor`),
  "High School Building": Array.from({length: 7}, (_, i) => `${i+1}${i===0?'st':i===1?'nd':i===2?'rd':'th'} Floor`),
};

function isCompleteCSULocation(value: string) {
  const location = value.trim();
  if (!location) return false;
  if (location.startsWith("Other Campus Area - ")) {
    return location.substring("Other Campus Area - ".length).trim().length > 0;
  }
  return Object.entries(QR_CAMPUS_FLOORS).some(([building, floors]) =>
    floors.some(floor => location === `${building} - ${floor}`)
  );
}

function CSULocationPicker({
  label,
  value,
  onChange,
  required = true,
}: {
  label: string;
  value: string;
  onChange: (value: string) => void;
  required?: boolean;
}) {
  const knownBuilding = Object.keys(QR_CAMPUS_FLOORS).find(b => value.startsWith(`${b} - `));
  const building = knownBuilding ?? (value ? "Other Campus Area" : "");
  const floor = knownBuilding ? value.slice(`${knownBuilding} - `.length) : "";
  const custom = building === "Other Campus Area"
    ? value.startsWith("Other Campus Area - ")
      ? value.slice("Other Campus Area - ".length)
      : value
    : "";
  const inputStyle = "w-full min-w-0 rounded-lg border border-[#cfd8e6] bg-background px-3 py-2.5 text-sm outline-none focus:ring-2 focus:ring-primary/20";

  return (
    <div className="min-w-0 space-y-2">
      <label className="block text-xs font-medium text-foreground">{label}{required ? " *" : ""}</label>
      <div className="grid grid-cols-1 gap-2 xl:grid-cols-2">
        <select
          aria-label={`${label} building`}
          value={building}
          onChange={e => onChange(e.target.value === "Other Campus Area"
            ? "Other Campus Area - "
            : e.target.value ? `${e.target.value} - ` : "")}
          className={inputStyle}
          required={required}
        >
          <option value="" disabled hidden>Choose building</option>
          {Object.keys(QR_CAMPUS_FLOORS).map(b => <option value={b} key={b}>{b}</option>)}
          <option value="Other Campus Area">Other Campus Area</option>
        </select>
        {building && building !== "Other Campus Area" ? (
          <select
            aria-label={`${label} floor`}
            value={floor}
            onChange={e => onChange(`${building} - ${e.target.value}`)}
            className={inputStyle}
            required={required}
          >
            <option value="" disabled hidden>Choose floor</option>
            {QR_CAMPUS_FLOORS[building].map(f => <option value={f} key={f}>{f}</option>)}
          </select>
        ) : building === "Other Campus Area" ? (
          <input
            aria-label={`${label} other campus area`}
            value={custom}
            onChange={e => onChange(`Other Campus Area - ${e.target.value}`)}
            className={inputStyle}
            placeholder="e.g. Security Office / Library / Gym"
            maxLength={235}
            required={required}
          />
        ) : (
          <div className="flex items-center rounded-lg border border-dashed border-[#cfd8e6] bg-muted/20 px-3 py-2 text-xs text-muted-foreground">Choose a building to see its floors.</div>
        )}
      </div>
      {isCompleteCSULocation(value) && (
        <p className="text-[11px] text-muted-foreground">Selected: {value}</p>
      )}
    </div>
  );
}

/* QRPASS_CSU_LOSTFOUND_WHITE_TABS_V154 */

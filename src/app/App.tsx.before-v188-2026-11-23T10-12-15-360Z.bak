          </div>
        </div>
      )}

      {recoveringItem && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4">
          <div className="max-h-[calc(100dvh-2rem)] w-full max-w-lg overflow-y-auto rounded-xl border border-border bg-card shadow-xl">
            <div className="border-b border-[#cfd8e6] px-5 py-4">
              <h3 className="font-semibold text-foreground">
                Record Lost Item Recovery
              </h3>
              <p className="mt-1 text-xs text-muted-foreground">
                Record who found or returned the item, where it was turned over, and the exact date and time before marking it recovered.
              </p>
            </div>

            <form
              onSubmit={handleLostRecoverySubmit}
              className="space-y-4 p-5"
            >
              <div className="rounded-lg border border-red-200 bg-red-50 px-4 py-3">
                <p className="text-xs font-medium text-red-800">
                  Lost Item / Owner
                </p>
                <p className="mt-1 text-sm font-semibold text-red-900">
                  {recoveringItem.item_name}
                </p>
                <p className="text-xs text-red-700 dark:text-red-300">
                  Owner: {recoveringItem.lost_by?.name || "Not available"}
                  {recoveringItem.lost_by?.username
                    ? ` (${recoveringItem.lost_by.username})`
                    : ""}
                </p>
              </div>

              <div>
                <label className="mb-1 block text-xs font-medium text-foreground">
                  Found / Turned Over By Student or Employee ID *
                </label>
                <input
                  type="text"
                  value={recoveryForm.found_by_identifier}
                  onChange={(e) =>
                    setRecoveryForm((current) => ({
                      ...current,
                      found_by_identifier: e.target.value,
                    }))
                  }
                  placeholder="Example: 26-9999"
                  required
                  className="w-full rounded-lg border border-[#cfd8e6] px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-primary/20 !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
                />
              </div>

              <div>
                <CSULocationPicker
                  label="Location Found / Turned Over"
                  value={recoveryForm.location_found}
                  onChange={value => setRecoveryForm(current => ({...current, location_found: value}))}
                />
              </div>

              <div>
                <label className="mb-1 block text-xs font-medium text-foreground">
                  Date & Time Found / Turned Over *
                </label>
                <input
                  type="datetime-local"
                  value={recoveryForm.date_found}
                  onChange={(e) =>
                    setRecoveryForm((current) => ({
                      ...current,
                      date_found: e.target.value,
                    }))
                  }
                  required
                  className="w-full rounded-lg border border-[#cfd8e6] px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-primary/20 !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
                />
              </div>

              <div className="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
                <button
                  type="button"
                  onClick={() => {
                    setRecoveringItem(null);
                    setError("");
                  }}
                  disabled={recoveringId !== null}
                  className="rounded-lg border border-[#cfd8e6] bg-background px-4 py-2 text-sm font-medium disabled:opacity-50 !bg-white !text-[#17336d] !border-[#cbd5e1] transition-colors hover:!bg-[#eef2ff] hover:!border-[#a8bde4] hover:!text-[#17336d] focus-visible:!ring-0 focus-visible:!shadow-none focus-visible:!outline-none"
                 
            onMouseEnter={(e) => {
              const el=e.currentTarget;
              if(!el.dataset.qrpassV158Saved) {
                el.dataset.qrpassV158Saved=el.style.cssText || " ";
              }
              el.style.setProperty("background", "#eef2ff", "important");
              el.style.setProperty("background-color", "#eef2ff", "important");
              el.style.setProperty("background-image", "none", "important");
              el.style.setProperty("color", "#17336d", "important");
              el.style.setProperty("border-color", "#a8bde4", "important");
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onMouseLeave={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onFocus={(e) => {
              e.currentTarget.style.setProperty("box-shadow", "none", "important");
              e.currentTarget.style.setProperty("outline", "none", "important");
            }}
            onBlur={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}

           data-qrpass-neutral-v169="true">
                  Cancel
                </button>

                <button
                  type="submit"
                  disabled={recoveringId !== null}
                  className="rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
                >
                  {recoveringId !== null
                    ? "Saving Recovery..."
                    : "Save & Mark Recovered"}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════════════
// PCO PAGES
// ══════════════════════════════════════════════════════════════════════════════
// PCO pages reuse the Student search/sort/refresh layout on desktop and mobile.

/* QRPASS_PCO_DIRECT_CONTROLS_V156 */
/* QRPASS_PCO_MANAGE_V158: page-specific PCO management window */
function QRPassPCOManageV158({
  title, records, onClose, onView,
}: {
  title: string;
  records: any[];
  onClose: () => void;
  onView?: (item: any) => void;
}) {
  const [searchV157, setSearchV157] = useState("");
  const [selectedV157, setSelectedV157] = useState<string[]>([]);
  const [detailV157, setDetailV157] = useState<any | null>(null);
  const safeV157 = Array.isArray(records) ? records : [];
  const visibleV157 = safeV157.filter((item) =>
    [item.id, item.item_name, item.item_type, item.serial_number, item.qr_code,
     item.status, item.created_at, item.user?.name, item.user?.username,
     item.title, item.message, item.type]
      .filter(v => v !== undefined && v !== null)
      .join(" ").toLowerCase().includes(searchV157.trim().toLowerCase())
  );
  const keyV157 = (item: any, i: number) => String(item.id ?? `row-${i}`);
  const visibleIdsV157 = visibleV157.map(keyV157);
  const allV157 = visibleIdsV157.length > 0 &&
    visibleIdsV157.every(id => selectedV157.includes(id));
  const exportV157 = () => {
    const chosen = selectedV157.length
      ? visibleV157.filter((item,i) => selectedV157.includes(keyV157(item,i)))
      : visibleV157;
    if (!chosen.length) return;
    const columns = ["id","item_name","item_type","serial_number","qr_code","status","created_at","title","message"];
    const quote = (value: unknown) => {
      let v=String(value ?? "");
      if (/^[\s]*[=+\-@]/.test(v)) v="'"+v;
      return `"${v.replace(/"/g,'""')}"`;
    };
    const csv=[columns.map(quote).join(","),...chosen.map(item=>columns.map(k=>quote(item[k])).join(","))].join("\r\n");
    const blob = new Blob(["\uFEFF",csv],{type:"text/csv;charset=utf-8"});
    const url=URL.createObjectURL(blob);
    const link=document.createElement("a"); link.href=url;
    link.download=`QRPass-PCO-${title.replace(/[^a-z0-9]+/gi,"-")}.csv`;
    document.body.appendChild(link); link.click(); link.remove();
    window.setTimeout(()=>URL.revokeObjectURL(url),1000);
  };
  return (
    <div className="fixed inset-0 z-[260] flex items-center justify-center bg-black/65 p-3"
      onMouseDown={e=>{if(e.target===e.currentTarget) onClose();}}>
      <div role="dialog" aria-modal="true" aria-label={title}
        className="flex max-h-[90vh] w-full max-w-4xl flex-col overflow-hidden rounded-2xl border border-[#c7d2fe] bg-white p-4 text-[#17336d] shadow-2xl sm:p-5">
        <div className="mb-5 flex items-center justify-between">
          <h2 className="text-lg font-bold">{title}</h2>
          <button type="button" onClick={onClose}
            className="rounded-xl border border-[#c7d2fe] bg-white px-4 py-2 text-sm hover:bg-[#eef2ff]"
           data-qrpass-neutral-v169="true">Close</button>
        </div>
        <div className="mb-3 flex gap-2">
          <button type="button" disabled title="No PCO archive endpoint is connected"
            className="rounded-xl border border-[#c7d2fe] bg-white px-3 py-2.5 text-sm opacity-50">View Archives</button>
          <input type="search" aria-label={`Search ${title}`} placeholder="Search records..."
            value={searchV157} onChange={e=>setSearchV157(e.target.value)}
            className="min-w-0 flex-1 rounded-xl border border-[#c7d2fe] bg-white px-4 py-2.5 text-sm outline-none hover:bg-[#eef2ff] focus:bg-white"/>
        </div>
        <div className="min-h-[70px] flex-1 overflow-y-auto rounded-xl border border-[#d8e1ee]">
          {!visibleV157.length ? <p className="p-7 text-center text-sm font-semibold">No matching records</p> :
          <div className="divide-y divide-[#e5eaf2]">{visibleV157.map((item,i)=>{
            const id=keyV157(item,i);
            return <div key={id} className="flex items-center gap-3 p-3 hover:bg-[#f8faff]">
              <input type="checkbox" aria-label={`Select record ${id}`}
                checked={selectedV157.includes(id)}
                onChange={()=>setSelectedV157(list=>list.includes(id)?list.filter(x=>x!==id):[...list,id])}/>
              <div className="min-w-0 flex-1">
                <p className="truncate text-sm font-semibold">{String(item.item_name ?? item.title ?? `Record #${id}`)}</p>
                <p className="truncate text-xs text-[#64748b]">{String(item.user?.name ?? item.item_type ?? item.type ?? "")} Â· {String(item.status ?? item.created_at ?? "")}</p>
              </div>
              <button type="button"
                onClick={()=>{if(onView){onView(item);onClose();} else setDetailV157(item);}}
                className="rounded-lg border border-[#c7d2fe] bg-white px-3 py-2 text-sm hover:bg-[#eef2ff]"
          >View</button>
            </div>;
          })}</div>}
        </div>
        <div className="mt-3 flex flex-wrap items-center gap-2">
          <span className="mr-auto text-xs text-[#64748b]">{selectedV157.length} selected Â· {visibleV157.length} shown</span>
          <button type="button" disabled={!visibleIdsV157.length}
            onClick={()=>setSelectedV157(v=>allV157?v.filter(id=>!visibleIdsV157.includes(id)):Array.from(new Set([...v,...visibleIdsV157])))}
            className="rounded-xl border border-[#c7d2fe] bg-white px-3 py-2 text-sm hover:bg-[#eef2ff] disabled:opacity-50"
          >{allV157?"Deselect All":"Select All"}</button>
          <button type="button" disabled={!visibleV157.length} onClick={exportV157}
            className="rounded-xl border border-[#c7d2fe] bg-white px-3 py-2 text-sm hover:bg-[#eef2ff] disabled:opacity-50"
          >Download</button>
          <button type="button" disabled title="PCO archive endpoint not verified"
            className="rounded-xl border border-[#c7d2fe] bg-white px-3 py-2 text-sm opacity-50">Archive</button>
          <button type="button" disabled title="Bulk permanent deletion not authorized"
            className="rounded-xl border border-red-200 bg-white px-3 py-2 text-sm text-red-600 opacity-50">Delete</button>
        </div>
        {detailV157 && <div role="dialog" aria-modal="true" aria-label="Record details"
          className="absolute inset-4 z-[1] flex items-center justify-center bg-black/40 p-2">
          <div className="max-h-[75vh] w-full max-w-xl overflow-auto rounded-xl bg-white p-5 text-[#17336d] shadow-2xl">
            <div className="mb-3 flex items-center justify-between">
              <h3 className="font-bold">Record Details</h3>
              <button type="button" onClick={()=>setDetailV157(null)} className="rounded-lg border border-[#c7d2fe] px-3 py-2" data-qrpass-neutral-v169="true">Close</button>
            </div>
            {Object.entries(detailV157).filter(([k,v])=>typeof v!=="object" && !k.startsWith("__")).slice(0,30).map(([k,v])=>
              <p key={k} className="border-b border-[#edf2ff] py-1 text-sm"><strong>{k}:</strong> {String(v??"")}</p>)}
          </div>
        </div>}
      </div>
    </div>
  );
}

/* QRPASS_PCO_MOBILE_REFRESH_V162 */
/* QRPASS_PCO_MOBILE_REFRESH_V165 */
function PCOResponsiveToolbar({
  search,
  onSearchChange,
  sort,
  onSortChange,
  onRefresh,
  loading,
  placeholder,
  sortLabels = ["Newest first", "Oldest first"],
  qrpassFilterSlot,
  manageAction,
  onManageV158,
}: {
  search: string;
  onSearchChange: (value: string) => void;
  sort: string;
  onSortChange: (value: string) => void;
  onRefresh: () => void;
  loading: boolean;
  placeholder: string;
  sortLabels?: [string, string];
  qrpassFilterSlot?: React.ReactNode;
  manageAction?: React.ReactNode;
  onManageV158?: () => void;
}) {
  return (
    <div className="flex min-w-0 flex-col gap-3 lg:flex-row">
      <div className="relative min-w-0 flex-1">
        <Search size={17} className="absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground" />
        <input
          type="search"
          aria-label={placeholder}
          value={search}
          onChange={(e) => onSearchChange(e.target.value)}
          placeholder={placeholder}
          className="w-full min-w-0 rounded-xl border border-border  py-3 pl-11 pr-4 text-sm text-foreground outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/15 !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
          ref={(element) => {
            if (element) element.style.setProperty("background-color", "#ffffff", "important");
          }}
          onMouseEnter={(event) => {
            if (document.activeElement !== event.currentTarget)
              event.currentTarget.style.setProperty("background-color", "#eef2ff", "important");
          }}
          onMouseLeave={(event) => event.currentTarget.style.setProperty("background-color", "#ffffff", "important")}
          onFocus={(event) => event.currentTarget.style.setProperty("background-color", "#ffffff", "important")}
          onBlur={(event) => event.currentTarget.style.setProperty("background-color", "#ffffff", "important")}
        />
      </div>
      {qrpassFilterSlot}
      <select
        aria-label="Sort results"
        value={sort}
        onChange={(e) => onSortChange(e.target.value)}
        className="w-full rounded-xl border border-border  px-4 py-3 text-sm font-medium text-foreground outline-none focus:border-primary lg:w-auto !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
          ref={(element) => {
            if (element) element.style.setProperty("background-color", "#ffffff", "important");
          }}
          onMouseEnter={(event) => {
            if (document.activeElement !== event.currentTarget)
              event.currentTarget.style.setProperty("background-color", "#eef2ff", "important");
          }}
          onMouseLeave={(event) => event.currentTarget.style.setProperty("background-color", "#ffffff", "important")}
          onFocus={(event) => event.currentTarget.style.setProperty("background-color", "#ffffff", "important")}
          onBlur={(event) => event.currentTarget.style.setProperty("background-color", "#ffffff", "important")}
      >
        <option value="newest">{sortLabels[0]}</option>
        <option value="oldest">{sortLabels[1]}</option>
      </select>
      {manageAction}
      {onManageV158 ? (
        <>
          <button
            type="button"
            aria-label="Manage Records"
            title="Manage Records"
            onClick={onManageV158}
            className="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#c7d2fe] bg-white text-[#17336d] hover:bg-[#eef2ff] !hidden md:!inline-flex"
          >
            <SlidersHorizontal size={18} strokeWidth={1.8} />
          </button>
          <button
            type="button"
            data-qrpass-mobile-refresh-v167="true"
            aria-label="Refresh"
            title="Refresh"
            onClick={onRefresh}
            disabled={loading}
            className="!inline-flex md:!hidden !w-auto !min-w-[112px] !max-w-none shrink-0 flex-nowrap items-center justify-center gap-2 whitespace-nowrap rounded-xl border border-[#c7d2fe] !bg-white !px-4 !py-3 text-sm font-medium text-[#17336d] hover:!bg-[#eef2ff] disabled:opacity-50"
          >
            <RefreshCw size={16} className="shrink-0" />
            <span className="!inline whitespace-nowrap">{loading ? "Refreshing..." : "Refresh"}</span>
          </button>
        </>
      ) : (
        <button
          type="button"
          onClick={onRefresh}
          disabled={loading}
          className="w-full rounded-xl border border-border bg-card px-5 py-3 text-sm font-medium text-foreground transition hover:bg-muted disabled:opacity-50 lg:w-auto inline-flex items-center justify-center gap-1.5 !border-0 !bg-transparent !shadow-none !text-[#17336d] !px-2 !py-1 hover:!bg-[#edf2ff] rounded-lg"
          >
          <RefreshCw size={13} className="shrink-0" />
          {loading ? "Refreshing..." : "Refresh"}
        </button>
      )}
    </div>
  );
}

/* QRPASS_PCO_RESPONSIVE_V170 */
/* QRPASS_PCO_COMPLETE_FILLED_ITEM_DETAILS_V113 */
function qrpassPCOHasFieldV113(value: unknown): boolean {
  if (value === null || value === undefined) return false;
  const text = String(value).trim();
  if (!text) return false;
  return !["n/a", "na", "not provided", "null", "undefined", "—", "-"].includes(text.toLowerCase());
}

function qrpassPCOSpecRowsV113(item: any): Array<{ label: string; value: string }> {
  const raw = String(item?.complete_description ?? "").trim();
  const parts = raw.split("|").map((part) => part.trim()).filter(Boolean);
  const rows = parts.map((part) => {
    const colon = part.indexOf(":");
    const hasLabel = colon > 0 && colon < 80;
    const label = hasLabel ? part.slice(0, colon).trim() : "Description";
    const value = hasLabel ? part.slice(colon + 1).trim() : part;
    return { label, value };
  }).filter(({value}) => qrpassPCOHasFieldV113(value));

  const directFields: Array<[string, unknown]> = [
    ["Computer / Laptop Type", item?.computer_type],
    ["Processor", item?.processor],
    ["Motherboard", item?.motherboard],
    ["Memory / RAM", item?.memory],
    ["Hard Drive / Storage", item?.hard_drive],
    ["Monitor", item?.monitor],
    ["Casing", item?.casing],
    ["Operating System", item?.operating_system],
    ["CD / DVD ROM", item?.cd_dvd_rom],
    ["Accessories Included", item?.accessories_included],
    ["Storage / Capacity", item?.storage_capacity],
    ["Unit Type", item?.unit_type],
    ["Power Source / Cable", item?.power_source],
    ["Lens / Attachment Included", item?.lens_attachment],
    ["Material / Body", item?.material_body],
    ["Model No.", item?.model_no],
    ["Size", item?.size],
  ];
  for (const [label, value] of directFields) {
    if (!qrpassPCOHasFieldV113(value)) continue;
    if (rows.some((entry) => entry.label.toLowerCase() === label.toLowerCase())) continue;
    rows.push({label, value: String(value).trim()});
  }
  return rows;
}

function PCOPermitRequests() {
  /* QRPASS_PCO_PENDING_ORDER_V107 */
  // QRPASS_PCO_COMPACT_PENDING_V101: list shows summary only; full details and approval stay in popup.
  // QRPASS_PCO_APPROVAL_IN_DETAILS_ONLY_V100: approval is available only after opening View.
  // QRPASS_PCO_HIDE_ITEM_NAME_V98: the name remains searchable and visible in View.
  const [manageOpenV158,setManageOpenV158]=useState(false);
  const [requestSearch, setRequestSearch] = useState("");
  const [requestSort, setRequestSort] = useState<"newest" | "oldest">("newest");
  const [pending, setPending] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [approvingId, setApprovingId] = useState<number | null>(null);
  const [error, setError] = useState("");
  const [viewingItemV96, setViewingItemV96] = useState<any | null>(null);

  async function loadPendingItems() {
    try {
      setLoading(true);
      setError("");
  
      const data = await getPendingItems();
  
      setPending(
        Array.isArray(data?.items)
          ? data.items
          : []
      );
    } catch (error) {
      console.error(
        "Failed to load pending items:",
        error
      );
  
      setPending([]);
  
      setError(
        error instanceof Error
          ? error.message
          : "Failed to load registration requests."
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadPendingItems();
  }, []);

  async function handleApprove(item: any) {
    try {
      setApprovingId(item.id);

      await approveItem(item.id);

      alert("Item approved and QR code issued successfully!");

      setPending((prev) =>
        prev.filter((p) => p.id !== item.id)
      );

    } catch (error) {
      alert(
        error instanceof Error
          ? error.message
          : "Failed to approve item."
      );
    } finally {
      setApprovingId(null);
    }
  }

  const matchesRequest = (item: any) => {
    const keyword = requestSearch.trim().toLowerCase();
    if (!keyword) return true;
    return [
      item.id ? `REQ-${String(item.id).padStart(3, "0")}` : "",
      item.user?.name, item.user?.username, item.user?.email, item.user?.college, item.user?.year_level, item.item_name,
      item.complete_description, item.item_type, item.serial_number,
      item.purpose, item.qr_code,
    ].filter(Boolean).join(" ").toLowerCase().includes(keyword);
  };
  const sortRequests = (records: any[]) => [...records]
    .filter(matchesRequest)
    .sort((x, y) => {
      const xDate = new Date(x.created_at || 0).getTime() || 0;
      const yDate = new Date(y.created_at || 0).getTime() || 0;
      return requestSort === "newest" ? yDate - xDate : xDate - yDate;
    });
  const pendingResults = sortRequests(pending);

  // QRPASS_PCO_STUDENT_INFO_TIME_V102 — keep the main list compact; show full student contact in the popup.
  // QRPASS_PCO_ACADEMIC_COLUMNS_V103 — show missing academic details explicitly instead of hiding the row.
  const collegeV103 = (user: any) => {
    const level = String(user?.year_level ?? "").trim();
    if (level.toLowerCase() === "senior high school") return "N/A (Senior High)";
    return String(user?.college ?? "").trim() || "Not provided";
  };
  const yearV103 = (user: any) => String(user?.year_level ?? "").trim() || "Not provided";
  const filedAtV102 = (value: any, part: "date" | "time") => {
    if (!value) return "—";
    const dt = new Date(value);
    if (Number.isNaN(dt.getTime())) return "—";
    if (part === "date") return dt.toLocaleDateString("en-PH", {
      timeZone: "Asia/Manila", year: "numeric", month: "short", day: "numeric",
    });
    return dt.toLocaleTimeString("en-PH", {
      timeZone: "Asia/Manila", hour: "numeric", minute: "2-digit", hour12: true,
    });
  };

  return (
    <div className="w-full min-w-0 space-y-5 overflow-x-hidden">
      <PageHeader
        title="Item Registration Requests"
        subtitle="Review and approve student item registration requests. Approval triggers QR code generation."
        />

      {error && (
        <div className="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">{error}</div>
      )}
      {/* Requests is the pending approval queue; issued QR codes belong in Registered Items. */}
      <div className="space-y-2">
      <div className="grid grid-cols-1 gap-3 sm:grid-cols-4">
        <StatCard
          label="Pending Review"
          value={String(pending.length)}
          icon={<Clock size={20} />}
          color="#2f5fd6"
        />
      </div>
      </div>

      <PCOResponsiveToolbar
        search={requestSearch}
        onSearchChange={setRequestSearch}
        sort={requestSort}
        onSortChange={(value) => setRequestSort(value as "newest" | "oldest")}
        onRefresh={loadPendingItems}
        onManageV158={() => setManageOpenV158(true)}
        loading={loading}
        placeholder="Search student, item, category, serial number..."
      />

      {manageOpenV158 && <QRPassPCOManageV158 title="Manage Registration Requests" records={pendingResults} onClose={()=>setManageOpenV158(false)}/>}
      <Card
        title="Pending Requests"
        action={
          <span className="text-xs bg-yellow-100 text-yellow-700 px-2 py-0.5 rounded-full font-semibold">
            {pendingResults.length} pending
          </span>
        }
      >
        {/* QRPASS_PCO_PENDING_UNIFORM_V106: responsive by available panel width, not browser width. */}
        <div className="qrpass-pco-pending-wrap-v106">
        <div className="qrpass-pco-pending-cards-v106 min-w-0 divide-y divide-border">
          {loading ? (
            <p className="p-6 text-center text-sm text-muted-foreground">Loading pending requests...</p>
          ) : pendingResults.length === 0 ? (
            <p className="p-6 text-center text-sm text-muted-foreground">No matching pending requests.</p>
          ) : pendingResults.map((item) => (
            <article key={item.id} className="min-w-0 space-y-3 p-4">
              <div className="flex min-w-0 items-start justify-between gap-2">
                <div className="min-w-0">
                  <p className="mt-1 text-[11px] font-mono text-muted-foreground">REQ-{String(item.id).padStart(3, "0")}</p>
                </div>
              </div>
              <dl className="grid min-w-0 grid-cols-2 gap-3 text-xs">
                <div className="min-w-0">
                  <dt className="text-muted-foreground">Student</dt>
                  <dd className="mt-1 break-words font-semibold text-foreground">{item.user?.name || "Unknown"}</dd>
                </div>
                <div className="min-w-0"><dt className="text-muted-foreground">User ID</dt><dd className="mt-1 break-words font-medium">{item.user?.username || "—"}</dd></div>
                <div className="min-w-0">
                  <dt className="text-muted-foreground">Department</dt>
                  <dd className="mt-1 break-words font-medium">{collegeV103(item.user)}</dd>
                </div>
                <div className="min-w-0">
                  <dt className="text-muted-foreground">Year Level</dt>
                  <dd className="mt-1 break-words font-medium">{yearV103(item.user)}</dd>
                </div>
                <div className="min-w-0">
                  <dt className="text-muted-foreground">Time</dt>
                  <dd className="mt-1 font-medium">{filedAtV102(item.created_at, "time")}</dd>
                </div>
                <div className="min-w-0">
                  <dt className="text-muted-foreground">Date Filed</dt>
                  <dd className="mt-1 font-medium">{filedAtV102(item.created_at, "date")}</dd>
                </div>
              </dl>
              <div className="flex flex-col gap-2">
                <button
                  type="button"
                  onClick={() => setViewingItemV96(item)}
                  className="inline-flex w-full items-center justify-center rounded-md border border-[#cfd8e6] bg-white px-4 py-2.5 text-sm font-semibold text-[#244780] transition hover:bg-[#eef4ff]"
          >
                  View
                </button>
              </div>
            </article>
          ))}
        </div>
        <div className="qrpass-pco-pending-grid-v106 min-w-0">
          <table className="qrpass-pco-pending-table-v106 w-full table-fixed">
            <colgroup>
              <col style={{ width: "8%" }} />
              <col style={{ width: "19%" }} />
              <col style={{ width: "11%" }} />
              <col style={{ width: "21%" }} />
              <col style={{ width: "10%" }} />
              <col style={{ width: "9%" }} />
              <col style={{ width: "12%" }} />
              <col style={{ width: "10%" }} />
            </colgroup>
            <thead>
              <tr className="bg-[#fafbfc]">
                {[
                  "Request No.",
                  "Student",
                  "Student ID",
                  "Department",
                  "Year Level",
                  "Time",
                  "Date",
                  "Item Details",
                ].map((h) => (
                  <th
                    key={h}
                    className={`py-3 px-3 text-xs text-muted-foreground font-semibold ${h === "Student" || h === "Department" ? "text-left" : "text-center"}`}
                  >
                    {h}
                  </th>
                ))}
              </tr>
            </thead>

            <tbody>
              {loading ? (
                <tr>
                  <td
                    colSpan={8}
                    className="text-center py-8 text-sm text-muted-foreground"
                  >
                    Loading pending requests...
                  </td>
                </tr>
              ) : pendingResults.length === 0 ? (
                <tr>
                  <td
                    colSpan={8}
                    className="text-center py-8 text-sm text-muted-foreground"
                  >
                    No pending item registration requests.
                  </td>
                </tr>
              ) : (
                pendingResults.map((item) => (
                  <tr
                    key={item.id}
                    className="border-t border-[#cfd8e6] hover:bg-[#eef2fc] transition-colors"
                  >
                    <td className="py-3 px-3 text-center text-xs font-mono text-muted-foreground">
                      REQ-{String(item.id).padStart(3, "0")}
                    </td>

                    <td className="py-3 px-3 text-left text-sm text-foreground font-semibold break-words">
                      {item.user?.name ?? "Unknown"}
                    </td>

                    <td className="py-3 px-3 text-center text-xs font-mono text-muted-foreground">
                      {item.user?.username ?? "—"}
                    </td>

                    <td className="py-3 px-3 text-center text-xs text-muted-foreground break-words">
                      {collegeV103(item.user)}
                    </td>

                    <td className="py-3 px-3 text-center text-xs text-muted-foreground break-words">
                      {yearV103(item.user)}
                    </td>

                    <td className="py-3 px-2 text-center text-xs text-muted-foreground whitespace-nowrap tabular-nums">
                      {filedAtV102(item.created_at, "time")}
                    </td>

                    <td className="py-3 px-2 text-center text-xs text-muted-foreground whitespace-nowrap tabular-nums">
                      {filedAtV102(item.created_at, "date")}
                    </td>

                    <td className="py-3 px-3 text-center text-sm text-foreground">
                      <button
                        type="button"
                        onClick={() => setViewingItemV96(item)}
                        className="inline-flex items-center justify-center rounded-md border border-[#cfd8e6] bg-white px-3 py-1.5 text-xs font-semibold text-[#244780] transition hover:bg-[#eef4ff]"
          >
                        View
                      </button>
                    </td>

                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
        </div>
      </Card>

      {viewingItemV96 && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4">
          <div data-qrpass-pco-fixed-modal-v119="true" className="flex h-[calc(100dvh-1.5rem)] max-h-[800px] w-full max-w-[860px] min-h-0 flex-col overflow-hidden rounded-2xl border border-[#dbe4f0] bg-card shadow-2xl sm:h-[88dvh]">
            <div className="flex shrink-0 items-start justify-between gap-4 border-b border-[#cfd8e6] bg-card px-5 py-4 sm:px-6">
              <div>
                <h3 className="font-semibold text-foreground">Item Details</h3>
                <p className="mt-1 text-xs text-muted-foreground">Review the full item details and description.</p>
              </div>
              <button
                type="button"
                onClick={() => setViewingItemV96(null)}
                className="rounded-md border border-[#d9e2ef] bg-white px-3 py-1.5 text-sm font-medium text-[#244780] transition hover:bg-[#eef4ff]"
           data-qrpass-neutral-v169="true">
                Close
              </button>
            </div>

            <div className="flex min-h-0 flex-1 flex-col px-4 pb-4 pt-4 sm:px-6 sm:pb-5">
              {/* QRPASS_PCO_ITEM_DETAILS_SINGLE_CARD_V111 */}
              <div data-qrpass-pco-item-card-v120="true" className="min-h-0 flex-1 overflow-y-auto overscroll-contain rounded-xl border border-[#dbe4f0] bg-[#f8fbff] p-4 sm:p-6">
                <p className="text-[11px] font-semibold uppercase tracking-wide text-[#617693]">Item Information</p>
                <div className="mt-4 grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2">
                  <div className="min-w-0">
                    <p className="text-[11px] font-semibold uppercase tracking-wide text-muted-foreground">Item Name</p>
                    <p className="mt-1 break-words text-sm font-medium text-foreground">{viewingItemV96.item_name || "Unnamed item"}</p>
                  </div>
                  {qrpassPCOHasFieldV113(viewingItemV96.brand_model) && (
                    <div className="min-w-0">
                      <p className="text-[11px] font-semibold uppercase tracking-wide text-muted-foreground">Brand / Model</p>
                      <p className="mt-1 break-words text-sm font-medium text-foreground">{viewingItemV96.brand_model}</p>
                    </div>
                  )}
                  {qrpassPCOHasFieldV113(viewingItemV96.serial_number) && (
                    <div className="min-w-0">
                      <p className="text-[11px] font-semibold uppercase tracking-wide text-muted-foreground">Serial Number</p>
                      <p className="mt-1 break-all text-sm font-medium text-foreground">{viewingItemV96.serial_number}</p>
                    </div>
                  )}
                  {qrpassPCOHasFieldV113(viewingItemV96.color) && (
                    <div className="min-w-0">
                      <p className="text-[11px] font-semibold uppercase tracking-wide text-muted-foreground">Color</p>
                      <p className="mt-1 break-words text-sm font-medium text-foreground">{viewingItemV96.color}</p>
                    </div>
                  )}
                  {qrpassPCOHasFieldV113(viewingItemV96.item_type) && (
                    <div className="min-w-0">
                      <p className="text-[11px] font-semibold uppercase tracking-wide text-muted-foreground">Type</p>
                      <p className="mt-1 break-words text-sm font-medium text-foreground">{viewingItemV96.item_type}</p>
                    </div>
                  )}
                  {/* QRPASS_PCO_QUANTITY_FORM_ONLY_V114 */}
                  {(
                    ["sports equipment", "other equipment"].includes(
                      String(viewingItemV96.item_type ?? "").trim().toLowerCase()
                    ) && qrpassPCOHasFieldV113(viewingItemV96.quantity)
                  ) && (
                    <div className="min-w-0">
                      <p className="text-[11px] font-semibold uppercase tracking-wide text-muted-foreground">Quantity</p>
                      <p className="mt-1 text-sm font-medium text-foreground">{viewingItemV96.quantity}</p>
                    </div>
                  )}
                  {qrpassPCOHasFieldV113(viewingItemV96.purpose) && (
                    <div className="min-w-0 sm:col-span-2">
                      <p className="text-[11px] font-semibold uppercase tracking-wide text-muted-foreground">Purpose / Reason for Bringing</p>
                      <p className="mt-1 break-words text-sm font-medium text-foreground">{viewingItemV96.purpose}</p>
                    </div>
                  )}
                </div>
                {qrpassPCOSpecRowsV113(viewingItemV96).length > 0 && (
                  <div className="mt-5 border-t border-[#dbe4f0] pt-4">
                    <p className="text-[11px] font-semibold uppercase tracking-wide text-[#617693]">Description / Specifications</p>
                    <div className="mt-4 grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2">
                      {/* QRPASS_PCO_ACCESSORIES_CHIPS_V123: Accessories use full-width wrapped chips; other specs are unchanged. */}
                      {qrpassPCOSpecRowsV113(viewingItemV96).map((spec, index) => (
                        <div
                          key={index}
                          className="min-w-0"
                          style={spec.label.trim().toLowerCase() === "accessories included" ? { gridColumn: "1 / -1" } : undefined}
                        >
                          <p className="text-[11px] font-semibold uppercase tracking-wide text-muted-foreground">{spec.label}</p>
                          {spec.label.trim().toLowerCase() === "accessories included" ? (
                            <div data-qrpass-accessories-v125="QRPASS_PCO_ACCESSORIES_UNIFORM_FIELDS_V125" className="mt-3 grid grid-cols-1 gap-x-5 gap-y-3 sm:grid-cols-2 lg:grid-cols-3" aria-label="Accessories included">
                              {String(spec.value).split(",").map((value) => value.trim()).filter(Boolean).map((accessory, accessoryIndex) => (
                                <div key={accessoryIndex} className="min-w-0" role="group" aria-label={`Accessory ${accessoryIndex + 1}`}>
                                  <p className="text-[11px] font-semibold uppercase tracking-wide text-muted-foreground">Accessory {accessoryIndex + 1}</p>
                                  <p className="mt-1 whitespace-pre-wrap break-words text-sm font-medium leading-relaxed text-foreground">{accessory}</p>
                                </div>
                              ))}
                            </div>
                          ) : (
                            <p className="mt-1 whitespace-pre-wrap break-words text-sm font-medium leading-relaxed text-foreground">{spec.value}</p>
                          )}
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>

              <div className="mt-4 flex shrink-0 flex-col gap-2 border-t border-[#dbe4f0] pt-4 sm:flex-row sm:items-center sm:justify-end">
                <button
                  type="button"
                  onClick={() => setViewingItemV96(null)}
                  className="inline-flex items-center justify-center rounded-md border border-[#d9e2ef] bg-white px-4 py-2.5 text-sm font-semibold text-[#244780] transition hover:bg-[#eef4ff]"
           data-qrpass-neutral-v169="true">
                  Close
                </button>
                <button
                  type="button"
                  onClick={() => handleApprove(viewingItemV96)}
                  disabled={approvingId === viewingItemV96.id}
                  className="inline-flex items-center justify-center gap-1 rounded-md bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground transition disabled:opacity-50 transition-colors hover:!bg-[#eef2ff] hover:!text-[#17336d] hover:!border-[#a8bde4] focus-visible:!ring-0 focus-visible:!shadow-none"
          >
                  <CheckCircle size={14} />
                  {approvingId === viewingItemV96.id ? "Approving..." : "Approve & Issue QR"}
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

    </div>
  );
}

function PCOItemRegistry({ adminView = false }: { adminView?: boolean } = {}) {
  const openSysadminManageV116 = React.useContext(QRPassSysadminManageContext);
  const [items, setItems] = useState<any[]>([]);
  const [manageOpenV158,setManageOpenV158]=useState(false);
  const [loading, setLoading] = useState(true);
  const [search, setSearch] = useState("");
  const [sortOrder, setSortOrder] = useState<"newest" | "oldest">("newest");
  const [statusFilter, setStatusFilter] = useState<"all" | "active" | "expired">("all");
  const [selectedItem, setSelectedItem] =
    useState<any | null>(null);

  async function loadItems() {
    try {
      setLoading(true);

      const data = await getAllItems();

      setItems(data.items ?? []);
    } catch (error) {
      console.error("Failed to load registered items:", error);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadItems();
  }, []);

  // Keep the approval queue separate from the PCO registered-items view.
  // Flagged incidents remain in the security/incident records, not this registry page.
  const registeredItems = items.filter(
    (item) => String(item.status ?? "").toLowerCase() === "approved" && !item.is_flagged
  );

  const registryStatus = (item: any) => item.is_expired ? "Expired" : "Active";

  const filteredItems = registeredItems.filter((item) => {
    const keyword = search.toLowerCase().trim();
    const searchable = [item.item_name, item.brand_model, item.serial_number,
      item.qr_code, item.item_type, item.user?.name, item.user?.username,
      registryStatus(item), item.id ? `ITEM-${String(item.id).padStart(3, "0")}` : ""
    ].filter(Boolean).join(" ").toLowerCase();
    return (!keyword || searchable.includes(keyword)) &&
      (statusFilter === "all" || registryStatus(item).toLowerCase() === statusFilter);
  }).sort((x, y) => {
    const xTime = new Date(x.created_at || 0).getTime() || 0;
    const yTime = new Date(y.created_at || 0).getTime() || 0;
    return sortOrder === "newest" ? yTime - xTime : xTime - yTime;
  });

  // SUMMARY
  const activeQrCount = registeredItems.filter(
    (item) => item.is_active_qr === true
  ).length;

  const expiredCount = registeredItems.filter(
    (item) => item.is_expired === true
  ).length;

  return (
    <div className="w-full min-w-0 space-y-5 overflow-x-hidden">
      <PageHeader
        title="Registered Items"
        subtitle="View and monitor the centralized records of registered items."
        />

      {/* SUMMARY CARDS */}
      <div className="space-y-2">
      <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
  <StatCard
    label="ALL"
    value={String(registeredItems.length)}
    icon={<Package size={20} />}
    color="#1a3a7b"
  />

  <StatCard
    label="Active QR Codes"
    value={String(activeQrCount)}
    icon={<QrCode size={20} />}
    color="#2ecc71"
  />

  <div className="col-span-2 min-w-0 md:col-span-1">
    <StatCard
      label="Expired"
      value={String(expiredCount)}
      icon={<Clock size={20} />}
      color="#2f5fd6"
    />
  </div>

</div>
      </div>

      {adminView ? (
      <PCOResponsiveToolbar
        search={search}
        onSearchChange={setSearch}
        sort={sortOrder}
        onSortChange={(value) => setSortOrder(value as "newest" | "oldest")}
        onRefresh={loadItems}
        onManageV158={!adminView ? () => setManageOpenV158(true) : undefined}
        loading={loading}
        placeholder="Search item, owner, serial number, QR ID..."
        manageAction={adminView && openSysadminManageV116 ? (
          <button
            type="button"
            aria-label="Manage Items"
            title="Manage Items"
            onClick={openSysadminManageV116}
            
            data-qrpass-manage-items-hover-v149="true"
            onMouseEnter={(e) => {
              const s = e.currentTarget.style;
              s.setProperty('background-color', '#eef2ff', 'important');
              s.setProperty('border-color', '#a8bde4', 'important');
              s.setProperty('box-shadow', 'none', 'important');
              s.setProperty('outline', 'none', 'important');
            }}
            onMouseLeave={(e) => {
              const s = e.currentTarget.style;
              s.setProperty('background-color', '#ffffff', 'important');
              s.setProperty('border-color', '#cbd5e1', 'important');
              s.setProperty('box-shadow', 'none', 'important');
              s.setProperty('outline', 'none', 'important');
            }}
            onFocus={(e) => {
              const s = e.currentTarget.style;
              s.setProperty('box-shadow', 'none', 'important');
              s.setProperty('outline', 'none', 'important');
            }}
            onBlur={(e) => {
              const s = e.currentTarget.style;
              s.setProperty('background-color', '#ffffff', 'important');
              s.setProperty('border-color', '#cbd5e1', 'important');
              s.setProperty('box-shadow', 'none', 'important');
              s.setProperty('outline', 'none', 'important');
            }}
className="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#cbd5e1] bg-white text-[#31539b] transition-colors hover:bg-[#eef2ff] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5278e7]/20"
          >
            <SlidersHorizontal size={18} strokeWidth={1.8} aria-hidden="true" />
          </button>
        ) : undefined}
        qrpassFilterSlot={adminView ? (
          <select data-qrpass-admin-items-filter="true" aria-label="Filter registered items"
            value={statusFilter}
            onChange={(e) => setStatusFilter(e.target.value as "all" | "active" | "expired")}
            className="h-12 w-full rounded-xl border border-[#c7d2fe]  px-3 text-sm font-medium text-[#17336d] outline-none focus:border-[#5278e7] lg:w-[185px] dark:border-[#5075b7] dark:bg-[#1e3765] dark:text-white !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
          ref={(element) => {
            if (element) element.style.setProperty("background-color", "#ffffff", "important");
          }}
          onMouseEnter={(event) => {
            if (document.activeElement !== event.currentTarget)
              event.currentTarget.style.setProperty("background-color", "#eef2ff", "important");
          }}
          onMouseLeave={(event) => event.currentTarget.style.setProperty("background-color", "#ffffff", "important")}
          onFocus={(event) => event.currentTarget.style.setProperty("background-color", "#ffffff", "important")}
          onBlur={(event) => event.currentTarget.style.setProperty("background-color", "#ffffff", "important")}>
            <option value="all">All ({registeredItems.length})</option>
            <option value="active">Active ({registeredItems.filter((item) => registryStatus(item) === "Active").length})</option>
            <option value="expired">Expired ({expiredCount})</option>
          </select>
        ) : undefined}
      />
      ) : (
      
      <div className="flex w-full min-w-0 flex-col gap-3 lg:flex-row lg:items-center">

        <label className="relative block min-w-0 flex-1">
          <Search
            size={17}
            className="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground"
          />
          


          

<input
  type="search"
  aria-label="Search PCO registered items"
  value={search}
  onChange={(e) => setSearch(e.target.value)}
  placeholder="Search item, owner, serial number, QR ID..."
  className="h-12 w-full min-w-0 rounded-xl border border-[#c7d2fe] pl-11 pr-4 text-sm text-[#17336d] outline-none transition-colors placeholder:text-[#8195bb] focus:border-[#5278e7] focus:ring-2 focus:ring-[#5278e7]/20"
  ref={(input) => {
    if (input) {
      input.style.setProperty("background-color", "#ffffff", "important");
    }
  }}
  onMouseEnter={(e) => {
    e.currentTarget.style.setProperty("background-color", "#eef2ff", "important");
  }}
  onMouseLeave={(e) => {
    e.currentTarget.style.setProperty("background-color", "#ffffff", "important");
  }}
  onFocus={(e) => {
    e.currentTarget.style.setProperty("background-color", "#ffffff", "important");
  }}
  onBlur={(e) => {
    e.currentTarget.style.setProperty("background-color", "#ffffff", "important");
  }}
/>


        </label>

        <div className="grid w-full min-w-0 grid-cols-2 items-center gap-2 sm:flex sm:flex-wrap lg:w-auto lg:shrink-0">

          <select
            aria-label="Filter PCO registered items"
            value={statusFilter}
            onChange={(e) =>
              setStatusFilter(
                e.target.value as "all" | "active" | "expired"
              )
            }
            className="h-12 min-w-[160px] flex-1 rounded-xl border border-[#bfceff]  px-3 text-sm text-foreground outline-none focus:border-[#6488ff]  dark:border-[#35537e] dark:bg-[#1b2b49] sm:flex-none !bg-white hover:!bg-[#eef2ff] focus:!bg-white !min-w-0 !w-full sm:!w-auto"
          ref={(element) => {
            if (element) element.style.setProperty("background-color", "#ffffff", "important");
          }}
          onMouseEnter={(event) => {
            if (document.activeElement !== event.currentTarget)
              event.currentTarget.style.setProperty("background-color", "#eef2ff", "important");
          }}
          onMouseLeave={(event) => event.currentTarget.style.setProperty("background-color", "#ffffff", "important")}
          onFocus={(event) => event.currentTarget.style.setProperty("background-color", "#ffffff", "important")}
          onBlur={(event) => event.currentTarget.style.setProperty("background-color", "#ffffff", "important")}
          >
            <option value="all">
              All Items ({registeredItems.length})
            </option>
            <option value="active">
              Active ({registeredItems.filter(item => !item.is_expired).length})
            </option>
            <option value="expired">
              Expired ({expiredCount})
            </option>
          </select>

          <select
            aria-label="Sort PCO registered items"
            value={sortOrder}
            onChange={(e) =>
              setSortOrder(
                e.target.value as "newest" | "oldest"
              )
            }
            className="h-12 min-w-[145px] flex-1 rounded-xl border border-[#bfceff]  px-3 text-sm text-foreground outline-none focus:border-[#6488ff]  dark:border-[#35537e] dark:bg-[#1b2b49] sm:flex-none !bg-white hover:!bg-[#eef2ff] focus:!bg-white !min-w-0 !w-full sm:!w-auto"
          ref={(element) => {
            if (element) element.style.setProperty("background-color", "#ffffff", "important");
          }}
          onMouseEnter={(event) => {
            if (document.activeElement !== event.currentTarget)
              event.currentTarget.style.setProperty("background-color", "#eef2ff", "important");
          }}
          onMouseLeave={(event) => event.currentTarget.style.setProperty("background-color", "#ffffff", "important")}
          onFocus={(event) => event.currentTarget.style.setProperty("background-color", "#ffffff", "important")}
          onBlur={(event) => event.currentTarget.style.setProperty("background-color", "#ffffff", "important")}
          >
            <option value="newest">Newest first</option>
            <option value="oldest">Oldest first</option>
          </select>

          <button type="button" title="Manage Items" aria-label="Manage Items"
              onClick={()=>setManageOpenV158(true)}
              
            data-qrpass-manage-items-hover-v149="true"
            onMouseEnter={(e) => {
              const s = e.currentTarget.style;
              s.setProperty('background-color', '#eef2ff', 'important');
              s.setProperty('border-color', '#a8bde4', 'important');
              s.setProperty('box-shadow', 'none', 'important');
              s.setProperty('outline', 'none', 'important');
            }}
            onMouseLeave={(e) => {
              const s = e.currentTarget.style;
              s.setProperty('background-color', '#ffffff', 'important');
              s.setProperty('border-color', '#cbd5e1', 'important');
              s.setProperty('box-shadow', 'none', 'important');
              s.setProperty('outline', 'none', 'important');
            }}
            onFocus={(e) => {
              const s = e.currentTarget.style;
              s.setProperty('box-shadow', 'none', 'important');
              s.setProperty('outline', 'none', 'important');
            }}
            onBlur={(e) => {
              const s = e.currentTarget.style;
              s.setProperty('background-color', '#ffffff', 'important');
              s.setProperty('border-color', '#cbd5e1', 'important');
              s.setProperty('box-shadow', 'none', 'important');
              s.setProperty('outline', 'none', 'important');
            }}
className="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#c7d2fe] bg-white text-[#17336d] hover:bg-[#eef2ff] !hidden md:!inline-flex">
              <SlidersHorizontal size={18} strokeWidth={1.8}/>
            </button>
  
<button
  type="button"
  title="Refresh"
  aria-label="Refresh"
  onClick={loadItems}
  disabled={loading}
  className="!inline-flex md:!hidden !w-auto !min-w-[115px] h-11 shrink-0 flex-nowrap items-center justify-center gap-2 whitespace-nowrap rounded-xl border border-[#c7d2fe] !bg-white px-4 py-2 text-sm font-semibold text-[#17336d] hover:!bg-[#eef2ff] disabled:opacity-50"
          >
  <RefreshCw size={16} className="shrink-0" />
  <span className="!inline whitespace-nowrap">
    {loading ? "Refreshing..." : "Refresh"}
  </span>
</button>


        </div>
      </div>
      )}


      {manageOpenV158 && <QRPassPCOManageV158 title="Manage Registered Items" records={filteredItems} onClose={()=>setManageOpenV158(false)} onView={(item)=>setSelectedItem(item)}/>}
      <Card title="Registered Items"
      >
        {/* RESULT COUNT */}
        {search && !loading && (
          <div className="mb-3 text-xs text-muted-foreground">
            Showing {filteredItems.length} of{" "}
            {registeredItems.length} item(s)
          </div>
        )}

        {/* Mobile: summary item cards keep owner, QR, status and details visible. */}
        <div className="divide-y divide-border lg:hidden">
          {loading ? (
            <p className="p-6 text-center text-sm text-muted-foreground">Loading registered items...</p>
          ) : filteredItems.length === 0 ? (
            <p className="p-6 text-center text-sm text-muted-foreground">No matching registered items.</p>
          ) : filteredItems.map((item) => (
            <article key={item.id} className="min-w-0 space-y-3 p-4">
              <div className="flex min-w-0 items-start justify-between gap-2">
                <div className="min-w-0 flex-1">
                  <p className="break-words text-sm font-semibold text-foreground">{item.item_name || "Unnamed item"}</p>
                  <p className="mt-1 text-[11px] font-mono text-muted-foreground">ITEM-{String(item.id).padStart(3, "0")}</p>
                </div>
                <div className="shrink-0"><StatusBadge status={registryStatus(item)} /></div>
              </div>
              <dl className="grid min-w-0 grid-cols-2 gap-3 text-xs">
                <div className="min-w-0"><dt className="text-muted-foreground">Owner</dt><dd className="mt-1 break-words font-medium">{item.user?.name || "Unknown"}</dd></div>
                <div className="min-w-0"><dt className="text-muted-foreground">Owner ID</dt><dd className="mt-1 break-all font-mono">{item.user?.username || "—"}</dd></div>
                <div className="min-w-0"><dt className="text-muted-foreground">Category</dt><dd className="mt-1 break-words">{item.item_type || "—"}</dd></div>
                <div className="min-w-0"><dt className="text-muted-foreground">Registered</dt><dd className="mt-1">{item.created_at ? new Date(item.created_at).toLocaleDateString("en-PH", {month:"short",day:"numeric",year:"numeric"}) : "—"}</dd></div>
                <div className="min-w-0"><dt className="text-muted-foreground">Serial number</dt><dd className="mt-1 break-all font-mono">{item.serial_number || "—"}</dd></div>
                <div className="min-w-0"><dt className="text-muted-foreground">QR ID</dt><dd className="mt-1 break-all font-mono text-primary">{item.qr_code || "Not issued"}</dd></div>
              </dl>
              <button type="button" onClick={() => setSelectedItem(item)}
                className="w-full rounded-xl border border-border bg-card px-4 py-3 text-sm font-semibold text-foreground hover:bg-muted">
                <Eye size={14} className="mr-2 inline" />View Details
              </button>
            </article>
          ))}
        </div>
        {/* Desktop: retain the full sortable/searchable records table. */}
        <div className="hidden overflow-x-auto lg:block">
          <table className="w-full">
            <thead>
              <tr className="bg-[#fafbfc]">
                {[
                  "Owner",
                  "Owner ID",
                  "Item",
                  "Type",
                  "Brand / Model",
                  "Serial Number",
                  "QR ID",
                  "Date Registered",
                  "Status",
                  "Action",
                ].map((heading) => (
                  <th
                    key={heading}
                    className="text-left py-2 px-3 text-xs text-muted-foreground font-medium whitespace-nowrap"
                  >
                    {heading}
                  </th>
                ))}
              </tr>
            </thead>

            <tbody>
              {loading ? (
                <tr>
                  <td
                    colSpan={10}
                    className="text-center py-8 text-sm text-muted-foreground"
                  >
                    Loading registered items...
                  </td>
                </tr>
              ) : filteredItems.length === 0 ? (
                <tr>
                  <td
                    colSpan={10}
                    className="text-center py-8 text-sm text-muted-foreground"
                  >
                    {search
                      ? "No matching registered items found."
                      : "No registered items found."}
                  </td>
                </tr>
              ) : (
                filteredItems.map((item) => (
                  <tr
                    key={item.id}
                    className="border-t border-[#cfd8e6] hover:bg-[#eef2fc] transition-colors"
                  >
                    {/* OWNER */}
                    <td className="py-3 px-3 text-sm font-medium whitespace-nowrap">
                      {item.user?.name ?? "Unknown"}
                    </td>

                    {/* OWNER ID */}
                    <td className="py-3 px-3 text-xs font-mono text-muted-foreground whitespace-nowrap">
                      {item.user?.username ?? "—"}
                    </td>

                    {/* ITEM */}
                    <td className="py-3 px-3 text-sm font-medium whitespace-nowrap">
                      {item.item_name}
                    </td>

                    {/* TYPE */}
                    <td className="py-3 px-3 text-xs text-muted-foreground whitespace-nowrap">
                      {item.item_type}
                    </td>

                    {/* BRAND / MODEL */}
                    <td className="py-3 px-3 text-xs text-muted-foreground whitespace-nowrap">
                      {item.brand_model || "—"}
                    </td>

                    {/* SERIAL NUMBER */}
                    <td className="py-3 px-3 text-xs font-mono whitespace-nowrap">
                      {item.serial_number}
                    </td>

                    {/* QR ID */}
                    <td className="py-3 px-3 text-xs font-mono text-primary whitespace-nowrap">
                      {item.qr_code || "Not issued"}
                    </td>

                    {/* DATE REGISTERED */}
                    <td className="py-3 px-3 text-xs text-muted-foreground whitespace-nowrap">
                      {new Date(
                        item.created_at
                      ).toLocaleDateString("en-PH", {
                        year: "numeric",
                        month: "short",
                        day: "numeric",
                      })}
                    </td>

                    {/* STATUS */}
                    <td className="py-3 px-3">
                      <StatusBadge
                        status={registryStatus(item)}
                      />
                    </td>

                    {/* ACTION */}
                    <td className="py-3 px-3">
                      <button
                        type="button"
                        onClick={() =>
                          setSelectedItem(item)
                        }
                        className="inline-flex items-center gap-1.5 rounded-md border border-[#cfd8e6] bg-white px-3 py-1.5 text-xs font-semibold text-primary hover:bg-[#eef2fc]"
          >
                        <Eye size={13} />
                        View
                      </button>
                    </td>
                                        </tr>
                                      ))
                                    )}
                                  </tbody>
                                </table>
                              </div>
                            </Card>

                            {/* REGISTERED ITEM DETAILS MODAL */}
                            {selectedItem && (
                              <div
                                className="fixed inset-0 z-[9999] flex items-center justify-center bg-black/55 p-4"
                                onClick={() =>
                                  setSelectedItem(null)
                                }
                              >
                                <div
                                  className="flex max-h-[92dvh] w-full max-w-2xl flex-col overflow-hidden rounded-2xl bg-card shadow-2xl"
                                  onClick={(e) =>
                                    e.stopPropagation()
                                  }
                                >
                                  {/* HEADER */}
                                  <div className="flex items-start justify-between gap-4 border-b border-[#dce3ee] bg-[#fafbfc] px-5 py-4">
                                    <div>
                                      <h2 className="text-lg font-bold text-foreground">
                                        Registered Item Details
                                      </h2>

                                      <p className="mt-0.5 text-xs text-muted-foreground">
                                        Complete registration information for this campus item.
                                      </p>
                                    </div>

                                    <button
                                      type="button"
                                      onClick={() =>
                                        setSelectedItem(null)
                                      }
                                      className="flex h-8 w-8 items-center justify-center rounded-md text-muted-foreground hover:bg-[#eef2fc] hover:text-primary"
          >
                                      <X size={18} />
                                    </button>
                                  </div>

                                  {/* CONTENT */}
                                  <div className="min-h-0 flex-1 overflow-y-auto p-4 sm:p-5">
                                    <div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
                                      <div className="rounded-lg border border-[#dce3ee] p-3">
                                        <p className="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">
                                          Owner
                                        </p>
                                        <p className="mt-1 text-sm font-semibold text-foreground">
                                          {selectedItem.user?.name ?? "Unknown"}
                                        </p>
                                      </div>

                                      <div className="rounded-lg border border-[#dce3ee] p-3">
                                        <p className="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">
                                          Owner ID
                                        </p>
                                        <p className="mt-1 font-mono text-sm text-foreground">
                                          {selectedItem.user?.username ?? "—"}
                                        </p>
                                      </div>

                                      <div className="rounded-lg border border-[#dce3ee] p-3">
                                        <p className="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">
                                          Item Name
                                        </p>
                                        <p className="mt-1 text-sm font-semibold text-foreground">
                                          {selectedItem.item_name || "—"}
                                        </p>
                                      </div>

                                      <div className="rounded-lg border border-[#dce3ee] p-3">
                                        <p className="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">
                                          Item Type
                                        </p>
                                        <p className="mt-1 text-sm text-foreground">
                                          {selectedItem.item_type || "—"}
                                        </p>
                                      </div>

                                      {(() => {
                                        const detailCards = [
                                          selectedItem.brand_model &&
                                          String(
                                            selectedItem.brand_model
                                          ).trim() &&
                                          String(
                                            selectedItem.brand_model
                                          ).toUpperCase() !== "N/A"
                                            ? {
                                                label: "Brand / Model",
                                                value:
                                                  selectedItem.brand_model,
                                                mono: false,
                                              }
                                            : null,

                                          selectedItem.serial_number &&
                                          String(
                                            selectedItem.serial_number
                                          ).trim()
                                            ? {
                                                label: "Serial Number",
                                                value:
                                                  selectedItem.serial_number,
                                                mono: true,
                                              }
                                            : null,

                                          selectedItem.color &&
                                          String(
                                            selectedItem.color
                                          ).trim() &&
                                          String(
                                            selectedItem.color
                                          ).toUpperCase() !== "N/A"
                                            ? {
                                                label: "Color",
                                                value:
                                                  selectedItem.color,
                                                mono: false,
                                              }
                                            : null,

                                          [
                                            "sports equipment",
                                            "other equipment",
                                          ].includes(
                                            String(
                                              selectedItem.item_type ?? ""
                                            ).toLowerCase()
                                          )
                                            ? {
                                                label: "Quantity",
                                                value:
                                                  selectedItem.quantity ||
                                                  "1",
                                                mono: false,
                                              }
                                            : null,
                                        ].filter(Boolean) as {
                                          label: string;
                                          value: any;
                                          mono: boolean;
                                        }[];

                                        return detailCards.map(
                                          (detail, index) => {
                                            const isLastOddCard =
                                              detailCards.length % 2 === 1 &&
                                              index ===
                                                detailCards.length - 1;

                                            return (
                                              <div
                                                key={detail.label}
                                                className={`rounded-lg border border-[#dce3ee] p-3 ${
                                                  isLastOddCard
                                                    ? "sm:col-span-2"
                                                    : ""
                                                }`}
                                              >
                                                <p className="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">
                                                  {detail.label}
                                                </p>

                                                <p
                                                  className={`mt-1 text-sm text-foreground ${
                                                    detail.mono
                                                      ? "font-mono"
                                                      : ""
                                                  }`}
                                                >
                                                  {detail.value}
                                                </p>
                                              </div>
                                            );
                                          }
                                        );
                                      })()}

                                      <div className="rounded-lg border border-[#dce3ee] p-3 sm:col-span-2">
                                        <p className="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">
                                          Purpose / Reason for Bringing
                                        </p>
                                        <p className="mt-1 whitespace-pre-wrap text-sm text-foreground">
                                          {selectedItem.purpose || "—"}
                                        </p>
                                      </div>

                                      <div className="rounded-lg border border-[#dce3ee] bg-[#f8fafc] p-3 sm:col-span-2">
                                        <p className="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">
                                          Description / Specifications
                                        </p>
                                        <p className="mt-1 whitespace-pre-wrap break-words text-sm leading-relaxed text-foreground">
                                          {selectedItem.complete_description ||
                                            selectedItem.description ||
                                            "No additional description or specifications were provided."}
                                        </p>
                                      </div>

                                      {selectedItem.accessories_included && (
                                        <div className="rounded-lg border border-[#dce3ee] p-3 sm:col-span-2">
                                          <p className="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">
                                            Accessories Included
                                          </p>
                                          <p className="mt-1 text-sm text-foreground">
                                            {selectedItem.accessories_included}
                                          </p>
                                        </div>
                                      )}

                                      {selectedItem.computer_type && (
                                        <div className="rounded-lg border border-[#dce3ee] p-3">
                                          <p className="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">
                                            Computer / Laptop Type
                                          </p>
                                          <p className="mt-1 text-sm text-foreground">
                                            {selectedItem.computer_type}
                                          </p>
                                        </div>
                                      )}

                                      {selectedItem.processor && (
                                        <div className="rounded-lg border border-[#dce3ee] p-3">
                                          <p className="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">
                                            Processor
                                          </p>
                                          <p className="mt-1 text-sm text-foreground">
                                            {selectedItem.processor}
                                          </p>
                                        </div>
                                      )}

                                      {selectedItem.memory && (
                                        <div className="rounded-lg border border-[#dce3ee] p-3">
                                          <p className="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">
                                            Memory / RAM
                                          </p>
                                          <p className="mt-1 text-sm text-foreground">
                                            {selectedItem.memory}
                                          </p>
                                        </div>
                                      )}

                                      {selectedItem.hard_drive && (
                                        <div className="rounded-lg border border-[#dce3ee] p-3">
                                          <p className="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">
                                            Storage
                                          </p>
                                          <p className="mt-1 text-sm text-foreground">
                                            {selectedItem.hard_drive}
                                          </p>
                                        </div>
                                      )}

                                      {selectedItem.operating_system && (
                                        <div className="rounded-lg border border-[#dce3ee] p-3">
                                          <p className="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">
                                            Operating System
                                          </p>
                                          <p className="mt-1 text-sm text-foreground">
                                            {selectedItem.operating_system}
                                          </p>
                                        </div>
                                      )}

                                      <div className="rounded-lg border border-[#dce3ee] p-3">
                                        <p className="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">
                                          QR ID
                                        </p>
                                        <p className="mt-1 font-mono text-sm text-primary">
                                          {selectedItem.qr_code || "Not issued"}
                                        </p>
                                      </div>

                                      <div className="rounded-lg border border-[#dce3ee] p-3">
                                        <p className="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">
                                          QR Expiration
                                        </p>
                                        <p className="mt-1 text-sm text-foreground">
                                          {selectedItem.qr_expires_at
                                            ? new Date(
                                                selectedItem.qr_expires_at
                                              ).toLocaleString("en-PH", {
                                                year: "numeric",
                                                month: "short",
                                                day: "numeric",
                                                hour: "numeric",
                                                minute: "2-digit",
                                              })
                                            : "No expiration set"}
                                        </p>
                                      </div>

                                      <div className="rounded-lg border border-[#dce3ee] p-3">
                                        <p className="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">
                                          Date Registered
                                        </p>
                                        <p className="mt-1 text-sm text-foreground">
                                          {selectedItem.created_at
                                            ? new Date(
                                                selectedItem.created_at
                                              ).toLocaleString("en-PH", {
                                                year: "numeric",
                                                month: "short",
                                                day: "numeric",
                                                hour: "numeric",
                                                minute: "2-digit",
                                              })
                                            : "—"}
                                        </p>
                                      </div>

                                      <div className="rounded-lg border border-[#dce3ee] p-3">
                                        <p className="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">
                                          Status
                                        </p>
                                        <div className="mt-1">
                                          <StatusBadge
                                            status={
                                              selectedItem.is_flagged
                                                ? "Flagged"
                                                : selectedItem.is_expired
                                                ? "Expired"
                                                : selectedItem.is_active_qr
                                                ? "Active"
                                                : selectedItem.status === "pending"
                                                ? "Pending"
                                                : selectedItem.registry_status ||
                                                  "Unknown"
                                            }
                                          />
                                        </div>
                                      </div>
                                    </div>
                                  </div>

                                  {/* FOOTER */}
                                  <div className="shrink-0 flex justify-end border-t border-border bg-card px-4 py-3 sm:px-5">
                                    <button
                                      type="button"
                                      onClick={() =>
                                        setSelectedItem(null)
                                      }
                                      className="rounded-md bg-primary px-4 py-2 text-xs font-semibold text-white transition-colors hover:!bg-[#eef2ff] hover:!text-[#17336d] hover:!border-[#a8bde4] focus-visible:!ring-0 focus-visible:!shadow-none"
           data-qrpass-neutral-v169="true">
                                      Close
                                    </button>
                                  </div>
                                </div>
                              </div>
                            )}
                          </div>
                        );
                      }

/* QRPASS_PCO_REPORTS_SYSADMIN_LAYOUT_V160 */
/* QRPASS_PCO_REPORTS_WHITE_DROPDOWNS_V161 */
function PCOReports() {
  type PCOReportKey = "monthly" | "issuance" | "approval" | "registry";
  type PCOPeriod = "day" | "week" | "month";
  type PCOFormat = "pdf" | "xlsx";
  const reportOptions: { key: PCOReportKey; name: string }[] = [
    { key: "monthly", name: "Monthly Item Registration Summary" },
    { key: "issuance", name: "QR Code Issuance Log" },
    { key: "approval", name: "Approval History with Timestamps" },
    { key: "registry", name: "Registered Items Export" },
  ];
  const [report, setReport] = useState<PCOReportKey>("monthly");
  const [period, setPeriod] = useState<PCOPeriod>("day");
  const [busy, setBusy] = useState(false);
  const [message, setMessage] = useState("");

  const stringify = (value: unknown): string =>
    value === undefined || value === null ? "" : String(value);
  const showDate = (value: unknown): string => {
    if (!value) return "";
    const parsed = new Date(String(value));
    return Number.isNaN(parsed.getTime()) ? stringify(value) : parsed.toLocaleString("en-PH");
  };
  const periodBounds = () => {
    const now = new Date();
    const start = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const end = new Date(start);
    if (period === "day") {
      end.setDate(end.getDate() + 1);
    } else if (period === "week") {
      start.setDate(start.getDate() - ((start.getDay() + 6) % 7));
      end.setTime(start.getTime());
      end.setDate(end.getDate() + 7);
    } else {
      start.setDate(1);
      end.setTime(start.getTime());
      end.setMonth(end.getMonth() + 1);
    }
    return { start, end };
  };

  async function generate(format: PCOFormat) {
    if (busy) return;
    setBusy(true);
    setMessage("");
    try {
      // Fetch fresh PCO records; never use Sysadmin users/audit/security endpoints.
      const response = await getAllItems();
      if (!Array.isArray(response?.items)) {
        throw new Error("The item records could not be loaded.");
      }
      const items = response.items as any[];
      const bounds = periodBounds();
      const stamp = (item: any) => report === "issuance" || report === "approval"
        ? (item.approved_at ?? item.updated_at ?? item.created_at)
        : item.created_at;
      const records = items.filter((item: any) => {
        const status = String(item.status ?? "").toLowerCase();
        if (report === "issuance" && !(status === "approved" && item.qr_code)) return false;
        if (report === "approval" && status !== "approved") return false;
        if (report === "registry" && (status !== "approved" || item.is_flagged)) return false;
        const dateValue = stamp(item);
        if (!dateValue) return false;
        const date = new Date(dateValue);
        return !Number.isNaN(date.getTime()) && date >= bounds.start && date < bounds.end;
      });
      if (!records.length) {
        setMessage("No PCO records found for the selected report and period.");
        return;
      }
      const headers = [
        "Registered At", "Owner", "Owner ID", "Item", "Category",
        "Brand / Model", "Serial Number", "QR ID", "Approved At", "Status"
      ];
      const rows: string[][] = records.map((item: any) => [
        showDate(item.created_at), stringify(item.user?.name ?? "Unknown"),
        stringify(item.user?.username), stringify(item.item_name),
        stringify(item.item_type ?? item.category), stringify(item.brand_model),
        stringify(item.serial_number), stringify(item.qr_code),
        showDate(item.approved_at ?? (String(item.status).toLowerCase() === "approved" ? item.updated_at : null)),
        stringify(item.status),
      ]);
      const label = reportOptions.find(option => option.key === report)?.name ?? "PCO Report";
      const filename = `QRPass-PCO-${report}-${period}-${new Date().toISOString().slice(0, 10)}`;
      if (format === "xlsx") {
        const sheet = XLSX.utils.aoa_to_sheet([headers, ...rows]);
        sheet["!cols"] = headers.map((_value, i) => ({ wch: i === 0 || i === 8 ? 22 : 18 }));
        const book = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(book, sheet, "PCO Report");
        XLSX.writeFile(book, `${filename}.xlsx`);
      } else {
        const pdf = new jsPDF({ orientation: "landscape" });
        pdf.setFontSize(16);
        pdf.text(label, 14, 18);
        pdf.setFontSize(9);
        pdf.text("University of Cebu - Main Campus | Property Custodian Office", 14, 26);
        pdf.text(`Period: ${period}   Records: ${records.length}`, 14, 33);
        autoTable(pdf, {
          startY: 40, head: [headers], body: rows,
          styles: { fontSize: 7, cellPadding: 2 },
          headStyles: { fillColor: [26, 58, 123] },
        });
        pdf.save(`${filename}.pdf`);
      }
      setMessage(`${label}: ${records.length} records downloaded.`);
    } catch (error) {
      setMessage(error instanceof Error ? error.message : "Could not generate the PCO report.");
    } finally {
      setBusy(false);
    }
  }

  return (
    <div id="qrpass-pco-reports-v160" className="w-full min-w-0 space-y-4 overflow-x-hidden">
      <PageHeader title="Downloadable Reports" subtitle="Generate and export official PCO item registration reports." />
      <div className="overflow-hidden rounded-2xl border border-[#dce3ee] bg-white shadow-sm">
        <div className="border-b border-[#e6ebf2] px-5 py-4 sm:px-6">
          <h3 className="text-lg font-semibold leading-none text-[#17336d]">Generate a report</h3>
        </div>
        <div className="grid gap-5 px-5 py-5 sm:px-6 lg:grid-cols-2">
          <div>
            <label htmlFor="pco-report-type-v160" className="mb-2 block text-sm font-semibold leading-6 text-[#17336d]">Report Type</label>
            <select id="pco-report-type-v160" aria-label="Report type"
              value={report}
              onChange={event => { setReport(event.target.value as PCOReportKey); setMessage(""); }}
              className="h-14 w-full rounded-xl border border-[#cbd5e1] bg-white px-4 text-base font-medium text-[#17336d] outline-none transition hover:border-[#9fb8e4] hover:bg-[#eef2ff] focus:border-[#80a4df] focus:bg-white focus:ring-2 focus:ring-[#dbe7ff] !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
            
    ref={(element) => { if (element) { element.style.setProperty("background", "#ffffff", "important"); element.style.setProperty("background-color", "#ffffff", "important"); } }}
    onMouseEnter={(event) => { event.currentTarget.style.setProperty("background", "#eef2ff", "important"); event.currentTarget.style.setProperty("background-color", "#eef2ff", "important"); }}
    onMouseLeave={(event) => { event.currentTarget.style.setProperty("background", "#ffffff", "important"); event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
    onFocus={(event) => { event.currentTarget.style.setProperty("background", "#ffffff", "important"); event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
    onBlur={(event) => { event.currentTarget.style.setProperty("background", "#ffffff", "important"); event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
            >
              {reportOptions.map(option => <option key={option.key} value={option.key}>{option.name}</option>)}
            </select>
          </div>
          <div>
            <label htmlFor="pco-report-period-v160" className="mb-2 block text-sm font-semibold leading-6 text-[#17336d]">Filter by Date</label>
            <select id="pco-report-period-v160" aria-label="Filter reports by date"
              value={period}
              onChange={event => { setPeriod(event.target.value as PCOPeriod); setMessage(""); }}
              className="h-14 w-full rounded-xl border border-[#cbd5e1] bg-white px-4 text-base font-medium text-[#17336d] outline-none transition hover:border-[#9fb8e4] hover:bg-[#eef2ff] focus:border-[#80a4df] focus:bg-white focus:ring-2 focus:ring-[#dbe7ff] !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
            
    ref={(element) => { if (element) { element.style.setProperty("background", "#ffffff", "important"); element.style.setProperty("background-color", "#ffffff", "important"); } }}
    onMouseEnter={(event) => { event.currentTarget.style.setProperty("background", "#eef2ff", "important"); event.currentTarget.style.setProperty("background-color", "#eef2ff", "important"); }}
    onMouseLeave={(event) => { event.currentTarget.style.setProperty("background", "#ffffff", "important"); event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
    onFocus={(event) => { event.currentTarget.style.setProperty("background", "#ffffff", "important"); event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
    onBlur={(event) => { event.currentTarget.style.setProperty("background", "#ffffff", "important"); event.currentTarget.style.setProperty("background-color", "#ffffff", "important"); }}
            >
              <option value="day">Today</option>
              <option value="week">This Week</option>
              <option value="month">This Month</option>
            </select>
          </div>
        </div>
        <div className="border-t border-[#e6ebf2] px-5 py-4 sm:px-6">
          <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-end">
            {([
              { key: "pdf", label: "Download PDF" },
              { key: "xlsx", label: "Download Excel" },
            ] as const).map(({key, label}) => (
              <button key={key} type="button" disabled={busy}
                onClick={() => void generate(key)}
                className="qrpass-report-download-registration-v71">
                <Download size={17} />{busy ? "Preparing..." : label}
              </button>
            ))}
          </div>
        </div>
        {message && <div className="border-t border-[#e6ebf2] px-5 py-3 sm:px-6">
          <p role="status" className="text-sm text-[#17336d]">{message}</p>
        </div>}
      </div>
    </div>
  );
}
function PCONotifications() {
  const [manageOpenV158,setManageOpenV158]=useState(false);
  const [notifications, setNotifications] = useState<any[]>([]);
  const [unreadCount, setUnreadCount] = useState(0);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [processingId, setProcessingId] = useState<number | null>(null);
  const [markingAll, setMarkingAll] = useState(false);

  async function loadNotifications(
    showLoading = true
  ) {
    try {
      if (showLoading) {
        setLoading(true);
      }

      setError("");

      const data =
        await getNotifications();

      setNotifications(
        Array.isArray(
          data?.notifications
        )
          ? data.notifications
          : []
      );

      setUnreadCount(
        Number(
          data?.unread_count ??
          0
        )
      );
    } catch (err) {
      console.error(
        "Failed to load PCO notifications:",
        err
      );

      setError(
        err instanceof Error
          ? err.message
          : "Failed to load notifications."
      );
    } finally {
      if (showLoading) {
        setLoading(false);
      }
    }
  }

  useEffect(() => {
    loadNotifications(true);

    const interval =
      window.setInterval(
        () => {
          loadNotifications(false);
        },
        15000
      );

    const handleFocus =
      () => {
        loadNotifications(false);
      };

    const handleVisibility =
      () => {
        if (
          document.visibilityState ===
          "visible"
        ) {
          loadNotifications(false);
        }
      };

    window.addEventListener(
      "focus",
      handleFocus
    );

    document.addEventListener(
      "visibilitychange",
      handleVisibility
    );

    return () => {
      window.clearInterval(
        interval
      );

      window.removeEventListener(
        "focus",
        handleFocus
      );

      document.removeEventListener(
        "visibilitychange",
        handleVisibility
      );
    };
  }, []);

  async function handleMarkRead(id: number) {
    try {
      setProcessingId(id);

      await markNotificationRead(id);

      setNotifications((current) =>
        current.map((notification) =>
          notification.id === id
            ? {
                ...notification,
                is_read: true,
                read_at:
                  notification.read_at ??
                  new Date().toISOString(),
              }
            : notification
        )
      );

      setUnreadCount((current) =>
        Math.max(0, current - 1)
      );
    } catch (err) {
      console.error(
        "Failed to mark notification as read:",
        err
      );

      alert(
        err instanceof Error
          ? err.message
          : "Failed to mark notification as read."
      );
    } finally {
      setProcessingId(null);
    }
  }

  async function handleMarkAllRead() {
    try {
      setMarkingAll(true);

      await markAllNotificationsRead();

      setNotifications((current) =>
        current.map((notification) => ({
          ...notification,
          is_read: true,
          read_at:
            notification.read_at ??
            new Date().toISOString(),
        }))
      );

      setUnreadCount(0);
    } catch (err) {
      console.error(
        "Failed to mark all notifications as read:",
        err
      );

      alert(
        err instanceof Error
          ? err.message
          : "Failed to mark all notifications as read."
      );
    } finally {
      setMarkingAll(false);
    }
  }

  function formatNotificationDate(
    dateString: string
  ) {
    if (!dateString) {
      return "—";
    }

    const date = new Date(dateString);

    if (Number.isNaN(date.getTime())) {
      return "—";
    }

    return date.toLocaleString([], {
      year: "numeric",
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  function getNotificationStyle(type: string) {
    switch (
      String(type ?? "").toLowerCase()
    ) {
      case "new_item_registration":
        return {
          background:
            "bg-yellow-50 border-yellow-200",
          iconBackground:
            "bg-yellow-100 text-yellow-700",
        };

      case "item_approved":
        return {
          background:
            "bg-green-50 border-green-200",
          iconBackground:
            "bg-green-100 text-green-700",
        };

      case "item_submitted":
        return {
          background:
            "bg-blue-50 border-blue-200",
          iconBackground:
            "bg-blue-100 text-blue-700",
        };

      case "lost_found_claim":
        return {
          background:
            "bg-purple-50 border-purple-200",
          iconBackground:
            "bg-purple-100 text-purple-700",
        };

      default:
        return {
          background:
            "bg-muted/30 border-[#cfd8e6]",
          iconBackground:
            "bg-muted text-muted-foreground",
        };
    }
  }

  const readCount =
    notifications.length - unreadCount;

  return (
    <div className="w-full min-w-0 space-y-5 overflow-x-hidden">      {manageOpenV158 && <QRPassPCOManageV158 title="Manage Notifications" records={notifications} onClose={()=>setManageOpenV158(false)}/>}
      {/* HEADER */}
      <div className="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <PageHeader
          title="Notifications"
          subtitle="PCO item registration alerts and system updates."
        />

        <div className="flex w-full min-w-0 flex-wrap items-center gap-2 md:w-auto">
          <button type="button" title="Manage Notifications" aria-label="Manage Notifications"
            onClick={()=>setManageOpenV158(true)}
            className="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-[#c7d2fe] bg-white text-[#17336d] hover:bg-[#eef2ff] !hidden md:!inline-flex"
          >
            <SlidersHorizontal size={18} strokeWidth={1.8}/>
          </button>
  
<button
  type="button"
  title="Refresh"
  aria-label="Refresh"
  onClick={() => loadNotifications(true)}
  disabled={loading}
  className="!inline-flex md:!hidden !w-auto !min-w-[115px] h-11 shrink-0 flex-nowrap items-center justify-center gap-2 whitespace-nowrap rounded-xl border border-[#c7d2fe] !bg-white px-4 py-2 text-sm font-semibold text-[#17336d] hover:!bg-[#eef2ff] disabled:opacity-50"
          >
  <RefreshCw size={16} className="shrink-0" />
  <span className="!inline whitespace-nowrap">
    {loading ? "Refreshing..." : "Refresh"}
  </span>
</button>


          <button
            onClick={handleMarkAllRead}
            disabled={
              markingAll ||
              unreadCount === 0
            }
            className="px-3 py-2 bg-primary text-white rounded-md text-xs font-semibold disabled:opacity-50 transition-colors hover:!bg-[#eef2ff] hover:!text-[#17336d] hover:!border-[#a8bde4] focus-visible:!ring-0 focus-visible:!shadow-none"
          >
            {markingAll
              ? "Marking..."
              : "Mark All as Read"}
          </button>
        </div>
      </div>

      {/* ERROR */}
      {error && (
        <div className="px-4 py-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700">
          {error}
        </div>
      )}

      {/* SUMMARY */}
      <StatisticalCardsSection>
      <div className="grid min-w-0 grid-cols-2 gap-3 sm:grid-cols-3">
        <StatCard
          label="All Notifications"
          value={String(
            notifications.length
          )}
          icon={
            <FileText size={20} />
          }
          color="#1a3a7b"
        />

        <StatCard
          label="Unread"
          value={String(unreadCount)}
          icon={
            <AlertTriangle size={20} />
          }
          color="#2f5fd6"
        />

        <StatCard
          label="Read"
          value={String(readCount)}
          icon={
            <CheckCircle size={20} />
          }
          color="#2ecc71"
        />
      </div>
      </StatisticalCardsSection>

      {/* NOTIFICATIONS */}
      <Card title="All Notifications">
        <div className="p-3">
          {loading ? (
            <div className="py-12 text-center">
              <p className="text-sm text-muted-foreground">
                Loading notifications...
              </p>
            </div>
          ) : notifications.length === 0 ? (
            <div className="py-12 text-center">
              <CheckCircle
                size={36}
                className="mx-auto mb-3 text-muted-foreground"
              />

              <p className="text-sm font-semibold text-foreground">
                No notifications
              </p>

              <p className="text-xs text-muted-foreground mt-1">
                New item registration
                requests will appear here.
              </p>
            </div>
          ) : (
            <div className="space-y-2">
              {notifications.map(
                (notification: any) => {
                  const styles =
                    getNotificationStyle(
                      notification.type
                    );

                  const isRead =
                    Boolean(
                      notification.is_read
                    );

                  return (
                    <div
                      key={
                        notification.id
                      }
                      className={`border rounded-lg p-4 transition-colors ${
                        isRead
                          ? "bg-white border-[#cfd8e6]"
                          : styles.background
                      }`}
                    >
                      <div className="flex items-start gap-3">
                        {/* ICON */}
                        <div
                          className={`w-9 h-9 rounded-full flex items-center justify-center shrink-0 ${
                            isRead
                              ? "bg-muted text-muted-foreground"
                              : styles.iconBackground
                          }`}
                        >
                          {notification.type ===
                          "new_item_registration" ? (
                            <Clock
                              size={17}
                            />
                          ) : notification.type ===
                            "item_approved" ? (
                            <CheckCircle
                              size={17}
                            />
                          ) : (
                            <FileText
                              size={17}
                            />
                          )}
                        </div>

                        {/* CONTENT */}
                        <div className="flex-1 min-w-0">
                          <div className="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between">
                            <div>
                              <div className="flex items-center gap-2">
                                <h3
                                  className={`text-sm ${
                                    isRead
                                      ? "font-medium"
                                      : "font-bold"
                                  }`}
                                >
                                  {notification.title ??
                                    "Notification"}
                                </h3>

                                {!isRead && (
                                  <span className="w-2 h-2 rounded-full bg-primary shrink-0" />
                                )}
                              </div>

                              <p className="text-xs text-muted-foreground mt-1 leading-relaxed">
                                {notification.message}
                              </p>
                            </div>

                            <span className="text-[11px] text-muted-foreground whitespace-nowrap">
                              {formatNotificationDate(
                                notification.created_at
                              )}
                            </span>
                          </div>

                          {/* ACTION */}
                          {!isRead && (
                            <div className="mt-3">
                              <button
                                onClick={() =>
                                  handleMarkRead(
                                    notification.id
                                  )
                                }
                                disabled={
                                  processingId ===
                                  notification.id
                                }
                                className="text-xs text-primary font-semibold hover:underline disabled:opacity-50"
                              >
                                {processingId ===
                                notification.id
                                  ? "Marking..."
                                  : "Mark as Read"}
                              </button>
                            </div>
                          )}

                          {isRead &&
                            notification.read_at && (
                              <p className="text-[10px] text-muted-foreground mt-2">
                                Read{" "}
                                {formatNotificationDate(
                                  notification.read_at
                                )}
                              </p>
                            )}
                        </div>
                      </div>
                    </div>
                  );
                }
              )}
            </div>
          )}
        </div>
      </Card>
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════════════
// ADMIN PAGES
// ══════════════════════════════════════════════════════════════════════════════

function AdminDashboard({ onNavigate }: { onNavigate?: (index: number) => void }) {
  return (
    <div className="w-full min-w-0">
      <PageHeader title="Overview Dashboard" />
    </div>
  );
}


function AdminRecords({ embedded = false, selectedType = "All", sharedPeriod = "all", sharedStart = "", sharedEnd = "" }: { embedded?: boolean; selectedType?: string; sharedPeriod?: CSUDatePeriod; sharedStart?: string; sharedEnd?: string } = {}) {
  const [records, setRecords] = useState<any[]>([]);
  const [summary, setSummary] = useState({
    total_records: 0,
    this_month: 0,
    flagged: 0,
  });

  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [search, setSearch] = useState("");
  const [typeFilter, setTypeFilter] = useState("All");
  const effectiveTypeFilter = embedded ? selectedType : typeFilter;
  const [periodFilter, setPeriodFilter] = useState<"all" | "day" | "week" | "month">("all");

  async function loadRecords() {
    try {
      setLoading(true);
      setError("");

      const data = await getSystemRecords();

      setRecords(data.records ?? []);

      setSummary(
        data.summary ?? {
          total_records: 0,
          this_month: 0,
          flagged: 0,
        }
      );
    } catch (err) {
      console.error(
        "Failed to load system records:",
        err
      );

      setError(
        err instanceof Error
          ? err.message
          : "Failed to load system records."
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadRecords();
  }, []);

  function formatDate(dateString: string) {
    if (!dateString) return "—";

    const date = new Date(dateString);

    if (Number.isNaN(date.getTime())) {
      return "—";
    }

    return date.toLocaleDateString();
  }

  function formatTime(dateString: string) {
    if (!dateString) return "—";

    const date = new Date(dateString);

    if (Number.isNaN(date.getTime())) {
      return "—";
    }

    return date.toLocaleTimeString([], {
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  const recordTypes = [
    "All",
    "Item Registration",
    "QR Scan",
    "Security Incident",
    "Lost & Found",
  ];

  const filteredRecords = records.filter(
    (record) => {
      const matchesType =
        effectiveTypeFilter === "All" ||
        record.record_type === effectiveTypeFilter;

      const query = search
        .trim()
        .toLowerCase();

      if (!matchesType) {
        return false;
      }

      if (embedded && !csuMatchesPeriod(record.date ?? record.created_at, sharedPeriod, sharedStart, sharedEnd)) return false;
      if (!embedded && periodFilter !== "all") {
        const date = new Date(record.date ?? "");
        if (Number.isNaN(date.getTime())) return false;
        const now = new Date();
        const start = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        if (periodFilter === "week") start.setDate(start.getDate() - ((start.getDay() + 6) % 7));
        if (periodFilter === "month") start.setDate(1);
        const end = new Date(start);
        if (periodFilter === "day") end.setDate(end.getDate() + 1);
        if (periodFilter === "week") end.setDate(end.getDate() + 7);
        if (periodFilter === "month") end.setMonth(end.getMonth() + 1);
        if (date < start || date >= end) return false;
      }

      if (!query) {
        return true;
      }

      return [
        record.record_type,
        record.title,
        record.description,
        record.user_name,
        record.user_id,
        record.status,
      ].some((value) =>
        String(value ?? "")
          .toLowerCase()
          .includes(query)
      );
    }
  );

  function exportCSV() {
    if (filteredRecords.length === 0) {
      alert(
        "There are no system records to export."
      );
      return;
    }

    const headers = [
      "Date",
      "Time",
      "Record Type",
      "Title",
      "Description",
      "User",
      "User ID",
      "Status",
    ];

    const rows = filteredRecords.map(
      (record) => [
        formatDate(record.date),
        formatTime(record.date),
        record.record_type ?? "",
        record.title ?? "",
        record.description ?? "",
        record.user_name ?? "",
        record.user_id ?? "",
        record.status ?? "",
      ]
    );

    const csvContent = [headers, ...rows]
      .map((row) =>
        row
          .map((value) => {
            const text = String(
              value ?? ""
            ).replace(/"/g, '""');

            return `"${text}"`;
          })
          .join(",")
      )
      .join("\n");

    const blob = new Blob(
      [csvContent],
      {
        type: "text/csv;charset=utf-8;",
      }
    );

    const url =
      URL.createObjectURL(blob);

    const link =
      document.createElement("a");

    link.href = url;

    link.download = `qrpass-system-records-${periodFilter}-${new Date()
      .toISOString()
      .slice(0, 10)}.csv`;

    document.body.appendChild(link);

    link.click();

    document.body.removeChild(link);

    URL.revokeObjectURL(url);
  }

  function getStatusClasses(status: string) {
    const value = String(
      status ?? ""
    ).toLowerCase();

    if (
      value === "verified" ||
      value === "approved" ||
      value === "claimed" ||
      value === "resolved"
    ) {
      return "bg-green-100 text-green-700";
    }

    if (
      value === "flagged"
    ) {
      return "bg-red-100 text-red-700";
    }

    if (
      value === "pending"
    ) {
      return "bg-yellow-100 text-yellow-700";
    }

    if (
      value === "found"
    ) {
      return "bg-blue-100 text-blue-700";
    }

    return "bg-gray-100 text-gray-700";
  }

  return (
    <div className="space-y-5">
      {!embedded && <>
      {/* HEADER */}
      <div className="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <PageHeader
          title="System Transactions"
          subtitle="Search, filter, and export centralized QRPass transaction records."
        />

        <div className="flex gap-2">
          <button
            onClick={loadRecords}
            disabled={loading}
            className="px-3 py-2 border border-[#cfd8e6] rounded-md text-xs font-semibold hover:bg-muted disabled:opacity-50 inline-flex items-center justify-center gap-1.5 !border-0 !bg-transparent !shadow-none !text-[#17336d] !px-2 !py-1 hover:!bg-[#edf2ff] rounded-lg"
          > <RefreshCw size={13} className="shrink-0" />
            {loading
              ? "Refreshing..."
              : "Refresh"}
          </button>
        </div>
      </div>

      {/* ERROR */}
      {error && (
        <div className="px-4 py-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700">
          {error}
        </div>
      )}

      {/* SUMMARY */}

      {/* System transaction types — same compact filter tabs as audit activity. */}
      <div className="rounded-xl border border-[#cfd8e6] bg-white px-4 py-3 flex flex-wrap items-center gap-2">
        {recordTypes.map(type => (
          <button
            type="button"
            key={type}
            onClick={() => setTypeFilter(type)}
            aria-pressed={typeFilter === type}
            className={`rounded-full px-3 py-2 text-xs font-semibold transition-colors ${typeFilter === type ? "bg-[#17336d] text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200"}`}
          >
            {type === "All" ? "All Transactions" : type}
          </button>
        ))}
        <span className="ml-auto text-xs text-slate-500">{filteredRecords.length} matching transactions</span>
      </div>

      </>}
      {embedded && <div className="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-[#dce3ee] bg-white px-4 py-3">
        <div>
          <p className="text-sm font-semibold text-[#17336d]">{selectedType} Records</p>
          <p className="text-xs text-muted-foreground">{filteredRecords.length} matching transactions. CSV includes the active date and search filters.</p>
        </div>
        <div className="flex flex-wrap gap-2">
          <button type="button" onClick={loadRecords} disabled={loading} className="rounded-lg border border-[#cfd8e6] px-3 py-2 text-xs font-semibold hover:bg-muted disabled:opacity-50 inline-flex items-center justify-center gap-1.5 !border-0 !bg-transparent !shadow-none !text-[#17336d] !px-2 !py-1 hover:!bg-[#edf2ff] rounded-lg"
          > <RefreshCw size={13} className="shrink-0" />{loading ? "Refreshing..." : "Refresh"}</button>
        </div>
      </div>}
      {error && embedded && <div role="alert" className="rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">{error}</div>}
      {/* SEARCH AND DATE FILTER */}
      <div className="bg-white border border-[#cfd8e6] rounded-lg p-4">
        <div className="grid grid-cols-1 md:grid-cols-[1fr_200px] gap-3">
          <input
            type="text"
            value={search}
            onChange={(event) =>
              setSearch(
                event.target.value
              )
            }
            placeholder="Search records, users, items, status..."
            className="h-12 w-full min-w-0 rounded-xl border border-[#c7d2fe] bg-[#eef2ff] pl-10 pr-4 text-sm text-[#17336d] outline-none transition-colors focus:border-[#5278e7] focus:bg-white focus:ring-2 focus:ring-[#5278e7]/20"
          />

          <select
            value={periodFilter}
            onChange={(event) => setPeriodFilter(event.target.value as "all" | "day" | "week" | "month")}
            className="w-full px-3 py-2.5 border border-[#cfd8e6] rounded-md text-sm bg-white"
            aria-label="Record date range"
          >
            <option value="all">All Dates</option>
            <option value="day">Today</option>
            <option value="week">This Week</option>
            <option value="month">This Month</option>
          </select>
        </div>
        <p className="text-[11px] text-slate-500 mt-2">Export CSV uses the selected record type, search and date range.</p>
      </div>

      {/* RECORDS TABLE */}
      <div className="bg-white border border-[#cfd8e6] rounded-lg overflow-hidden">
        <div className="px-4 py-3 border-b border-[#cfd8e6]">
          <div className="flex items-center justify-between">
            <div>
              <h2 className="font-semibold text-sm text-foreground">
                System Transactions
              </h2>

              <p className="text-xs text-muted-foreground mt-0.5">
                Showing{" "}
                {
                  filteredRecords.length
                }{" "}
                record
                {filteredRecords.length !==
                1
                  ? "s"
                  : ""}
              </p>
            </div>
          </div>
        </div>

        <div className="overflow-x-auto">
          <table className="w-full min-w-[1100px]">
            <thead>
              <tr className="bg-[#fafbfc]">
                {[
                  "Date",
                  "Time",
                  "Type",
                  "Record",
                  "Description",
                  "User",
                  "Status",
                ].map((heading) => (
                  <th
                    key={heading}
                    className="text-left py-3 px-3 text-xs text-muted-foreground font-semibold"
                  >
                    {heading}
                  </th>
                ))}
              </tr>
            </thead>

            <tbody className="divide-y divide-border">
              {loading ? (
                <tr>
                  <td
                    colSpan={7}
                    className="py-12 text-center text-sm text-muted-foreground"
                  >
                    Loading system records...
                  </td>
                </tr>
              ) : filteredRecords.length ===
                0 ? (
                <tr>
                  <td
                    colSpan={7}
                    className="py-12 text-center"
                  >
                    <p className="text-sm font-semibold text-foreground">
                      No system records
                      found.
                    </p>

                    <p className="text-xs text-muted-foreground mt-1">
                      Try changing the
                      search or filter.
                    </p>
                  </td>
                </tr>
              ) : (
                filteredRecords.map(
                  (record) => (
                    <tr
                      key={record.id}
                      className="hover:bg-[#eef2fc]"
                    >
                      <td className="py-3 px-3 text-xs text-foreground whitespace-nowrap">
                        {formatDate(
                          record.date
                        )}
                      </td>

                      <td className="py-3 px-3 text-xs text-muted-foreground whitespace-nowrap">
                        {formatTime(
                          record.date
                        )}
                      </td>

                      <td className="py-3 px-3">
                        <span className="text-xs font-semibold text-primary">
                          {record.record_type ??
                            "Record"}
                        </span>
                      </td>

                      <td className="py-3 px-3">
                        <p className="text-xs font-semibold text-foreground">
                          {record.title ??
                            "—"}
                        </p>

                        {record.user_id && (
                          <p className="text-[11px] text-muted-foreground mt-0.5">
                            {
                              record.user_id
                            }
                          </p>
                        )}
                      </td>

                      <td className="py-3 px-3">
                        <p className="text-xs text-foreground max-w-[330px]">
                          {record.description ??
                            "—"}
                        </p>
                      </td>

                      <td className="py-3 px-3 text-xs text-foreground">
                        {record.user_name ??
                          "—"}
                      </td>

                      <td className="py-3 px-3">
                        <span
                          className={`inline-flex px-2.5 py-1 rounded-full text-[11px] font-semibold ${getStatusClasses(
                            record.status
                          )}`}
                        >
                          {record.status ??
                            "Unknown"}
                        </span>
                      </td>
                    </tr>
                  )
                )
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}
// =========================================================
// QR CODE SCAN ACTIVITY EXCEL
// =========================================================

async function downloadQrScanActivityExcel() {
  try {
    const data = await getScanLogs();

    const logs = data.logs ?? [];

    if (logs.length === 0) {
      alert(
        "There are no QR scan records to export."
      );

      return;
    }

    const verifiedCount = logs.filter(
      (log: any) =>
        String(
          log.result ?? ""
        ).toLowerCase() ===
        "verified"
    ).length;

    const entryCount = logs.filter(
      (log: any) =>
        String(
          log.direction ?? ""
        ).toUpperCase() === "IN"
    ).length;

    const exitCount = logs.filter(
      (log: any) =>
        String(
          log.direction ?? ""
        ).toUpperCase() === "OUT"
    ).length;

    // =====================================================
    // SUMMARY SHEET
    // =====================================================

    const summaryRows = [
      {
        Metric: "Total QR Scans",
        Value: logs.length,
      },

      {
        Metric: "Verified Scans",
        Value: verifiedCount,
      },

      {
        Metric: "Entry Scans",
        Value: entryCount,
      },

      {
        Metric: "Exit Scans",
        Value: exitCount,
      },

      {
        Metric: "Report Generated",
        Value:
          new Date().toLocaleString(
            "en-PH"
          ),
      },
    ];

    // =====================================================
    // SCAN ACTIVITY SHEET
    // =====================================================

    const scanRows = logs.map(
      (log: any) => ({
        Date: log.scanned_at
          ? new Date(
              log.scanned_at
            ).toLocaleDateString(
              "en-PH"
            )
          : "—",

        Time: log.scanned_at
          ? new Date(
              log.scanned_at
            ).toLocaleTimeString(
              "en-PH",
              {
                hour: "2-digit",
                minute: "2-digit",
              }
            )
          : "—",

        "QR ID":
          log.qr_code ?? "—",

        Item:
          log.item?.item_name ??
          "Unknown Item",

        Type:
          log.item?.item_type ??
          "—",

        "Serial Number":
          log.item?.serial_number ??
          "—",

        Owner:
          log.item?.user?.name ??
          "Unknown",

        "Owner ID":
          log.item?.user?.username ??
          "—",

        Gate:
          log.gate ?? "—",

        Direction:
          log.direction ?? "—",

        Result:
          log.result ?? "—",

        "Scanned By":
          log.scanner?.name ??
          "—",

        "Scanner ID":
          log.scanner?.username ??
          "—",
      })
    );

    // =====================================================
    // CREATE EXCEL WORKBOOK
    // =====================================================

    const workbook =
      XLSX.utils.book_new();

    const summarySheet =
      XLSX.utils.json_to_sheet(
        summaryRows
      );

    const scanSheet =
      XLSX.utils.json_to_sheet(
        scanRows
      );

    summarySheet["!cols"] = [
      { wch: 25 },
      { wch: 25 },
    ];

    scanSheet["!cols"] = [
      { wch: 14 }, // Date
      { wch: 12 }, // Time
      { wch: 25 }, // QR ID
      { wch: 25 }, // Item
      { wch: 20 }, // Type
      { wch: 20 }, // Serial
      { wch: 25 }, // Owner
      { wch: 18 }, // Owner ID
      { wch: 15 }, // Gate
      { wch: 12 }, // Direction
      { wch: 15 }, // Result
      { wch: 25 }, // Scanned By
      { wch: 18 }, // Scanner ID
    ];

    XLSX.utils.book_append_sheet(
      workbook,
      summarySheet,
      "Summary"
    );

    XLSX.utils.book_append_sheet(
      workbook,
      scanSheet,
      "QR Scan Activity"
    );

    const today = new Date()
      .toISOString()
      .slice(0, 10);

    XLSX.writeFile(
      workbook,
      `QRPass-QR-Scan-Activity-${today}.xlsx`
    );
  } catch (err) {
    console.error(
      "Failed to generate QR Scan Activity Excel:",
      err
    );

    alert(
      err instanceof Error
        ? err.message
        : "Failed to generate QR Scan Activity Excel report."
    );
  }
}
// =========================================================
// SYSTEM ADMIN - LOST REPORTS / CLAIM MANAGEMENT
// Administrator oversight is read-only. CSU verifies and releases items.
// =========================================================
function SysAdminLostFound() {
  /* QRPASS_LOSTFOUND_ROLE_REPORTS_V117 */
  const openSysadminLostFoundManagerV117 = React.useContext(QRPassSysadminManageContext);
  const [qrpassSortOrder, setQrpassSortOrder] = useState<"newest" | "oldest">("newest");
  const [items, setItems] = useState<any[]>([]);
  const [tab, setTab] = useState<"all" | "lost" | "found" | "recovered">("all");
  const [status, setStatus] = useState("all");
  const [query, setQuery] = useState("");
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [selectedItem, setSelectedItem] = useState<any | null>(null);
  const [limitedDetails, setLimitedDetails] = useState(false);
  const [lfPeriod, setLfPeriod] = useState<CSUDatePeriod>("all");
  const [lfFrom, setLfFrom] = useState("");
  const [lfTo, setLfTo] = useState("");

  async function loadItems(silent = false) {
    try {
      if (!silent) { setLoading(true); setError(""); }
      const data = await getSystemRecords();
      if (Array.isArray(data?.lost_found_items)) {
        setItems(data.lost_found_items);
        setLimitedDetails(false);
      } else {
        // Compatibility with older SystemRecordController.php.
        const fallback = (data?.records ?? [])
          .filter((r: any) => r.record_type === "Lost & Found")
          .map((r: any) => ({
            id: r.reference_id,
            item_name: r.title,
            status: r.status,
            reported_at: r.date,
            reporter: { name: r.user_name, username: r.user_id },
            category: r.details?.category,
            brand_model: r.details?.brand_model,
            color: r.details?.color,
            location_found: r.details?.location_found,
            claimant: r.details?.claimed_by ? { name: r.details.claimed_by } : null,
          }));
        setItems(fallback);
        setLimitedDetails(true);
      }
    } catch (e) {
      if (!silent) setError(e instanceof Error ? e.message : "Failed to load Lost & Found records.");
    } finally {
      if (!silent) setLoading(false);
    }
  }

  useEffect(() => { loadItems(); }, []);

  /* QRPass sysadmin Lost & Found live count v1 */
  useEffect(() => {
    let inFlight = false;
    const intervalId = window.setInterval(async () => {
      if (document.visibilityState !== "visible" || inFlight) return;
      inFlight = true;
      try { await loadItems(true); } finally { inFlight = false; }
    }, 10000);
    return () => window.clearInterval(intervalId);
  }, []);

  function formattedDate(value: string | null | undefined) {
    if (!value) return "—";
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? "—" : date.toLocaleString("en-PH", {dateStyle:"medium", timeStyle:"short"});
  }
  function csvCell(value: unknown) {
    return `"${String(value ?? "").replace(/"/g, '""')}"`;
  }
  const periodLostFoundItems = items.filter(item => csuMatchesPeriod(item.reported_at ?? item.created_at ?? item.date, lfPeriod, lfFrom, lfTo));
  const counts = {
    reports: periodLostFoundItems.length,
    lost: periodLostFoundItems.filter(i => String(i.report_type ?? i.type ?? i.status ?? "").toLowerCase() === "lost" && !["recovered","claimed","resolved"].includes(String(i.status ?? "").toLowerCase())).length,
    found: periodLostFoundItems.filter(i => String(i.report_type ?? i.type ?? i.status ?? "").toLowerCase() === "found" && !["recovered","claimed","resolved"].includes(String(i.status ?? "").toLowerCase())).length,
    recovered: periodLostFoundItems.filter(i => ["recovered","claimed","resolved"].includes(String(i.status ?? "").toLowerCase())).length,
  };
  const filtered = periodLostFoundItems.filter(item => {
    const stat = String(item.status ?? "").toLowerCase();
    const reportType = String(item.report_type ?? item.type ?? "").toLowerCase();
    const isRecovered = ["recovered", "claimed", "resolved"].includes(stat);
    if (tab === "recovered" && !isRecovered) return false;
    if (tab === "lost" && (isRecovered || (reportType !== "lost" && stat !== "lost"))) return false;
    if (tab === "found" && (isRecovered || (reportType !== "found" && !["found", "pending"].includes(stat)))) return false;
    if (status !== "all" && stat !== status) return false;
    const searchText = [item.item_name, item.category, item.brand_model, item.color,
      item.reporter?.name, item.reporter?.username, item.finder?.name,
      item.lost_by?.name, item.lostBy?.name, item.claimant?.name,
      item.location_found, item.location_lost, item.status].join(" ").toLowerCase();
    return searchText.includes(query.toLowerCase().trim());
  });
  filtered.sort((a: any, b: any) => (qrpassSortOrder === "newest" ? 1 : -1) * ((new Date(b.reported_at ?? b.created_at ?? 0).getTime() || 0) - (new Date(a.reported_at ?? a.created_at ?? 0).getTime() || 0)));
  function exportCSV() {
    if (!filtered.length) { alert("No matching Lost & Found records to export."); return; }
    const rows = [
      ["Report ID", "Item", "Report Type", "Category", "Status", "Reporter", "Owner", "Finder", "Claimant", "Location", "Reported At", "Claimed At"],
      ...filtered.map(i => [i.id, i.item_name, i.report_type, i.category, i.status,
        i.reporter?.name, i.lost_by?.name ?? i.lostBy?.name, i.finder?.name,
        i.claimant?.name, i.location_found ?? i.location_lost, i.created_at ?? i.reported_at, i.claimed_at])
    ];
    const csv = "\uFEFF" + rows.map(row => row.map(csvCell).join(",")).join("\r\n");
    const url = URL.createObjectURL(new Blob([csv], {type: "text/csv;charset=utf-8;"}));
    const link = document.createElement("a");
    link.href = url;
    link.download = `QRPass-Admin-${tab}-${new Date().toISOString().slice(0,10)}.csv`;
    document.body.appendChild(link); link.click(); link.remove();
    URL.revokeObjectURL(url);
  }
  const statusClass = (value: string) => {
    const s = value.toLowerCase();
    if (["recovered", "claimed"].includes(s)) return "bg-green-50 text-green-700 border-green-200";
    if (s === "pending") return "bg-amber-50 text-amber-700 border-amber-200";
    if (s === "lost") return "bg-red-50 text-red-700 border-red-200";
    return "bg-blue-50 text-blue-700 border-blue-200";
  };
  return (
    <div className="space-y-5">
      <div className="flex flex-wrap items-center justify-between gap-3">
        <PageHeader title="Lost & Found Management" subtitle="Monitor lost, found and recovered items across campus." />
        <div className="flex flex-wrap gap-2">

        </div>
      </div>
      {error && <div className="p-3 rounded-lg border border-red-200 bg-red-50 text-red-700 text-sm">{error}</div>}
      {limitedDetails && <div className="p-3 rounded-lg border border-amber-200 bg-amber-50 text-amber-800 text-xs">Detailed claim fields require the accompanying SystemRecordController.php update. Basic system records are displayed meanwhile.</div>}
      {/* Standalone Reporting Period selector removed from staff page. */}
      <div className="bg-white rounded-xl border border-[#cfd8e6] overflow-hidden">
        <div className="p-4 flex flex-col md:flex-row gap-3 border-b border-[#cfd8e6]">
          <div className="relative flex-1"><Search size={15} className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" />
            <input value={query} onChange={e=>setQuery(e.target.value)} placeholder="Search item, reporter, claimant or location..." className="h-12 w-full min-w-0 rounded-xl border border-[#c7d2fe] !bg-white hover:!bg-[#eef2ff] focus:!bg-white pl-10 pr-4 text-sm text-[#17336d] outline-none transition-colors focus:border-[#5278e7] focus:bg-white focus:ring-2 focus:ring-[#5278e7]/20" />
          </div>
          <select data-qrpass-filter="reports" aria-label="Filter lost and found reports" value={tab} onChange={e => {setTab(e.target.value as typeof tab);setStatus("all");setSelectedItem(null);}} className="h-12 min-w-[165px] max-w-full rounded-xl border border-[#c7d2fe] bg-[#eef2ff] px-3 text-sm font-medium text-[#17336d] outline-none focus:border-[#5278e7] dark:border-[#5278b8] dark:bg-[#19345f] dark:text-white">
            <option value="all">All Reports ({counts.reports})</option><option value="lost">Lost ({counts.lost})</option><option value="found">Found ({counts.found})</option><option value="recovered">Recovered / Claimed ({counts.recovered})</option>
          </select>
          <select aria-label="Sort records" value={qrpassSortOrder} onChange={e => setQrpassSortOrder(e.target.value as "newest" | "oldest")} className="h-12 min-w-[150px] rounded-xl border border-[#c7d2fe] bg-[#eef2ff] px-3 text-sm font-medium text-[#17336d] outline-none focus:border-[#5278e7]"><option value="newest">Newest first</option><option value="oldest">Oldest first</option></select>
          {openSysadminLostFoundManagerV117 && (
            <button
              type="button"
              aria-label="Manage Reports"
              title="Manage Reports"
              onClick={openSysadminLostFoundManagerV117}
              className="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#cbd5e1] bg-white text-[#31539b] transition-colors hover:bg-[#eef2ff] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5278e7]/20"
            
  onMouseEnter={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', '#eef2ff', 'important');
    s.setProperty('background-color', '#eef2ff', 'important');
    s.setProperty('border-color', '#a8bde4', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
  onMouseLeave={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', '#ffffff', 'important');
    s.setProperty('background-color', '#ffffff', 'important');
    s.setProperty('border-color', '#cbd5e1', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
  onFocus={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', e.currentTarget.matches(':hover') ? '#eef2ff' : '#ffffff', 'important');
    s.setProperty('border-color', e.currentTarget.matches(':hover') ? '#a8bde4' : '#cbd5e1', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
  onBlur={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', '#ffffff', 'important');
    s.setProperty('background-color', '#ffffff', 'important');
    s.setProperty('border-color', '#cbd5e1', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
>
              <SlidersHorizontal size={18} strokeWidth={1.8} aria-hidden="true" />
            </button>
          )}
          <button type="button" data-qrpass-refresh-toolbar="v1" onClick={() => { void loadItems(); }} className="inline-flex h-12 shrink-0 items-center justify-center gap-2 rounded-xl px-3 text-sm font-medium text-[#17336d] hover:bg-[#edf2ff]" aria-label="Refresh records"
          ><RefreshCw size={15} />Refresh</button>

        </div>
        <div className="p-4 border-b border-[#cfd8e6] flex flex-wrap items-center gap-2">

          <span className="ml-auto text-xs text-slate-500">{filtered.length} matching records</span>
        </div>
        <div className="overflow-x-auto">
          <table className="w-full min-w-[780px] text-sm">
            <thead className="bg-slate-50 text-xs text-slate-500 border-b border-[#cfd8e6]"><tr>
              {(["Item / Category","Report Type","Reported By","Location","Status",tab==="recovered"?"Claimant":"Date","Details"]).map(h=><th key={h} className="text-left px-4 py-3 font-semibold">{h}</th>)}
            </tr></thead>
            <tbody className="divide-y divide-slate-100">
              {loading ? <tr><td colSpan={7} className="py-12 text-center text-slate-500">Loading records...</td></tr> : filtered.length===0 ? <tr><td colSpan={7} className="py-12 text-center text-slate-500"><div className="qrpass-empty-state-v3"><BookOpen size={26} aria-hidden="true" /><strong>No {tab === "all" ? "reports" : tab + " reports"} match the selected filters.</strong></div></td></tr> : filtered.map(item => (
                <tr key={item.id} className="hover:bg-blue-50/40">
                  <td className="px-4 py-3"><p className="font-semibold text-slate-800">{item.item_name ?? "Unnamed Item"}</p><p className="text-xs text-slate-500">{item.category ?? "Other"}</p></td>
                  <td className="px-4 py-3 capitalize">{item.report_type ?? "—"}</td>
                  <td className="px-4 py-3">{item.reporter?.name ?? "—"}</td>
                  <td className="px-4 py-3">{item.location_found ?? item.location_lost ?? "—"}</td>
                  <td className="px-4 py-3"><span className={`rounded-full border px-2.5 py-1 text-[11px] font-semibold ${statusClass(String(item.status ?? ""))}`}>{item.status ?? "Unknown"}</span></td>
                  <td className="px-4 py-3">{tab === "recovered" ? (item.claimant?.name ?? "—") : formattedDate(item.created_at ?? item.reported_at)}</td>
                  <td className="px-4 py-3"><button type="button" onClick={()=>setSelectedItem(item)} className="text-blue-800 font-semibold hover:underline">View</button></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        </div>
      {selectedItem && <div className="fixed inset-0 z-[100] bg-black/50 flex items-center justify-center p-4" onClick={()=>setSelectedItem(null)}>
        <div role="dialog" aria-modal="true" aria-label="Lost and Found report details" className="bg-white rounded-xl w-full max-w-2xl max-h-[85vh] overflow-y-auto shadow-xl p-5 space-y-4" onClick={e=>e.stopPropagation()}>
          <div className="flex justify-between items-center"><h2 className="font-bold text-lg text-[#17336d]">Lost & Found Report Details</h2><button type="button" aria-label="Close details" onClick={()=>setSelectedItem(null)}><X size={20}/></button></div>
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            {([
              ["Item",selectedItem.item_name],["Category",selectedItem.category],["Report Type",selectedItem.report_type],
              ["Status",selectedItem.status],["Brand / Model",selectedItem.brand_model],["Color",selectedItem.color],
              ["Reported by",selectedItem.reporter?.name],["Owner",selectedItem.lost_by?.name ?? selectedItem.lostBy?.name],
              ["Finder",selectedItem.finder?.name],["Claimant",selectedItem.claimant?.name],
              ["Found at",selectedItem.location_found],["Last seen at",selectedItem.location_lost],
              ["Reported at",formattedDate(selectedItem.created_at ?? selectedItem.reported_at)],
              ["Claimed at",formattedDate(selectedItem.claimed_at)],
            ] as [string, any][]).map(([label,value]) => <div key={label}><p className="text-xs text-slate-500">{label}</p><p className="font-medium break-words">{value ?? "—"}</p></div>)}
          </div>
          {selectedItem.description && <div><p className="text-xs font-semibold text-slate-600">Description</p><p className="whitespace-pre-wrap text-sm mt-1">{selectedItem.description}</p></div>}
          {selectedItem.photo_url && <img src={selectedItem.photo_url} alt="Reported item" className="max-h-52 rounded-lg border object-contain" />}
          <div className="text-right"><button type="button" onClick={()=>setSelectedItem(null)} className="px-4 py-2 rounded-lg bg-[#17336d] text-white text-sm transition-colors hover:!bg-[#eef2ff] hover:!text-[#17336d] hover:!border-[#a8bde4] focus-visible:!ring-0 focus-visible:!shadow-none"
           data-qrpass-neutral-v169="true">Close</button></div>
        </div>
      </div>}
    </div>
  );
}

// QRPASS_ROLE_REPORT_MANAGER_V17 — consistent Manage Users layout, selected role/report context.
// QRPASS_SYSADMIN_MANAGERS_V19 — shared report manager toolbar and logs alignment.
type QrpassReportRoleV16 = "student" | "security" | "pco" | "sysadmin";
type QrpassReportCategoryV16 = "registration" | "scan" | "entryexit" | "incidents" | "lostfound";
function QrpassRoleReportManagerV16({ role, category, onClose }: { role: QrpassReportRoleV16; category: QrpassReportCategoryV16; onClose: () => void }) {
  const allowed: Record<QrpassReportRoleV16, QrpassReportCategoryV16[]> = {
    student: ["registration"],
    security: ["scan", "entryexit", "incidents", "lostfound"],
    pco: ["registration"],
    sysadmin: ["registration", "scan", "entryexit", "incidents", "lostfound"],
  };
  const permitted = allowed[role];
  // Always manage the current role report, rather than allowing unrelated categories.
  const kind: QrpassReportCategoryV16 = permitted.includes(category) ? category : permitted[0];
  const [view, setView] = React.useState<"active" | "archived">("active");
  const [rows, setRows] = React.useState<any[]>([]);
  const [chosen, setChosen] = React.useState<string[]>([]);
  const [query, setQuery] = React.useState("");
  const [busy, setBusy] = React.useState(false);
  const [error, setError] = React.useState("");
  const [message, setMessage] = React.useState("");
  const module = kind === "registration" ? "items" : kind === "lostfound" ? "lost-found" : null;
  // Back-end page management does not yet expose role-filtered archive/restore
  // for Students/CSU, or archive endpoints for Scan/Incident records.
  const canArchive = (role === "pco" || role === "sysadmin") && module !== null;
  const typeLabels: Record<QrpassReportCategoryV16, string> = {
    registration: "Registered Items", scan: "QR Scan Activity", entryexit: "Gate Entry / Exit",
    incidents: "Security Incidents", lostfound: "Lost & Found"
  };
  const read = React.useCallback(async () => {
    setBusy(true); setError(""); setChosen([]);
    try {
      let source: any;
      if (canArchive && module) {
        const token = localStorage.getItem("token");
        const response = await fetch(`http://localhost:8000/api/sysadmin/page-manage/${module}?view=${view}`, {
          headers: {Accept: "application/json", Authorization: `Bearer ${token ?? ""}`}
        });
        source = await response.json();
        if (!response.ok) throw new Error(source?.message || `HTTP ${response.status}`);
        source = source?.data ?? [];
      } else if (kind === "registration") {
        const data: any = await getAllItems();
        source = Array.isArray(data) ? data : (data?.items ?? []);
      } else if (kind === "scan" || kind === "entryexit") {
        const data: any = await getScanLogs();
        source = Array.isArray(data) ? data : (data?.logs ?? []);
      } else if (kind === "incidents") {
        const data: any = await getSecurityIncidents();
        source = Array.isArray(data) ? data : (data?.incidents ?? []);
      } else {
        const data: any = await getLostFoundItems();
        source = Array.isArray(data) ? data : (data?.items ?? data?.lost_found_items ?? []);
      }
      if (!Array.isArray(source)) source = [];
      if (kind === "entryexit") source = source.filter((r: any) => ["IN", "OUT"].includes(String(r.direction ?? "").toUpperCase()));
      if (role === "student") {
        // Do not present unknown-owner or non-student item registrations as student records.
        source = source.filter((r: any) => ["student", "user"].includes(String(r.user?.role ?? r.owner?.role ?? r.user_role ?? "").toLowerCase()));
      }
      setRows(source.slice(0, 1000));
    } catch (e) {
      setRows([]);
      setError(e instanceof Error ? e.message : "Could not load reports.");
    } finally { setBusy(false); }
  }, [role,kind,view,canArchive,module]);
  React.useEffect(() => { void read(); }, [read]);
  const filtered = rows.filter((r: any) => JSON.stringify(r).toLowerCase().includes(query.toLowerCase()));
  const selectedVisible = filtered.filter((r: any, i: number) => chosen.includes(String(r.id ?? `${kind}-${i}`)));
  const allSelected = filtered.length > 0 && selectedVisible.length === filtered.length;
  function label(r: any) { return String(r.item_name ?? r.item?.item_name ?? r.title ?? r.description ?? r.qr_code ?? r.action ?? `Record #${r.id}`); }
  function date(r: any) { return String(r.scanned_at ?? r.reported_at ?? r.registered_at ?? r.created_at ?? "—"); }
  function exportExcel() {
    const selected = selectedVisible.length ? selectedVisible : filtered;
    const records = selected.map((r: any) => ({
      ID: r.id ?? "", Record: label(r), Status: r.status ?? r.result ?? "", Direction: r.direction ?? "",
      Owner: r.user?.name ?? r.owner?.name ?? "", Date: date(r)
    }));
    if (!records.length) { setError("No records to download."); return; }
    const book = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(book, XLSX.utils.json_to_sheet(records), "Records");
    XLSX.writeFile(book, `QRPass-${role}-${kind}-${view}.xlsx`);
  }
  async function change(action: "archive" | "restore") {
    if (!canArchive || !module || !chosen.length) return;
    setBusy(true); setError(""); setMessage("");
    try {
      const token = localStorage.getItem("token");
      const response = await fetch(`http://localhost:8000/api/sysadmin/page-manage/${module}`, {
        method: "POST", headers: {Accept: "application/json", Authorization: `Bearer ${token ?? ""}`, "Content-Type": "application/json"},
        body: JSON.stringify({action, ids: chosen.map(Number)})
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data?.message || `HTTP ${response.status}`);
      setMessage(`${data.affected ?? 0} record(s) ${action === "archive" ? "archived" : "restored"}.`);
      await read();
      window.dispatchEvent(new CustomEvent("qrpass-page-records-changed", {detail: {module}}));
    } catch(e) {setError(e instanceof Error ? e.message : "Action failed.");}
    finally {setBusy(false);}
  }
  return <div className="fixed inset-0 z-[260] flex items-center justify-center bg-black/60 p-3" data-qrpass-manage-v31="true" data-qrpass-manage-v32="true" role="dialog" aria-modal="true" aria-label="Manage role reports">
    <div className="w-full max-w-4xl max-h-[90vh] overflow-y-auto rounded-2xl border border-[#c7d2fe] bg-white p-6 text-slate-900 shadow-2xl dark:bg-[#0d1830] dark:text-white">
      <div className="mb-5 flex items-center justify-between gap-3"><h2 className="text-lg font-bold">Manage {role === "student" ? "Student" : role === "security" ? "CSU" : role === "pco" ? "PCO" : "System Administrator"} Reports</h2><button type="button" onClick={onClose} className="rounded-xl border px-4 py-2 hover:bg-[#eef2ff] dark:hover:text-[#17336d]"
           data-qrpass-neutral-v169="true">Close</button></div>
      <div className="mb-4 flex flex-wrap items-center gap-2">

        <button type="button" disabled={!canArchive || busy} title={canArchive ? "View archived records for this report" : "Archives unavailable: role-specific backend support required"} className="shrink-0 rounded-xl border border-[#cbd5e1] bg-white px-3 py-2 text-[#17336d] transition-colors disabled:cursor-not-allowed disabled:opacity-50 dark:bg-[#1e2d4b] dark:text-white !bg-white !text-[#17336d] !border-[#cbd5e1] transition-colors hover:!bg-[#eef2ff] hover:!border-[#a8bde4] hover:!text-[#17336d] focus-visible:!ring-0 focus-visible:!shadow-none focus-visible:!outline-none" onClick={() => { if (canArchive) setView(v => v === "active" ? "archived" : "active"); }} 
            onMouseEnter={(e) => {
              const el=e.currentTarget;
              if(!el.dataset.qrpassV158Saved) {
                el.dataset.qrpassV158Saved=el.style.cssText || " ";
              }
              el.style.setProperty("background", "#eef2ff", "important");
              el.style.setProperty("background-color", "#eef2ff", "important");
              el.style.setProperty("background-image", "none", "important");
              el.style.setProperty("color", "#17336d", "important");
              el.style.setProperty("border-color", "#a8bde4", "important");
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onMouseLeave={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onFocus={(e) => {
              e.currentTarget.style.setProperty("box-shadow", "none", "important");
              e.currentTarget.style.setProperty("outline", "none", "important");
            }}
            onBlur={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}

          >{view === "active" ? "View Archives" : "Back to Records"}</button>
        <input aria-label="Search report records" value={query} onChange={e => setQuery(e.target.value)} placeholder="Search records..." className="min-w-[160px] flex-1 rounded-xl border border-[#c7d2fe] bg-[#eef2ff] px-3 py-2 text-[#17336d] transition-colors hover:bg-white focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#93b4ef] dark:text-[#17336d]" />
      </div>
      {error && <p className="mb-3 rounded-lg bg-red-100 p-3 text-sm text-red-800">{error}</p>}
      {message && <p className="mb-3 rounded-lg bg-green-100 p-3 text-sm text-green-800">{message}</p>}
      {!canArchive && <p className="mb-3 text-xs text-slate-500 dark:text-slate-300">Viewing and Excel download are available. Archive/Restore requires a role-specific backend endpoint.</p>}
      <div className="max-h-[46vh] overflow-auto rounded-xl border border-[#d8e1ee]">
        {busy && !rows.length ? <p className="p-6 text-center">Loading records...</p> : !filtered.length ? <p className="p-6 text-center font-semibold">No matching records.</p> : <table className="w-full text-left text-sm"><thead><tr className="bg-slate-50 dark:bg-[#182945]"><th className="p-3">Select</th><th className="p-3">Record</th><th className="p-3">Status</th><th className="p-3">Date</th></tr></thead><tbody>{filtered.map((r: any, i: number) => {
          const key = String(r.id ?? `${kind}-${i}`); const checked = chosen.includes(key);
          return <tr key={key} tabIndex={0} aria-selected={checked} onClick={() => setChosen(prev => checked ? prev.filter(id => id !== key) : [...prev,key])} onKeyDown={e => {if(e.key === "Enter" || e.key === " "){e.preventDefault();setChosen(prev => checked ? prev.filter(id => id !== key) : [...prev,key]);}}} className={`cursor-pointer border-t transition hover:bg-[#eef2ff] hover:text-[#17336d] ${checked ? "bg-[#eef2ff] dark:text-[#17336d]" : ""}`}>
            <td className="p-3"><input type="checkbox" checked={checked} readOnly aria-label={`Select ${label(r)}`} /></td><td className="p-3">{label(r)}</td><td className="p-3">{String(r.status ?? r.result ?? "—")}</td><td className="p-3">{date(r)}</td>
          </tr>;
        })}</tbody></table>}
      </div>
      <div className="mt-4 flex flex-wrap items-center gap-2"><span className="mr-auto text-xs text-slate-500 dark:text-slate-300">{chosen.length} selected · {filtered.length} shown</span><button type="button" onClick={() => setChosen(allSelected ? [] : filtered.map((r:any,i:number)=>String(r.id ?? `${kind}-${i}`)))} className="rounded-xl border px-3 py-2 hover:bg-[#eef2ff] dark:hover:text-[#17336d]"
          >{allSelected ? "Deselect All" : "Select All"}</button><button type="button" onClick={exportExcel} disabled={!filtered.length} className="rounded-xl border px-3 py-2 hover:bg-[#eef2ff] dark:hover:text-[#17336d]"
          >Download</button>{canArchive && <button type="button" disabled={busy || !chosen.length} onClick={() => void change(view === "active" ? "archive" : "restore")} className="rounded-xl border px-3 py-2 hover:bg-[#eef2ff] disabled:opacity-50 dark:hover:text-[#17336d]">{view === "active" ? "Archive" : "Restore"}</button>}</div>
    </div>
  </div>;
}

function AdminAnalytics() {
  const [reportRole, setReportRole] = useState<"student" | "security" | "pco" | "sysadmin" | null>(null);
  const [roleReportManagerOpenV16, setRoleReportManagerOpenV16] = React.useState(false);
  const [showDownloadableReports, setShowDownloadableReports] = useState(true);
  const [registrationStatusFilter, setRegistrationStatusFilter] = useState("all");
  // QRPASS_REPORT_SEARCH_SORT_20261120
  const [reportSearch, setReportSearch] = useState("");
  const [reportSort, setReportSort] = useState<"newest" | "oldest">("newest");
  const [recentCategory, setRecentCategory] = useState<"registration" | "scan" | "entryexit" | "incidents" | "lostfound">("registration");
  const [analyticsTab, setAnalyticsTab] = useState<"charts" | "registrations" | "incidents">("charts");
  const [exportPeriod, setExportPeriod] = useState<"day" | "week" | "month" | "all" | "custom">("all");
  const [exportFrom, setExportFrom] = useState("");
  const [exportTo, setExportTo] = useState("");
  const [exportingReport, setExportingReport] = useState(false);

  const [reportData, setReportData] = useState<any>(null);
  const [recentSecurityScans, setRecentSecurityScans] = useState<any[]>([]);
  const [recentSecurityIncidents, setRecentSecurityIncidents] = useState<any[]>([]);
  const [recentLostFound, setRecentLostFound] = useState<any[]>([]);
  const [detailsLoading, setDetailsLoading] = useState(false);
  const [detailsError, setDetailsError] = useState("");
  const [securityScansLoading, setSecurityScansLoading] = useState(false);
  const [securityScansError, setSecurityScansError] = useState("");
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  async function loadReports() {
    try {
      setLoading(true);
      setError("");

      const data = await getReports();

      setReportData(data);
    } catch (err) {
      console.error("Failed to load reports:", err);

      setError(
        err instanceof Error
          ? err.message
          : "Failed to load report data."
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadReports();
  }, []);

  // CSU activity is a different source from item registrations.
  useEffect(() => {
    if (reportRole !== "security" && reportRole !== "sysadmin") return;
    let cancelled = false;
    setSecurityScansLoading(true);
    setSecurityScansError("");
    getScanLogs().then((response: any) => {
      if (cancelled) return;
      const logs = Array.isArray(response?.logs) ? response.logs : [];
      setRecentSecurityScans([...logs].sort((a: any, b: any) =>
        (new Date(b.scanned_at ?? 0).getTime() || 0) - (new Date(a.scanned_at ?? 0).getTime() || 0)
      ).slice(0, 30));
    }).catch((err: any) => {
      if (!cancelled) setSecurityScansError(err instanceof Error ? err.message : "Unable to load QR scan activity.");
    }).finally(() => { if (!cancelled) setSecurityScansLoading(false); });
    return () => { cancelled = true; };
  }, [reportRole]);

  // Each category's recent table uses its actual API data source.
  useEffect(() => {
    if (!reportRole || !(reportRole === "security" || reportRole === "sysadmin")) return;
    let cancelled = false;
    setDetailsLoading(true);
    setDetailsError("");
    Promise.all([getSecurityIncidents(), getLostFoundItems()]).then(([incidentsResponse, foundResponse]: any[]) => {
      if (cancelled) return;
      const incidents = Array.isArray(incidentsResponse?.incidents) ? incidentsResponse.incidents : [];
      const found = Array.isArray(foundResponse) ? foundResponse :
        (Array.isArray(foundResponse?.items) ? foundResponse.items :
         (Array.isArray(foundResponse?.lost_found_items) ? foundResponse.lost_found_items : []));
      setRecentSecurityIncidents(incidents);
      setRecentLostFound(found);
    }).catch((err: any) => {
      if (!cancelled) setDetailsError(err instanceof Error ? err.message : "Unable to load recent records.");
    }).finally(() => { if (!cancelled) setDetailsLoading(false); });
    return () => { cancelled = true; };
  }, [reportRole]);

  const summary = reportData?.summary ?? {
    total_registered_items: 0,
    active_qr_codes: 0,
    pending_items: 0,
    scans_today: 0,
    scans_this_month: 0,
    registrations_this_month: 0,
    flagged_incidents: 0,
    resolved_incidents: 0,
    lost_found_available: 0,
    lost_found_claimed: 0,
  };

  const reportSources: ("scan" | "registration")[] =
    reportRole === "sysadmin" ? ["scan", "registration"] :
    reportRole === "security" ? ["scan"] : ["registration"];

  const itemTypes =
    reportData?.item_types ?? [];

  const dailyScans =
    reportData?.daily_scans ?? [];

  const monthlyRegistrations =
    reportData?.monthly_registrations ?? [];

  const recentRegistrations: any[] = Array.isArray(reportData?.recent_registrations)
    ? reportData.recent_registrations : [];

  // Expose every status actually present in this reporting dataset, not just approved/pending.
  const registrationStatuses = Array.from(new Set(recentRegistrations.map((item: any) =>
    String(item.status ?? "Unknown").trim().toLowerCase() || "unknown"
  ))).sort((a, b) => {
    const priority: Record<string, number> = { approved: 0, pending: 1, rejected: 2, flagged: 3 };
    return (priority[a] ?? 99) - (priority[b] ?? 99) || a.localeCompare(b);
  });
  // Use owner role when included in the API. Do not guess an owner's role from their name.
  const roleRecentRegistrations = reportRole === "student"
    ? recentRegistrations.filter((item: any) => {
        const ownerRole = String(item.user?.role ?? item.owner?.role ?? "").toLowerCase();
        return !ownerRole || ["student", "user"].includes(ownerRole);
      })
    : recentRegistrations;
  const filteredRecentRegistrations = roleRecentRegistrations.filter((item: any) =>
    registrationStatusFilter === "all" || String(item.status ?? "Unknown").trim().toLowerCase() === registrationStatusFilter
  );

  const recentIncidents =
    reportData?.recent_incidents ?? [];

  function formatDate(dateString: string) {
    if (!dateString) return "—";

    const date = new Date(dateString);

    if (Number.isNaN(date.getTime())) {
      return "—";
    }

    return date.toLocaleDateString();
  }

  function formatTime(dateString: string) {
    if (!dateString) return "—";

    const date = new Date(dateString);

    if (Number.isNaN(date.getTime())) {
      return "—";
    }

    return date.toLocaleTimeString([], {
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  const monthNames = [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Oct",
    "Nov",
    "Dec",
  ];

  const maxItemType = Math.max(
    ...itemTypes.map((item: any) =>
      Number(item.total ?? 0)
    ),
    1
  );

  const maxDailyScans = Math.max(
    ...dailyScans.map((item: any) =>
      Number(item.total ?? 0)
    ),
    1
  );

  const maxMonthly = Math.max(
    ...monthlyRegistrations.map((item: any) =>
      Number(item.total ?? 0)
    ),
    1
  );

  // =========================================================
  // DAILY QR SCAN PDF
  // =========================================================

  async function downloadDailyQrScanPDF() {
    try {
      const data = await getScanLogs();

      const allLogs = data.logs ?? [];

      const today = new Date();

      const todayLogs = allLogs.filter(
        (log: any) => {
          if (!log.scanned_at) {
            return false;
          }

          const scanDate = new Date(
            log.scanned_at
          );

          return (
            scanDate.getFullYear() ===
              today.getFullYear() &&
            scanDate.getMonth() ===
              today.getMonth() &&
            scanDate.getDate() ===
              today.getDate()
          );
        }
      );

      if (todayLogs.length === 0) {
        alert(
          "There are no QR scan records for today."
        );

        return;
      }

      const doc = new jsPDF({
        orientation: "landscape",
      });

      const verifiedCount =
        todayLogs.filter(
          (log: any) =>
            String(
              log.result ?? ""
            ).toLowerCase() === "verified"
        ).length;

      const inCount =
        todayLogs.filter(
          (log: any) =>
            String(
              log.direction ?? ""
            ).toUpperCase() === "IN"
        ).length;

      const outCount =
        todayLogs.filter(
          (log: any) =>
            String(
              log.direction ?? ""
            ).toUpperCase() === "OUT"
        ).length;

      doc.setFontSize(18);

      doc.text(
        "QRPass Daily QR Scan Summary",
        14,
        18
      );

      doc.setFontSize(10);

      doc.text(
        "University of Cebu - Main Campus",
        14,
        25
      );

      doc.text(
        `Report Date: ${today.toLocaleDateString()}`,
        14,
        31
      );

      doc.text(
        `Total QR Scans: ${todayLogs.length}`,
        14,
        37
      );

      doc.text(
        `Verified Scans: ${verifiedCount}`,
        14,
        43
      );

      doc.text(
        `Entry Scans: ${inCount}`,
        75,
        37
      );

      doc.text(
        `Exit Scans: ${outCount}`,
        75,
        43
      );

      const tableRows =
        todayLogs.map((log: any) => {
          return [
            formatDate(
              log.scanned_at
            ),

            formatTime(
              log.scanned_at
            ),

            log.item?.user?.name ??
              "Unknown",

            log.item?.user?.username ??
              "—",

            log.item?.item_name ??
              "Unknown Item",

            log.item?.serial_number ??
              "—",

            log.qr_code ?? "—",

            log.gate ?? "—",

            log.direction ?? "—",

            log.result ?? "—",

            log.scanner?.name ?? "—",
          ];
        });

      autoTable(doc, {
        startY: 50,

        head: [
          [
            "Date",
            "Time",
            "Owner",
            "Owner ID",
            "Item",
            "Serial No.",
            "QR Code",
            "Gate",
            "Direction",
            "Result",
            "Scanned By",
          ],
        ],

        body: tableRows,

        styles: {
          fontSize: 7,
          cellPadding: 2,
        },

        headStyles: {
          fillColor: [0, 48, 135],
          textColor: [255, 255, 255],
        },

        alternateRowStyles: {
          fillColor: [245, 247, 250],
        },
      });

      const filenameDate = today
        .toISOString()
        .slice(0, 10);

      doc.save(
        `QRPass-Daily-QR-Scan-${filenameDate}.pdf`
      );
    } catch (err) {
      console.error(
        "Failed to generate daily QR scan PDF:",
        err
      );

      alert(
        err instanceof Error
          ? err.message
          : "Failed to generate Daily QR Scan PDF."
      );
    }
  }

  // =========================================================
  // MONTHLY ITEM REGISTRATION PDF
  // =========================================================

  async function downloadMonthlyRegistrationPDF() {
    try {
      const data = await getAllItems();

      const allItems = data.items ?? [];

      const now = new Date();

      const monthlyItems =
        allItems.filter(
          (item: any) => {
            if (!item.created_at) {
              return false;
            }

            const created =
              new Date(
                item.created_at
              );

            return (
              created.getFullYear() ===
                now.getFullYear() &&
              created.getMonth() ===
                now.getMonth()
            );
          }
        );

      if (
        monthlyItems.length === 0
      ) {
        alert(
          "There are no item registrations for this month."
        );

        return;
      }

      const doc = new jsPDF({
        orientation: "landscape",
      });

      const monthName =
        now.toLocaleDateString(
          "en-US",
          {
            month: "long",
            year: "numeric",
          }
        );

      const approvedCount =
        monthlyItems.filter(
          (item: any) =>
            String(
              item.status ?? ""
            ).toLowerCase() === "approved"
        ).length;

      const pendingCount =
        monthlyItems.filter(
          (item: any) =>
            String(
              item.status ?? ""
            ).toLowerCase() === "pending"
        ).length;

      doc.setFontSize(18);

      doc.text(
        "QRPass Monthly Item Registration Summary",
        14,
        18
      );

      doc.setFontSize(10);

      doc.text(
        "University of Cebu - Main Campus",
        14,
        25
      );

      doc.text(
        `Reporting Period: ${monthName}`,
        14,
        31
      );

      doc.text(
        `Total Registrations: ${monthlyItems.length}`,
        14,
        37
      );

      doc.text(
        `Approved: ${approvedCount}`,
        75,
        37
      );

      doc.text(
        `Pending: ${pendingCount}`,
        120,
        37
      );

      const tableRows =
        monthlyItems.map(
          (item: any) => {
            return [
              formatDate(
                item.created_at
              ),

              item.user?.name ??
                "Unknown",

              item.user?.username ??
                "—",

              item.item_name ??
                "—",

              item.item_type ??
                "—",

              item.brand_model ??
                "—",

              item.serial_number ??
                "—",

              item.color ??
                "—",

              item.qr_code ??
                "Not issued",

              item.status ??
                "—",
            ];
          }
        );

      autoTable(doc, {
        startY: 45,

        head: [
          [
            "Date",
            "Owner",
            "Owner ID",
            "Item",
            "Type",
            "Brand / Model",
            "Serial No.",
            "Color",
            "QR Code",
            "Status",
          ],
        ],

        body: tableRows,

        styles: {
          fontSize: 7,
          cellPadding: 2,
        },

        headStyles: {
          fillColor: [0, 48, 135],
          textColor: [255, 255, 255],
        },

        alternateRowStyles: {
          fillColor: [245, 247, 250],
        },
      });

      const fileMonth =
        `${now.getFullYear()}-${String(
          now.getMonth() + 1
        ).padStart(2, "0")}`;

      doc.save(
        `QRPass-Monthly-Item-Registration-${fileMonth}.pdf`
      );
    } catch (err) {
      console.error(
        "Failed to generate monthly registration PDF:",
        err
      );

      alert(
        err instanceof Error
          ? err.message
          : "Failed to generate Monthly Registration PDF."
      );
    }
  }

  // =========================================================
  // SECURITY INCIDENT EXCEL
  // =========================================================

  // =========================================================
// SECURITY INCIDENT EXCEL
// =========================================================

async function downloadFlaggedIncidentsExcel() {
  try {
    const data = await getSecurityIncidents();

    const incidents = data.incidents ?? [];

    if (incidents.length === 0) {
      alert(
        "There are no security incident records to export."
      );

      return;
    }

    const flaggedCount = incidents.filter(
      (incident: any) =>
        String(
          incident.status ?? ""
        ).toLowerCase() === "flagged"
    ).length;

    const resolvedCount = incidents.filter(
      (incident: any) =>
        String(
          incident.status ?? ""
        ).toLowerCase() === "resolved"
    ).length;

    const incidentRows = incidents.map(
      (incident: any) => {
        return {
          Date: formatDate(
            incident.reported_at
          ),

          Time: formatTime(
            incident.reported_at
          ),

          "Incident Type":
            incident.incident_type ??
            "Security Incident",

          "Scanned Code":
            incident.scanned_code ?? "",

          "Item Name":
            incident.item?.item_name ??
            incident.item_name ??
            "Unknown Item",

          "Serial Number":
            incident.item?.serial_number ??
            incident.serial_number ??
            "",

          Gate:
            incident.gate ?? "",

          "Reported By":
            incident.reporter?.name ??
            "Security Personnel",

          "Reporter ID":
            incident.reporter?.username ??
            "",

          Status:
            incident.status ??
            "Flagged",

          Description:
            incident.description ?? "",
        };
      }
    );

    const summaryRows = [
      {
        Metric:
          "Total Security Incidents",
        Value:
          incidents.length,
      },
      {
        Metric:
          "Currently Flagged",
        Value:
          flaggedCount,
      },
      {
        Metric:
          "Resolved Incidents",
        Value:
          resolvedCount,
      },
      {
        Metric:
          "Report Generated",
        Value:
          new Date().toLocaleString(),
      },
    ];

    const workbook =
      XLSX.utils.book_new();

    const summarySheet =
      XLSX.utils.json_to_sheet(
        summaryRows
      );

    const incidentSheet =
      XLSX.utils.json_to_sheet(
        incidentRows
      );

    summarySheet["!cols"] = [
      { wch: 25 },
      { wch: 25 },
    ];

    incidentSheet["!cols"] = [
      { wch: 14 },
      { wch: 12 },
      { wch: 22 },
      { wch: 25 },
      { wch: 25 },
      { wch: 22 },
      { wch: 15 },
      { wch: 25 },
      { wch: 20 },
      { wch: 14 },
      { wch: 45 },
    ];

    XLSX.utils.book_append_sheet(
      workbook,
      summarySheet,
      "Summary"
    );

    XLSX.utils.book_append_sheet(
      workbook,
      incidentSheet,
      "Security Incidents"
    );

    const today = new Date()
      .toISOString()
      .slice(0, 10);

    XLSX.writeFile(
      workbook,
      `QRPass-Security-Incidents-${today}.xlsx`
    );
  } catch (err) {
    console.error(
      "Failed to generate security incident Excel report:",
      err
    );

    alert(
      err instanceof Error
        ? err.message
        : "Failed to generate Security Incident Excel report."
    );
  }
}

// =========================================================
// GATE ENTRY / EXIT LOG PDF
// =========================================================

async function downloadGateEntryExitPDF() {
  try {
    const data = await getScanLogs();

    const logs = Array.isArray(data?.logs)
      ? data.logs
      : [];

    const gateLogs = logs.filter(
      (log: any) => {
        const direction = String(
          log.direction ?? ""
        ).toUpperCase();

        return (
          direction === "IN" ||
          direction === "OUT"
        );
      }
    );

    if (gateLogs.length === 0) {
      alert(
        "There are no Gate Entry/Exit records to generate."
      );
      return;
    }

    const entryCount = gateLogs.filter(
      (log: any) =>
        String(
          log.direction ?? ""
        ).toUpperCase() === "IN"
    ).length;

    const exitCount = gateLogs.filter(
      (log: any) =>
        String(
          log.direction ?? ""
        ).toUpperCase() === "OUT"
    ).length;

    const verifiedCount = gateLogs.filter(
      (log: any) =>
        String(
          log.result ?? ""
        ).toLowerCase() === "verified"
    ).length;

    const uniqueOwners = new Set(
      gateLogs
        .map(
          (log: any) =>
            log.item?.user?.id ??
            log.item?.user?.username ??
            null
        )
        .filter(Boolean)
    ).size;

    const doc = new jsPDF({
      orientation: "landscape",
    });

    doc.setFontSize(18);

    doc.text(
      "QRPass Gate Entry / Exit Log",
      14,
      18
    );

    doc.setFontSize(10);

    doc.text(
      "University of Cebu - Main Campus",
      14,
      25
    );

    doc.text(
      `Generated: ${new Date().toLocaleString(
        "en-PH"
      )}`,
      14,
      31
    );

    doc.text(
      `Total Transactions: ${gateLogs.length}`,
      14,
      39
    );

    doc.text(
      `Entries: ${entryCount}`,
      14,
      45
    );

    doc.text(
      `Exits: ${exitCount}`,
      65,
      39
    );

    doc.text(
      `Verified: ${verifiedCount}`,
      65,
      45
    );

    doc.text(
      `Unique Owners: ${uniqueOwners}`,
      115,
      39
    );

    const rows = gateLogs.map(
      (log: any) => {
        const scanDate = log.scanned_at
          ? new Date(log.scanned_at)
          : null;

        return [
          scanDate &&
          !Number.isNaN(
            scanDate.getTime()
          )
            ? scanDate.toLocaleDateString(
                "en-PH"
              )
            : "—",

          scanDate &&
          !Number.isNaN(
            scanDate.getTime()
          )
            ? scanDate.toLocaleTimeString(
                "en-PH",
                {
                  hour: "2-digit",
                  minute: "2-digit",
                }
              )
            : "—",

          log.qr_code ?? "—",

          log.item?.item_name ??
            "Unknown Item",

          log.item?.item_type ?? "—",

          log.item?.serial_number ??
            "—",

          log.item?.user?.name ??
            "Unknown",

          log.item?.user?.username ??
            "—",

          log.gate ?? "—",

          log.direction ?? "—",

          log.result ?? "—",

          log.scanner?.name ?? "—",
        ];
      }
    );

    autoTable(doc, {
      startY: 52,

      head: [
        [
          "Date",
          "Time",
          "QR ID",
          "Item",
          "Type",
          "Serial No.",
          "Owner",
          "Owner ID",
          "Gate",
          "Direction",
          "Result",
          "Scanned By",
        ],
      ],

      body: rows,

      styles: {
        fontSize: 6.5,
        cellPadding: 2,
      },

      headStyles: {
        fillColor: [26, 58, 123],
        textColor: [255, 255, 255],
      },

      alternateRowStyles: {
        fillColor: [245, 247, 250],
      },
    });

    const today = new Date()
      .toISOString()
      .slice(0, 10);

    doc.save(
      `QRPass-Gate-Entry-Exit-Log-${today}.pdf`
    );
  } catch (err) {
    console.error(
      "Failed to generate Gate Entry/Exit Log PDF:",
      err
    );

    alert(
      err instanceof Error
        ? err.message
        : "Failed to generate Gate Entry/Exit Log PDF."
    );
  }
}

  // Custom period reports: scans and registrations for the current day, week or month.
  async function downloadPeriodPDF(period: "day" | "week" | "month", source: "scan" | "registration") {
    try {
      const now = new Date();
      const from = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      if (period === "week") from.setDate(from.getDate() - ((from.getDay() + 6) % 7));
      if (period === "month") from.setDate(1);
      const to = new Date(from);
      if (period === "day") to.setDate(to.getDate() + 1);
      if (period === "week") to.setDate(to.getDate() + 7);
      if (period === "month") to.setMonth(to.getMonth() + 1);
      const data = source === "scan" ? await getScanLogs() : await getAllItems();
      const all = source === "scan" ? (data?.logs ?? []) : (data?.items ?? []);
      const rows = all.filter((item: any) => {
        const raw = source === "scan" ? item.scanned_at : item.created_at;
        if (!raw) return false;
        const date = new Date(raw);
        return !Number.isNaN(date.getTime()) && date >= from && date < to;
      });
      if (!rows.length) { alert(`No ${source === "scan" ? "QR scans" : "registrations"} for the selected ${period}.`); return; }
      const doc = new jsPDF({orientation:"landscape"});
      doc.setFontSize(17);
      doc.text(`QRPass ${period.toUpperCase()} ${source === "scan" ? "QR Scan Report" : "Item Registration Report"}`, 14, 18);
      doc.setFontSize(10);
      doc.text("University of Cebu — Main Campus",14,25);
      doc.text(`Period: ${from.toLocaleDateString("en-PH")} to ${new Date(to.getTime()-1).toLocaleDateString("en-PH")} | Records: ${rows.length}`,14,32);
      const head = source === "scan" ?
        ["Date/Time","Item","Owner","QR Code","Gate","Direction","Result","Scanned By"] :
        ["Date Registered","Item","Owner","Type","Brand / Model","Serial No.","Status"];
      const body = rows.map((r:any) => source === "scan" ? [
        new Date(r.scanned_at).toLocaleString("en-PH"), r.item?.item_name ?? "—",
        r.item?.user?.name ?? "—", r.qr_code ?? "—", r.gate ?? "—",
        r.direction ?? "—", r.result ?? "—", r.scanner?.name ?? "—",
      ] : [
        new Date(r.created_at).toLocaleString("en-PH"),r.item_name ?? "—",
        r.user?.name ?? "—",r.item_type ?? "—",r.brand_model ?? "—",r.serial_number ?? "—",r.status ?? "—",
      ]);
      autoTable(doc,{startY:40,head:[head],body,styles:{fontSize:8,cellPadding:2},headStyles:{fillColor:[26,58,123]},alternateRowStyles:{fillColor:[245,247,250]}});
      const name=`QRPass-${source}-${period}-${from.toISOString().slice(0,10)}.pdf`;
      doc.save(name);
    } catch (err) {
      console.error("Admin report export failed",err);
      alert(err instanceof Error ? err.message : "Could not generate report.");
    }
  }

  // The selected report period is applied to the actual exported rows (not just the label).
  function selectedExportRange() {
    const now = new Date();
    const from = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    let until: Date | null = null;
    if (exportPeriod === "all") return {from: null as Date | null, until, label: "All Time"};
    if (exportPeriod === "custom") {
      if (!exportFrom || !exportTo) throw new Error("Please select both From and To dates.");
      const start = new Date(`${exportFrom}T00:00:00`);
      const end = new Date(`${exportTo}T00:00:00`);
      if (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime()) || start > end) {
        throw new Error("Please enter a valid date range (From must not be after To).");
      }
      end.setDate(end.getDate() + 1);
      return {from: start, until: end, label: `${exportFrom} to ${exportTo}`};
    }
    if (exportPeriod === "week") from.setDate(from.getDate() - ((from.getDay() + 6) % 7));
    if (exportPeriod === "month") from.setDate(1);
    until = new Date(from);
    if (exportPeriod === "day") until.setDate(until.getDate() + 1);
    if (exportPeriod === "week") until.setDate(until.getDate() + 7);
    if (exportPeriod === "month") until.setMonth(until.getMonth() + 1);
    const label = exportPeriod === "day" ? "Today" : exportPeriod === "week" ? "This Week" : "This Month";
    return {from, until, label};
  }

  type AdminReportKind = "registration" | "scan" | "entryexit" | "incidents" | "lostfound";
  const downloadOptions: {kind: AdminReportKind; label: string; hint: string}[] =
    reportRole === "student" ? [
      {kind:"registration", label:"Student Item Registration Report",hint:"Registered item records and statuses"},
    ] : reportRole === "security" ? [
      {kind:"scan",label:"QR Scan Activity Report",hint:"Verified item scan activity"},
      {kind:"entryexit",label:"Gate Entry / Exit Report",hint:"Entry and exit transactions"},
      {kind:"incidents",label:"Security Incidents Report",hint:"Flagged and resolved incidents"},
      {kind:"lostfound",label:"Lost & Found Report",hint:"CSU item recovery records"},
    ] : reportRole === "pco" ? [
      {kind:"registration",label:"Property / Registered Items Report",hint:"Item inventory and registration records"},
    ] : reportRole === "sysadmin" ? [
      {kind:"registration",label:"Item Registration Report",hint:"Campus-wide registered items"},
      {kind:"scan",label:"QR Scan Activity Report",hint:"All scan activity"},
      {kind:"entryexit",label:"Gate Entry / Exit Report",hint:"IN and OUT transactions"},
      {kind:"incidents",label:"Security Incidents Report",hint:"Flagged and resolved cases"},
      {kind:"lostfound",label:"Lost & Found Report",hint:"Lost, found, and recovered cases"},
    ] : [];

  async function exportRoleReport(kind: AdminReportKind, format: "pdf" | "csv") {
    try {
      if (!reportRole) return;
      const range = selectedExportRange();
      setExportingReport(true);
      const response = kind === "registration" ? await getAllItems() :
        kind === "scan" || kind === "entryexit" ? await getScanLogs() :
        kind === "incidents" ? await getSecurityIncidents() : await getLostFoundItems();
      const data: any = response;
      const records: any[] = kind === "registration" ? (data?.items ?? []) :
        kind === "scan" || kind === "entryexit" ? (data?.logs ?? []) :
        kind === "incidents" ? (data?.incidents ?? []) : (Array.isArray(data) ? data : (data?.items ?? data?.lost_found_items ?? []));
      const original = Array.isArray(records) ? records : [];
      const timestampFor = (record: any) => kind === "scan" || kind === "entryexit" ? record.scanned_at :
        kind === "incidents" ? (record.reported_at ?? record.created_at) :
        (record.created_at ?? record.reported_at);
      const filtered = original.filter((record: any) => {
        if (kind === "entryexit" && !["IN","OUT"].includes(String(record.direction ?? "").toUpperCase())) return false;
        const stamp = timestampFor(record);
        const when = stamp ? new Date(stamp) : null;
        return !!when && !Number.isNaN(when.getTime()) &&
          (!range.from || when >= range.from) && (!range.until || when < range.until);
      });
      if (!filtered.length) {
        alert(`No matching records for ${range.label}.`);
        return;
      }
      const str = (v: any) => v === null || v === undefined || v === "" ? "—" : String(v);
      const dt = (v: any) => v ? new Date(v).toLocaleString("en-PH") : "—";
      let headers: string[] = [];
      let rows: string[][] = [];
      if (kind === "registration") {
        headers = ["Date Registered", "Item", "Category", "Owner", "Owner ID", "Brand / Model", "Serial", "Status"];
        rows = filtered.map((r:any) => [dt(timestampFor(r)),str(r.item_name),str(r.item_type),str(r.user?.name),str(r.user?.username),str(r.brand_model),str(r.serial_number),str(r.status)]);
      } else if (kind === "scan" || kind === "entryexit") {
        headers = ["Date / Time", "QR ID", "Item", "Owner", "Gate", "Direction", "Result", "Scanned By"];
        rows = filtered.map((r:any) => [dt(timestampFor(r)),str(r.qr_code),str(r.item?.item_name),str(r.item?.user?.name),str(r.gate),str(r.direction),str(r.result),str(r.scanner?.name)]);
      } else if (kind === "incidents") {
        headers = ["Date / Time", "Incident", "Item", "QR ID", "Owner", "Gate", "Status", "Reporter"];
        rows = filtered.map((r:any) => [dt(timestampFor(r)),str(r.incident_type),str(r.item_name),str(r.scanned_code),str(r.owner_name),str(r.gate),str(r.status),str(r.reporter?.name)]);
      } else {
        headers = ["Date / Time", "Item", "Category", "Report Type", "Location", "Status", "Owner / Finder"];
        rows = filtered.map((r:any) => [dt(timestampFor(r)),str(r.item_name),str(r.category),str(r.type ?? r.report_type),str(r.location_found ?? r.location_lost),str(r.status),str(r.finder?.name ?? r.owner?.name)]);
      }
      const option = downloadOptions.find(o => o.kind === kind);
      const title = `QRPass ${option?.label ?? "System Report"}`;
      const filename = `QRPass-${kind}-${range.label.replace(/[^a-z0-9]+/gi,"-")}`;
      if (format === "csv") {
        const escapeCSV = (v: string) => `"${v.replace(/"/g,'""')}"`;
        const lines = [headers, ...rows].map(row => row.map(escapeCSV).join(","));
        const blob = new Blob(["\uFEFF" + lines.join("\r\n")], {type: "text/csv;charset=utf-8;"});
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `${filename}.csv`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      } else {
        const pdf = new jsPDF({orientation:"landscape"});
        pdf.setFontSize(17);
        pdf.text(title,14,18);
        pdf.setFontSize(10);
        pdf.text("University of Cebu - Main Campus",14,25);
        pdf.text(`Reporting Period: ${range.label} | Records: ${filtered.length}`,14,32);
        autoTable(pdf, {startY:39, head:[headers], body:rows, styles:{fontSize:7,cellPadding:2},
          headStyles:{fillColor:[26,58,123],textColor:[255,255,255]},
          alternateRowStyles:{fillColor:[245,247,250]}});
        pdf.save(`${filename}.pdf`);
      }
    } catch (err) {
      alert(err instanceof Error ? err.message : "Could not generate report.");
    } finally {
      setExportingReport(false);
    }
  }

  // Recent Activity uses actual event timestamps. The same period also controls report exports.
  const recentPeriodName: CSUDatePeriod = exportPeriod === "day" ? "today" : exportPeriod;
  const isRecentDate = (value: string | null | undefined) =>
    (exportPeriod !== "custom" || (!!exportFrom && !!exportTo && exportFrom <= exportTo)) &&
    csuMatchesPeriod(value, recentPeriodName, exportFrom, exportTo);
  const filterAndSortReport = (rows: any[], dateFn: (row: any) => string | null | undefined) => rows
    .filter((row: any) => isRecentDate(dateFn(row)) && (!reportSearch.trim() || JSON.stringify(row).toLowerCase().includes(reportSearch.trim().toLowerCase())))
    .sort((a: any, b: any) => {
      const delta = (new Date(dateFn(b) ?? 0).getTime() || 0) - (new Date(dateFn(a) ?? 0).getTime() || 0);
      return reportSort === "newest" ? delta : -delta;
    });
  const periodRecentSecurityScans = filterAndSortReport(recentSecurityScans, (log: any) => log.scanned_at ?? log.created_at);
  const periodRecentSecurityIncidents = filterAndSortReport(recentSecurityIncidents, (incident: any) => incident.reported_at ?? incident.created_at);
  const periodRecentLostFound = filterAndSortReport(recentLostFound, (item: any) => item.created_at ?? item.reported_at);
  const periodRecentRegistrations = filterAndSortReport(recentRegistrations, (item: any) => item.created_at ?? item.registered_at);
  const periodRoleRecentRegistrations = filterAndSortReport(roleRecentRegistrations, (item: any) => item.created_at ?? item.registered_at);
  const periodFilteredRecentRegistrations = filterAndSortReport(filteredRecentRegistrations, (item: any) => item.created_at ?? item.registered_at);

  const renderRecentToolbar = () => (
    <div className="border-b border-[#dce3ee] px-4 py-4">
      <div className="flex w-full min-w-0 flex-col gap-3 sm:flex-row sm:items-center">
  <div className="relative min-w-0 flex-1">
    <Search size={17} className="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-[#64748b]" />

    <input
  type="search"
  aria-label="Search reports"
  value={reportSearch}
  onChange={(e) => setReportSearch(e.target.value)}
  placeholder="Search report records..."
  className="h-12 w-full min-w-0 rounded-xl border border-[#c7d2fe] pl-11 pr-4 text-sm text-[#17336d] outline-none transition-colors placeholder:text-[#8195bb] focus:border-[#5278e7] focus:ring-2 focus:ring-[#5278e7]/20"
  ref={(input) => {
    if (input) {
      input.style.setProperty("background-color", "#ffffff", "important");
    }
  }}
  onMouseEnter={(e) => {
    if (document.activeElement !== e.currentTarget) {
      e.currentTarget.style.setProperty("background-color", "#eef2ff", "important");
    }
  }}
  onMouseLeave={(e) => {
    e.currentTarget.style.setProperty("background-color", "#ffffff", "important");
  }}
  onFocus={(e) => {
    e.currentTarget.style.setProperty("background-color", "#ffffff", "important");
  }}
  onBlur={(e) => {
    e.currentTarget.style.setProperty("background-color", "#ffffff", "important");
  }}
/>
  </div>
            {/* QRPASS_ANALYTICS_DROPDOWN_V1: Category or status before Newest first */}
          {(reportRole === "security" || reportRole === "sysadmin") ? (
            <select aria-label="Filter analytics category" value={recentCategory} onChange={e=>setRecentCategory(e.target.value as typeof recentCategory)} className="h-12 min-w-[170px] max-w-full rounded-xl border border-[#c7d2fe] bg-[#eef2ff] px-3 text-sm font-medium text-[#17336d] outline-none focus:border-[#5278e7] dark:border-[#6485c2] dark:bg-[#19345f] dark:text-white">
              {downloadOptions.map(option => <option key={option.kind} value={option.kind}>{option.label.replace(/ Report$/, "")}</option>)}
            </select>
          ) : (
            <select aria-label="Filter analytics record status" value={registrationStatusFilter} onChange={e=>setRegistrationStatusFilter(e.target.value)} className="h-12 min-w-[170px] max-w-full rounded-xl border border-[#c7d2fe] bg-[#eef2ff] px-3 text-sm font-medium text-[#17336d] outline-none focus:border-[#5278e7] dark:border-[#6485c2] dark:bg-[#19345f] dark:text-white">
              <option value="all">All Records</option>
              {registrationStatuses.map(status => <option key={status} value={status}>{status.charAt(0).toUpperCase()+status.slice(1)}</option>)}
            </select>
          )}
<select aria-label="Sort reports" value={reportSort} onChange={e => setReportSort(e.target.value as 'newest' | 'oldest')} className="h-12 w-full rounded-xl border border-[#c7d2fe] bg-[#eef2ff] px-4 text-sm font-medium text-[#17336d] outline-none sm:w-[150px] focus:border-[#2f5fd6]">
    <option value="newest">Newest first</option>
    <option value="oldest">Oldest first</option>
  </select>
          {reportRole && (
            <button
              type="button"
              aria-label="Manage Reports"
              title="Manage Reports"
              onClick={() => setRoleReportManagerOpenV16(true)}
              className="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#cbd5e1] bg-white text-[#31539b] transition-colors hover:bg-[#eef2ff] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5278e7]/20"
            
  onMouseEnter={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', '#eef2ff', 'important');
    s.setProperty('background-color', '#eef2ff', 'important');
    s.setProperty('border-color', '#a8bde4', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
  onMouseLeave={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', '#ffffff', 'important');
    s.setProperty('background-color', '#ffffff', 'important');
    s.setProperty('border-color', '#cbd5e1', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
  onFocus={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', e.currentTarget.matches(':hover') ? '#eef2ff' : '#ffffff', 'important');
    s.setProperty('border-color', e.currentTarget.matches(':hover') ? '#a8bde4' : '#cbd5e1', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
  onBlur={(e) => {
    const s = e.currentTarget.style;
    s.setProperty('background', '#ffffff', 'important');
    s.setProperty('background-color', '#ffffff', 'important');
    s.setProperty('border-color', '#cbd5e1', 'important');
    s.setProperty('box-shadow', 'none', 'important');
    s.setProperty('outline', 'none', 'important');
  }}
>
              <SlidersHorizontal size={18} strokeWidth={1.8} aria-hidden="true" />
            </button>
          )}
          {/* QRPASS_REPORT_REFRESH_BESIDE_SORT_V3 */}
          <button
          onClick={loadReports}
          disabled={loading} className="px-3 py-2 border border-[#cfd8e6] rounded-md text-xs font-semibold hover:bg-muted disabled:opacity-50 inline-flex items-center justify-center gap-1.5 !border-0 !bg-transparent !shadow-none !text-[#17336d] !px-2 !py-1 hover:!bg-[#edf2ff] rounded-lg"
          > <RefreshCw size={13} className="shrink-0" />
          {loading
            ? "Refreshing..."
            : "Refresh Reports"}
        </button>

</div>

      {downloadOptions.length > 1 && (
        <div>
          </div>
      )}
    </div>
  );

return (
    <div className="space-y-5">
      {/* HEADER */}
      <div className="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <PageHeader
          title="Reports & Analytics"
          subtitle="Real-time QRpass statistics and downloadable system reports."
        />


      </div>

      {/* Role selection: full-width rows; hidden when a role is opened. */}
      {!reportRole && (
        <section className="overflow-hidden rounded-2xl border border-[#dce3ee] bg-white shadow-sm" aria-label="Select report role">
          <div className="border-b border-[#dce3ee] px-4 py-4 sm:px-5">
            <h3 className="text-sm font-bold text-[#17336d]">Reports by Role</h3>
            <p className="mt-1 text-xs text-[#64748b]">Select a role to view its relevant QRPass records.</p>
          </div>
          <div className="divide-y divide-[#e2e8f0]">
            {([
              {id:"student",label:"Students",icon:<User size={20}/>},
              {id:"security",label:"Security Personnel (CSU)",icon:<Shield size={20}/>},
              {id:"pco",label:"Property Custodian (PCO)",icon:<Package size={20}/>},
              {id:"sysadmin",label:"System Administrator",icon:<BarChart2 size={20}/>},
            ] as const).map(role => (
              <button
                key={role.id}
                type="button"
                onClick={() => {
                  setRoleReportManagerOpenV16(false);
                  setReportRole(role.id);
                  setRecentCategory(role.id === "security" ? "scan" : "registration");
                  setRegistrationStatusFilter("all");
                  setAnalyticsTab(role.id === "security" ? "incidents" : role.id === "sysadmin" ? "charts" : "registrations");
                }}
                className="flex w-full min-h-[68px] items-center gap-4 px-4 py-4 text-left transition-colors hover:bg-[#f5f8ff] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#2f5fd6] sm:px-5"
          >
                <span className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#dce3ee] bg-[#eef2fc] text-[#17336d]">{role.icon}</span>
                <span className="min-w-0 flex-1">
                  <span className="block text-sm font-semibold text-[#17336d]">{role.label}</span>
                </span>
                <ChevronRight size={19} className="shrink-0 text-[#64748b]" />
              </button>
            ))}
          </div>
        </section>
      )}

      {/* QRPASS_REPORTS_BACK_ONLY_V15: shared Back button for every selected report role */}
{reportRole && (
        <div className="flex justify-start pb-1">
          <button type="button" onClick={() => {
                        setRoleReportManagerOpenV16(false);
              setReportRole(null);
                        setRecentCategory("registration");
                        setRegistrationStatusFilter("all");
                      }}
                      className="inline-flex items-center gap-2 rounded-lg border border-[#cfd8e6] bg-white px-4 py-2 text-sm font-semibold text-[#17336d] !bg-white !text-[#17336d] !border-[#cbd5e1] transition-colors hover:!bg-[#eef2ff] hover:!border-[#a8bde4] hover:!text-[#17336d] focus-visible:!ring-0 focus-visible:!shadow-none focus-visible:!outline-none"
                     
            onMouseEnter={(e) => {
              const el=e.currentTarget;
              if(!el.dataset.qrpassV158Saved) {
                el.dataset.qrpassV158Saved=el.style.cssText || " ";
              }
              el.style.setProperty("background", "#eef2ff", "important");
              el.style.setProperty("background-color", "#eef2ff", "important");
              el.style.setProperty("background-image", "none", "important");
              el.style.setProperty("color", "#17336d", "important");
              el.style.setProperty("border-color", "#a8bde4", "important");
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onMouseLeave={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onFocus={(e) => {
              e.currentTarget.style.setProperty("box-shadow", "none", "important");
              e.currentTarget.style.setProperty("outline", "none", "important");
            }}
            onBlur={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}

           data-qrpass-neutral-v169="true">
                      <ChevronRight size={15} className="rotate-180"/> Back
                    </button>
        </div>
      )}

      {/* QRPASS_ROLE_REPORT_LAUNCH_V16 — inside selected role only */}
      
      {roleReportManagerOpenV16 && reportRole && (
        <QrpassRoleReportManagerV16 key={`${reportRole}-${recentCategory}`} role={reportRole} category={recentCategory} onClose={() => {setRoleReportManagerOpenV16(false); void loadReports();}} />
      )}
      {reportRole && <>

      {/* ERROR */}
      {error && (
        <div className="px-4 py-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700">
          {error}
        </div>
      )}

      {/* Campus-wide summary is shown only when System Administrator is selected. */}
      {reportRole && <div data-qrpass-statistical-summary="true" className="rounded-2xl border border-[#dce3ee] bg-white p-4 shadow-sm sm:p-5">
        <div className="mb-4 flex flex-wrap items-start justify-between gap-2">
          <div>
            <h3 className="text-sm font-bold text-[#17336d]">System Summary</h3>
            <p className="mt-1 text-xs text-muted-foreground">Statistics relevant to the selected role are shown. Counts are campus-wide.</p>
          </div>
          <div className="flex items-center gap-2">
            <span className="rounded-full border border-[#dce3ee] bg-[#f8fafc] px-3 py-1 text-[11px] font-medium text-muted-foreground">Campus-wide</span>
            
          </div>
        </div>
        <div className="grid grid-cols-2 gap-3 lg:grid-cols-4">
          {([
            {category: "registration", label: "Registered Items", value: summary.total_registered_items, icon: <Package size={19}/>, color: "#1a3a7b"},
            {category: "registration", label: "Active QR", value: summary.active_qr_codes, icon: <QrCode size={19}/>, color: "#557bdc"},
            {category: "registration", label: "Pending", value: summary.pending_items, icon: <Clock size={19}/>, color: "#6b8ee6"},
            {category: "scan", label: "Scans Today", value: summary.scans_today, icon: <ScanLine size={19}/>, color: "#2f5fd6"},
            {category: "incidents", label: "Flagged", value: summary.flagged_incidents, icon: <AlertTriangle size={19}/>, color: "#e8543a"},
            {category: "incidents", label: "Resolved", value: summary.resolved_incidents, icon: <CheckCircle size={19}/>, color: "#2ecc71"},
            {category: "scan", label: "Scans This Month", value: summary.scans_this_month, icon: <BarChart2 size={19}/>, color: "#1a3a7b"},
            {category: "registration", label: "Registrations This Month", value: summary.registrations_this_month, icon: <FileText size={19}/>, color: "#557bdc"},
            {category: "lostfound", label: "Found Items", value: summary.lost_found_available, icon: <Search size={19}/>, color: "#2f5fd6"},
            {category: "lostfound", label: "Claimed Items", value: summary.lost_found_claimed, icon: <CheckCircle size={19}/>, color: "#2ecc71"},
          ]).filter(item => reportRole === "sysadmin" ||
            (reportRole === "security" && ["scan", "incidents", "lostfound"].includes(item.category)) ||
            ((reportRole === "student" || reportRole === "pco") && item.category === "registration")
          ).map(item => (
            <div key={item.label} className="flex min-h-[98px] items-center gap-3 rounded-xl border border-[#dce3ee] bg-[#fbfcff] p-3 sm:p-4">
              <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl" style={{color:item.color, backgroundColor:`${item.color}13`}}>{item.icon}</span>
              <div className="min-w-0">
                <p className="text-[11px] font-semibold text-[#64748b]">{item.label}</p>
                <p className="mt-1 text-2xl font-bold leading-none text-[#111827]">{Number(item.value ?? 0).toLocaleString("en-PH")}</p>
              </div>
            </div>
          ))}
        </div></div>}

      {/* Role-specific recent records. CSU scans are not item registrations. */}
      {(reportRole === "security" || reportRole === "sysadmin") && (recentCategory === "scan" || recentCategory === "entryexit") && (
        <div className="overflow-hidden rounded-xl border border-[#dce3ee] bg-white shadow-sm">
          <div className="px-4 py-3">
            <h3 className="text-sm font-semibold text-[#17336d]">{recentCategory === "entryexit" ? "Recent Gate Entry / Exit Activity" : "Recent QR Scan Activity"}</h3>
            <p className="mt-1 text-xs text-muted-foreground">Actual verification and entry/exit events from the scan logs, not registration records.</p>
          </div>
          {renderRecentToolbar()}
          <div className="overflow-x-auto">
            <table className="w-full min-w-[850px]">
              <thead className="bg-[#fafbfc]"><tr>
                {['Date / Time', 'Item', 'Owner', 'Gate', 'Direction', 'Result', 'Scanned By'].map(heading =>
                  <th key={heading} className="px-3 py-3 text-left text-xs font-semibold text-muted-foreground">{heading}</th>
                )}
              </tr></thead>
              <tbody className="divide-y divide-border">
                {securityScansLoading ? (
                  <tr><td colSpan={7} className="py-10 text-center text-sm text-muted-foreground">Loading scan activity...</td></tr>
                ) : securityScansError ? (
                  <tr><td colSpan={7} className="py-10 text-center text-sm text-red-600">{securityScansError}</td></tr>
                ) : periodRecentSecurityScans.filter((log: any) => recentCategory !== "entryexit" || ["in", "out", "entry", "exit"].includes(String(log.direction ?? "").toLowerCase())).length === 0 ? (
                  <tr><td colSpan={7} className="py-10 text-center text-sm text-muted-foreground">No scan records available.</td></tr>
                ) : periodRecentSecurityScans.filter((log: any) => recentCategory !== "entryexit" || ["in", "out", "entry", "exit"].includes(String(log.direction ?? "").toLowerCase())).map((log: any, index: number) => (
                  <tr key={log.id ?? `scan-${index}`} className="hover:bg-[#f8fafc]">
                    <td className="px-3 py-3 text-xs">{log.scanned_at ? new Date(log.scanned_at).toLocaleString('en-PH') : '—'}</td>
                    <td className="px-3 py-3 text-xs font-semibold">{log.item?.item_name ?? log.item_name ?? '—'}</td>
                    <td className="px-3 py-3 text-xs">{log.item?.user?.name ?? log.owner?.name ?? '—'}</td>
                    <td className="px-3 py-3 text-xs">{log.gate ?? '—'}</td>
                    <td className="px-3 py-3 text-xs"><QRpassDirectionBadge direction={log.direction} /></td>
                    <td className="px-3 py-3 text-xs">{log.result ?? '—'}</td>
                    <td className="px-3 py-3 text-xs">{log.scanner?.name ?? '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
      {reportRole === "pco" && recentCategory === "registration" && (
        <div className="overflow-hidden rounded-xl border border-[#dce3ee] bg-white shadow-sm">
          <div className="px-4 py-3">
            <h3 className="text-sm font-semibold text-[#17336d]">Property Inventory Overview</h3>
            <p className="mt-1 text-xs text-muted-foreground">
              Property-oriented inventory of registered items, including category, identifying details and registration status.
              These are campus-wide records: the current API does not mark items as specifically assigned to PCO.
            </p>
          </div>
          {renderRecentToolbar()}

          <div className="overflow-x-auto">
            <table className="w-full min-w-[900px]">
              <thead className="bg-[#fafbfc]"><tr>
                {["Category", "Item / Equipment", "Brand / Model", "Serial / Identification", "Registered Owner", "Status"].map(h =>
                  <th key={h} className="px-3 py-3 text-left text-xs font-semibold text-muted-foreground">{h}</th>)}
              </tr></thead>
              <tbody className="divide-y divide-border">
                {loading ? <tr><td colSpan={6} className="py-10 text-center text-sm text-muted-foreground">Loading inventory...</td></tr> :
                  periodFilteredRecentRegistrations.length === 0 ? <tr><td colSpan={6} className="py-10 text-center text-sm text-muted-foreground">No inventory records match this filter.</td></tr> :
                  [...periodFilteredRecentRegistrations].sort((a: any, b: any) => String(a.item_type ?? "").localeCompare(String(b.item_type ?? ""))).map((item: any) =>
                    <tr key={item.id} className="hover:bg-[#f8fafc]">
                      <td className="px-3 py-3 text-xs">{item.item_type ?? "—"}</td>
                      <td className="px-3 py-3 text-xs font-semibold">{item.item_name ?? "—"}</td>
                      <td className="px-3 py-3 text-xs">{item.brand_model || "—"}</td>
                      <td className="px-3 py-3 text-xs">{item.serial_number || "—"}</td>
                      <td className="px-3 py-3 text-xs">{item.user?.name ?? "Unknown"}</td>
                      <td className="px-3 py-3 text-xs capitalize">{item.status ?? "Unknown"}</td>
                    </tr>)}
              </tbody>
            </table>
          </div>
        </div>
      )}
      {(reportRole === "security" || reportRole === "sysadmin") && recentCategory === "incidents" && (
        <div className="overflow-hidden rounded-xl border border-[#dce3ee] bg-white shadow-sm">
          <div className="px-4 py-3"><h3 className="text-sm font-semibold text-[#17336d]">Recent Security Incidents</h3></div>
          {renderRecentToolbar()}
          <div className="overflow-x-auto"><table className="w-full min-w-[700px]">
            <thead className="bg-[#fafbfc]"><tr>{["Date", "Item / Incident", "Gate / Location", "Status", "Description"].map(h => <th key={h} className="px-3 py-3 text-left text-xs font-semibold text-muted-foreground">{h}</th>)}</tr></thead>
            <tbody className="divide-y divide-border">
              {detailsLoading ? <tr><td colSpan={5} className="px-3 py-8 text-center text-sm">Loading incidents...</td></tr> :
              detailsError ? <tr><td colSpan={5} className="px-3 py-8 text-center text-sm text-red-600">{detailsError}</td></tr> :
              periodRecentSecurityIncidents.length === 0 ? <tr><td colSpan={5} className="px-3 py-8 text-center text-sm">No incidents found.</td></tr> :
              periodRecentSecurityIncidents.slice(0,30).map((incident: any, i: number) => <tr key={incident.id ?? i}>
                <td className="px-3 py-3 text-xs">{formatDate(incident.reported_at ?? incident.created_at)}</td>
                <td className="px-3 py-3 text-xs font-semibold">{incident.item?.item_name ?? incident.item_name ?? incident.incident_type ?? "—"}</td>
                <td className="px-3 py-3 text-xs">{incident.gate ?? incident.location ?? "—"}</td>
                <td className="px-3 py-3 text-xs capitalize">{incident.status ?? "—"}</td>
                <td className="px-3 py-3 text-xs">{incident.description ?? incident.reason ?? "—"}</td>
              </tr>)}
            </tbody>
          </table></div>
        </div>
      )}
      {(reportRole === "security" || reportRole === "sysadmin") && recentCategory === "lostfound" && (
        <div className="overflow-hidden rounded-xl border border-[#dce3ee] bg-white shadow-sm">
          <div className="px-4 py-3"><h3 className="text-sm font-semibold text-[#17336d]">Recent Lost & Found Records</h3></div>
          {renderRecentToolbar()}
          <div className="overflow-x-auto"><table className="w-full min-w-[700px]">
            <thead className="bg-[#fafbfc]"><tr>{["Date", "Item", "Type", "Location", "Status"].map(h => <th key={h} className="px-3 py-3 text-left text-xs font-semibold text-muted-foreground">{h}</th>)}</tr></thead>
            <tbody className="divide-y divide-border">
              {detailsLoading ? <tr><td colSpan={5} className="px-3 py-8 text-center text-sm">Loading lost and found records...</td></tr> :
              detailsError ? <tr><td colSpan={5} className="px-3 py-8 text-center text-sm text-red-600">{detailsError}</td></tr> :
              periodRecentLostFound.length === 0 ? <tr><td colSpan={5} className="px-3 py-8 text-center text-sm">No Lost & Found records found.</td></tr> :
              periodRecentLostFound.slice(0,30).map((item: any, i: number) => <tr key={item.id ?? i}>
                <td className="px-3 py-3 text-xs">{formatDate(item.reported_at ?? item.created_at)}</td>
                <td className="px-3 py-3 text-xs font-semibold">{item.item_name ?? item.name ?? "—"}</td>
                <td className="px-3 py-3 text-xs capitalize">{item.report_type ?? item.type ?? "—"}</td>
                <td className="px-3 py-3 text-xs">{item.location_found ?? item.location_lost ?? "—"}</td>
                <td className="px-3 py-3 text-xs capitalize">{item.status ?? "—"}</td>
              </tr>)}
            </tbody>
          </table></div>
        </div>
      )}
      {reportRole && reportRole !== "security" && reportRole !== "pco" && recentCategory === "registration" && (
        <div className="overflow-hidden rounded-xl border border-[#dce3ee] bg-white shadow-sm">
          <div className="px-4 py-3">
            <h3 className="text-sm font-semibold text-[#17336d]">{reportRole === "student" ? "Recent Student Item Registrations" : "Recent Campus-wide Item Registrations"}</h3>
            <p className="mt-1 text-xs text-muted-foreground">{reportRole === "student" ? "Student-owned registrations where the API identifies owner role; owner role missing from records is not assumed to be non-student." : "All recent item registration records across campus."}</p>
          </div>
          {renderRecentToolbar()}

          <div className="overflow-x-auto">
            <table className="w-full min-w-[850px]">
              <thead className="bg-[#fafbfc]">
                <tr>{["Date", "Student", "Item", "Type", "Serial Number", "Status"].map(h => (
                  <th key={h} className="px-3 py-3 text-left text-xs font-semibold text-muted-foreground">{h}</th>
                ))}</tr>
              </thead>
              <tbody className="divide-y divide-border">
                {loading ? (
                  <tr><td colSpan={6} className="py-10 text-center text-sm text-muted-foreground">Loading registrations...</td></tr>
                ) : periodFilteredRecentRegistrations.length === 0 ? (
                  <tr><td colSpan={6} className="py-10 text-center text-sm text-muted-foreground">No registration records match the selected status.</td></tr>
                ) : periodFilteredRecentRegistrations.map((item: any) => (
                  <tr key={item.id} className="hover:bg-[#f8fafc]">
                    <td className="px-3 py-3 text-xs">{formatDate(item.created_at)}</td>
                    <td className="px-3 py-3 text-xs">
                      <p className="font-semibold">{item.user?.name ?? "Unknown"}</p>
                      <p className="text-muted-foreground">{item.user?.username ?? ""}</p>
                    </td>
                    <td className="px-3 py-3 text-xs font-semibold">{item.item_name ?? "—"}</td>
                    <td className="px-3 py-3 text-xs">{item.item_type ?? "—"}</td>
                    <td className="px-3 py-3 text-xs">{item.serial_number || "—"}</td>
                    <td className="px-3 py-3">
                      <span className={`rounded-full px-2.5 py-1 text-[11px] font-semibold ${String(item.status ?? "").toLowerCase() === "approved" ? "bg-green-100 text-green-700" : String(item.status ?? "").toLowerCase() === "pending" ? "bg-yellow-100 text-yellow-700" : "bg-slate-100 text-slate-700"}`}>
                        {item.status ?? "Unknown"}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}


      </>}
    </div>
  );
}

function AdminNotifications() {
  return (
    <div className="space-y-5">
      <PageHeader title="Notifications" subtitle="Administrative alerts and system updates." />
      <Card title="All Notifications">
        <div className="p-3 space-y-2">
          <NotifItem type="warning" message="4 flagged QR scan incidents require administrative review." time="Jun 16, 2026 – 8:00 AM" />
          <NotifItem type="info" message="Monthly system report due by June 30, 2026." time="Jun 14, 2026 – 9:00 AM" />
          <NotifItem type="success" message="Campus-wide QR inspection for June 18 has been scheduled." time="Jun 13, 2026 – 3:00 PM" />
        </div>
      </Card>
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════════════
// SYSADMIN PAGES
// ══════════════════════════════════════════════════════════════════════════════
/* QRPASS_STUDENT_ACADEMIC_V105: use the same academic choices as student registration. */
const QRPassStudentAcademicDepartmentsV105 = [
  "College of Allied Engineering",
  "College of Arts and Sciences",
  "College of Business and Accountancy",
  "College of Computer Studies",
  "College of Criminal Justice",
  "College of Customs Administration",
  "College of Hospitality Management",
  "College of Nursing",
  "College of Social Work",
  "College of Teacher Education"
];

function SysAdminUserAccounts() {
  const [qrpassSortOrder, setQrpassSortOrder] = useState<"newest" | "oldest">("newest");
  const [users, setUsers] = useState<any[]>([]);

  const [summary, setSummary] = useState<any>({
    total_users: 0,
    active_users: 0,
    inactive_users: 0,
    students: 0,
    security: 0,
    pco: 0,
    system_admins: 0,
  });

  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [success, setSuccess] = useState("");
  const [search, setSearch] = useState("");
  const [userRoleFilter, setUserRoleFilter] = useState("all");
  const [userStatusFilter, setUserStatusFilter] = useState("all");
  const [accountsPeriod, setAccountsPeriod] = useState<CSUDatePeriod>("all");
  const [accountsFrom, setAccountsFrom] = useState("");
  const [accountsTo, setAccountsTo] = useState("");

  const [updatingId, setUpdatingId] =
    useState<number | null>(null);
  // QRPASS_USER_ACCOUNT_REVOKE_V33
  const [revokingUserId, setRevokingUserId] = useState<number | null>(null);
  /* QRPASS_REVOKE_YES_NO_V118 */
  const [pendingRevokeUserV118, setPendingRevokeUserV118] = useState<any | null>(null);
  const [pendingDisableUserV183, setPendingDisableUserV183] = useState<any | null>(null);
  const [disableErrorV183, setDisableErrorV183] = useState("");
  const [disablingV183, setDisablingV183] = useState(false);

  const [revokeReasonV91, setRevokeReasonV91] = useState("");
  const [revokeSuccessV181, setRevokeSuccessV181] = useState(false); // QRPASS_REVOKE_PURGE_NOTIFY_V181 // QRPASS_PERMANENT_ACCESS_V91

  const [showAddUser, setShowAddUser] =
    useState(false);

  const [creatingUser, setCreatingUser] =
    useState(false);

  const [savingEdit, setSavingEdit] =
    useState(false);

  const [editUser, setEditUser] =
    useState<any | null>(null);

  const [newUser, setNewUser] = useState({
    name: "",
    email: "",
    username: "",
    role: "student",
    password: "",
    college: "",
    year_level: "",
  });

  const periodAccounts = users.filter((user:any) => csuMatchesPeriod(user.created_at ?? user.registered_at, accountsPeriod, accountsFrom, accountsTo));
  const accountPeriodStats = {
    total: periodAccounts.length,
    students: periodAccounts.filter((user:any) => String(user.role ?? "").toLowerCase() === "student").length,
    personnel: periodAccounts.filter((user:any) => ["security", "pco"].includes(String(user.role ?? "").toLowerCase())).length,
    active: periodAccounts.filter((user:any) => String(user.status ?? "").toLowerCase() === "approved").length,
    disabled: periodAccounts.filter((user:any) => String(user.status ?? "").toLowerCase() !== "approved").length,
    admins: periodAccounts.filter((user:any) => String(user.role ?? "").toLowerCase() === "sysadmin").length,
  };

  async function loadUsers() {
  try {
    setLoading(true);
    setError("");

    const data =
      await getUsers();

    /* qrpass-sysadmin-users-list-sync-v5: hide archived users on the actual background User List. */
    const userList = Array.isArray(data?.users)
      ? data.users.filter((user: any) => !user.qrpass_archived_at)
      : [];

    /*
    |--------------------------------------------------------------------------
    | USER LIST
    |--------------------------------------------------------------------------
    */

    setUsers(userList);

    /*
    |--------------------------------------------------------------------------
    | SUMMARY COUNTS
    |--------------------------------------------------------------------------
    */

    const totalUsers =
      userList.length;

    const students =
      userList.filter(
        (user: any) =>
          String(
            user.role ?? ""
          ).toLowerCase() ===
          "student"
      ).length;

    const security =
      userList.filter(
        (user: any) =>
          String(
            user.role ?? ""
          ).toLowerCase() ===
          "security"
      ).length;

    const pco =
      userList.filter(
        (user: any) =>
          String(
            user.role ?? ""
          ).toLowerCase() ===
          "pco"
      ).length;

    const systemAdmins =
      userList.filter(
        (user: any) =>
          String(
            user.role ?? ""
          ).toLowerCase() ===
          "sysadmin"
      ).length;

    const activeUsers =
      userList.filter(
        (user: any) =>
          String(
            user.status ?? ""
          ).toLowerCase() ===
          "approved"
      ).length;

    const inactiveUsers =
      userList.filter(
        (user: any) =>
          String(
            user.status ?? ""
          ).toLowerCase() !==
          "approved"
      ).length;

    /*
    |--------------------------------------------------------------------------
    | UPDATE SUMMARY CARDS
    |--------------------------------------------------------------------------
    */

    setSummary({
      total_users:
        totalUsers,

      active_users:
        activeUsers,

      inactive_users:
        inactiveUsers,

      students:
        students,

      security:
        security,

      pco:
        pco,

      system_admins:
        systemAdmins,
    });
  } catch (err) {
    console.error(
      "Failed to load users:",
      err
    );

    setError(
      err instanceof Error
        ? err.message
        : "Failed to load user accounts."
    );

    setUsers([]);

    setSummary({
      total_users: 0,
      active_users: 0,
      inactive_users: 0,
      students: 0,
      security: 0,
      pco: 0,
      system_admins: 0,
    });
  } finally {
    setLoading(false);
  }
}

  useEffect(() => {
    void loadUsers();
    const onRecordsChanged = (event: Event) => {
      const detail = (event as CustomEvent<{ module?: string }>).detail;
      if (detail?.module === 'users') void loadUsers();
    };
    window.addEventListener('qrpass-page-records-changed', onRecordsChanged);
    return () => window.removeEventListener('qrpass-page-records-changed', onRecordsChanged);
  }, []);

  function getRoleLabel(role: string) {
    switch (
      String(role ?? "").toLowerCase()
    ) {
      case "student":
        return "Student";

      case "security":
        return "Security Personnel (CSU)";

      case "pco":
        return "PCO Staff";

      case "sysadmin":
        return "System Administrator";

      default:
        return role || "Unknown";
    }
  }

  function getStatusLabel(status: string) {
    return String(
      status ?? ""
    ).toLowerCase() === "approved"
      ? "Active"
      : "Disabled";
  }

  function formatDate(dateString: string) {
    if (!dateString) {
      return "—";
    }

    const date =
      new Date(dateString);

    if (Number.isNaN(date.getTime())) {
      return "—";
    }

    return date.toLocaleDateString(
      "en-US",
      {
        year: "numeric",
        month: "short",
        day: "numeric",
      }
    );
  }

  async function handleAddUser(
    event: any
  ) {
    event.preventDefault();

    setError("");
    setSuccess("");

    if (
      !newUser.name.trim() ||
      !newUser.email.trim() ||
      !newUser.username.trim() ||
      !newUser.password.trim()
    ) {
      setError(
        "Please complete all required fields."
      );

      return;
    }

    if (newUser.role === 'student' && (!newUser.year_level || (newUser.year_level !== 'Senior High School' && !newUser.college))) {
      setError('Please select the student year level and department (department is not required for Senior High School).');
      return;
    }

    if (newUser.password.length < 6) {
      setError(
        "Password must contain at least 6 characters."
      );

      return;
    }

    try {
      setCreatingUser(true);

      const data = await createUser({
        name: newUser.name.trim(),

        email: newUser.email.trim(),

        username:
          newUser.username.trim(),

        role:
          newUser.role as
            | "student"
            | "security"
            | "pco"
            | "sysadmin",

        password: newUser.password,
        college: newUser.role === 'student' && newUser.year_level !== 'Senior High School' ? newUser.college : null,
        year_level: newUser.role === 'student' ? newUser.year_level : null,
      });

      setSuccess(
        data.message ??
          "User account created successfully."
      );

      setNewUser({
        name: "",
        email: "",
        username: "",
        role: "student",
        password: "",
    college: "",
    year_level: "",
      });

      setShowAddUser(false);

      await loadUsers();
    } catch (err) {
      console.error(
        "Failed to create user:",
        err
      );

      setError(
        err instanceof Error
          ? err.message
          : "Failed to create user account."
      );
    } finally {
      setCreatingUser(false);
    }
  }

  function handleStartEdit(user: any) {
    setError("");
    setSuccess("");
    setShowAddUser(false);

    setEditUser({
      id: user.id,
      name: user.name ?? "",
      email: user.email ?? "",
      username: user.username ?? "",
      role: user.role ?? "student",
      college: user.college ?? "",
      year_level: user.year_level ?? "",
    });
  }

  function handleCancelEdit() {
    setEditUser(null);
    setError("");
  }

  async function handleSaveEdit(
    event: any
  ) {
    event.preventDefault();

    if (!editUser) {
      return;
    }

    setError("");
    setSuccess("");

    if (
      !editUser.name.trim() ||
      !editUser.email.trim() ||
      !editUser.username.trim()
    ) {
      setError(
        "Name, email, and username are required."
      );

      return;
    }

    if (editUser.role === 'student' && (!editUser.year_level || (editUser.year_level !== 'Senior High School' && !editUser.college))) {
      setError('Please select the student year level and department (department is not required for Senior High School).');
      return;
    }

    try {
      setSavingEdit(true);

      const data = await updateUser(
        editUser.id,
        {
          name:
            editUser.name.trim(),

          email:
            editUser.email.trim(),

          username:
            editUser.username.trim(),

          role:
            editUser.role as
              | "student"
              | "security"
              | "pco"
              | "sysadmin",
          college: editUser.role === 'student' && editUser.year_level !== 'Senior High School' ? editUser.college : null,
          year_level: editUser.role === 'student' ? editUser.year_level : null,
        }
      );

      setSuccess(
        data.message ??
          "User account updated successfully."
      );

      setEditUser(null);

      await loadUsers();
    } catch (err) {
      console.error(
        "Failed to update user:",
        err
      );

      setError(
        err instanceof Error
          ? err.message
          : "Failed to update user account."
      );
    } finally {
      setSavingEdit(false);
    }
  }

  // Reuse the existing authenticated active-session list and revoke API.
  // This revokes all returned sessions belonging to the selected account.
  // QRPASS_PERMANENT_REVOKE_V34
  async function handleRevokeUserSessions(user: any) {
    const uid = Number(user?.id);
    if (!Number.isSafeInteger(uid) || uid <= 0 || revokingUserId !== null) return;
    if (user?.qrpass_revoked_at) return;
    setRevokeReasonV91("");
    setPendingRevokeUserV118(user);
  }

  // QRPASS_PERMANENT_ACCESS_V91: Revoke access forever, but preserve the account and audit data.
  async function confirmRevokeV118() {
    const user = pendingRevokeUserV118;
    const uid = Number(user?.id);
    const reason = revokeReasonV91.trim();
    if (!Number.isSafeInteger(uid) || uid <= 0 || revokingUserId !== null) return;
    if (reason.length < 5) { setError('Enter a reason of at least 5 characters.'); return; }
    setRevokingUserId(uid);
    setError(''); setSuccess('');
    try {
      const result = await revokeUserAccessV91(uid, reason);
      setSuccess("");
      setRevokeSuccessV181(true);
      setPendingRevokeUserV118(null); setRevokeReasonV91('');
      await loadUsers();
    } catch (e) { setError(e instanceof Error ? e.message : 'Failed to revoke access.'); }
    finally { setRevokingUserId(null); }
  }

  async function handleToggleStatus(
    user: any
  ) {
    if (user?.qrpass_revoked_at) { setError("A revoked account cannot be enabled."); return; }
    const currentStatus =
      String(
        user.status ?? ""
      ).toLowerCase();

    const newStatus =
      currentStatus === "approved"
        ? "inactive"
        : "approved";

    const action =
      newStatus === "inactive"
        ? "disable"
        : "enable";

    // QRPASS_DISABLE_FLOATING_CONFIRM_V183: Disable confirmation is a QRPass modal, not a browser popup.
    if (newStatus === "inactive") {
      setDisableErrorV183("");
      setPendingDisableUserV183(user);
      return;
    }

    const confirmed =
      window.confirm(
        `Are you sure you want to ${action} the account of ${user.name}?`
      );

    if (!confirmed) {
      return;
    }

    try {
      setUpdatingId(user.id);

      setError("");
      setSuccess("");

      const data =
        await updateUserStatus(
          user.id,
          newStatus
        );

      setSuccess(
        data.message ??
          "User account updated successfully."
      );

      await loadUsers();
    } catch (err) {
      console.error(
        "Failed to update user status:",
        err
      );

      setError(
        err instanceof Error
          ? err.message
          : "Failed to update user status."
      );
    } finally {
      setUpdatingId(null);
    }
  }


  // QRPASS_DISABLE_FLOATING_CONFIRM_V183: confirm disable with backend before closing.
  async function confirmDisableV183() {
    const user=pendingDisableUserV183;
    const id=Number(user?.id);
    if(!Number.isSafeInteger(id)||id<=0||disablingV183)return;
    setDisablingV183(true);
    setDisableErrorV183("");
    setError("");
    setSuccess("");
    try {
      const result=await updateUserStatus(id,"inactive");
      await loadUsers();
      setPendingDisableUserV183(null);
      setSuccess(result.message ?? "User account disabled successfully.");
    } catch(err) {
      setDisableErrorV183(err instanceof Error ? err.message : "Failed to disable user account.");
    } finally {
      setDisablingV183(false);
    }
  }

  const filteredUsers =
    users.filter((user: any) => {
      const keyword =
        search
          .trim()
          .toLowerCase();

        if (userRoleFilter !== "all" && String(user.role ?? "").toLowerCase() !== userRoleFilter) return false;
        const active = String(user.status ?? "").toLowerCase() === "approved";
        if (userStatusFilter === "active" && !active) return false;
        if (userStatusFilter === "inactive" && active) return false;
        if (!keyword) {
          return true;
        }

        const searchableText = [
        user.name,
        user.username,
        user.email,
        getRoleLabel(user.role),
        user.qrpass_revoked_at ? "Revoked" : getStatusLabel(user.status),
      ]
        .join(" ")
        .toLowerCase();

      return searchableText.includes(
        keyword
      );
    });

  filteredUsers.sort((a: any, b: any) => (qrpassSortOrder === "newest" ? 1 : -1) * ((new Date(b.created_at ?? 0).getTime() || 0) - (new Date(a.created_at ?? 0).getTime() || 0)));

  const totalPersonnel =
    Number(summary.security ?? 0) +
    Number(summary.pco ?? 0) +
    Number(summary.system_admins ?? 0);

  return (
    <div className="space-y-5">
      {/* HEADER */}
      <div className="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <PageHeader
          title="User Accounts"
          subtitle="Manage QRpass user accounts and role-based access."
        />

        
      </div>

      {/* SUCCESS MESSAGE */}
      {success && (
        <div className="px-4 py-3 bg-green-50 border border-green-200 rounded-lg text-sm text-green-700">
          {success}
        </div>
      )}

      {/* ERROR MESSAGE */}
      {error && (
        <div className="px-4 py-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700">
          {error}
        </div>
      )}

      {/* QRPASS_USER_ACCOUNTS_DROPDOWN_SIZE_V175: shared Add/Edit dropdown dimensions only */}
      <style>{`
        html body #root#root#root#root#root#root#root#root#root#root select[data-qrpass-user-select-v175="true"] {
          height: 56px !important;
          min-height: 56px !important;
          max-height: 56px !important;
          box-sizing: border-box !important;
        }
      `}</style>
      {/* ADD USER FORM */}
      {/* QRPASS_ADD_USER_SELECT_WHITE_ON_OPEN_V156 */}
      {showAddUser && (
        <div data-qrpass-add-user-floating="QRPASS_ADD_USER_FLOAT_V149" className="fixed inset-0 z-[260] overflow-y-auto bg-[#0f172a]/50 px-3 py-5 sm:p-8 items-center justify-center flex" role="presentation">
          <div role="dialog" aria-modal="true" aria-label="Add New User Account" className="mx-auto w-full max-w-4xl rounded-2xl bg-white shadow-2xl">
            <Card title="Add New User Account">
          <form
            onSubmit={handleAddUser}
            className="p-4 space-y-4"
           data-qrpass-add-user-uniform-v140="QRPASS_ADD_USER_RESTORE_UNIFORM_V140" data-qrpass-add-user-form-v52="true" data-qrpass-add-user-white-v55="true">
            <div className="grid md:grid-cols-2 gap-4">
              <div>
                <label className="block text-xs font-semibold mb-1">
                  Full Name
                </label>
                {/* QRPASS_ADD_USER_FULL_NAME_RESTORED_V52 */}
                <input
                  type="text"
                  name="fullName"
                  autoComplete="name"
                  aria-label="Full Name"
                  value={newUser.name}
                  onChange={(e) => setNewUser((current) => ({ ...current, name: e.target.value }))}
                  placeholder="Enter full name"
                  required
                  className="w-full px-3 py-2 text-sm border border-[#cbd5e1] rounded-xl bg-white text-[#17336d] focus:outline-none"
                />
              </div>

              <div>
                <label className="block text-xs font-semibold mb-1">
                  Email Address
                </label>

                <input
                  type="email"
                  value={newUser.email}
                  onChange={(e) =>
                    setNewUser(
                      (current) => ({
                        ...current,
                        email:
                          e.target.value,
                      })
                    )
                  }
                  placeholder="e.g. student@uc.edu.ph"
                  required
                  className="w-full px-3 py-2 text-sm border border-[#cfd8e6] rounded-md bg-[#fafbfc] focus:outline-none focus:border-[#2f5fd6] focus:ring-2 focus:ring-[#2f5fd6]/15"
                />
              </div>

              <div>
                <label className="block text-xs font-semibold mb-1">
                  ID NUMBER
                </label>

                <input
                  type="text" pattern="[0-9]*" inputMode="numeric"
                  value={
                    newUser.username
                  }
                  onChange={(e) =>
                    setNewUser(
                      (current) => ({
                        ...current,
                        username:
                          e.target.value.replace(/[^0-9]/g, ""),
                      })
                    )
                  }
                  placeholder="e.g. 261234"
                  required
                  className="w-full px-3 py-2 text-sm border border-[#cfd8e6] rounded-md bg-[#fafbfc] focus:outline-none focus:border-[#2f5fd6] focus:ring-2 focus:ring-[#2f5fd6]/15"
                 data-qrpass-add-user-field-v55="username"
                />
              </div>

              <div>
                <label className="block text-xs font-semibold mb-1">
                  Role
                </label>

                <span data-qrpass-account-role-v54="add" className="qrpass-account-role-wrap-v54 w-full">
<select data-qrpass-user-select-v175="true"
                  value={newUser.role}
                  onChange={(e) =>
                    setNewUser(
                      (current) => ({
                        ...current,
                        role:
                          e.target.value,
                      })
                    )
                  }
                  className="h-[58px] min-h-[58px] w-full box-border rounded-xl border border-[#cbd5e1] bg-white px-4 pr-10 text-sm text-[#17336d] outline-none transition-colors hover:bg-[#eef2ff] focus:border-[#5278e7]"
                
                      style={{ backgroundColor: "#ffffff", height: 58, minHeight: 58 }}
                    
                      onMouseEnter={(e) => { if (document.activeElement !== e.currentTarget) e.currentTarget.style.setProperty('background-color', '#eef2ff', 'important'); }}
                    
                      onMouseLeave={(e) => { e.currentTarget.style.setProperty('background-color', '#ffffff', 'important'); }}
                    
                      onFocus={(e) => { e.currentTarget.style.setProperty('background-color', '#ffffff', 'important'); }}
                    
                      onBlur={(e) => { e.currentTarget.style.setProperty('background-color', '#ffffff', 'important'); }}
                    >
                  <option value="student">
                    Student
                  </option>

                  <option value="security">
                    Security Personnel
                    (CSU)
                  </option>

                  <option value="pco">
                    PCO Staff
                  </option>

                  <option value="sysadmin">
                    System Administrator
                  </option>
                </select>
<svg className="qrpass-account-role-chevron-v54" aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="m4 6 4 4 4-4" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" /></svg>
</span>
              </div>

              {/* QRPASS_STUDENT_ACADEMIC_V105: student academic fields */}
              {newUser.role === "student" && (
                <>
                  <div>
                    <label className="mb-1 block text-xs font-semibold">Year Level</label>
                    <select data-qrpass-user-select-v175="true" ref={(element) => {
                      if (element) {
                        element.style.setProperty('background', '#ffffff', 'important');
                        element.style.setProperty('background-color', '#ffffff', 'important');
                      }
                    }} aria-label="Student Year Level" required value={newUser.year_level}
                      
                      
                      
                      
                      onChange={(e) => {
                        const value = e.target.value;
                        setNewUser((current) => ({ ...current, year_level: value, college: value === "Senior High School" ? "" : current.college }));
                      }}
                      className="h-[58px] min-h-[58px] w-full box-border rounded-xl border border-[#cbd5e1] bg-white px-4 pr-10 text-sm text-[#17336d] outline-none transition-colors hover:bg-[#eef2ff] focus:border-[#5278e7]"
                      style={{ backgroundColor: "#ffffff", height: 58, minHeight: 58 }}
                    
                      onMouseEnter={(e) => { if (document.activeElement !== e.currentTarget) e.currentTarget.style.setProperty('background-color', '#eef2ff', 'important'); }}
                    
                      onMouseLeave={(e) => { e.currentTarget.style.setProperty('background-color', '#ffffff', 'important'); }}
                    
                      onFocus={(e) => { e.currentTarget.style.setProperty('background-color', '#ffffff', 'important'); }}
                    
                      onBlur={(e) => { e.currentTarget.style.setProperty('background-color', '#ffffff', 'important'); }}
                    >
                      <option value="">Select year level</option>
                      {['Senior High School', '1st Year', '2nd Year', '3rd Year', '4th Year'].map(level => (
                        <option key={level} value={level}>{level}</option>
                      ))}
                    </select>
                  </div>
                  {newUser.year_level !== "Senior High School" && (
                    <div>
                      <label className="mb-1 block text-xs font-semibold">Department</label>
                      <select data-qrpass-user-select-v175="true" ref={(element) => {
                      if (element) {
                        element.style.setProperty('background', '#ffffff', 'important');
                        element.style.setProperty('background-color', '#ffffff', 'important');
                      }
                    }} aria-label="Student Department" required value={newUser.college}
                      
                      
                      
                      
                        onChange={(e) => setNewUser((current) => ({ ...current, college: e.target.value }))}
                        className="h-[58px] min-h-[58px] w-full box-border rounded-xl border border-[#cbd5e1] bg-white px-4 pr-10 text-sm text-[#17336d] outline-none transition-colors hover:bg-[#eef2ff] focus:border-[#5278e7]"
                      style={{ backgroundColor: "#ffffff", height: 58, minHeight: 58 }}
                    
                      onMouseEnter={(e) => { if (document.activeElement !== e.currentTarget) e.currentTarget.style.setProperty('background-color', '#eef2ff', 'important'); }}
                    
                      onMouseLeave={(e) => { e.currentTarget.style.setProperty('background-color', '#ffffff', 'important'); }}
                    
                      onFocus={(e) => { e.currentTarget.style.setProperty('background-color', '#ffffff', 'important'); }}
                    
                      onBlur={(e) => { e.currentTarget.style.setProperty('background-color', '#ffffff', 'important'); }}
                    >
                        <option value="">Select department</option>
                        {QRPassStudentAcademicDepartmentsV105.map((department) => (
                  <option key={department} value={department}>{department}</option>
                ))}
                      </select>
                    </div>
                  )}
                </>
              )}

              <div className="md:col-span-2">
                <label className="block text-xs font-semibold mb-1">
                  Password
                </label>

                <input
                  type="password"
                  value={
                    newUser.password
                  }
                  onChange={(e) =>
                    setNewUser(
                      (current) => ({
                        ...current,
                        password:
                          e.target.value,
                      })
                    )
                  }
                  placeholder="Minimum 6 characters"
                  minLength={6}
                  required
                  className="w-full px-3 py-2 text-sm border border-[#cfd8e6] rounded-md bg-[#fafbfc] focus:outline-none focus:border-[#2f5fd6] focus:ring-2 focus:ring-[#2f5fd6]/15"
                 data-qrpass-add-user-field-v55="password"
                />

                
              </div>
            </div>

            <div className="flex justify-end gap-2 pt-2">
              <button
                type="button"
                onClick={() => {
                  setShowAddUser(
                    false
                  );

                  setNewUser({
                    name: "",
                    email: "",
                    username: "",
                    role: "student",
                    password: "",
    college: "",
    year_level: "",
                  });

                  setError("");
                }}
                disabled={
                  creatingUser
                }
                className="px-4 py-2 border border-[#cfd8e6] rounded-md text-xs font-semibold disabled:opacity-50 !bg-white !text-[#17336d] !border-[#cbd5e1] transition-colors hover:!bg-[#eef2ff] hover:!border-[#a8bde4] hover:!text-[#17336d] focus-visible:!ring-0 focus-visible:!shadow-none focus-visible:!outline-none"
               
            onMouseEnter={(e) => {
              const el=e.currentTarget;
              if(!el.dataset.qrpassV158Saved) {
                el.dataset.qrpassV158Saved=el.style.cssText || " ";
              }
              el.style.setProperty("background", "#eef2ff", "important");
              el.style.setProperty("background-color", "#eef2ff", "important");
              el.style.setProperty("background-image", "none", "important");
              el.style.setProperty("color", "#17336d", "important");
              el.style.setProperty("border-color", "#a8bde4", "important");
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onMouseLeave={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onFocus={(e) => {
              e.currentTarget.style.setProperty("box-shadow", "none", "important");
              e.currentTarget.style.setProperty("outline", "none", "important");
            }}
            onBlur={(e) => {
              const el=e.currentTarget;

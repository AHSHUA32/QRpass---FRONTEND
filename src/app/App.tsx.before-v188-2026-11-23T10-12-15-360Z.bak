           GLOBAL DARK MODE READABILITY / CONTRAST FIX
           Applies across Student, Security, PCO and SysAdmin.
        ====================================================== */

        .dark {
          --foreground: #f7f9fc;
          --card-foreground: #f7f9fc;
          --popover-foreground: #f7f9fc;
          --muted-foreground: #b9c5d6;
          --secondary-foreground: #e7eef9;
        }

        .dark .text-foreground {
          color: #f7f9fc !important;
        }

        .dark .text-muted-foreground {
          color: #b9c5d6 !important;
        }

        /* Green / success surfaces */
        .dark .bg-green-50,
        .dark .bg-green-100,
        .dark .bg-green-200,
        .dark .bg-green-50\/30,
        .dark .bg-green-50\/40,
        .dark .bg-green-50\/50 {
          background-color: #10291d !important;
        }

        .dark .border-green-100,
        .dark .border-green-200,
        .dark .border-green-300,
        .dark .border-green-900\/70 {
          border-color: #2d6b4d !important;
        }

        .dark .text-green-300,
        .dark .text-green-500,
        .dark .text-green-600,
        .dark .text-green-700,
        .dark .text-green-800,
        .dark .text-green-900 {
          color: #bbf7d0 !important;
        }

        /* Yellow / warning / claimant surfaces */
        .dark .bg-yellow-50,
        .dark .bg-yellow-100,
        .dark .bg-yellow-200,
        .dark .bg-yellow-50\/30,
        .dark .bg-yellow-50\/40,
        .dark .bg-yellow-50\/50 {
          background-color: #2b2511 !important;
        }

        .dark .border-yellow-100,
        .dark .border-yellow-200,
        .dark .border-yellow-300,
        .dark .border-yellow-900\/70 {
          border-color: #806b21 !important;
        }

        .dark .text-yellow-300,
        .dark .text-yellow-500,
        .dark .text-yellow-600,
        .dark .text-yellow-700,
        .dark .text-yellow-800,
        .dark .text-yellow-900 {
          color: #fde68a !important;
        }

        /* Red / error / lost surfaces */
        .dark .bg-red-50,
        .dark .bg-red-100,
        .dark .bg-red-200,
        .dark .bg-red-50\/30,
        .dark .bg-red-50\/40,
        .dark .bg-red-50\/50 {
          background-color: #30191d !important;
        }

        .dark .border-red-100,
        .dark .border-red-200,
        .dark .border-red-300,
        .dark .border-red-900\/70 {
          border-color: #7f3f49 !important;
        }

        .dark .text-red-300,
        .dark .text-red-500,
        .dark .text-red-600,
        .dark .text-red-700,
        .dark .text-red-800,
        .dark .text-red-900 {
          color: #fecaca !important;
        }

        /* Blue / informational surfaces */
        .dark .bg-blue-50,
        .dark .bg-blue-100,
        .dark .bg-blue-200,
        .dark .bg-blue-50\/30,
        .dark .bg-blue-50\/40,
        .dark .bg-blue-50\/50 {
          background-color: #13263f !important;
        }

        .dark .border-blue-100,
        .dark .border-blue-200,
        .dark .border-blue-300,
        .dark .border-blue-900\/70 {
          border-color: #355b8c !important;
        }

        .dark .text-blue-300,
        .dark .text-blue-500,
        .dark .text-blue-600,
        .dark .text-blue-700,
        .dark .text-blue-800,
        .dark .text-blue-900 {
          color: #c7d9ff !important;
        }

        /* Slate / gray / neutral cards */
        .dark .bg-slate-50,
        .dark .bg-slate-100,
        .dark .bg-gray-50,
        .dark .bg-gray-100 {
          background-color: #182335 !important;
        }

        .dark .text-slate-500,
        .dark .text-slate-600,
        .dark .text-slate-700,
        .dark .text-slate-800,
        .dark .text-gray-500,
        .dark .text-gray-600,
        .dark .text-gray-700,
        .dark .text-gray-800 {
          color: #c7d2e1 !important;
        }

        .dark .border-slate-200,
        .dark .border-slate-300,
        .dark .border-gray-200,
        .dark .border-gray-300 {
          border-color: #33455f !important;
        }

        /* Common light semi-transparent utility backgrounds */
        .dark .bg-muted\/20 {
          background-color: rgba(28, 42, 64, 0.62) !important;
        }

        .dark .bg-muted\/40 {
          background-color: rgba(28, 42, 64, 0.82) !important;
        }

        .dark .bg-white\/5,
        .dark .bg-white\/10 {
          background-color: rgba(255, 255, 255, 0.07) !important;
        }

        /* Ensure disabled and subtle controls remain readable */
        .dark button:disabled,
        .dark input:disabled,
        .dark select:disabled,
        .dark textarea:disabled {
          opacity: 0.72 !important;
        }

        /* Status pills should never become pale-on-pale */
        .dark .rounded-full.bg-green-100 {
          background-color: #153723 !important;
          color: #bbf7d0 !important;
        }

        .dark .rounded-full.bg-yellow-100 {
          background-color: #3a3114 !important;
          color: #fde68a !important;
        }

        .dark .rounded-full.bg-red-100 {
          background-color: #3b1d22 !important;
          color: #fecaca !important;
        }

        .dark .rounded-full.bg-blue-100 {
          background-color: #172f52 !important;
          color: #c7d9ff !important;
        }

        /* Improve outlines and card separation throughout the app */
        .dark .border {
          border-color: #344761;
        }

        .dark .shadow-sm,
        .dark .shadow-md,
        .dark .shadow-lg,
        .dark .shadow-xl,
        .dark .shadow-2xl {
          --tw-shadow-color: rgba(0, 0, 0, 0.44) !important;
        }


        /* =====================================================
           DARK MODE FINAL CONTRAST SAFETY NET
           Covers legacy hard-coded utilities throughout QRPass.
        ====================================================== */

        html.dark body,
        html.dark #root {
          color: #f4f7fb;
        }

        /* Hard-coded dark text that becomes unreadable on dark surfaces */
        html.dark .text-gray-900,
        html.dark .text-gray-950,
        html.dark .text-slate-900,
        html.dark .text-slate-950,
        html.dark .text-black,
        html.dark [class~="text-[#111827]"],
        html.dark [class~="text-[#0f172a]"],
        html.dark [class~="text-[#16224b]"],
        html.dark [class~="text-[#334155]"] {
          color: #f5f8fd !important;
        }

        html.dark .text-gray-400,
        html.dark .text-gray-500,
        html.dark .text-gray-600,
        html.dark .text-gray-700,
        html.dark .text-gray-800,
        html.dark .text-slate-400,
        html.dark .text-slate-500,
        html.dark .text-slate-600,
        html.dark .text-slate-700,
        html.dark .text-slate-800,
        html.dark [class~="text-[#64748b]"],
        html.dark [class~="text-[#52637a]"] {
          color: #b8c6d9 !important;
        }

        html.dark [class~="text-[#1a3a7b]"] {
          color: #9fc0ff !important;
        }

        /* Legacy light cards / inputs / table headers */
        html.dark .bg-white {
          background-color: #121f32 !important;
        }

        html.dark .bg-gray-50,
        html.dark .bg-gray-100,
        html.dark .bg-slate-50,
        html.dark .bg-slate-100,
        html.dark [class~="bg-[#fafbfc]"],
        html.dark [class~="bg-[#fbfcfe]"],
        html.dark [class~="bg-[#f8fafc]"],
        html.dark [class~="bg-[#f3f5f9]"],
        html.dark [class~="bg-[#f2f5fb]"],
        html.dark [class~="bg-[#eef2ff]"] {
          background-color: #17253a !important;
        }

        html.dark [class~="bg-[#eef2fc]"] {
          background-color: #1a3154 !important;
        }

        html.dark .border-gray-100,
        html.dark .border-gray-200,
        html.dark .border-gray-300,
        html.dark .border-slate-100,
        html.dark .border-slate-200,
        html.dark .border-slate-300,
        html.dark [class~="border-[#cfd8e6]"],
        html.dark [class~="border-[#dce3ee]"],
        html.dark [class~="border-[#e5eaf2]"],
        html.dark [class~="border-[#edf0f5]"] {
          border-color: #354961 !important;
        }

        /* Catch status variants, including opacity classes */
        html.dark [class*="bg-green-50"],
        html.dark [class*="bg-green-100"] {
          background-color: #102b20 !important;
        }

        html.dark [class*="text-green-"] {
          color: #a7f3c6 !important;
        }

        html.dark [class*="border-green-"] {
          border-color: #2f7554 !important;
        }

        html.dark [class*="bg-yellow-50"],
        html.dark [class*="bg-yellow-100"],
        html.dark [class*="bg-amber-50"],
        html.dark [class*="bg-amber-100"] {
          background-color: #302711 !important;
        }

        html.dark [class*="text-yellow-"],
        html.dark [class*="text-amber-"] {
          color: #fde68a !important;
        }

        html.dark [class*="border-yellow-"],
        html.dark [class*="border-amber-"] {
          border-color: #8a7427 !important;
        }

        html.dark [class*="bg-red-50"],
        html.dark [class*="bg-red-100"] {
          background-color: #341b21 !important;
        }

        html.dark [class*="text-red-"] {
          color: #fecaca !important;
        }

        html.dark [class*="border-red-"] {
          border-color: #86434d !important;
        }

        html.dark [class*="bg-blue-50"],
        html.dark [class*="bg-blue-100"] {
          background-color: #142b49 !important;
        }

        html.dark [class*="text-blue-"] {
          color: #bfd6ff !important;
        }

        html.dark [class*="border-blue-"] {
          border-color: #3e6598 !important;
        }

        /* Tables: ensure data never inherits black/dark text */
        html.dark table {
          color: #e5edf8;
        }

        html.dark table thead th {
          color: #c4d2e6 !important;
          border-color: #344860 !important;
        }

        html.dark table tbody td {
          color: #e5edf8;
          border-color: #2e425a !important;
        }

        html.dark table tbody tr:hover {
          background-color: #172a45 !important;
        }

        /* Neutral text inside table cells that used hard-coded black */
        html.dark table .text-gray-900,
        html.dark table .text-slate-900,
        html.dark table [class~="text-[#111827]"] {
          color: #f7f9fc !important;
        }

        /* Outline / secondary buttons */
        html.dark button.bg-white,
        html.dark a.bg-white {
          background-color: #17253a !important;
          color: #dbe7f7 !important;
          border-color: #405570 !important;
        }

        html.dark button.bg-white:hover,
        html.dark a.bg-white:hover {
          background-color: #203653 !important;
        }

        /* Common form fields that still carry light hard-coded backgrounds */
        html.dark input,
        html.dark select,
        html.dark textarea {
          background-color: #111e31 !important;
          color: #f7f9fc !important;
          border-color: #405570 !important;
        }

        html.dark input::placeholder,
        html.dark textarea::placeholder {
          color: #91a1b7 !important;
        }

        /* Keep disabled elements readable instead of nearly disappearing */
        html.dark button:disabled,
        html.dark input:disabled,
        html.dark select:disabled,
        html.dark textarea:disabled {
          opacity: 0.78 !important;
        }

        /* Force generic muted panels to remain separated from the page */
        html.dark .bg-muted,
        html.dark .bg-muted\/20,
        html.dark .bg-muted\/40 {
          background-color: #17253a !important;
        }

        .dark ::-webkit-scrollbar {
          width: 10px;
          height: 10px;
        }

        .dark ::-webkit-scrollbar-track {
          background: #0b1220;
        }

        .dark ::-webkit-scrollbar-thumb {
          background: #33445e;
          border: 2px solid #0b1220;
          border-radius: 999px;
        }

        .dark ::-webkit-scrollbar-thumb:hover {
          background: #465c7a;
        }

        img[alt="Selected Lost and Found item preview"] {
          max-width: 100% !important;
          max-height: 200px !important;
          width: auto !important;
          height: auto !important;
          object-fit: contain !important;
        }
      

        /* ==========================================================
           QRPASS LIGHTS OUT — X-inspired black surfaces + QRPass blue
           Dark mode only; keeps existing light mode and app logic.
           ========================================================== */
        html.dark {
          color-scheme: dark;
          --background: #000000;
          --foreground: #f7f9f9;
          --card: #080a0e;
          --card-foreground: #f7f9f9;
          --popover: #080a0e;
          --popover-foreground: #f7f9f9;
          --primary: #3b82f6;
          --primary-foreground: #ffffff;
          --secondary: #16181c;
          --secondary-foreground: #e7edf5;
          --muted: #16181c;
          --muted-foreground: #9ca9b8;
          --accent: #3b82f6;
          --accent-foreground: #ffffff;
          --border: #30353b;
          --input: #3b4250;
          --input-background: #101419;
          --ring: #60a5fa;
          --sidebar: #05080e;
          --sidebar-foreground: #f7f9f9;
          --sidebar-accent: #11213c;
          --sidebar-accent-foreground: #f7f9f9;
          --sidebar-border: #30353b;
          --qrpass-table-header: #101419;
          --qrpass-table-alternate: #0b0e13;
          --qrpass-table-hover: #15253c;
        }
        html.dark body,
        html.dark main,
        html.dark .bg-background {
          background: #000000 !important;
          color: #f7f9f9;
        }
        html.dark main {
          background-image: none !important;
        }
        html.dark header,
        html.dark header.bg-white,
        html.dark footer {
          background: #080a0e !important;
          border-color: #30353b !important;
          box-shadow: none !important;
        }
        html.dark aside {
          background: #05080e !important;
          border-color: #30353b !important;
        }
        html.dark aside nav button:hover {
          background: #15253c !important;
        }
        html.dark .bg-white,
        html.dark .bg-card,
        html.dark [class~="bg-[#ffffff]"] {
          background-color: #080a0e !important;
        }
        html.dark [class~="bg-[#fafbfc]"],
        html.dark [class~="bg-[#fbfcfe]"],
        html.dark [class~="bg-[#f6f8fb]"],
        html.dark [class~="bg-[#f3f5f9]"],
        html.dark [class~="bg-[#f2f5fb]"],
        html.dark [class~="bg-[#f3f5fa]"],
        html.dark .bg-muted,
        html.dark .bg-slate-50,
        html.dark .bg-slate-100 {
          background-color: #101419 !important;
        }
        html.dark [class~="bg-[#eef2fc]"],
        html.dark [class~="bg-[#eef2ff]"] {
          background-color: #161e2a !important;
        }
        html.dark [class~="text-[#111827]"],
        html.dark [class~="text-[#334155]"],
        html.dark [class~="text-[#16224b]"],
        html.dark .text-foreground {
          color: #f7f9f9 !important;
        }
        html.dark [class~="text-[#64748b]"],
        html.dark [class~="text-[#94a3b8]"],
        html.dark [class~="text-[#52637a]"],
        html.dark .text-muted-foreground {
          color: #a3afbd !important;
        }
        html.dark [class~="text-[#1a3a7b]"] {
          color: #75b1ff !important;
        }
        html.dark [class~="border-[#cfd8e6]"],
        html.dark [class~="border-[#dce3ee]"],
        html.dark [class~="border-[#e5eaf2]"],
        html.dark [class~="border-[#eef2f7]"],
        html.dark [class~="border-[#edf0f5]"],
        html.dark [class~="border-[#c7d2fe]"],
        html.dark .border-slate-200,
        html.dark .border-slate-300 {
          border-color: #30353b !important;
        }
        html.dark input,
        html.dark select,
        html.dark textarea {
          background-color: #101419 !important;
          color: #f7f9f9 !important;
          border-color: #3b4250 !important;
          color-scheme: dark;
        }
        html.dark input:focus,
        html.dark select:focus,
        html.dark textarea:focus {
          border-color: #60a5fa !important;
          box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.17) !important;
        }
        html.dark input::placeholder,
        html.dark textarea::placeholder {
          color: #8996a5 !important;
        }
        html.dark select option {
          background-color: #101419 !important;
          color: #f7f9f9 !important;
        }
        html.dark table {
          background: #080a0e !important;
          color: #f7f9f9;
        }
        html.dark table thead tr {
          background: #101419 !important;
        }
        html.dark table thead th,
        html.dark table tbody td {
          border-color: #30353b !important;
        }
        html.dark table thead th {
          color: #bac5d1 !important;
        }
        html.dark table tbody tr {
          background-color: #080a0e !important;
        }
        html.dark table tbody tr:nth-child(even) {
          background-color: #0b0e13 !important;
        }
        html.dark table tbody tr:hover {
          background-color: #15253c !important;
        }
        html.dark button.bg-primary {
          background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%) !important;
          border-color: #2563eb !important;
          color: #ffffff !important;
        }
        
        /* QRPASS_BLUE_BUTTON_WHITE_HOVER_V161: retain white text when hovering blue/primary buttons. */
        #root button.bg-primary:hover:not(:disabled),
        #root button[class*="bg-blue-"]:hover:not(:disabled),
        #root button[class*="from-blue-"]:hover:not(:disabled),
        #root button[class*="bg-gradient-to-"]:hover:not(:disabled),
        #root button[class*="bg-gradient-linear-"]:hover:not(:disabled),
        #root button[class*="bg-[#1a3a7b]"]:hover:not(:disabled),
        #root button[class*="bg-[#2f5fd6]"]:hover:not(:disabled),
        #root button[class*="bg-[#1e448b]"]:hover:not(:disabled),
        #root button[class*="text-white"][class*="bg-"]:hover:not(:disabled) {
          color: #ffffff !important;
          -webkit-text-fill-color: #ffffff !important;
        }
        #root button.bg-primary:hover:not(:disabled) :is(span, strong, b),
        #root button[class*="bg-blue-"]:hover:not(:disabled) :is(span, strong, b),
        #root button[class*="from-blue-"]:hover:not(:disabled) :is(span, strong, b),
        #root button[class*="text-white"][class*="bg-"]:hover:not(:disabled) :is(span, strong, b) {
          color: #ffffff !important;
          -webkit-text-fill-color: #ffffff !important;
        }
        html.dark button.bg-primary:hover {
          background: linear-gradient(180deg, #3b82f6 0%, #2563eb 100%) !important;
        }
        html.dark button.bg-background:not([class*="red-"]):not([class*="green-"]),
        html.dark button.bg-white:not([class*="red-"]):not([class*="green-"]) {
          background: #101419 !important;
          border-color: #3b4250 !important;
          color: #e7edf5 !important;
        }
        html.dark button.bg-background:hover,
        html.dark button.bg-white:hover {
          background: #182235 !important;
        }
        html.dark [class~="hover:bg-[#eef2fc]"]:hover,
        html.dark [class~="hover:bg-[#f6f8fb]"]:hover,
        html.dark [class~="hover:bg-[#fbfcfe]"]:hover,
        html.dark [class~="hover:bg-[#f3f5fa]"]:hover {
          background-color: #15253c !important;
        }
        html.dark ::-webkit-scrollbar-track {background: #000000;}
        html.dark ::-webkit-scrollbar-thumb {
          background: #30353b;
          border-color: #000000;
        }
        html.dark ::-webkit-scrollbar-thumb:hover {background: #4b5563;}
`}</style>

      {/* =====================================================
          HEADER
      ====================================================== */}

      <header className="bg-white text-foreground h-12 flex items-center px-2 sm:px-3 gap-1.5 sm:gap-2 z-50 shadow-sm border-b border-[#cfd8e6] flex-shrink-0 sticky top-0">
        <button
          onClick={() =>
            setSidebarOpen(
              !sidebarOpen
            )
          }
          className="text-[#1a3a7b] hover:text-[#2f5fd6] hover:bg-[#eef2fc] rounded-md transition-colors p-1"
          >
          {sidebarOpen ? (
            <X size={18} />
          ) : (
            <Menu size={18} />
          )}
        </button>

        <div className="flex items-center gap-2 min-w-0">
          <img src="/qrpass-header-shield.png" alt="QRPass shield" className="h-9 w-9 shrink-0 object-contain" />
          
        </div>

        <div className="flex-1" />

        {/* ===================================================
            HEADER RIGHT SIDE
        ==================================================== */}

        <div className="flex items-center gap-1 sm:gap-2">

          {/* =================================================
              DARK MODE TOGGLE
          ================================================== */}

          <button
            type="button"
            onClick={() =>
              setDarkMode(
                (current) => !current
              )
            }
            title={
              darkMode
                ? "Switch to Light Mode"
                : "Switch to Dark Mode"
            }
            aria-label={
              darkMode
                ? "Switch to Light Mode"
                : "Switch to Dark Mode"
            }
            className={`rounded-lg p-1.5 transition-all ${
              darkMode
                ? "bg-[#1d2a43] text-yellow-300 ring-1 ring-[#31445f] hover:bg-[#263753]"
                : "text-[#1a3a7b] hover:text-[#2f5fd6] hover:bg-[#eef2fc]"
            }`}
          >
            {darkMode ? (
              <Sun size={18} />
            ) : (
              <Moon size={18} />
            )}
          </button>

          {/* =================================================
              NOTIFICATION BELL
          ================================================== */}

          <div className="relative">
            <button
              type="button"
              onClick={
                handleNotificationToggle
              }
              title="Notifications"
              className="relative text-[#1a3a7b] hover:text-[#2f5fd6] hover:bg-[#eef2fc] rounded-lg transition-all p-1.5"
          >
              <Bell size={18} />

              {unreadNotificationCount >
                0 && (
                <span className="absolute -top-1 -right-1 min-w-[17px] h-[17px] px-1 bg-red-500 text-white text-[9px] font-bold rounded-full flex items-center justify-center">
                  {unreadNotificationCount >
                  99
                    ? "99+"
                    : unreadNotificationCount}
                </span>
              )}
            </button>

            {/* NOTIFICATION DROPDOWN */}

            {notificationOpen && (
              <div
                className="fixed left-3 right-3 top-14 z-[100] w-auto max-w-none overflow-hidden rounded-xl border border-[#dce3ee] bg-white text-slate-900 sm:absolute sm:left-auto sm:right-0 sm:top-10 sm:w-[430px] sm:max-w-[94vw] dark:border-[#29415f] dark:bg-[#0f1d35] dark:text-slate-100"
                style={{
                  boxShadow:
                    "0 16px 40px rgba(16, 26, 51, 0.22)",
                }}
              >
                {/* HEADER */}
                <div className="border-b border-[#e5eaf2] bg-[#fbfcfe] px-4 py-3 dark:border-[#29415f] dark:bg-[#13243c]">
                  <div className="flex items-start justify-between gap-3">
                    <div>
                      <p className="text-sm font-semibold text-[#111827] dark:text-slate-100">
                        Notifications
                      </p>

                      <p className="mt-0.5 text-[11px] text-[#64748b] dark:text-slate-400">
                        {unreadNotificationCount} unread{" "}
                        {unreadNotificationCount === 1
                          ? "notification"
                          : "notifications"}
                      </p>
                    </div>

                    {unreadNotificationCount > 0 && (
                      <button
                        type="button"
                        onClick={handleHeaderMarkAllRead}
                        disabled={
                          markingAllNotifications
                        }
                        className="whitespace-nowrap rounded-md px-2 py-1 text-[11px] font-semibold text-[#1a3a7b] transition-colors hover:bg-[#eef2fc] disabled:opacity-50 dark:text-blue-300 dark:hover:bg-blue-500/10"
          >
                        {markingAllNotifications
                          ? "Saving..."
                          : "Mark all as read"}
                      </button>
                    )}
                  </div>

                  {/* COUNTS / FILTERS */}
                  <div className="mt-3 grid grid-cols-3 gap-2">

                    {/* ALL */}
                    <button
                      type="button"
                      onClick={() =>
                        setNotificationFilter(
                          "all"
                        )
                      }
                      className={`rounded-lg border px-3 py-2 text-left transition-all ${
                        notificationFilter ===
                        "all"
                          ? "border-[#2f5fd6] bg-[#eef2fc] shadow-sm dark:border-blue-400/40 dark:bg-blue-500/15"
                          : "border-[#dce3ee] bg-white hover:border-[#c7d2e5] hover:bg-[#f6f8fb] dark:border-[#29415f] dark:bg-[#101f36] dark:hover:border-[#355575] dark:hover:bg-[#172a45]"
                      }`}
                    >
                      <p className="text-[10px] font-semibold uppercase tracking-wide text-[#64748b] dark:text-slate-400">
                        All
                      </p>

                      <p
                        className={`mt-0.5 text-sm font-bold ${
                          notificationFilter ===
                          "all"
                            ? "text-[#1a3a7b] dark:text-blue-300"
                            : "text-[#111827] dark:text-slate-100"
                        }`}
                      >
                        {
                          headerNotifications.length
                        }
                      </p>
                    </button>


                    {/* UNREAD */}
                    <button
                      type="button"
                      onClick={() =>
                        setNotificationFilter(
                          "unread"
                        )
                      }
                      className={`rounded-lg border px-3 py-2 text-left transition-all ${
                        notificationFilter ===
                        "unread"
                          ? "border-[#2f5fd6] bg-[#eef2fc] shadow-sm dark:border-blue-400/40 dark:bg-blue-500/15"
                          : "border-[#dce3ee] bg-white hover:border-[#c7d2e5] hover:bg-[#f6f8fb] dark:border-[#29415f] dark:bg-[#101f36] dark:hover:border-[#355575] dark:hover:bg-[#172a45]"
                      }`}
                    >
                      <p className="text-[10px] font-semibold uppercase tracking-wide text-[#64748b] dark:text-slate-400">
                        Unread
                      </p>

                      <p
                        className={`mt-0.5 text-sm font-bold ${
                          notificationFilter ===
                          "unread"
                            ? "text-[#1a3a7b] dark:text-blue-300"
                            : "text-[#111827] dark:text-slate-100"
                        }`}
                      >
                        {
                          unreadNotificationCount
                        }
                      </p>
                    </button>


                    {/* READ */}
                    <button
                      type="button"
                      onClick={() =>
                        setNotificationFilter(
                          "read"
                        )
                      }
                      className={`rounded-lg border px-3 py-2 text-left transition-all ${
                        notificationFilter ===
                        "read"
                          ? "border-[#2f5fd6] bg-[#eef2fc] shadow-sm dark:border-blue-400/40 dark:bg-blue-500/15"
                          : "border-[#dce3ee] bg-white hover:border-[#c7d2e5] hover:bg-[#f6f8fb] dark:border-[#29415f] dark:bg-[#101f36] dark:hover:border-[#355575] dark:hover:bg-[#172a45]"
                      }`}
                    >
                      <p className="text-[10px] font-semibold uppercase tracking-wide text-[#64748b] dark:text-slate-400">
                        Read
                      </p>

                      <p
                        className={`mt-0.5 text-sm font-bold ${
                          notificationFilter ===
                          "read"
                            ? "text-[#1a3a7b] dark:text-blue-300"
                            : "text-[#111827] dark:text-slate-100"
                        }`}
                      >
                        {
                          readNotificationCount
                        }
                      </p>
                    </button>
                  </div>
                </div>


                {/* NOTIFICATION LIST */}
                <div className="max-h-[52vh] space-y-2 overflow-y-auto bg-[#f8fafc] p-2 sm:max-h-[470px] dark:bg-[#0b172a]">

                  {notificationsLoading &&
                  headerNotifications.length ===
                    0 ? (
                    <div className="py-10 text-center text-xs text-slate-500 dark:text-slate-400">
                      Loading notifications...
                    </div>
                  ) : headerNotifications.length ===
                    0 ? (
                    <div className="px-4 py-10 text-center">
                      <Bell
                        size={26}
                        className="mx-auto mb-2 text-slate-400"
                      />

                      <p className="text-sm font-semibold text-slate-800 dark:text-slate-100">
                        No notifications
                      </p>

                      <p className="mt-1 text-xs text-slate-500 dark:text-slate-400">
                        You are all caught up.
                      </p>
                    </div>
                  ) : filteredHeaderNotifications.length ===
                    0 ? (
                    <div className="px-4 py-10 text-center">
                      <FileText
                        size={26}
                        className="mx-auto mb-2 text-slate-400"
                      />

                      <p className="text-sm font-semibold text-slate-800 dark:text-slate-100">
                        No{" "}
                        {notificationFilter ===
                        "unread"
                          ? "unread"
                          : "read"}{" "}
                        notifications
                      </p>

                      <p className="mt-1 text-xs text-slate-500 dark:text-slate-400">
                        Try another notification
                        filter.
                      </p>
                    </div>
                  ) : (
                    filteredHeaderNotifications.map(
                      (notification) => {
                        const style =
                          getNotificationStyle(
                            notification.type
                          );

                        return (
                          <div
                            key={notification.id}
                            role="button"
                            tabIndex={0}
                            title="Open related page"
                            onClick={() =>
                              handleHeaderNotificationOpen(
                                notification
                              )
                            }
                            onKeyDown={(
                              event
                            ) => {
                              if (
                                event.key ===
                                  "Enter" ||
                                event.key === " "
                              ) {
                                event.preventDefault();

                                handleHeaderNotificationOpen(
                                  notification
                                );
                              }
                            }}
                            className={`cursor-pointer rounded-xl border p-3 transition-all hover:-translate-y-[1px] hover:shadow-md focus:outline-none focus:ring-2 focus:ring-[#2f5fd6]/25 ${
                              notification.is_read
                                ? "border-[#e5eaf2] bg-white hover:bg-[#fbfcfe] dark:border-[#29415f] dark:bg-[#13243c] dark:hover:bg-[#172a45]"
                                : `${style.card} shadow-sm`
                            }`}
                          >
                            <div className="flex gap-3">

                              {/* ICON */}
                              <div
                                className={`flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg ${
                                  notification.is_read
                                    ? "bg-[#f3f5f9] text-[#94a3b8] dark:bg-slate-400/10 dark:text-slate-400"
                                    : style.icon
                                }`}
                              >
                                {getNotificationIcon(
                                  notification.type
                                )}
                              </div>


                              <div className="min-w-0 flex-1">

                                {/* TITLE + NEW BADGE */}
                                <div className="flex items-start gap-2">
                                  <p className="flex-1 text-xs font-semibold leading-5 text-slate-900 dark:text-slate-100">
                                    {notification.title ??
                                      "QRPass Notification"}
                                  </p>

                                  {!notification.is_read && (
                                    <span className="flex-shrink-0 rounded-full bg-[#2f5fd6] px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide text-white dark:bg-blue-500">
                                      New
                                    </span>
                                  )}
                                </div>


                                {/* MESSAGE */}
                                <p className="mt-1 break-words text-xs leading-relaxed text-slate-600 dark:text-slate-300">
                                  {notification.message ??
                                    "You have a new QRPass notification."}
                                </p>


                                {/* TYPE */}
                                <div className="mt-2">
                                  <span
                                    className={`inline-flex items-center rounded-full px-2 py-0.5 text-[9px] font-semibold ${
                                      notification.is_read
                                        ? "bg-gray-100 text-gray-600 dark:bg-slate-400/10 dark:text-slate-300"
                                        : style.badge
                                    }`}
                                  >
                                    {getNotificationTypeLabel(
                                      notification.type
                                    )}
                                  </span>
                                </div>


                                {/* DATE + ACTION */}
                                <div className="mt-2 flex items-end justify-between gap-2">
                                  <div>
                                    <p className="text-[10px] text-slate-500 dark:text-slate-400">
                                      {formatNotificationDate(
                                        notification.created_at
                                      )}
                                    </p>

                                    <p className="mt-0.5 text-[9px] text-slate-500 dark:text-slate-400">
                                      {notification.is_read
                                        ? "Read"
                                        : "Unread"}

                                      <span className="mx-1">
                                        •
                                      </span>

                                      <span className="font-semibold text-[#1a3a7b] dark:text-blue-300">
                                        Click to open
                                      </span>
                                    </p>
                                  </div>

                                  {!notification.is_read && (
                                    <button
                                      type="button"
                                      onClick={(
                                        event
                                      ) => {
                                        event.stopPropagation();

                                        handleHeaderMarkRead(
                                          notification.id
                                        );
                                      }}
                                      disabled={
                                        markingNotificationId ===
                                        notification.id
                                      }
                                      className="whitespace-nowrap text-[10px] font-semibold text-[#1a3a7b] hover:underline disabled:opacity-50 dark:text-blue-300"
                                    >
                                      {markingNotificationId ===
                                      notification.id
                                        ? "Saving..."
                                        : "Mark as read"}
                                    </button>
                                  )}
                                </div>
                              </div>
                            </div>
                          </div>
                        );
                      }
                    )
                  )}
                </div>


                {/* NOTIFICATION FOOTER */}
                <div className="flex items-center justify-between gap-3 border-t border-[#e5eaf2] bg-[#fbfcfe] px-4 py-2.5 dark:border-[#29415f] dark:bg-[#13243c]">
                  <span className="text-[10px] text-[#64748b] dark:text-slate-400">
                    Showing{" "}
                    <span className="font-semibold text-[#111827] dark:text-slate-100">
                      {
                        filteredHeaderNotifications.length
                      }
                    </span>{" "}
                    of{" "}
                    <span className="font-semibold text-[#111827] dark:text-slate-100">
                      {
                        headerNotifications.length
                      }
                    </span>
                  </span>

                  <button
                    type="button"
                    onClick={() =>
                      loadHeaderNotifications(
                        true
                      )
                    }
                    disabled={
                      notificationsLoading
                    }
                    className="flex items-center gap-1.5 rounded-md px-2 py-1 text-[10px] font-semibold text-[#1a3a7b] transition-colors hover:bg-[#eef2fc] disabled:opacity-50 dark:text-blue-300 dark:hover:bg-blue-500/10 inline-flex items-center justify-center gap-1.5 !border-0 !bg-transparent !shadow-none !text-[#17336d] !px-2 !py-1 hover:!bg-[#edf2ff] rounded-lg"
          >
                    <RefreshCw
                      size={11}
                      className={
                        notificationsLoading
                          ? "animate-spin"
                          : ""
                      }
                    />

                    {notificationsLoading
                      ? "Refreshing..."
                      : "Refresh"}
                  </button>
                </div>
              </div>
            )}
          </div>

          {/* =================================================
              ACCOUNT BUTTON
          ================================================== */}

          <div className="relative">
            <button
              type="button"
              onClick={
                handleAccountToggle
              }
              title="Account"
              className="flex items-center gap-1.5 px-1.5 py-1 rounded-lg hover:bg-[#eef2fc] transition-all"
          >
              <div
                  className="w-7 h-7 rounded-full overflow-hidden flex items-center justify-center flex-shrink-0"
                  style={{
                    background:
                      "linear-gradient(135deg, #1a3a7b 0%, #2f5fd6 100%)",
                    boxShadow:
                      "0 2px 8px rgba(26, 58, 123, 0.18)",
                  }}
                >
                  {currentUser?.profile_photo_url ? (
                    <img
                      src={currentUser.profile_photo_url}
                      alt="Profile"
                      className="w-full h-full object-cover"
                    />
                  ) : (
                    <User
                      size={13}
                      className="text-white"
                    />
                  )}
                </div>
              <span className="hidden sm:inline text-foreground text-xs font-medium max-w-[130px] truncate">
                {currentUser?.name ??
                  roleInfo.label}
              </span>
            </button>

            {/* ACCOUNT DROPDOWN */}

            {accountOpen && (
              <div
                  className="fixed left-3 right-3 top-14 z-[100] w-auto overflow-hidden rounded-xl border border-[#dce3ee] bg-white text-foreground sm:absolute sm:left-auto sm:right-0 sm:top-10 sm:w-72 dark:border-[#29415f] dark:bg-[#0f1d35] dark:text-slate-100"
                  style={{
                    boxShadow: "0 16px 40px rgba(16, 26, 51, 0.16)",
                  }}
                >

                {/* PROFILE */}
                <div className="px-4 py-4 border-b border-[#e5eaf2] bg-[#fbfcfe] dark:border-[#29415f] dark:bg-[#13243c]">
                  <div className="flex items-center gap-3">
                    <div
                        className="w-11 h-11 rounded-full overflow-hidden flex items-center justify-center flex-shrink-0"
                        style={{
                          background:
                            "linear-gradient(135deg, #1a3a7b 0%, #2f5fd6 100%)",
                          boxShadow:
                            "0 4px 12px rgba(26, 58, 123, 0.20)",
                        }}
                      >
                        {currentUser?.profile_photo_url ? (
                          <img
                            src={currentUser.profile_photo_url}
                            alt="Profile"
                            className="w-full h-full object-cover"
                          />
                        ) : (
                          <User
                            size={20}
                            className="text-white"
                          />
                        )}
                      </div>

                    <div className="min-w-0">
                      <p className="text-sm font-semibold text-[#111827] truncate dark:text-slate-100">
                        {currentUser?.name ??
                          roleInfo.label}
                      </p>

                      <p className="text-xs text-[#64748b] truncate mt-0.5 dark:text-slate-400">
                        {currentUser?.username ??
                          "QRPass User"}
                      </p>
                    </div>
                  </div>
                </div>

                {/* INFORMATION */}
                <div className="px-4 py-3 space-y-3 bg-white dark:bg-[#0f1d35]">
                  <div>
                    <p className="text-[10px] uppercase tracking-wide text-[#94a3b8] font-semibold dark:text-slate-400">
                      Account ID
                    </p>

                    <p className="text-xs font-medium text-[#111827] mt-0.5 dark:text-slate-100">
                      {currentUser?.username ?? "—"}
                    </p>
                  </div>

                  <div>
                    <p className="text-[10px] uppercase tracking-wide text-[#94a3b8] font-semibold dark:text-slate-400">
                      Role
                    </p>

                    <span className="inline-flex items-center mt-1 px-2 py-1 rounded-full bg-[#eef2fc] text-[#1a3a7b] text-[11px] font-semibold dark:bg-blue-500/15 dark:text-blue-300">
                      {roleInfo.label}
                    </span>
                  </div>

                  {currentUser?.email && (
                    <div>
                      <p className="text-[10px] uppercase tracking-wide text-[#94a3b8] font-semibold dark:text-slate-400">
                        Email
                      </p>

                      <p className="text-xs font-medium text-[#111827] mt-0.5 break-all dark:text-slate-100">
                        {currentUser.email}
                      </p>
                    </div>
                  )}
                </div>
                  {/* ACCOUNT SETTINGS */}
                  <div className="border-t border-[#e5eaf2] p-2 bg-white dark:border-[#29415f] dark:bg-[#0f1d35]">
                    <button
                      type="button"
                      onClick={() => {
                        setAccountOpen(false);
                        setAccountSettingsOpen(true);
                      }}
                      className="w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium text-[#334155] hover:bg-[#eef2fc] hover:text-[#1a3a7b] transition-colors dark:text-slate-200 dark:hover:bg-[#172a45] dark:hover:text-blue-300"
          >
                      <div className="flex items-center gap-2">
                        <Settings size={15} />
                        <span>Account Settings</span>
                      </div>

                      <ChevronRight
                        size={14}
                        className="text-[#94a3b8]"
                      />
                    </button>
                  </div>
                {/* LOGOUT */}
                <div className="border-t border-[#e5eaf2] p-2 bg-white dark:border-[#29415f] dark:bg-[#0f1d35]">
                  <button
                    type="button"
                    onClick={onLogout}
                    className="w-full flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium text-[#334155] hover:bg-[#eef2fc] hover:text-[#1a3a7b] transition-colors dark:text-slate-200 dark:hover:bg-[#172a45] dark:hover:text-blue-300"
          >
                    <LogOut size={15} />

                    Log Out
                  </button>
                </div>
              </div>
            )}
          </div>
        </div>
      </header>

      {/* =====================================================
          MAIN BODY
      ====================================================== */}

      <div className="flex flex-1 min-h-0 relative overflow-hidden">

        {/* MOBILE BACKDROP */}

        {isMobile &&
          sidebarOpen && (
            <div
              className="fixed inset-0 top-12 bg-black/50 z-30"
              onClick={() =>
                setSidebarOpen(
                  false
                )
              }
            />
          )}

        {/* ===================================================
            SIDEBAR
        ==================================================== */}

        <aside
          className="h-full min-h-0 flex-col flex-shrink-0 transition-all duration-200 overflow-hidden z-40"
          style={{
            position: isMobile
              ? "fixed"
              : "relative",

            top: isMobile
              ? "48px"
              : "auto",

            bottom: isMobile
              ? "0"
              : "auto",

            left: 0,

            width: sidebarOpen
              ? "210px"
              : "0px",

            background:
            "linear-gradient(180deg, #0c1a3a 0%, #0e1f42 100%)",

            borderRight:
              "1px solid rgba(255,255,255,0.08)",

            display:
              "flex",
          }}
        >
          <div className="p-3 border-b border-white/10 flex-shrink-0">
            <p className="text-xs text-[#8ea4c9] font-medium uppercase tracking-wider whitespace-nowrap">
              Navigation
            </p>
          </div>

          <nav className="flex-1 py-2 overflow-y-auto">
            {navItems.map(
              (item, i) => (role === "sysadmin" && (item.label === "Active Sessions") ? null : (
                <button
                  key={i}
                  onClick={() =>
                    handleNavClick(i)
                  }
                  className="w-full flex items-center gap-2.5 px-3 py-3 text-sm font-medium transition-all duration-150 text-left whitespace-nowrap"
                  style={{
                    color: activeNav === i ? "#ffffff" : "rgba(255,255,255,0.75)",

                    backgroundColor:
                    activeNav === i
                      ? "rgba(47,95,214,0.22)"
                      : "transparent",
                    borderLeft:
                      activeNav === i
                        ? "3px solid #2f5fd6"
                        : "3px solid transparent",
                  }}
                >
                  <span
                    style={{
                      opacity:
                        activeNav === i
                          ? 1
                          : 0.7,
                    }}
                  >
                    {item.icon}
                  </span>

                  <span className="truncate">
                    {item.label}
                  </span>

                  {item.badge && (
                    <span className="ml-auto bg-secondary text-secondary-foreground text-[10px] font-bold px-1.5 py-0.5 rounded-full flex-shrink-0">
                      {
                        item.badge
                      }
                    </span>
                  )}
                </button>
              ))
            )}
          </nav>

        </aside>

        {/* ===================================================
            MAIN CONTENT
        ==================================================== */}

        {/* QRPASS_STUDENT_WHITE_CONTROLS_V130 â€” Student only, style-only */}
        <style>{`
          .qrpass-dashboard-root[data-qrpass-role="student"] .qrpass-main :is(
            input[type="search"], input[aria-label^="Search" i], input[placeholder^="Search" i],
            select[aria-label*="sort" i], select[aria-label*="filter" i],
            select[aria-label*="status" i], select[data-qrpass-filter],
            select[class*="bg-[#eef2ff]"], select[class*="bg-[#edf2ff]"],
            input[class*="bg-[#eef2ff]"][type="search"]
          ) {
            background-color: #ffffff !important;
            border-color: #c7d2fe !important;
            color: #17336d !important;
            transition: background-color .16s ease, border-color .16s ease !important;
          }
          .qrpass-dashboard-root[data-qrpass-role="student"] .qrpass-main :is(
            input[type="search"], input[aria-label^="Search" i], input[placeholder^="Search" i],
            select[aria-label*="sort" i], select[aria-label*="filter" i],
            select[aria-label*="status" i], select[data-qrpass-filter],
            select[class*="bg-[#eef2ff]"], select[class*="bg-[#edf2ff]"]
          ):hover:not(:focus):not(:disabled) {
            background-color: #eef2ff !important;
            border-color: #a8bde4 !important;
          }
          .qrpass-dashboard-root[data-qrpass-role="student"] .qrpass-main :is(
            input[type="search"], input[aria-label^="Search" i], input[placeholder^="Search" i],
            select[aria-label*="sort" i], select[aria-label*="filter" i],
            select[aria-label*="status" i], select[data-qrpass-filter]
          ):focus {
            background-color: #ffffff !important;
            border-color: #5278e7 !important;
            box-shadow: 0 0 0 3px rgba(82,120,231,.14) !important;
          }
          .qrpass-dashboard-root[data-qrpass-role="student"] .qrpass-main button:is(
            [class*="bg-[#eef2ff]"], [class*="bg-[#edf2ff]"], [class*="bg-blue-50"]
          ):not([aria-pressed="true"]):not([aria-selected="true"]):not([data-state="active"])
           :not([class*="bg-primary"]):not([class*="bg-red"]):not([class*="bg-green"])
           :not([class*="bg-yellow"]):not([class*="bg-amber"])
           :not([class*="bg-[#17336d]"]):not([type="submit"]) {
            background-color: #ffffff !important;
            border-color: #c7d2fe !important;
            transition: background-color .16s ease, border-color .16s ease !important;
          }
          .qrpass-dashboard-root[data-qrpass-role="student"] .qrpass-main button:is(
            [class*="bg-[#eef2ff]"], [class*="bg-[#edf2ff]"], [class*="bg-blue-50"]
          ):not([aria-pressed="true"]):not([aria-selected="true"]):not([data-state="active"])
           :not([class*="bg-primary"]):not([class*="bg-red"]):not([class*="bg-green"])
           :not([class*="bg-yellow"]):not([class*="bg-amber"])
           :not([class*="bg-[#17336d]"]):not([type="submit"]):hover:not(:disabled) {
            background-color: #eef2ff !important;
            border-color: #a8bde4 !important;
          }
        `}</style>
        <main
          data-qrpass-csu={role === "security"}
          data-qrpass-hide-page-subtitles={role !== "sysadmin"}
          className="qrpass-main flex-1 min-h-0 min-w-0 overflow-y-auto overflow-x-hidden p-3 md:p-5"
          style={{ overflowAnchor: "none" }}
          onClick={() => {
            setNotificationOpen(false);
            setAccountOpen(false);
          }}
        >
          {/* BREADCRUMB */}
          <div className="flex items-center gap-1.5 text-xs mb-3 flex-wrap">
            <QrCode
              size={11}
              className="text-[#2f5fd6] flex-shrink-0"
            />

            <span className="text-[#1a3a7b] font-semibold">
              QRpass
            </span>

            <ChevronRight
              size={11}
              className="text-[#b8c4d6]"
            />

            <span className="hidden sm:inline text-[#64748b]">
              {roleInfo.label}
            </span>

            <ChevronRight
              size={11}
              className="hidden sm:inline text-[#b8c4d6]"
            />

            <span className="text-[#111827] font-semibold truncate">
              {navItems[activeNav]?.label ?? ""}
            </span>
          </div>

                    <div className={role === "sysadmin" ? `qrpass-admin-page mx-auto w-full max-w-[1480px] ${[0, 1, 3].includes(activeNav) ? "" : "qrpass-sysadmin-hide-search-v24"}` : "w-full"}>
            {role === "sysadmin" && [3].includes(activeNav) && (
  <button type="button" className="qrpass-manage-logs-shortcut-v3 qrpass-page-manage-v1"
    onClick={() => { setQrpassPageManageType(activeNav===0?'items':activeNav===1?'lost-found':activeNav===3?'users':'choose'); }}>
    <Settings size={15} /> {({0:'Manage Items',1:'Manage Reports',2:'Manage Reports',3:'Manage Users'} as Record<number,string>)[activeNav]}
  </button>
)}
            <QRPassSysadminManageContext.Provider value={role === "sysadmin" ? () => setQrpassPageManageType(activeNav === 0 ? "items" : activeNav === 1 ? "lost-found"  : "choose") : null}>
            <QRPassCSUManageContextV147.Provider value={role === "security" && activeNav < 5 ? () => setCsuManagerOpenV147(true) : null}>
              <QRPassPageSubtitleContext.Provider value={role === "sysadmin"}>
                <ActivePage onNavigate={handleNavClick} />
              </QRPassPageSubtitleContext.Provider>
            </QRPassCSUManageContextV147.Provider>
            {role === "security" && csuManagerOpenV147 && activeNav < 5 && (
              <QRPassCSUPageManagerV147 key={activeNav} page={activeNav} onClose={() => setCsuManagerOpenV147(false)} />
            )}
            </QRPassSysadminManageContext.Provider>
            {qrpassPageManageType && qrpassPageManageType !== 'choose' && <QrpassPageManager key={qrpassPageManageType} module={qrpassPageManageType} onClose={() => setQrpassPageManageType(null)} />}
          </div>
        </main>
      </div>
{/* =====================================================
    ACCOUNT SETTINGS MODAL
====================================================== */}

{accountSettingsOpen && (
  <div
    className="fixed inset-0 z-[200] flex items-center justify-center p-2 sm:p-4"
    style={{
      background: "rgba(15, 23, 42, 0.45)",
      backdropFilter: "blur(3px)",
    }}
  >
    <div
      className="w-full max-w-2xl bg-white border border-[#dce3ee] rounded-2xl overflow-hidden flex flex-col max-h-[calc(100dvh-1rem)] sm:max-h-[calc(100dvh-2rem)]"
      style={{
        boxShadow: "0 24px 70px rgba(16, 26, 51, 0.22)",
      }}
    >
      {/* MODAL HEADER */}
      <div className="shrink-0 px-4 py-3 sm:px-5 sm:py-4 border-b border-[#e5eaf2] bg-[#fbfcfe] flex items-center justify-between">
        <div>
          <div className="flex items-center gap-2">
            <Settings
              size={18}
              className="text-[#1a3a7b]"
            />

            <h2 className="text-base font-semibold text-[#111827]">
              Account Settings
            </h2>
          </div>

         
        </div>

        <button
          type="button"
          onClick={() =>
            setAccountSettingsOpen(false)
          }
          className="w-8 h-8 rounded-lg flex items-center justify-center text-[#64748b] hover:text-[#111827] hover:bg-[#eef2fc] transition-colors"
          title="Close"
           data-qrpass-neutral-v169="true">
          <X size={17} />
        </button>
      </div>

      {/* PROFILE AREA */}
      <div className="min-h-0 flex-1 overflow-y-auto overscroll-contain p-3 sm:p-5">
        <div className="flex flex-col sm:flex-row items-center sm:items-start gap-3 sm:gap-5 pb-3 sm:pb-5 border-b border-[#e5eaf2]">
          {/* PROFILE PHOTO */}
          <div className="flex flex-col items-center gap-2">
            <div
                className="w-20 h-20 sm:w-24 sm:h-24 rounded-full overflow-hidden flex items-center justify-center"
                style={{
                  background:
                    "linear-gradient(135deg, #1a3a7b 0%, #2f5fd6 100%)",
                  boxShadow:
                    "0 8px 20px rgba(26, 58, 123, 0.20)",
                }}
              >
                {currentUser?.profile_photo_url ? (
                  <img
                    src={currentUser.profile_photo_url}
                    alt="Profile"
                    className="w-full h-full object-cover"
                  />
                ) : (
                  <User
                    size={38}
                    className="text-white"
                  />
                )}
              </div>

           <div className="flex flex-col items-center gap-1.5">
  <label
    className={`text-[11px] font-semibold text-[#1a3a7b] hover:text-[#2f5fd6] cursor-pointer ${
      uploadingProfilePhoto
        ? "opacity-50 pointer-events-none"
        : ""
    }`}
  >
    {uploadingProfilePhoto
      ? "Uploading..."
      : "Change Photo"}

    <input
      type="file"
      accept="image/jpeg,image/png,image/webp"
      onChange={handleProfilePhotoUpload}
      className="hidden"
    />
  </label>

  {currentUser?.profile_photo_url && (
    <button
      type="button"
      onClick={handleRemoveProfilePhoto}
      disabled={uploadingProfilePhoto}
      className="text-[10px] font-semibold text-red-500 hover:text-red-600 disabled:opacity-50"
    >
      Remove Photo
    </button>
  )}
</div>
          </div>

          {/* ACCOUNT SUMMARY */}
          <div className="flex-1 min-w-0 text-center sm:text-left">
            <h3 className="text-base sm:text-lg font-bold text-[#111827]">
              {currentUser?.name ??
                roleInfo.label}
            </h3>

            <p className="text-xs text-[#64748b] mt-0.5">
              @{currentUser?.username ??
                "qrpass-user"}
            </p>

            <div className="flex flex-wrap justify-center sm:justify-start gap-2 mt-3">
              <span className="inline-flex items-center px-2.5 py-1 rounded-full bg-[#eef2fc] text-[#1a3a7b] text-[11px] font-semibold">
                {roleInfo.label}
              </span>

              <span className="inline-flex items-center px-2.5 py-1 rounded-full bg-[#ecfdf3] text-[#15803d] text-[11px] font-semibold">
                Active Account
              </span>
            </div>
          </div>
        </div>

        {/* ACCOUNT INFORMATION */}
        {/* QRPASS_PROFILE_FAST_HOVER_V165 */}
        {/* QRPASS_PROFILE_WHITE_HOVER_V160 */}
        <div className="mt-3 sm:mt-5">
          <div className="flex items-center gap-2 mb-4">
            <User
              size={16}
              className="text-[#1a3a7b]"
            />

            <h3 className="text-sm font-semibold text-[#111827]">
              Profile Information
            </h3>
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
            <div>
              <label className="block text-[11px] font-semibold text-[#64748b] mb-1.5">
                Full Name
              </label>

              <input
                type="text"
                value={profileName}
                onChange={(e) => {
                  setProfileName(e.target.value);
                  setProfileMessage("");
                }}
                placeholder="Enter your full name"
                className="w-full px-3 py-2.5 text-sm border border-[#cfd8e6] rounded-lg text-[#111827] focus:outline-none focus:border-[#2f5fd6] focus:ring-2 focus:ring-[#2f5fd6]/15 !bg-white hover:!bg-[#eef2ff] !transition-none"
              />
            </div>

            <div>
              <label className="block text-[11px] font-semibold text-[#64748b] mb-1.5">
                Account ID
              </label>

              <input
                type="text"
                value={currentUser?.username ?? ""}
                readOnly
                className="w-full px-3 py-2.5 text-sm border border-[#cfd8e6] rounded-lg text-[#64748b] !bg-white hover:!bg-[#eef2ff] !transition-none"
              />
            </div>

            <div className="sm:col-span-2">
              <label className="block text-[11px] font-semibold text-[#64748b] mb-1.5">
                Email Address
              </label>

              <input
                type="email"
                value={profileEmail}
                onChange={(e) =>
                  setProfileEmail(e.target.value)
                }
                placeholder="Enter your email address"
                className="w-full px-3 py-2.5 text-sm border border-[#cfd8e6] rounded-lg text-[#111827] focus:outline-none focus:border-[#2f5fd6] focus:ring-2 focus:ring-[#2f5fd6]/15 !bg-white hover:!bg-[#eef2ff] !transition-none"
              />
            </div>
          </div>
        </div>

        {/* SECURITY */}
        <div className="mt-3 pt-3 sm:mt-5 sm:pt-5 border-t border-[#e5eaf2]">
          <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div className="flex items-start gap-3">
              <div className="w-9 h-9 rounded-lg bg-[#eef2fc] text-[#1a3a7b] flex items-center justify-center">
                <Lock size={16} />
              </div>

              <div>
                <p className="text-sm font-semibold text-[#111827]">
                  Password & Security
                </p>

                <p className="text-xs text-[#64748b] mt-0.5">
                  Change your account password.
                </p>
              </div>
            </div>

            <button data-qrpass-blue-v173="account-trigger"
            type="button"
            onClick={() => setChangePasswordOpen(true)}
            className="w-full sm:w-auto min-h-10 border border-[#cfd8e6] bg-white text-[#1a3a7b] text-xs font-semibold px-3 py-2 rounded-lg hover:bg-[#eef2fc] transition-colors"
          >
            Change Password
          </button>
          </div>
        </div>
      </div>

     {/* MODAL FOOTER */}
<div className="shrink-0 px-3 py-3 sm:px-5 border-t border-[#e5eaf2] bg-[#fbfcfe]">
  {profileMessage && (
    <div className="mb-3 px-3 py-2 rounded-lg bg-[#eef2fc] border border-[#d7e0f3] text-xs font-medium text-[#1a3a7b]">
      {profileMessage}
    </div>
  )}

  <div className="flex items-center justify-end gap-2">
    <button
      type="button"
      onClick={() =>
        setAccountSettingsOpen(false)
      }
      className="px-4 py-2 text-xs font-semibold border border-[#cfd8e6] rounded-lg bg-white text-[#334155] hover:bg-[#eef2fc] transition-colors"
           data-qrpass-neutral-v169="true">
      Close
    </button>

    <button
      type="button"
      onClick={handleSaveAccountProfile}
      disabled={
        savingProfile ||
        !profileName.trim()
      }
      className="bg-primary text-white px-4 py-2 rounded-lg text-xs font-semibold disabled:opacity-50 disabled:cursor-not-allowed transition-colors hover:!bg-[#eef2ff] hover:!text-[#17336d] hover:!border-[#a8bde4] focus-visible:!ring-0 focus-visible:!shadow-none"
          >
      {savingProfile
        ? "Saving..."
        : "Save Changes"}
    </button>
  </div>
</div>
    </div>
  </div>
)}

{/* =====================================================
    CHANGE PASSWORD MODAL
====================================================== */}

{changePasswordOpen && (
  <div
    className="fixed inset-0 z-[300] flex items-center justify-center overflow-y-auto p-3 sm:p-4"
    data-qrpass-password-modal-fast-v167="true"
    style={{
      background: "rgba(15, 23, 42, 0.55)",
    }}
    onMouseDown={(e) => {
      if (e.target === e.currentTarget) {
        setChangePasswordOpen(false);
        setCurrentPassword("");
        setNewPassword("");
        setConfirmPassword("");
        setPasswordMessage("");
      }
    }}
  >
    <div
      className="my-auto w-full max-w-md overflow-hidden rounded-2xl border border-[#dce3ee] bg-white"
      style={{
        boxShadow:
          "0 24px 70px rgba(16, 26, 51, 0.25)",
      }}
    >
      {/* QRPASS_SHARED_CHANGE_PASSWORD_V170 — shared across logged-in accounts; login recovery untouched */}
      {/* CHANGE PASSWORD HEADER */}
      <div className="flex items-center justify-between border-b border-[#e5eaf2] bg-[#fbfcfe] px-5 py-4">
        <div>
          <div className="flex items-center gap-2">
            <Lock
              size={18}
              className="text-[#1a3a7b]"
            />

            <h2 className="text-base font-semibold text-[#111827]">
              Change Password
            </h2>
          </div>

          
        </div>

        <button
          type="button"
          onClick={() => {
            setChangePasswordOpen(false);
            setCurrentPassword("");
            setNewPassword("");
            setConfirmPassword("");
            setPasswordMessage("");
          }}
          disabled={changingPassword}
          className="flex h-8 w-8 items-center justify-center rounded-lg text-[#64748b] transition-colors hover:bg-[#eef2fc] hover:text-[#111827] disabled:cursor-not-allowed disabled:opacity-50"
          title="Close"
           data-qrpass-neutral-v169="true">
          <X size={17} />
        </button>
      </div>

      <form
        onSubmit={(e) => {
          e.preventDefault();
          handleChangePassword();
        }}
      >
        <div className="space-y-4 p-5">
          {/* QRPASS_CHANGE_PASSWORD_INPUT_HOVER_V164 */}
          {/* QRPASS_PASSWORD_WHITE_FAST_BLUE_V166: scoped, immediate CSS inside App.tsx */}
          <style>{`
            html body #root#root input[data-qrpass-password-v166="true"] { background: #ffffff !important; background-color: #ffffff !important; transition: none !important; }
            html body #root#root input[data-qrpass-password-v166="true"]:hover:not(:focus) { background: #eef2ff !important; background-color: #eef2ff !important; }
            html body #root#root input[data-qrpass-password-v166="true"]:focus { background: #ffffff !important; background-color: #ffffff !important; }
          `}</style>
          {/* CURRENT PASSWORD */}
          <div>
            <label className="mb-1.5 block text-[11px] font-semibold text-[#64748b]">
              Current Password
            </label>

            <input
              type="password"
              value={currentPassword}
              onChange={(e) => {
                setCurrentPassword(e.target.value);
                setPasswordMessage("");
              }}
              autoComplete="current-password"
              placeholder="Enter your current password"
              className="w-full rounded-lg border border-[#c7d2fe] bg-white px-3 py-2.5 text-sm text-[#111827] outline-none hover:bg-[#eef2ff] focus:border-[#6d91e8] focus:bg-white focus:ring-2 focus:ring-[#6d91e8]/15"
              data-qrpass-password-v166="true"
              style={{ backgroundColor: "#ffffff" }}
            />
          </div>

          {/* NEW PASSWORD */}
          <div>
            <label className="mb-1.5 block text-[11px] font-semibold text-[#64748b]">
              New Password
            </label>

            <input
              type="password"
              value={newPassword}
              onChange={(e) => {
                setNewPassword(e.target.value);
                setPasswordMessage("");
              }}
              autoComplete="new-password"
              placeholder="At least 8 characters"
              className="w-full rounded-lg border border-[#c7d2fe] bg-white px-3 py-2.5 text-sm text-[#111827] outline-none hover:bg-[#eef2ff] focus:border-[#6d91e8] focus:bg-white focus:ring-2 focus:ring-[#6d91e8]/15"
              data-qrpass-password-v166="true"
              style={{ backgroundColor: "#ffffff" }}
            />

            
          </div>

          {/* CONFIRM PASSWORD */}
          <div>
            <label className="mb-1.5 block text-[11px] font-semibold text-[#64748b]">
              Confirm New Password
            </label>

            <input
              type="password"
              value={confirmPassword}
              onChange={(e) => {
                setConfirmPassword(e.target.value);
                setPasswordMessage("");
              }}
              autoComplete="new-password"
              placeholder="Re-enter your new password"
              className="w-full rounded-lg border border-[#c7d2fe] bg-white px-3 py-2.5 text-sm text-[#111827] outline-none hover:bg-[#eef2ff] focus:border-[#6d91e8] focus:bg-white focus:ring-2 focus:ring-[#6d91e8]/15"
              data-qrpass-password-v166="true"
              style={{ backgroundColor: "#ffffff" }}
            />
          </div>

          {passwordMessage && (
            <div className="rounded-lg border border-[#d7e0f3] bg-[#eef2fc] px-3 py-2 text-xs font-medium text-[#1a3a7b]">
              {passwordMessage}
            </div>
          )}
        </div>

        {/* QRPASS_CHANGE_PASSWORD_MODAL_SPEED_V167 */}
        <style>{`
          [data-qrpass-password-modal-fast-v167="true"] { backdrop-filter: none !important; -webkit-backdrop-filter: none !important; }
          [data-qrpass-password-modal-fast-v167="true"] button { transition: none !important; animation: none !important; }
          [data-qrpass-password-modal-fast-v167="true"] button[type="submit"] { color: #ffffff !important; background: linear-gradient(180deg, #31579f, #1c356b) !important; box-shadow: none !important; }
          [data-qrpass-password-modal-fast-v167="true"] button[type="submit"]:hover:not(:disabled) { color: #ffffff !important; background: linear-gradient(180deg, #31579f, #1c356b) !important; box-shadow: 0 0 0 3px #dce8ff !important; }
        `}</style>
        {/* QRPASS_CHANGE_PASSWORD_BLUE_V168: disabled is still disabled; appearance matches Save Changes */}
        <style>{`
          html body #root#root#root button.qrpass-change-password-primary-v168,
          html body #root#root#root button.qrpass-change-password-primary-v168:is(:hover,:focus,:active,:disabled) {
            background: linear-gradient(180deg,#31579f 0%,#1c356b 100%) !important;
            background-color: #244681 !important;
            background-image: linear-gradient(180deg,#31579f 0%,#1c356b 100%) !important;
            color: #ffffff !important;
            opacity: 1 !important;
            filter: none !important;
            transition: none !important;
            text-shadow: none !important;
          }
          html body #root#root#root button.qrpass-change-password-primary-v168:is(:hover,:focus-visible) {
            box-shadow: 0 0 0 3px rgba(82,120,231,.24) !important;
            outline: 1px solid #aac1ef !important;
            outline-offset: 2px !important;
          }
          html body #root#root#root button.qrpass-change-password-primary-v168:disabled {
            cursor: not-allowed !important;
          }
        `}</style>
        {/* CHANGE PASSWORD FOOTER */}
        <div className="flex items-center justify-end gap-2 border-t border-[#e5eaf2] bg-[#fbfcfe] px-5 py-3">
          <button
            type="button"
            onClick={() => {
              setChangePasswordOpen(false);
              setCurrentPassword("");
              setNewPassword("");
              setConfirmPassword("");
              setPasswordMessage("");
            }}
            disabled={changingPassword}
            className="rounded-lg border border-[#cfd8e6] bg-white px-4 py-2 text-xs font-semibold text-[#334155] transition-colors disabled:cursor-not-allowed disabled:opacity-50 !bg-white !text-[#17336d] !border-[#cbd5e1] transition-colors hover:!bg-[#eef2ff] hover:!border-[#a8bde4] hover:!text-[#17336d] focus-visible:!ring-0 focus-visible:!shadow-none focus-visible:!outline-none"
           
            onMouseEnter={(e) => {
              const el=e.currentTarget;
              if(!el.dataset.qrpassV158Saved) {
                el.dataset.qrpassV158Saved=el.style.cssText || " ";
              }
              el.style.setProperty("background", "#eef2ff", "important");
              el.style.setProperty("background-color", "#eef2ff", "important");
              el.style.setProperty("background-image", "none", "important");
              el.style.setProperty("color", "#17336d", "important");
              el.style.setProperty("border-color", "#a8bde4", "important");
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onMouseLeave={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onFocus={(e) => {
              e.currentTarget.style.setProperty("box-shadow", "none", "important");
              e.currentTarget.style.setProperty("outline", "none", "important");
            }}
            onBlur={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}

           data-qrpass-neutral-v169="true">
            Cancel
          </button>

          <button data-qrpass-blue-v173="account-submit"
            type="submit"
            disabled={changingPassword}
            className="rounded-lg bg-primary px-4 py-2 text-xs font-semibold text-white disabled:cursor-not-allowed disabled:opacity-100 transition-colors hover:!bg-[#eef2ff] hover:!text-[#17336d] hover:!border-[#a8bde4] focus-visible:!ring-0 focus-visible:!shadow-none qrpass-change-password-primary-v168"
          >
            {changingPassword
              ? "Changing..."
              : "Change Password"}
          </button>
        </div>
      </form>
    </div>
  </div>
)}

  
    </div>
  );
}


// ── App root ──────────────────────────────────────────────────────────────────
// QRPASS_DIGITS_ONLY_ID_V178: input sanitization and guards are scoped to ID NUMBER fields.
export default function App() {

  // QRPASS_ROLE_ONLY_SIZE_V176: Role dropdown (shows Student) size only, in Add/Edit User.
  React.useEffect(() => {
    const id = 'qrpass-role-only-size-v176';
    if (document.getElementById(id)) return;
    const style = document.createElement('style');
    style.id = id;
    style.textContent = `
      html body #root .qrpass-admin-page.qrpass-admin-page.qrpass-admin-page.qrpass-admin-page.qrpass-admin-page.qrpass-admin-page.qrpass-admin-page.qrpass-admin-page.qrpass-admin-page.qrpass-admin-page [data-qrpass-account-role-v54="add"] > select,
      html body #root .qrpass-admin-page.qrpass-admin-page.qrpass-admin-page.qrpass-admin-page.qrpass-admin-page.qrpass-admin-page.qrpass-admin-page.qrpass-admin-page.qrpass-admin-page.qrpass-admin-page [data-qrpass-account-role-v54="edit"] > select {
        height: 54px !important;
        min-height: 54px !important;
        max-height: 54px !important;
        box-sizing: border-box !important;
      }
    `;
    document.head.appendChild(style);
    return () => style.remove();
  }, []);


  // QRPASS_AUTH_ACCOUNT_BLUE_V173: one-time CSS-only styling, no observers or mouse-event handlers.
  React.useEffect(() => {
    const id='qrpass-auth-account-blue-v173';
    if(document.getElementById(id))return;
    const style=document.createElement('style');
    style.id=id;
    style.textContent=`
      html body #root button[data-qrpass-blue-v173],
      html body #root button[data-qrpass-blue-v173]:is(:hover,:focus,:active,:disabled) {
        background: linear-gradient(180deg,#31579f 0%,#1c356b 100%) !important;
        background-image: linear-gradient(180deg,#31579f 0%,#1c356b 100%) !important;
        background-color: #25477f !important;
        color: #ffffff !important;
        -webkit-text-fill-color: #ffffff !important;
        opacity: 1 !important;
        transform: none !important;
        filter: none !important;
        transition: none !important;
        animation: none !important;
      }
      html body #root button[data-qrpass-blue-v173] :is(span,svg) { color:#ffffff !important; }
      html body #root button[data-qrpass-blue-v173]:is(:hover,:focus-visible) {
        box-shadow: 0 0 0 3px #dce8ff !important;
        outline: 1px solid #9dbaf3 !important;
        outline-offset: 2px !important;
      }
      html body #root button[data-qrpass-blue-v173]:disabled { cursor:not-allowed !important; }
    `;
    document.head.appendChild(style);
    return ()=>style.remove();
  }, []);


  // QRPASS_NEUTRAL_BUTTON_HOVER_V169: component-scoped installation of lightweight neutral-button CSS.
  // No MutationObserver, JS hover handlers or timers (avoids hover lag).
  React.useEffect(() => {
    const id = "qrpass-neutral-buttons-v169";
    if (document.getElementById(id)) return;
    const element = document.createElement("style");
    element.id = id;
    element.textContent = `
      html body #root button[data-qrpass-neutral-v169="true"]:not(:disabled) {
        background: #ffffff !important;
        background-color: #ffffff !important;
        background-image: none !important;
        color: #17336d !important;
        border: 1px solid #a8bde4 !important;
        box-shadow: none !important;
        outline: none !important;
        filter: none !important;
        transform: none !important;
        transition: none !important;
      }
      html body #root button[data-qrpass-neutral-v169="true"]:not(:disabled):is(:hover,:focus,:active) {
        background: #eef2ff !important;
        background-color: #eef2ff !important;
        background-image: none !important;
        color: #17336d !important;
        border-color: #9bb5ec !important;
        box-shadow: none !important;
        outline: none !important;
        filter: none !important;
        transform: none !important;
        transition: none !important;
      }
      /* Keyboard navigation remains visible, but avoids the doubled ring. */
      html body #root button[data-qrpass-neutral-v169="true"]:focus-visible {
        outline: 2px solid #6d91e8 !important;
        outline-offset: 2px !important;
      }
    `;
    document.head.appendChild(element);
    return () => element.remove();
  }, []);


  // QRPASS_BLUE_BUTTON_HOVER_OPTIMIZED_V166
  // Delegation runs only on actual pointer entry, not on every React DOM update.
  useEffect(() => {
    const id = 'qrpass-blue-save-settings-hover-v166';
    const sheet=document.createElement('style');sheet.id=id;
    sheet.textContent=`
      html body #root#root button[data-qrpass-blue-action-v166="true"]:hover:not(:disabled),
      html body #root#root button[data-qrpass-blue-action-v166="true"]:focus-visible:not(:disabled) {
        background: linear-gradient(180deg,#31579f 0%,#1c356b 100%) !important;
        background-color:#244681 !important;
        background-image:linear-gradient(180deg,#31579f 0%,#1c356b 100%) !important;
        color:#ffffff !important;border:1px solid #a9c5f7 !important;
        box-shadow:0 0 0 3px #dce8ff !important;outline:none !important;
        opacity:1 !important;transform:none !important;filter:none !important;
        transition:none !important;animation:none !important;
      }
      html body #root#root button[data-qrpass-blue-action-v166="true"]:is(:hover,:focus-visible) * {color:#ffffff !important;}
    `;
    document.head.appendChild(sheet);
    const onHover=(event:PointerEvent)=>{
      const node=event.target;
      if(!(node instanceof Element))return;
      const b=node.closest('button') as HTMLButtonElement|null;
      if(b?.closest('[data-qrpass-password-modal-fast-v167="true"]'))return; // v167: skip expensive computedStyle in this modal
      if(!b||b.dataset.qrpassBlueActionV166==='true'||b.disabled)return;
      const cls=typeof b.className==='string'?b.className:'';
      const label=(b.textContent||'')+' '+(b.getAttribute('aria-label')||'');
      if(/(?:delete|revoke|remove|disable|logout|cancel|back)/i.test(label)||/(?:red-|rose-|danger)/i.test(cls))return;
      const filled=/(?:^|\s)(?:bg-primary|bg-blue-[5-9]00|bg-indigo-[5-9]00|bg-\[#(?:1a3a7b|17336d|1e448b|2f5fd6|234a91|244681)\])(?=\s|$)/i.test(cls);
      const style=window.getComputedStyle(b);
      const m=style.backgroundColor.match(/^rgba?\((\d+),\s*(\d+),\s*(\d+)/);
      const blue=m&&(+m[3] > +m[1]*1.15)&&(+m[3] > +m[2]*1.10)&&(+m[1]<125)&&(+m[2]<155);
      if(filled || (blue && /rgb\(255,\s*255,\s*255\)/.test(style.color)))b.dataset.qrpassBlueActionV166='true';
    };
    document.addEventListener('pointerover',onHover,{passive:true});
    return ()=>{document.removeEventListener('pointerover',onHover);sheet.remove()};
  }, []);


  // QRPASS_BLUE_BUTTON_NO_EFFECTS_V162: visual-only; leave click handlers and button disabled logic intact.
  useEffect(() => {
    const cssId = "qrpass-blue-buttons-no-effects-v162";
    if (document.getElementById(cssId)) return;
    const sheet = document.createElement("style");
    sheet.id = cssId;
    sheet.textContent = `
      /* Blue filled ACTION buttons only; excludes Cancel, outlined controls,
         red destructive actions, navbar icon-only controls and disabled semantics. */
      html body #root button:is(
        .bg-primary,
        [class~="bg-blue-500"],
        [class~="bg-blue-600"],
        [class~="bg-blue-700"],
        [class~="bg-blue-800"],
        [class~="bg-indigo-600"],
        [class~="bg-indigo-700"],
        [class~="bg-[#1a3a7b]"],
        [class~="bg-[#17336d]"],
        [class~="bg-[#1e448b]"],
        [class~="bg-[#2f5fd6]"],
        [class~="bg-[#234a91]"]
      ):not([class*="red-"]):not([class*="rose-"]):not([class*="danger"]):not(:disabled),
      html body #root button:is(
        .bg-primary,
        [class~="bg-blue-500"],
        [class~="bg-blue-600"],
        [class~="bg-blue-700"],
        [class~="bg-blue-800"],
        [class~="bg-indigo-600"],
        [class~="bg-indigo-700"],
        [class~="bg-[#1a3a7b]"],
        [class~="bg-[#17336d]"],
        [class~="bg-[#1e448b]"],
        [class~="bg-[#2f5fd6]"],
        [class~="bg-[#234a91]"]
      ):not([class*="red-"]):not([class*="rose-"]):not([class*="danger"]):not(:disabled):is(:hover,:active,:focus) {
        background: #1a3a7b !important;
        background-color: #1a3a7b !important;
        background-image: none !important;
        color: #ffffff !important;
        opacity: 1 !important;
        box-shadow: none !important;
        filter: none !important;
        transform: none !important;
        transition: none !important;
        animation: none !important;
      }
      /* Preserve visible keyboard navigation without hover/glow. */
      html body #root button.bg-primary:focus-visible {
        outline: 2px solid #93c5fd !important;
        outline-offset: 2px !important;
      }
    `;
    document.head.appendChild(sheet);
    return () => sheet.remove();
  }, []);


  useEffect(() => {
    const updateTitle = () => {
      try {
        const raw = localStorage.getItem("qrpass-footer-brand");
        const saved = raw ? JSON.parse(raw) : null;
        document.title = String(saved?.system_name || "QRpass");
      } catch { document.title = "QRpass"; }
    };
    updateTitle();
    window.addEventListener("qrpass-settings-updated", updateTitle);
    return () => window.removeEventListener("qrpass-settings-updated", updateTitle);
  }, []);
  const [view, setView] = useState<View>(() =>
    localStorage.getItem("token") ? "checking" : "login"
  );

  const [role, setRole] = useState<Role>("student");
  const [restoreAttempt, setRestoreAttempt] = useState(0);

  // Restore an existing login only after backend verification.
  useEffect(() => {
    let cancelled = false;
    const token = localStorage.getItem("token");

    if (!token) {
      setView("login");
      return;
    }

    async function restoreSession() {
      try {
        const response = await window.fetch(`${API_URL}/account`, {
          method: "GET",
          headers: {
            Accept: "application/json",
            Authorization: `Bearer ${token}`,
          },
        });

        if (cancelled) return;

        if (response.status === 401 || response.status === 403) {
          localStorage.removeItem("token");
          localStorage.removeItem("user");
          localStorage.removeItem("role");
          setRole("student");
          setView("login");
          return;
        }

        if (!response.ok) {
          throw new Error(`Session check failed: ${response.status}`);
        }

        const data = await response.json();
        const user = data?.user;

        const validRoles: Role[] = [
          "student",
          "security",
          "pco",
          "sysadmin",
        ];

        if (!user || !validRoles.includes(user.role as Role)) {
          localStorage.removeItem("token");
          localStorage.removeItem("user");
          localStorage.removeItem("role");
          setRole("student");
          setView("login");
          return;
        }

        if (cancelled) return;

        localStorage.setItem("user", JSON.stringify(user));
        localStorage.setItem("role", user.role);

        setRole(user.role as Role);
        setView("dashboard");

      } catch (error) {
        if (cancelled) return;

        console.error("Session restoration failed:", error);

        // Network problems should not silently delete a valid login.
        setView("restore-error");
      }
    }

    void restoreSession();

    return () => {
      cancelled = true;
    };
  }, [restoreAttempt]);


        /*
    |--------------------------------------------------------------------------
    | AUTOMATIC SESSION INACTIVITY TIMEOUT
    |--------------------------------------------------------------------------
    */

    useEffect(() => {
      if (view !== "dashboard") {
        return;
      }

      let timeoutId:
        ReturnType<typeof setTimeout> | null =
          null;

      let timeoutMinutes = 30;

      let disposed = false;

      async function loadTimeoutPolicy() {
        try {
          const data =
            await getSessionPolicy();

          timeoutMinutes =
            Math.max(
              1,
              Number(
                data
                  ?.session_timeout_minutes ??
                  30
              )
            );

      resetInactivityTimer();
    } catch (error) {
      console.error(
        "Failed to load session timeout policy:",
        error
      );

      timeoutMinutes = 30;

      resetInactivityTimer();
    }
  }

  function expireSession() {
    sessionStorage.removeItem("qrpass-active-page-v1");
    if (disposed) {
      return;
    }

    localStorage.removeItem(
      "token"
    );

    localStorage.removeItem(
      "user"
    );

    localStorage.removeItem(
      "role"
    );

    alert(
      "Your session has expired due to inactivity. Please log in again."
    );

    setRole("student");
    setView("login");
  }

  function resetInactivityTimer() {
    if (disposed) {
      return;
    }

    if (timeoutId) {
      clearTimeout(
        timeoutId
      );
    }

    timeoutId =
      setTimeout(
        expireSession,
        timeoutMinutes *
          60 *
          1000
      );
  }

  /*
  |--------------------------------------------------------------------------
  | REAL USER ACTIVITY
  |--------------------------------------------------------------------------
  */

  const activityEvents = [
    "mousedown",
    "mousemove",
    "keydown",
    "scroll",
    "touchstart",
    "click",
  ];

  activityEvents.forEach(
    (eventName) => {
      window.addEventListener(
        eventName,
        resetInactivityTimer,
        {
          passive: true,
        }
      );
    }
  );

  loadTimeoutPolicy();

  return () => {
    disposed = true;

    if (timeoutId) {
      clearTimeout(
        timeoutId
      );
    }

    activityEvents.forEach(
      (eventName) => {
        window.removeEventListener(
          eventName,
          resetInactivityTimer
        );
      }
    );
  };
}, [view]);

  /*
  |--------------------------------------------------------------------------
  | LOGIN
  |--------------------------------------------------------------------------
  */

  function handleLogin(r: Role) {
    setRole(r);
    setView("dashboard");
  }

  /*
  |--------------------------------------------------------------------------
  | REAL LOGOUT
  |--------------------------------------------------------------------------
  |
  | 1. Ask Laravel to revoke the current Sanctum token.
  | 2. Clear the token from the browser.
  | 3. Return the user to the login page.
  |
  */

  async function handleLogout() {
    try {
      await logout();
    } catch (error) {
      console.error(
        "Server logout failed:",
        error
      );
    } finally {
      sessionStorage.removeItem("qrpass-active-page-v1");
      /*
      |--------------------------------------------------------------------------
      | Clear Local Session
      |--------------------------------------------------------------------------
      */

      localStorage.removeItem(
        "token"
      );

      localStorage.removeItem(
        "user"
      );

      localStorage.removeItem(
        "role"
      );

      /*
      |--------------------------------------------------------------------------
      | Reset QRPass UI
      |--------------------------------------------------------------------------
      */

      setRole("student");

      setView("login");
    }
  }

  /*
  |--------------------------------------------------------------------------
  | PAGE RENDERING
  |--------------------------------------------------------------------------
  */

  if (view === "checking") {
    return (
      <>
        <style>{`
          @keyframes qrpassSoftPulse {
            0% {
              transform: scale(0.98);
              opacity: 0.88;
            }
            50% {
              transform: scale(1);
              opacity: 1;
            }
            100% {
              transform: scale(0.98);
              opacity: 0.88;
            }
          }

          @keyframes qrpassSoftGlow {
            0% {
              box-shadow: 0 0 0 0 rgba(26, 58, 123, 0.12);
            }
            50% {
              box-shadow: 0 0 0 16px rgba(47, 95, 214, 0.03);
            }
            100% {
              box-shadow: 0 0 0 0 rgba(26, 58, 123, 0.12);
            }
          }
        `}</style>

        <div className="flex min-h-screen items-center justify-center bg-gradient-to-br from-[#e1eafa] via-[#f6f9ff] to-[#dce8fa] px-6">
          <div className="flex flex-col items-center justify-center text-center">
            <div
              className="flex h-28 w-28 items-center justify-center rounded-full border border-[#ccdaf2] bg-white/85 shadow-[0_8px_32px_rgba(26,58,123,0.10)]"
              style={{
                animation:
                  "qrpassSoftPulse 1.8s ease-in-out infinite, qrpassSoftGlow 2.2s ease-in-out infinite",
              }}
            >
              <img
                src="/qrpass-shield-only.png"
                alt="QRPass"
                className="h-20 w-20 object-contain select-none"
                draggable={false}
              />
            </div>

            <div className="mt-6">
              <h2 className="text-xl font-bold tracking-wide text-[#17336d]">
                QRPass
              </h2>
              <p className="mt-2 text-sm text-[#64748b]">
                Securing your session...
              </p>
            </div>
          </div>
        </div>
      </>
    );
  }

  if (view === "restore-error") {
    return (
      <div className="flex min-h-screen items-center justify-center bg-[#eef2fc] p-4">
        <div className="w-full max-w-sm rounded-2xl border border-[#dce3ee] bg-white p-8 text-center shadow-lg">
          <h2 className="text-xl font-bold text-[#1a3a7b]">
            QRPass
          </h2>
          <p className="mt-3 text-sm text-[#64748b]">
            Could not verify your session. Check your connection or backend server.
          </p>
          <button
            type="button"
            onClick={() => {
              setView("checking");
              setRestoreAttempt(value => value + 1);
            }}
            className="mt-5 w-full rounded-xl bg-primary px-5 py-3 text-sm font-semibold text-white transition-colors hover:!bg-[#eef2ff] hover:!text-[#17336d] hover:!border-[#a8bde4] focus-visible:!ring-0 focus-visible:!shadow-none"
          >
            Retry Connection
          </button>
          <button
            type="button"
            onClick={() => { void handleLogout(); }}
            className="mt-3 text-sm font-semibold text-[#1a3a7b]"
          >
            Log In Again
          </button>
        </div>
      </div>
    );
  }
  if (view === "dashboard") {
    return (
      <Dashboard
        role={role}
        onLogout={handleLogout}
      />
    );
  }

  return (
    <LoginPage
      onLogin={handleLogin}
    />
  );
}

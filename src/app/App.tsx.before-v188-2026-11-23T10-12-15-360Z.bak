        }
      }
      @media (max-width: 380px) {
        .qrpass-auth-register-card .grid.grid-cols-2 {
          grid-template-columns: minmax(0, 1fr) !important;
        }
        .qrpass-auth-register-card .flex.justify-center > button {
          width: 100% !important;
        }
      }
    
      /* QRPASS_CREATE_ACCOUNT_POLISH_V34: visual polish scoped exclusively to the student registration card */
      .qrpass-auth-register-card > .bg-primary {
        padding: 18px 24px 17px !important;
      }
      .qrpass-auth-register-card > .bg-primary h2 {
        font-size: 22px !important;
        line-height: 1.3 !important;
        letter-spacing: -0.015em;
      }
      .qrpass-auth-register-card > .p-5 {
        padding: 22px 24px 24px !important;
      }
      .qrpass-auth-register-card > .p-5 form > p:first-child {
        margin-bottom: 15px !important;
        letter-spacing: 0.035em;
        color: #17336d;
      }
      .qrpass-auth-register-card > .p-5 form .grid {
        column-gap: 15px !important;
        row-gap: 15px !important;
      }
      .qrpass-auth-register-card > .p-5 form label {
        display: block;
        margin-bottom: 7px !important;
        font-size: 13px !important;
        line-height: 1.4;
        font-weight: 600 !important;
        color: #172c4f;
      }
      .qrpass-auth-register-card > .p-5 form input:not([type="checkbox"]),
      .qrpass-auth-register-card > .p-5 form select {
        height: 48px !important;
        min-height: 48px !important;
        width: 100%;
        border: 1px solid #cbd7ea !important;
        border-radius: 12px !important;
        font-size: 15px !important;
        box-shadow: none;
        transition: border-color .16s ease, box-shadow .16s ease;
      }
      .qrpass-auth-register-card > .p-5 form input:not([type="checkbox"]) {
        background: #fbfcff !important;
      }
      .qrpass-auth-register-card > .p-5 form select {
        background-color: #f1f5ff !important;
      }
      .qrpass-auth-register-card > .p-5 form input:focus,
      .qrpass-auth-register-card > .p-5 form select:focus {
        border-color: #3563c8 !important;
        box-shadow: 0 0 0 3px rgba(53,99,200,.12) !important;
      }
      .qrpass-auth-register-card > .p-5 form > .mt-4.flex.items-start {
        margin-top: 20px !important;
        padding: 13px 15px !important;
        gap: 9px !important;
        border-radius: 12px !important;
        line-height: 1.6 !important;
      }
      .qrpass-auth-register-card > .p-5 form > .flex.gap-3.mt-5.justify-end {
        margin-top: 22px !important;
        gap: 12px !important;
        flex-wrap: wrap;
      }
      .qrpass-auth-register-card > .p-5 form > .flex.gap-3.mt-5.justify-end button {
        min-height: 46px !important;
        padding: 10px 19px !important;
        border-radius: 11px !important;
        font-weight: 600;
        font-size: 13px !important;
      }
      @media (max-width: 640px) {
        .qrpass-auth-register-card > .bg-primary { padding: 16px 18px !important; }
        .qrpass-auth-register-card > .p-5 { padding: 18px 18px 22px !important; }
        .qrpass-auth-register-card > .p-5 form .grid { row-gap: 13px !important; }
        .qrpass-auth-register-card > .p-5 form > .flex.gap-3.mt-5.justify-end button { flex: 1 1 140px; }
      }

      /* QRPASS_CREATE_ACCOUNT_LOGIN_SIZE_V35: registration size and spacing only; preserve existing top accent */
      .qrpass-auth-register-card {
        width: 100% !important;
        max-width: 435px !important;
        margin-inline: auto !important;
      }
      .qrpass-auth-register-card > .bg-primary {
        padding: 15px 20px 13px !important;
      }
      .qrpass-auth-register-card > .bg-primary h2 {
        font-size: 21px !important;
      }
      .qrpass-auth-register-card > .p-5 {
        padding: 17px 20px 20px !important;
      }
      .qrpass-auth-register-card > .p-5 form > p:first-child {
        margin-bottom: 11px !important;
      }
      .qrpass-auth-register-card > .p-5 form .grid {
        column-gap: 12px !important;
        row-gap: 10px !important;
      }
      .qrpass-auth-register-card > .p-5 form label {
        margin-bottom: 5px !important;
        font-size: 12px !important;
      }
      .qrpass-auth-register-card > .p-5 form input:not([type="checkbox"]),
      .qrpass-auth-register-card > .p-5 form select {
        height: 43px !important;
        min-height: 43px !important;
        font-size: 14px !important;
      }
      .qrpass-auth-register-card > .p-5 form > .mt-4.flex.items-start {
        margin-top: 14px !important;
        padding: 10px 12px !important;
        line-height: 1.45 !important;
      }
      .qrpass-auth-register-card > .p-5 form > .flex.gap-3.mt-5.justify-end {
        margin-top: 15px !important;
        gap: 9px !important;
      }
      .qrpass-auth-register-card > .p-5 form > .flex.gap-3.mt-5.justify-end button {
        min-height: 41px !important;
        padding: 8px 12px !important;
        font-size: 12px !important;
      }
      @media (max-width: 480px) {
        .qrpass-auth-register-card > .p-5 { padding: 15px !important; }
        .qrpass-auth-register-card > .bg-primary { padding: 15px !important; }
        .qrpass-auth-register-card > .p-5 form > .flex.gap-3.mt-5.justify-end button { flex: 1 1 130px; }
      }
`}</style>
  );
  const PageShell = React.useMemo(
  () =>
    function AuthPageShell({
      children,
    }: {
      children: React.ReactNode;
    }) {
      return (
        <div
          className="min-h-screen flex flex-col qrpass-auth-page"
          style={{
            fontFamily: "Inter, sans-serif",
            background: "#f6f8fb",
          }}
        >
          {AuthThemeStyles}


          <div className="flex-1 flex flex-col items-center justify-center px-4 py-10 qrpass-auth-content">
            {children}

            <p className="mt-8 text-xs text-muted-foreground text-center">
              QRpass V1.0
              <span className="mx-2">|</span>
              QRpass V1.0
            </p>
          </div>

        </div>
      );
    },
  []
);

  // ==========================================================================
  // TWO-FACTOR AUTHENTICATION PAGE
  // ==========================================================================

  if (mode === "two-factor") {
    return (
      <PageShell>
        <div className="flex flex-col items-center mb-6 qrpass-auth-logo">
          <QRpassLogo
            size={72}
            showText
          />
        </div>

        <div className="w-full max-w-sm bg-white rounded-xl border border-[#cfd8e6] shadow-md overflow-hidden qrpass-auth-card">
          <div className="rounded-t-xl bg-primary px-6 py-4">
            <h2
              className="text-white font-bold text-base"
              style={{
                fontFamily:
                  "Barlow, sans-serif",
              }}
            >
              Two-Factor Authentication
            </h2>

            <p className="text-white/70 text-xs mt-1">
              Enter the verification code sent to your registered email address.
            </p>
          </div>

          <form
            onSubmit={
              handleTwoFactorSubmit
            }
            className="p-6 space-y-4"
          >
            <div className="rounded-lg border border-blue-200 bg-blue-50 px-3 py-3">
              <div className="flex items-start gap-2">
                <Shield
                  size={16}
                  className="text-blue-700 mt-0.5 flex-shrink-0"
                />

                <p className="text-xs text-blue-800 leading-relaxed">
                  For your security, QRPass sent a 6-digit login verification
                  code to the email registered with this account. The code
                  expires after 10 minutes.
                </p>
              </div>
            </div>

            <div>
              <label className="block text-xs font-semibold text-foreground mb-1.5 uppercase tracking-wide">
                Verification Code
              </label>

              <input
                type="text"
                inputMode="numeric"
                autoComplete="one-time-code"
                value={
                  twoFactorCode
                }
                onChange={(e) => {
                  const value =
                    e.target.value
                      .replace(
                        /\D/g,
                        ""
                      )
                      .slice(
                        0,
                        6
                      );

                  setTwoFactorCode(
                    value
                  );

                  setTwoFactorError(
                    ""
                  );
                }}
                placeholder="000000"
                maxLength={6}
                autoFocus
                disabled={
                  isVerifyingTwoFactor
                }
                className="w-full px-3 py-3 text-center text-2xl font-bold tracking-[0.45em] border border-[#cfd8e6] rounded-md bg-[#fafbfc] focus:outline-none focus:border-[#2f5fd6] focus:ring-2 focus:ring-[#2f5fd6]/15 disabled:opacity-50"
              />
            </div>

            {twoFactorError && (
              <div
                role="alert"
                className="flex items-start gap-2 rounded-md border border-red-200 bg-red-50 px-3 py-2.5"
              >
                <AlertCircle
                  size={15}
                  className="mt-0.5 flex-shrink-0 text-red-600"
                />

                <p className="text-xs leading-relaxed text-red-700">
                  {twoFactorError}
                </p>
              </div>
            )}

            <button
              type="submit"
              disabled={
                isVerifyingTwoFactor ||
                twoFactorCode.length !==
                  6
              }
              className="w-full bg-primary text-white py-2.5 rounded-md text-sm font-semibold transition-opacity disabled:opacity-50 disabled:cursor-not-allowed transition-colors hover:!bg-[#eef2ff] hover:!text-[#17336d] hover:!border-[#a8bde4] focus-visible:!ring-0 focus-visible:!shadow-none"
          >
              {isVerifyingTwoFactor
                ? "Verifying..."
                : "Verify & Sign In"}
            </button>

            <button
              type="button"
              disabled={
                isVerifyingTwoFactor
              }
              onClick={() => {
                setTwoFactorChallenge(
                  ""
                );

                setTwoFactorCode(
                  ""
                );

                setTwoFactorError(
                  ""
                );

                setPassword("");

                setMode(
                  "login"
                );
              }}
              className="w-full text-xs text-muted-foreground disabled:opacity-50 !bg-white !text-[#17336d] !border-[#cbd5e1] transition-colors hover:!bg-[#eef2ff] hover:!border-[#a8bde4] hover:!text-[#17336d] focus-visible:!ring-0 focus-visible:!shadow-none focus-visible:!outline-none"
             
            onMouseEnter={(e) => {
              const el=e.currentTarget;
              if(!el.dataset.qrpassV158Saved) {
                el.dataset.qrpassV158Saved=el.style.cssText || " ";
              }
              el.style.setProperty("background", "#eef2ff", "important");
              el.style.setProperty("background-color", "#eef2ff", "important");
              el.style.setProperty("background-image", "none", "important");
              el.style.setProperty("color", "#17336d", "important");
              el.style.setProperty("border-color", "#a8bde4", "important");
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onMouseLeave={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onFocus={(e) => {
              e.currentTarget.style.setProperty("box-shadow", "none", "important");
              e.currentTarget.style.setProperty("outline", "none", "important");
            }}
            onBlur={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}

           data-qrpass-neutral-v169="true">
              Back to Sign In
            </button>
          </form>
        </div>
      </PageShell>
    );
  }

  // ==========================================================================
  // REGISTER PAGE
  // ==========================================================================

  if (mode === "register") {
    return (
      <div
        className="min-h-screen flex flex-col qrpass-auth-page"
        style={{
          fontFamily:
            "Inter, sans-serif",
          background: "#f6f8fb",
        }}
      >
        {AuthThemeStyles}
        {/* QRPASS_REGISTER_MATCH_SEARCH_HOVER_V134 — scoped to Create Account only, no external CSS */}
        <style>{`
          /* Same white/default and pale-blue/hover as the search field reference. */
          #root .qrpass-auth-page .qrpass-auth-register-card input:not([type="checkbox"]):not([type="radio"]),
          #root .qrpass-auth-page .qrpass-auth-register-card button[role="combobox"] {
            background: #ffffff !important;
            background-color: #ffffff !important;
            border: 1px solid #cbd5e1 !important;
            box-shadow: none !important;
            outline: none !important;
            transition: background-color 150ms ease, border-color 150ms ease !important;
          }
          #root .qrpass-auth-page .qrpass-auth-register-card input:not([type="checkbox"]):not([type="radio"]):hover,
          #root .qrpass-auth-page .qrpass-auth-register-card button[role="combobox"]:hover {
            background: #eef2ff !important;
            background-color: #eef2ff !important;
            border-color: #a8bde4 !important;
            box-shadow: none !important;
            outline: none !important;
          }
          #root .qrpass-auth-page .qrpass-auth-register-card input:not([type="checkbox"]):not([type="radio"]):focus,
          #root .qrpass-auth-page .qrpass-auth-register-card input:not([type="checkbox"]):not([type="radio"]):focus-visible,
          #root .qrpass-auth-page .qrpass-auth-register-card button[role="combobox"]:focus,
          #root .qrpass-auth-page .qrpass-auth-register-card button[role="combobox"]:focus-visible {
            background: #eef2ff !important;
            background-color: #eef2ff !important;
            border-color: #a8bde4 !important;
            box-shadow: none !important;
            outline: none !important;
          }
          /* Selected dropdown list options retain their readable active state. */
        `}</style>

        {/* QRPASS_REGISTRATION_OUTLINE_REFERENCE_V133 — scoped to Create Account only, no new CSS files */}
        <style>{`
          #root .qrpass-auth-register-card input,
          #root .qrpass-auth-register-card button[role="combobox"] {
            border: 1px solid #cbd5e1 !important;
            box-shadow: none !important;
            background-color: #ffffff !important;
          }
          #root .qrpass-auth-register-card input:hover,
          #root .qrpass-auth-register-card button[role="combobox"]:hover {
            border-color: #b8c9df !important;
            background-color: #eaf3ff !important;
          }
          #root .qrpass-auth-register-card input:focus,
          #root .qrpass-auth-register-card button[role="combobox"]:focus-visible {
            border-color: #93b4ed !important;
            box-shadow: 0 0 0 2px rgba(147, 180, 237, .12) !important;
          }
        `}</style>



        <div className="flex-1 flex flex-col items-center px-4 py-8 qrpass-auth-content qrpass-auth-register-content">

          <div className="w-full max-w-[540px] bg-white rounded-xl border border-[#cfd8e6] shadow-md overflow-visible qrpass-auth-card qrpass-auth-register-card">

            {/* HEADER */}
            <div className="bg-primary px-6 py-4">
              <h2
                className="text-white font-bold text-base"
                style={{
                  fontFamily:
                    "Barlow, sans-serif",
                }}
              >
                Create Account
              </h2>
            </div>

            {!regSubmitted ? (
              <div className="p-5">


                {registrationErrorV182 && (
                  <div role="alert" className="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm leading-relaxed text-red-700">
                    {registrationErrorV182}
                  </div>
                )}
                {/* REGISTRATION FORM */}
                {regRole === "student" && (
                  <form
                    onSubmit={
                      handleRegister
                    }
                  >

                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-x-3 gap-y-3">
                      {fields.filter(field => !(field.label === "College / Department" && regFields["Year Level"] === "Senior High School")).map(
                        (field) => (
                          <div
                            key={field.label}
                            className={field.label === "College / Department" || field.label === "Year Level" ? "sm:col-span-2" : ""}
                          >
                            <label className="block text-xs font-semibold text-foreground mb-1">
                              {
                                field.label
                              }
                            </label>

                            {field.type ===
                            "select" ? (
                              <QRPassRegistrationSelect
                                label={field.label}
                                value={regFields[field.label] ?? ""}
                                options={field.options ?? []}
                                placeholder={field.label === "Year Level" ? "Select year level" : "Select college"}
                                onValueChange={(next) => setRegFields((previous) => ({
                                  ...previous,
                                  [field.label]: next,
                                  ...(field.label === "Year Level" && next === "Senior High School"
                                    ? { "College / Department": "" }
                                    : {}),
                                }))}
                              />
                            
                            ) : (
                              <div className="relative">
                                <input
                                  ref={(element) => qrpassRegistrationFieldBackgroundV129(element, "idle")}
                                  onMouseEnter={(event) => {
                                    if (document.activeElement !== event.currentTarget) qrpassRegistrationFieldBackgroundV129(event.currentTarget, "hover");
                                  }}
                                  onMouseLeave={(event) => qrpassRegistrationFieldBackgroundV129(event.currentTarget, "idle")}
                                  onFocus={(event) => qrpassRegistrationFieldBackgroundV129(event.currentTarget, "idle")}
                                  onBlur={(event) => qrpassRegistrationFieldBackgroundV129(event.currentTarget, event.currentTarget.matches(":hover") ? "hover" : "idle")}
                                  type={field.type === "password"
                                    ? ((field.label === "Password" ? showRegPassword : showRegConfirmPassword) ? "text" : "password")
                                    : field.type}
                                  inputMode={field.label === "Student ID No." || field.label === "Contact Number" ? "numeric" : undefined}
                                  autoComplete={field.label === "Full Name" ? "name" : field.label === "Contact Number" ? "tel" : field.type === "password" ? "new-password" : undefined}
                                  pattern={field.label === "Student ID No." || field.label === "Contact Number" ? "[0-9]+" : undefined}
                                  maxLength={field.label === "Student ID No." || field.label === "Contact Number" ? 20 : undefined}
                                  placeholder={field.placeholder}
                                  value={regFields[field.label] ?? ""}
                                  onChange={(e) => {
                                    const raw = e.target.value;
                                    const sanitized = field.label === "Full Name"
                                      ? raw.replace(/[0-9]/g, "")
                                      : (field.label === "Student ID No." || field.label === "Contact Number")
                                        ? raw.replace(/[^0-9]/g, "")
                                        : raw;
                                    setRegFields((previous) => ({ ...previous, [field.label]: sanitized }));
                                  }}
                                  required={field.label !== "Contact Number"}
                                  minLength={field.type === "password" ? 6 : undefined}
                                  className={"w-full px-3 py-2 text-sm border border-[#cfd8e6] rounded-md !bg-white hover:!bg-[#eef2ff] focus:!bg-white focus:outline-none focus:border-[#2f5fd6] focus:ring-2 focus:ring-[#2f5fd6]/15" + (field.type === "password" ? " pr-11" : "")}
                                />
                                {field.type === "password" && (
                                  <button
                                    type="button"
                                    className="absolute right-3 top-1/2 -translate-y-1/2 rounded p-1 text-[#637da9] hover:text-[#17336d] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#2f5fd6]"
                                    aria-label={(field.label === "Password" ? showRegPassword : showRegConfirmPassword) ? "Hide " + field.label : "Show " + field.label}
                                    title={(field.label === "Password" ? showRegPassword : showRegConfirmPassword) ? "Hide password" : "Show password"}
                                    onClick={() => field.label === "Password"
                                      ? setShowRegPassword(v => !v)
                                      : setShowRegConfirmPassword(v => !v)}
                                  >
                                    {(field.label === "Password" ? showRegPassword : showRegConfirmPassword)
                                      ? <EyeOff size={18} /> : <Eye size={18} />}
                                  </button>
                                )}
                              </div>
                            )}
                          </div>
                        )
                      )}
                    </div>


                    <div className="flex gap-3 mt-5 justify-end">
                      <button
                        type="button"
                        onClick={() =>
                          switchMode(
                            "login"
                          )
                        }
                        data-qrpass-hover-uniform-v141="true" onMouseEnter={(e) => e.currentTarget.style.setProperty("background-color", "#eef2ff", "important")} onMouseLeave={(e) => e.currentTarget.style.setProperty("background-color", "#ffffff", "important")}
            className="text-xs px-4 py-2 border border-[#cfd8e6] rounded-md text-muted-foreground transition-colors !bg-white !text-[#17336d] !border-[#cbd5e1] transition-colors hover:!bg-[#eef2ff] hover:!border-[#a8bde4] hover:!text-[#17336d] focus-visible:!ring-0 focus-visible:!shadow-none focus-visible:!outline-none"
                       data-qrpass-neutral-v169="true">
                        ← Back to Login
                      </button>

                      <button data-qrpass-blue-v173="register-submit"
                        type="submit"
                        className="text-xs bg-primary text-white px-5 py-2 rounded-md font-semibold transition-opacity transition-colors hover:!bg-[#eef2ff] hover:!text-[#17336d] hover:!border-[#a8bde4] focus-visible:!ring-0 focus-visible:!shadow-none"
          >
                        Submit Registration
                      </button>
                    </div>
                  </form>
                )}

              </div>
            ) : (
              <div className="p-10 flex flex-col items-center gap-4">
                <div className="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center">
                  <CheckCircle
                    size={32}
                    className="text-green-500"
                  />
                </div>

                <div className="text-center">
                  <h3
                    className="font-bold text-foreground text-base"
                    style={{
                      fontFamily:
                        "Barlow, sans-serif",
                    }}
                  >
                    Registration
                    Submitted!
                  </h3>

                  <p className="text-xs text-muted-foreground mt-1 max-w-xs">
                    Your account has been
                    registered successfully.
                    You may return to the
                    login page.
                  </p>
                </div>

                <button
                  type="button"
                  onClick={() =>
                    switchMode(
                      "login"
                    )
                  }
                  className="text-xs bg-primary text-white px-5 py-2 rounded-md font-semibold !bg-white !text-[#17336d] !border-[#cbd5e1] transition-colors hover:!bg-[#eef2ff] hover:!border-[#a8bde4] hover:!text-[#17336d] focus-visible:!ring-0 focus-visible:!shadow-none focus-visible:!outline-none"
                 
            onMouseEnter={(e) => {
              const el=e.currentTarget;
              if(!el.dataset.qrpassV158Saved) {
                el.dataset.qrpassV158Saved=el.style.cssText || " ";
              }
              el.style.setProperty("background", "#eef2ff", "important");
              el.style.setProperty("background-color", "#eef2ff", "important");
              el.style.setProperty("background-image", "none", "important");
              el.style.setProperty("color", "#17336d", "important");
              el.style.setProperty("border-color", "#a8bde4", "important");
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onMouseLeave={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onFocus={(e) => {
              e.currentTarget.style.setProperty("box-shadow", "none", "important");
              e.currentTarget.style.setProperty("outline", "none", "important");
            }}
            onBlur={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}

           data-qrpass-neutral-v169="true">
                  ← Back to Login
                </button>
              </div>
            )}
          </div>

          <p className="mt-6 text-xs text-muted-foreground text-center">
           QRpass V1.0

            <span className="mx-2">
              |
            </span>

            QRpass V1.0
          </p>
        </div>

      </div>
    );
  }

  // ==========================================================================
  // FORGOT PASSWORD PAGE
  // ==========================================================================

  if (mode === "forgot") {
    return (
      <PageShell>

        <div className="qrpass-auth-forgot-card w-full max-w-sm bg-white rounded-xl border border-[#cfd8e6] shadow-md overflow-hidden qrpass-auth-card">
          <div className="bg-primary px-6 py-4">
            <h2
              className="text-white font-bold text-base"
              style={{
                fontFamily:
                  "Barlow, sans-serif",
              }}
            >
              Forgot Password
            </h2>

            
          </div>

          <form
            onSubmit={
              handleForgotSubmit
            }
            className="p-6 space-y-4"
          >
            <div>
              <label className="block text-sm font-semibold text-[#17336d] mb-2">
                Email Address
              </label>

              <div className="relative">
                <User
                  size={15}
                  className="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground"
                />

                <input
                  type="email"
                  value={forgotEmail}
                  onChange={(e) =>
                    setForgotEmail(
                      e.target.value
                    )
                  }
                  
                  ref={(el) => { /* QRPASS_FORGOT_EMAIL_FOCUS_OUTLINE_V136 */
                    if (!el) return;
                    const focus = document.activeElement === el;
                    const hover = el.matches(':hover');
                    el.style.setProperty('background-color', focus ? '#FFFFFF' : hover ? '#EEF2FF' : '#FFFFFF', 'important');
                    el.style.setProperty('border-color', focus ? '#6289FF' : hover ? '#9DB7F1' : '#CBD5E1', 'important');
                    el.style.setProperty('box-shadow', focus ? '0 0 0 4px rgba(98, 137, 255, 0.16)' : 'none', 'important');
                    el.style.setProperty('outline', 'none', 'important');
                  }}
                  onMouseEnter={(e) => {
                    if (document.activeElement === e.currentTarget) return;
                    e.currentTarget.style.setProperty('background-color', '#EEF2FF', 'important');
                    e.currentTarget.style.setProperty('border-color', '#9DB7F1', 'important');
                    e.currentTarget.style.setProperty('box-shadow', 'none', 'important');
                  }}
                  onMouseLeave={(e) => {
                    const focused = document.activeElement === e.currentTarget;
                    e.currentTarget.style.setProperty('background-color', '#FFFFFF', 'important');
                    e.currentTarget.style.setProperty('border-color', focused ? '#6289FF' : '#CBD5E1', 'important');
                    e.currentTarget.style.setProperty('box-shadow', focused ? '0 0 0 4px rgba(98, 137, 255, 0.16)' : 'none', 'important');
                  }}
                  onFocus={(e) => {
                    e.currentTarget.style.setProperty('background-color', '#FFFFFF', 'important');
                    e.currentTarget.style.setProperty('border-color', '#6289FF', 'important');
                    e.currentTarget.style.setProperty('box-shadow', '0 0 0 4px rgba(98, 137, 255, 0.16)', 'important');
                    e.currentTarget.style.setProperty('outline', 'none', 'important');
                  }}
                  onBlur={(e) => {
                    const hovering = e.currentTarget.matches(':hover');
                    e.currentTarget.style.setProperty('background-color', hovering ? '#EEF2FF' : '#FFFFFF', 'important');
                    e.currentTarget.style.setProperty('border-color', hovering ? '#9DB7F1' : '#CBD5E1', 'important');
                    e.currentTarget.style.setProperty('box-shadow', 'none', 'important');
                  }}
                  placeholder="Enter your registered email"
                  required
                  className="w-full pl-9 pr-3 py-2.5 rounded-md border border-[#cfd8e6] text-sm bg-[#fafbfc] focus:outline-none focus:border-[#2f5fd6] focus:ring-2 focus:ring-[#2f5fd6]/15 focus:border-primary transition-colors"
                />
              </div>
            </div>


            <button
              type="submit"
              className="w-full py-2.5 rounded-md font-semibold text-sm"
              style={{
                backgroundColor:
                  "#1a3a7b",
                color: "#fff",
              }}
          >
              Send Verification Code
            </button>

            <button
              type="button"
              onClick={() =>
                switchMode("login")
              }
              className="w-full py-2 text-xs text-muted-foreground transition-colors !bg-white !text-[#17336d] !border-[#cbd5e1] transition-colors hover:!bg-[#eef2ff] hover:!border-[#a8bde4] hover:!text-[#17336d] focus-visible:!ring-0 focus-visible:!shadow-none focus-visible:!outline-none"
             
            onMouseEnter={(e) => {
              const el=e.currentTarget;
              if(!el.dataset.qrpassV158Saved) {
                el.dataset.qrpassV158Saved=el.style.cssText || " ";
              }
              el.style.setProperty("background", "#eef2ff", "important");
              el.style.setProperty("background-color", "#eef2ff", "important");
              el.style.setProperty("background-image", "none", "important");
              el.style.setProperty("color", "#17336d", "important");
              el.style.setProperty("border-color", "#a8bde4", "important");
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onMouseLeave={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onFocus={(e) => {
              e.currentTarget.style.setProperty("box-shadow", "none", "important");
              e.currentTarget.style.setProperty("outline", "none", "important");
            }}
            onBlur={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}

           data-qrpass-neutral-v169="true">
              ← Back to Login
            </button>
          </form>
        </div>
      </PageShell>
    );
  }

  // ==========================================================================
  // VERIFY CODE PAGE
  // ==========================================================================

  if (mode === "verify") {
    return (
      <PageShell><div className="w-full max-w-sm bg-white rounded-xl border border-[#cfd8e6] shadow-md overflow-hidden qrpass-auth-card">

          <div className="bg-primary px-6 py-4">
            <h2
              className="text-white font-bold text-base"
              style={{
                fontFamily:
                  "Barlow, sans-serif",
              }}
            >
              Enter Verification Code
            </h2>

            <p className="text-white/70 text-xs mt-0.5">
              A 6-digit code was sent to{" "}

              <strong>
                {forgotEmail}
              </strong>
            </p>
          </div>

          <form
            onSubmit={
              handleVerifySubmit
            }
            className="p-6 space-y-5"
          >
            <div>
              <label className="block text-xs font-semibold text-foreground mb-3 uppercase tracking-wide text-center">
                6-Digit Code
              </label>

              <div className="flex gap-2 justify-center">
                {codeInputs.map((value, index) => (
  <input
    key={index}
    id={`code-${index}`}
    type="text"
    inputMode="numeric"
    maxLength={1}
    value={value}

    onChange={(e) => {
  const input =
    e.target.value.replace(
      /\D/,
      ""
    );

  const form =
    e.currentTarget.form;

  const next = [
    ...codeInputs,
  ];

  next[index] =
    input;

  setCodeInputs(next);
  setCodeError(false);

  // Move to next box
  if (
    input &&
    index < 5
  ) {
    (
      document.getElementById(
        `code-${index + 1}`
      ) as HTMLInputElement
    )?.focus();
  }

  // Automatically verify after the 6th digit
  if (
    input &&
    index === 5 &&
    next.every(
      (digit) => digit !== ""
    )
  ) {
    setTimeout(() => {
      form?.requestSubmit();
    }, 0);
  }
}}

    onKeyDown={(e) => {
      // ENTER = Verify Code
      if (e.key === "Enter") {
        e.preventDefault();

        e.currentTarget.form?.requestSubmit();

        return;
      }

      // BACKSPACE = previous box
      if (
        e.key === "Backspace" &&
        !codeInputs[index] &&
        index > 0
      ) {
        (
          document.getElementById(
            `code-${index - 1}`
          ) as HTMLInputElement
        )?.focus();
      }
    }}

    className={`w-10 h-12 text-center text-lg font-bold rounded-md border-2 focus:outline-none focus:border-[#2f5fd6] focus:ring-2 focus:ring-[#2f5fd6]/15 transition-colors ${
      codeError
        ? "border-red-400 bg-red-50"
        : "border-[#cfd8e6] bg-[#fafbfc] focus:border-primary"
    }`}
  />
))}
              </div>

              {codeError && (
                <p className="text-center text-xs text-red-500 mt-2">
                  Incorrect code. Please
                  try again.
                </p>
              )}
            </div>

            <button
              type="submit"
              className="w-full py-2.5 rounded-md font-semibold text-sm"
              style={{
                backgroundColor:
                  "#1a3a7b",
                color: "#fff",
              }}
          >
              Verify Code
            </button>

            <div className="text-center space-y-1">
              <p className="text-xs text-muted-foreground">
                Didn{"'"}t receive a
                code?{" "}

                <button
  type="button"
  onClick={async () => {
    try {
      await requestPasswordReset(
        forgotEmail.trim()
      );

      setCodeInputs([
        "",
        "",
        "",
        "",
        "",
        "",
      ]);

      setCodeError(false);

      (
        document.getElementById(
          "code-0"
        ) as HTMLInputElement
      )?.focus();
    } catch (error) {
      alert(
        error instanceof Error
          ? error.message
          : "Unable to resend verification code."
      );
    }
  }}
  className="text-primary font-medium hover:underline"
>
  Resend
</button>
              </p>

              <button
                type="button"
                onClick={() =>
                  switchMode(
                    "forgot"
                  )
                }
                className="text-xs text-muted-foreground hover:text-foreground transition-colors"
              >
                ← Change email
              </button>
            </div>
          </form>
        </div>
      </PageShell>
    );
  }

  // ==========================================================================
  // RESET PASSWORD PAGE
  // ==========================================================================

  if (mode === "reset") {
    return (
      <PageShell>
        <div className="flex flex-col items-center mb-6 qrpass-auth-logo">
          <QRpassLogo
            size={72}
            showText
          />
        </div>

        <div className="w-full max-w-sm bg-white rounded-xl border border-[#cfd8e6] shadow-md overflow-hidden qrpass-auth-card">
          <div className="bg-primary px-6 py-4">
            <h2
              className="text-white font-bold text-base"
              style={{
                fontFamily:
                  "Barlow, sans-serif",
              }}
            >
              Set New Password
            </h2>

            <p className="text-white/70 text-xs mt-0.5">
              Choose a strong new password
              for your account.
            </p>
          </div>

          <form
            onSubmit={
              handleResetSubmit
            }
            className="p-6 space-y-4"
          >
            {/* NEW PASSWORD */}
            <div>
              <label className="block text-xs font-semibold text-foreground mb-1.5 uppercase tracking-wide">
                New Password
              </label>

              <div className="relative">
                <Lock
                  size={15}
                  className="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground"
                />

                <input
                  type="password"
                  value={newPass}
                  onChange={(e) =>
                    setNewPass(
                      e.target.value
                    )
                  }
                  placeholder="Enter new password"
                  required
                  className="w-full pl-9 pr-3 py-2.5 rounded-md border border-[#cfd8e6] text-sm bg-[#fafbfc] focus:outline-none focus:border-[#2f5fd6] focus:ring-2 focus:ring-[#2f5fd6]/15 focus:border-primary transition-colors"
                />
              </div>
            </div>

            {/* CONFIRM */}
            <div>
              <label className="block text-xs font-semibold text-foreground mb-1.5 uppercase tracking-wide">
                Confirm New Password
              </label>

              <div className="relative">
                <Lock
                  size={15}
                  className="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground"
                />

                <input
                  type="password"
                  value={confirmPass}
                  onChange={(e) =>
                    setConfirmPass(
                      e.target.value
                    )
                  }
                  placeholder="Confirm new password"
                  required
                  className="w-full pl-9 pr-3 py-2.5 rounded-md border border-[#cfd8e6] text-sm bg-[#fafbfc] focus:outline-none focus:border-[#2f5fd6] focus:ring-2 focus:ring-[#2f5fd6]/15 focus:border-primary transition-colors"
                />
              </div>
            </div>

            {confirmPass &&
              newPass !==
                confirmPass && (
                <p className="text-xs text-red-500">
                  Passwords do not match.
                </p>
              )}

            <button
              type="submit"
              disabled={
                !newPass ||
                newPass !== confirmPass
              }
              className="w-full py-2.5 rounded-md font-semibold text-sm disabled:opacity-40 disabled:cursor-not-allowed"
              style={{
                backgroundColor:
                  "#1a3a7b",
                color: "#fff",
              }}
          >
              Change Password
            </button>
          </form>
        </div>
      </PageShell>
    );
  }

  // ==========================================================================
  // RESET COMPLETE PAGE
  // ==========================================================================

  if (mode === "reset-done") {
    return (
      <PageShell>
        <div className="w-full max-w-sm bg-white rounded-xl border border-[#cfd8e6] shadow-md p-10 flex flex-col items-center gap-4 qrpass-auth-card">
          <div className="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center">
            <CheckCircle
              size={32}
              className="text-green-500"
            />
          </div>

          <div className="text-center">
            <h3
              className="font-bold text-foreground text-base"
              style={{
                fontFamily:
                  "Barlow, sans-serif",
              }}
            >
              Password Changed!
            </h3>

            <p className="text-xs text-muted-foreground mt-1">
              Your password has been
              updated successfully. You
              can now log in using your
              new password.
            </p>
          </div>

          <button
            type="button"
            onClick={() =>
              switchMode("login")
            }
            className="text-xs bg-primary text-white px-5 py-2 rounded-md font-semibold !bg-white !text-[#17336d] !border-[#cbd5e1] transition-colors hover:!bg-[#eef2ff] hover:!border-[#a8bde4] hover:!text-[#17336d] focus-visible:!ring-0 focus-visible:!shadow-none focus-visible:!outline-none"
           
            onMouseEnter={(e) => {
              const el=e.currentTarget;
              if(!el.dataset.qrpassV158Saved) {
                el.dataset.qrpassV158Saved=el.style.cssText || " ";
              }
              el.style.setProperty("background", "#eef2ff", "important");
              el.style.setProperty("background-color", "#eef2ff", "important");
              el.style.setProperty("background-image", "none", "important");
              el.style.setProperty("color", "#17336d", "important");
              el.style.setProperty("border-color", "#a8bde4", "important");
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onMouseLeave={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onFocus={(e) => {
              e.currentTarget.style.setProperty("box-shadow", "none", "important");
              e.currentTarget.style.setProperty("outline", "none", "important");
            }}
            onBlur={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}

           data-qrpass-neutral-v169="true">
            Back to Login
          </button>
        </div>
      </PageShell>
    );
  }

  // ==========================================================================
  // LOGIN PAGE
  // ==========================================================================

  return (
    <div
      className="min-h-screen flex flex-col qrpass-login-viewport"
      style={{
        fontFamily:
          "Inter, sans-serif",
        background: "#f6f8fb",
      }}
    >
      {/* Keep the sign-in page fixed within a desktop viewport. Small screens can scroll. */}
      <style>{`
        /* QRPASS LOGIN LAYOUT CLEAN V11 - single source of truth */
        .qrpass-login-viewport {
          width: 100%;
          min-height: 100dvh;
          display: flex;
          flex-direction: column;
          box-sizing: border-box;
        }
        .qrpass-login-body {
          width: 100%;
          min-width: 0;
          min-height: 0;
          flex: 1 1 auto;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 24px;
          /* Final QRPass login background selected by the project team. */
          background-color: #f4f7fc;
          background-image: url("/qrpass-login-background.png");
          background-position: center center;
          background-repeat: no-repeat;
          background-size: cover;
        }
        .qrpass-login-card {
          width: 100% !important;
          max-width: 400px !important;
          min-width: 0;
          min-height: 0 !important;
          height: auto !important;
          flex: 0 0 auto;
          overflow: hidden;
          border-radius: 20px !important;
          box-shadow: 0 18px 42px rgba(23, 55, 113, 0.11) !important;
        }
        .qrpass-login-card > .qrpass-login-card-content {
          padding: 27px 29px 23px !important;
          display: flex;
          flex-direction: column;
          justify-content: center;
        }
        .qrpass-login-form {
          display: flex;
          flex-direction: column;
          gap: 18px !important;
          margin: 0;
        }
        .qrpass-login-form > * + * {
          margin-top: 0 !important;
        }
        .qrpass-login-card-logo {
          width: 100%;
          display: flex;
          align-items: center;
          justify-content: center;
          margin: 0 0 -8px !important;
        }
        .qrpass-login-card-logo img {
          width: 96px !important;
          max-width: 100%;
          height: auto !important;
          object-fit: contain;
        }
        .qrpass-login-form > .qrpass-login-card-logo + div {
          margin: 0 0 3px !important;
          text-align: center;
        }
        .qrpass-login-form h2 {
          font-size: 27px !important;
          line-height: 1.2 !important;
          font-weight: 700 !important;
          letter-spacing: -0.025em;
        }
        .qrpass-login-form label { margin-bottom: 8px !important; }
        .qrpass-login-form input[type="text"],
        .qrpass-login-form input[type="password"] {
          height: 50px !important;
          font-size: 15px !important;
          border-radius: 14px;
        }
        .qrpass-login-form button[type="submit"] {
          height: 50px !important;
          font-size: 16px !important;
          border-radius: 14px;
        }
        .qrpass-login-card-content > div:last-child {
          margin-top: 19px !important;
          padding-top: 16px !important;
        }
        .qrpass-login-viewport > .flex.h-2 {
          height: 5px !important;
          background: linear-gradient(90deg, #173b7a, #3563c8, #7c9cf6) !important;
        }
        .qrpass-login-viewport > .flex.h-2 > div {
          background: transparent !important;
        }
        /* Keep the desktop sign-in visible and centered at normal zoom. */
        @media (min-width: 768px) and (min-height: 700px) {
          .qrpass-login-viewport {
            position: fixed;
            inset: 0;
            height: 100dvh;
            min-height: 0;
            max-height: 100dvh;
            overflow: hidden;
          }
          .qrpass-login-body {
            flex: 1 1 0;
            overflow-y: auto;
            padding: 16px 24px;
          }
          .qrpass-login-card {
            min-height: min(560px, calc(100dvh - 135px)) !important;
          }
        }
        /* At high zoom or short windows, prioritize usable inputs over hiding content. */
        @media (min-width: 768px) and (max-height: 699px) {
          .qrpass-login-viewport {
            position: relative;
            height: auto;
            max-height: none;
            min-height: 100dvh;
            overflow: visible;
          }
          .qrpass-login-body { padding: 24px 20px; }
        }
        /* Mobile: leave comfortable spacing at both screen edges. */
        @media (max-width: 767px) {
          .qrpass-login-viewport {
            position: relative;
            inset: auto;
            height: auto;
            min-height: 100dvh;
            max-height: none;
            overflow: visible;
          }
          .qrpass-login-body {
            min-height: 0;
            padding: 22px clamp(18px, 6vw, 28px) 26px !important;
          }
          .qrpass-login-card {
            width: 100% !important;
            max-width: 370px !important;
            min-height: 0 !important;
            border-radius: 19px !important;
          }
          .qrpass-login-card > .qrpass-login-card-content {
            padding: 22px 21px 20px !important;
          }
          .qrpass-login-form { gap: 15px !important; }
          .qrpass-login-card-logo { margin-bottom: -6px !important; }
          .qrpass-login-card-logo img { width: 90px !important; }
          .qrpass-login-form h2 { font-size: 24px !important; }
          .qrpass-login-form input[type="text"],
          .qrpass-login-form input[type="password"],
          .qrpass-login-form button[type="submit"] { height: 47px !important; }
          .qrpass-login-card-content > div:last-child {
            margin-top: 16px !important;
            padding-top: 13px !important;
          }
        }
        @media (max-width: 360px) {
          .qrpass-login-body { padding-left: 16px !important; padding-right: 16px !important; }
          .qrpass-login-card > .qrpass-login-card-content {
            padding-left: 18px !important;
            padding-right: 18px !important;
          }
          .qrpass-login-form { gap: 13px !important; }
        }
        /* MOBILE LOGIN REFINEMENT — keeps desktop layout and all auth logic unchanged. */
        @media (max-width: 767px) {
          .qrpass-login-viewport {
            min-height: 100svh;
            min-height: 100dvh;
            overflow-x: hidden;
          }
          .qrpass-login-body {
            box-sizing: border-box;
            min-height: calc(100svh - 11px);
            min-height: calc(100dvh - 11px);
            padding: max(16px, env(safe-area-inset-top)) clamp(14px, 5vw, 22px) max(20px, env(safe-area-inset-bottom)) !important;
            background-attachment: scroll;
            background-position: center center;
          }
          .qrpass-login-card {
            width: 100% !important;
            max-width: 370px !important;
            margin-inline: auto;
            box-sizing: border-box;
          }
          .qrpass-login-form input[type="text"],
          .qrpass-login-form input[type="password"] {
            box-sizing: border-box;
            width: 100%;
            min-width: 0;
            max-width: 100%;
            font-size: 16px !important; /* Stops iOS auto-zoom on focus. */
          }
          .qrpass-login-form button,
          .qrpass-login-card-content button {
            touch-action: manipulation;
          }
          .qrpass-login-form > .flex.items-center.justify-between {
            flex-wrap: wrap; /* Keep Remember me + Forgot Password from overlapping. */
            row-gap: 8px;
          }
          .qrpass-login-form > .flex.items-center.justify-between > button {
            white-space: nowrap;
          }
        }
        /* Compact phones (320–380 px): preserve readable inputs and tap targets. */
        @media (max-width: 380px) {
          .qrpass-login-card > .qrpass-login-card-content {
            padding: 18px 17px 17px !important;
          }
          .qrpass-login-form { gap: 13px !important; }
          .qrpass-login-card-logo img { width: 82px !important; }
          .qrpass-login-form h2 { font-size: 23px !important; }
          .qrpass-login-card-content > div:last-child {
            margin-top: 14px !important;
            padding-top: 12px !important;
          }
        }
        /* Short displays and landscape phones: allow vertical scrolling, no clipped buttons. */
        @media (max-width: 767px) and (max-height: 660px) {
          .qrpass-login-body {
            justify-content: flex-start;
            padding-top: 16px !important;
            padding-bottom: 20px !important;
          }
        }
        @media (max-width: 767px) and (orientation: landscape) {
          .qrpass-login-body {
            justify-content: flex-start;
            padding-top: 12px !important;
            padding-bottom: 18px !important;
          }
        }
        @media (max-height: 610px) {
          .qrpass-login-body { justify-content: flex-start; }
        }
`}</style>


      


      <div className="flex-1 flex flex-col items-center justify-center px-4 py-10 qrpass-login-body">



        {/* LOGIN CARD */}
        <div
          className="relative w-full max-w-[430px] overflow-hidden rounded-[20px] border border-[#d7e0ee] bg-white shadow-[0_16px_40px_rgba(30,58,110,0.12)] qrpass-login-card"
        >
          {/* BLUE TOP ACCENT */}
          <div className="h-1 w-full bg-gradient-to-r from-[#173b7a] via-[#2f5fd6] to-[#7fa1ff]" />

          <div className="px-8 pb-8 pt-7 sm:px-9 qrpass-login-card-content">
            <form
              onSubmit={handleLogin}
              className="space-y-5 qrpass-login-form"
            >
              {/* QRPass logo inside the white login card */}
              {/* v75: real shield-only PNG, extracted from original asset (no CSS cropping) */}
              <div className="flex items-center justify-center qrpass-login-card-logo qrpass-shield-only-v75" style={{ marginBottom: 2 }}>
                <img src="/qrpass-shield-only.png" alt="QRPass shield" style={{ width: 61, height: "auto", objectFit: "contain" }} />
              </div>
              <style>{`
                #root .qrpass-login-card-logo.qrpass-shield-only-v75 {
                  min-height: 64px !important;
                  margin: 0 auto 1px !important;
                  display: flex !important;
                  justify-content: center !important;
                  align-items: center !important;
                }
                #root .qrpass-login-card-logo.qrpass-shield-only-v75 img {
                  display: block !important;
                  width: 61px !important;
                  height: auto !important;
                  max-width: 61px !important;
                  position: static !important;
                  transform: none !important;
                  object-fit: contain !important;
                }
                @media (max-width: 380px) {
                  #root .qrpass-login-card-logo.qrpass-shield-only-v75 img {
                    width: 56px !important;
                    max-width: 56px !important;
                  }
                }
              `}</style>

              {/* LOGIN HEADING */}
              <div className="mb-1 text-center qrpass-welcome-v71">
                <h2
                  className="text-[26px] sm:text-[28px] font-bold leading-tight text-[#17336d]"
                  style={{ fontFamily: "Barlow, sans-serif", letterSpacing: "-0.025em" }}
                >
                  Log in to QRpass
                </h2>
              </div>

              {/* USERNAME */}
              <div>
                <label className="mb-2 block text-[12px] font-bold uppercase tracking-[0.06em] text-[#17336d]">
                  ID NUMBER
                </label>

                <div className="relative">
                  <User
                    size={18}
                    className="absolute left-4 top-1/2 -translate-y-1/2 text-[#7186b5]"
                  />

                  <input
                    type="text" pattern="[0-9]*" inputMode="numeric"
                    value={username}
                    onChange={(e) => {
                      setUsername(
                        e.target.value.replace(/[^0-9]/g, "")
                      );

                      if (loginError) {
                        setLoginError("");
                      }
                    }}
                    placeholder="Enter your ID number"
                    required
                    autoComplete="username"
                    disabled={isLoggingIn}
                    className="h-[52px] w-full rounded-xl border border-transparent bg-[#edf3ff] pl-12 pr-4 text-[15px] text-[#172033] outline-none transition-all placeholder:text-[#7c8596] focus:border-[#2f5fd6] focus:bg-white focus:ring-4 focus:ring-[#2f5fd6]/10 disabled:cursor-not-allowed disabled:opacity-60"
                  />
                </div>
              </div>

              {/* PASSWORD */}
              <div>
                <label className="mb-2 block text-[12px] font-bold uppercase tracking-[0.06em] text-[#17336d]">
                  PASSWORD
                </label>

                <div className="relative">
                  <Lock
                    size={18}
                    className="absolute left-4 top-1/2 -translate-y-1/2 text-[#7186b5]"
                  />

                  <input
                    type={
                      showPassword
                        ? "text"
                        : "password"
                    }
                    value={password}
                    onChange={(e) => {
                      setPassword(
                        e.target.value
                      );

                      if (loginError) {
                        setLoginError("");
                      }
                    }}
                    placeholder="Enter your password"
                    required
                    autoComplete="current-password"
                    disabled={isLoggingIn}
                    className="h-[52px] w-full rounded-xl border border-transparent bg-[#edf3ff] pl-12 pr-12 text-[15px] text-[#172033] outline-none transition-all placeholder:text-[#7c8596] focus:border-[#2f5fd6] focus:bg-white focus:ring-4 focus:ring-[#2f5fd6]/10 disabled:cursor-not-allowed disabled:opacity-60"
                  />

                  {/* SHOW / HIDE PASSWORD */}
                  <button
                    type="button"
                    onClick={() =>
                      setShowPassword(
                        (current) =>
                          !current
                      )
                    }
                    disabled={isLoggingIn}
                    className="absolute right-4 top-1/2 -translate-y-1/2 text-[#7186b5] transition-colors hover:text-[#2f5fd6] disabled:opacity-50"
                    aria-label={
                      showPassword
                        ? "Hide password"
                        : "Show password"
                    }
                    title={
                      showPassword
                        ? "Hide password"
                        : "Show password"
                    }
                  >
                    {showPassword ? (
                      <EyeOff size={18} />
                    ) : (
                      <Eye size={18} />
                    )}
                  </button>
                </div>
              </div>

              {/* REMEMBER ME + FORGOT PASSWORD */}
              <div className="flex items-center justify-between gap-3">
                <label className="flex cursor-pointer select-none items-center gap-2 text-[13px] text-[#5e6f8f]">
                  <input
                    type="checkbox"
                    checked={rememberMe}
                    onChange={(e) => {
                      const checked =
                        e.target.checked;

                      setRememberMe(
                        checked
                      );

                      if (!checked) {
                        localStorage.removeItem(
                          "qrpass-remembered-id"
                        );
                      }
                    }}
                    disabled={isLoggingIn}
                    className="h-[17px] w-[17px] rounded border-[#aebbd0] accent-[#1a3a7b] disabled:opacity-50"
                  />

                  <span>Remember me</span>
                </label>

                <button
                  type="button"
                  onClick={() =>
                    switchMode(
                      "forgot"
                    )
                  }
                  disabled={isLoggingIn}
                  className="text-[13px] font-semibold text-[#2f5fd6] transition-colors hover:text-[#173b7a] hover:underline disabled:opacity-50"
                >
                  Forgot Password?
                </button>
              </div>

              {/* LOGIN ERROR */}
              {loginError && (
                <div
                  role="alert"
                  className="flex items-start gap-2 rounded-xl border border-red-200 bg-red-50 px-4 py-3"
                >
                  <AlertCircle
                    size={16}
                    className="mt-0.5 flex-shrink-0 text-red-600"
                  />

                  <p className="text-[13px] leading-relaxed text-red-700">
                    {loginError}
                  </p>
                </div>
              )}

              {/* LOGIN BUTTON */}
              <button data-qrpass-blue-v173="login-submit"
                type="submit"
                disabled={isLoggingIn}
                className="flex h-[50px] w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#214a96] to-[#123873] text-[15px] font-bold text-white shadow-[0_8px_18px_rgba(26,58,123,0.22)] transition-all duration-150 hover:-translate-y-[1px] hover:shadow-[0_10px_22px_rgba(26,58,123,0.28)] active:translate-y-0 disabled:cursor-not-allowed disabled:opacity-60 transition-colors hover:!bg-[#eef2ff] hover:!text-[#17336d] hover:!border-[#a8bde4] focus-visible:!ring-0 focus-visible:!shadow-none"
          >
                {isLoggingIn ? (
                  <>
                    <RefreshCw
                      size={16}
                      className="animate-spin"
                    />

                    Signing in...
                  </>
                ) : (
                  "Log In"
                )}
              </button>

              </form>

            {/* REGISTER */}
            <div className="mt-5 border-t border-[#d8e1ee] pt-5 text-center">
              <p className="text-[13px] text-[#6b7b98]">
                Don{"'"}t have an account?{" "}

                <button
                  type="button"
                  onClick={() =>
                    switchMode(
                      "register"
                    )
                  }
                  className="font-bold text-[#2f5fd6] transition-colors hover:text-[#173b7a] hover:underline"
                >
                  Register here
                </button>
              </p>
            </div>
          </div>
        </div>

      </div>


    </div>
  );
}


// ── Dashboard layout ──────────────────────────────────────────────────────────
function Dashboard({
  role,
  onLogout,
}: {
  role: Role;
  onLogout: () => void;
}) {
  const navItems = NAV[role];
  const pages = PAGES[role];
  const [footerBrand, setFooterBrand] = useState(() => {
    try {
      const stored = localStorage.getItem("qrpass-footer-brand");
      if (stored) {
        const parsed = JSON.parse(stored);
        return { institution: String(parsed.institution || "University of Cebu"), system_name: String(parsed.system_name || "QRpass") };
      }
    } catch { /* use defaults */ }
    return { institution: "University of Cebu", system_name: "QRpass" };
  });
  useEffect(() => {
    let mounted = true;
    const refreshBrand = async () => {
      try {
        const response = await getSystemSettings();
        if (mounted && response?.settings) {
          const brand = {
            institution: String(response.settings.institution || "University of Cebu"),
            system_name: String(response.settings.system_name || "QRpass"),
          };
          document.title = brand.system_name;
          document.title = brand.system_name;
          setFooterBrand(brand);
          localStorage.setItem("qrpass-footer-brand", JSON.stringify(brand));
        }
      } catch (err) { console.warn("Footer branding unavailable:", err); }
    };
    refreshBrand();
    window.addEventListener("qrpass-settings-updated", refreshBrand);
    return () => { mounted = false; window.removeEventListener("qrpass-settings-updated", refreshBrand); };
  }, []);

  const [csuManagerOpenV147, setCsuManagerOpenV147] = useState(false);
  const [qrpassPageManageType, setQrpassPageManageType] = useState<'items'|'lost-found'|'users'|'choose'|null>(null);
  const [activeNav, setActiveNav] = useState<number>(() => {
    try {
      const user = JSON.parse(localStorage.getItem("user") || "null");
      const userId = String(user?.id ?? user?.username ?? "");

      if (!userId) return 0;

      const saved = JSON.parse(
        sessionStorage.getItem("qrpass-active-page-v1") || "null"
      );

      if (!saved || saved.userId !== userId || saved.role !== role) {
        return 0;
      }

      const index = navItems.findIndex(
        item => item.label === saved.label
      );

      return (index >= 0 && index < pages.length ? index : 0);
    } catch {
      return 0;
    }
  });

  // Remember the last selected sidebar page for this user.
  useEffect(() => {
    try {
      const user = JSON.parse(localStorage.getItem("user") || "null");
      const userId = String(user?.id ?? user?.username ?? "");
      const page = navItems[activeNav];

      if (!userId || !page) return;

      sessionStorage.setItem(
        "qrpass-active-page-v1",
        JSON.stringify({
          userId,
          role,
          label: page.label
        })
      );
    } catch {
      // Storage unavailable; navigation still works normally.
    }
  }, [activeNav, role]);

  const [isMobile, setIsMobile] =
    useState(window.innerWidth < 768);

  const [sidebarOpen, setSidebarOpen] =
    useState(window.innerWidth >= 768);

  // =========================================================
  // DARK MODE
  // =========================================================

  const [darkMode, setDarkMode] =
    useState(() => {
      const savedTheme =
        localStorage.getItem("qrpass-theme");

      return savedTheme === "dark";
    });

  useEffect(() => {
    const root = document.documentElement;

    root.classList.toggle("dark", darkMode);

    localStorage.setItem(
      "qrpass-theme",
      darkMode ? "dark" : "light"
    );

    // Dashboard-only dark mode: restore the normal light theme on logout.
    return () => {
      root.classList.remove("dark");
    };
  }, [darkMode]);

  // =========================================================
  // HEADER MENUS
  // =========================================================

  const [notificationOpen, setNotificationOpen] =
    useState(false);

  const [accountOpen, setAccountOpen] =
    useState(false);

  const [accountSettingsOpen, setAccountSettingsOpen] =
    useState(false);

    const [changePasswordOpen, setChangePasswordOpen] =
  useState(false);

  const [currentPassword, setCurrentPassword] =
    useState("");

  const [newPassword, setNewPassword] =
    useState("");

  const [confirmPassword, setConfirmPassword] =
    useState("");

  const [changingPassword, setChangingPassword] =
    useState(false);

  const [passwordMessage, setPasswordMessage] =
    useState("");

  const [profileName, setProfileName] =
    useState("");

  const [profileEmail, setProfileEmail] =
    useState("");

  const [savingProfile, setSavingProfile] =
    useState(false);

  const [profileMessage, setProfileMessage] =
    useState("");

    const [uploadingProfilePhoto, setUploadingProfilePhoto] =
  useState(false);
  // =========================================================
  // NOTIFICATIONS
  // =========================================================

  const [headerNotifications, setHeaderNotifications] =
    useState<any[]>([]);

  const [notificationsLoading, setNotificationsLoading] =
    useState(false);

  const [
    markingNotificationId,
    setMarkingNotificationId,
  ] = useState<number | null>(null);

  const [
    markingAllNotifications,
    setMarkingAllNotifications,
  ] = useState(false);

  const [notificationFilter, setNotificationFilter] =
  useState<"all" | "unread" | "read">("unread");

  // CURRENT USER
  // =========================================================

  const [currentUser, setCurrentUser] = useState<any>(() => {
    try {
      const savedUser =
        localStorage.getItem("user");

      return savedUser
        ? JSON.parse(savedUser)
        : null;
    } catch {
      return null;
    }
  });

  // LOAD LATEST ACCOUNT DATA
// =========================================================

useEffect(() => {
  let cancelled = false;

  const loadAccountData = async () => {
    try {
      const data = await getAccount();

      if (cancelled) {
        return;
      }

      if (data?.user) {
        setCurrentUser(data.user);

        localStorage.setItem(
          "user",
          JSON.stringify(data.user)
        );
      }
    } catch (error) {
      console.error(
        "Failed to load account information:",
        error
      );
    }
  };

  loadAccountData();

  return () => {
    cancelled = true;
  };
}, [role]);

  // Keep the editable profile fields in sync with the
  // current user loaded from the backend.
  useEffect(() => {
    if (accountSettingsOpen && currentUser) {
      setProfileName(currentUser.name ?? "");
      setProfileEmail(currentUser.email ?? "");
      setProfileMessage("");
    }
  }, [accountSettingsOpen, currentUser]);
const handleProfilePhotoUpload = async (
  event: React.ChangeEvent<HTMLInputElement>
) => {
  const file = event.target.files?.[0];

  if (!file) {
    return;
  }

  try {
    setUploadingProfilePhoto(true);
    setProfileMessage("");

    const data =
      await uploadAccountProfilePhoto(file);

    const updatedUser = {
      ...currentUser,
      profile_photo: data.profile_photo,
      profile_photo_url: data.profile_photo_url,
    };

    setCurrentUser(updatedUser);

    localStorage.setItem(
      "user",
      JSON.stringify(updatedUser)
    );

    setProfileMessage(
      data.message ||
        "Profile photo updated successfully."
    );
  } catch (error: any) {
    setProfileMessage(
      error?.errors?.profile_photo?.[0] ||
        error?.message ||
        "Failed to upload profile photo."
    );
  } finally {
    setUploadingProfilePhoto(false);

    // Allows selecting the same image again later.
    event.target.value = "";
  }
};

const handleRemoveProfilePhoto = async () => {
  if (!currentUser?.profile_photo_url) {
    return;
  }

  const confirmed = window.confirm(
    "Remove your current profile photo?"
  );

  if (!confirmed) {
    return;
  }

  try {
    setUploadingProfilePhoto(true);
    setProfileMessage("");

    const data = await removeAccountProfilePhoto();

    const updatedUser =
      data?.user ?? {
        ...currentUser,
        profile_photo:
          data?.profile_photo ?? null,
        profile_photo_url:
          data?.profile_photo_url ?? null,
      };

    setCurrentUser(updatedUser);

    localStorage.setItem(
      "user",
      JSON.stringify(updatedUser)
    );

    setProfileMessage(
      data?.message ||
        "Profile photo removed successfully."
    );
  } catch (error: any) {
    setProfileMessage(
      error?.message ||
        "Failed to remove profile photo."
    );
  } finally {
    setUploadingProfilePhoto(false);
  }
};


// =========================================================
// CHANGE PASSWORD
// =========================================================

const handleChangePassword = async () => {
  if (!currentPassword.trim()) {
    setPasswordMessage(
      "Please enter your current password."
    );
    return;
  }

  if (newPassword.length < 8) {
    setPasswordMessage(
      "New password must be at least 8 characters."
    );
    return;
  }

  if (newPassword !== confirmPassword) {
    setPasswordMessage(
      "New password and confirmation do not match."
    );
    return;
  }

  try {
    setChangingPassword(true);
    setPasswordMessage("");

    const data = await updateAccountPassword({
      current_password: currentPassword,
      password: newPassword,
      password_confirmation: confirmPassword,
    });

    setPasswordMessage(
      data.message ||
        "Password changed successfully."
    );

    setCurrentPassword("");
    setNewPassword("");
    setConfirmPassword("");

    setTimeout(() => {
      setChangePasswordOpen(false);
      setPasswordMessage("");
    }, 1200);
  } catch (error: any) {
    setPasswordMessage(
      error?.errors?.current_password?.[0] ||
        error?.errors?.password?.[0] ||
        error?.message ||
        "Failed to change password."
    );
  } finally {
    setChangingPassword(false);
  }
};


const handleSaveAccountProfile = async () => {
  try {
    setSavingProfile(true);
    setProfileMessage("");

    const data = await updateAccountProfile({
      name: profileName.trim(),
      email: profileEmail.trim(),
    });

    if (data.user) {
      setCurrentUser(data.user);

      localStorage.setItem(
        "user",
        JSON.stringify(data.user)
      );
    }

    setProfileMessage(
      data.message ||
        "Account information updated successfully."
    );

    // SUCCESS POPUP
    window.alert("Saved Changes");

  } catch (error: any) {
    setProfileMessage(
      error?.errors?.email?.[0] ||
        error?.errors?.name?.[0] ||
        error?.message ||
        "Failed to update account."
    );
  } finally {
    setSavingProfile(false);
  }
};

  const roleInfo =
    ROLES.find((r) => r.id === role)!;

  const ActivePage =
    pages[activeNav] ?? pages[0];

  // =========================================================
  // RESPONSIVE SIDEBAR
  // =========================================================

  useEffect(() => {
    const handler = () => {
      const mobile =
        window.innerWidth < 768;

      setIsMobile(mobile);

      if (!mobile) { setSidebarOpen(true); } else { setSidebarOpen(false); }
    };

    window.addEventListener(
      "resize",
      handler
    );

    return () => {
      window.removeEventListener(
        "resize",
        handler
      );
    };
  }, []);

  // =========================================================
  // LOAD HEADER NOTIFICATIONS
  // =========================================================

  async function loadHeaderNotifications(
    showLoading = true
  ) {
    try {
      if (showLoading) {
        setNotificationsLoading(true);
      }

      const data =
        await getNotifications();

      setHeaderNotifications(
        Array.isArray(
          data?.notifications
        )
          ? data.notifications
          : []
      );
    } catch (error) {
      console.error(
        "Failed to load notifications:",
        error
      );
    } finally {
      if (showLoading) {
        setNotificationsLoading(false);
      }
    }
  }

  useEffect(() => {
    /*
    |--------------------------------------------------------------------------
    | INITIAL LOAD
    |--------------------------------------------------------------------------
    */

    loadHeaderNotifications(true);

    /*
    |--------------------------------------------------------------------------
    | AUTOMATIC REFRESH
    |--------------------------------------------------------------------------
    */

    const notificationInterval =
      window.setInterval(
        () => {
          loadHeaderNotifications(
            false
          );
        },
        15000
      );

    /*
    |--------------------------------------------------------------------------
    | REFRESH WHEN USER RETURNS TO WINDOW / TAB
    |--------------------------------------------------------------------------
    */

    const handleWindowFocus =
      () => {
        loadHeaderNotifications(
          false
        );
      };

    const handleVisibilityChange =
      () => {
        if (
          document.visibilityState ===
          "visible"
        ) {
          loadHeaderNotifications(
            false
          );
        }
      };

    window.addEventListener(
      "focus",
      handleWindowFocus
    );

    document.addEventListener(
      "visibilitychange",
      handleVisibilityChange
    );

    return () => {
      window.clearInterval(
        notificationInterval
      );

      window.removeEventListener(
        "focus",
        handleWindowFocus
      );

      document.removeEventListener(
        "visibilitychange",
        handleVisibilityChange
      );
    };
  }, [role]);

  const unreadNotificationCount =
    headerNotifications.filter(
      (notification) =>
        !notification.is_read
    ).length;

  const readNotificationCount =
    headerNotifications.length -
    unreadNotificationCount;

  const filteredHeaderNotifications =
    headerNotifications.filter(
      (notification) => {
        if (
          notificationFilter ===
          "unread"
        ) {
          return !notification.is_read;
        }

        if (
          notificationFilter ===
          "read"
        ) {
          return Boolean(
            notification.is_read
          );
        }

        return true;
      }
    );

  // =========================================================
  // MARK SINGLE NOTIFICATION READ
  // =========================================================

  async function handleHeaderMarkRead(
  id: number
) {
  try {
    setMarkingNotificationId(id);

    await markNotificationRead(id);

    setHeaderNotifications(
      (previous) =>
        previous.map(
          (notification) =>
            notification.id === id
              ? {
                  ...notification,
                  is_read: true,
                  read_at:
                    notification.read_at ??
                    new Date().toISOString(),
                }
              : notification
        )
    );

    // After viewing/reading a notification,
    // return the bell dropdown to unread notifications.
    // The notification will disappear from the current list.
    setNotificationFilter("unread");

  } catch (error) {
    console.error(
      "Failed to mark notification as read:",
      error
    );
  } finally {
    setMarkingNotificationId(null);
  }
}

  // =========================================================
  // MARK ALL NOTIFICATIONS READ
  // =========================================================

  async function handleHeaderMarkAllRead() {
    if (
      unreadNotificationCount === 0
    ) {
      return;
    }

    try {
      setMarkingAllNotifications(true);

      await markAllNotificationsRead();

      setHeaderNotifications(
        (previous) =>
          previous.map(
            (notification) => ({
              ...notification,

              is_read: true,

              read_at:
                notification.read_at ??
                new Date().toISOString(),
            })
          )
      );
    } catch (error) {
      console.error(
        "Failed to mark all notifications as read:",
        error
      );
    } finally {
      setMarkingAllNotifications(false);
    }
  }

  // =========================================================
  // DATE FORMATTER
  // =========================================================

  function formatNotificationDate(
    value:
      | string
      | null
      | undefined
  ) {
    if (!value) {
      return "";
    }

    const date =
      new Date(value);

    if (
      Number.isNaN(
        date.getTime()
      )
    ) {
      return "";
    }

    return date.toLocaleString(
      "en-PH",
      {
        month: "short",
        day: "numeric",
        year: "numeric",
        hour: "numeric",
        minute: "2-digit",
      }
    );
  }


  // =========================================================
  // NOTIFICATION DISPLAY HELPERS
  // =========================================================

  function getNotificationStyle(
    type:
      | string
      | null
      | undefined
  ) {
    const normalizedType =
      String(type ?? "")
        .toLowerCase();

    /*
    |--------------------------------------------------------------------------
    | ITEM REGISTRATION / REQUESTS
    |--------------------------------------------------------------------------
    */

    if (
      normalizedType ===
        "new_item_registration" ||
      normalizedType.includes(
        "admin_item_registration"
      )
    ) {
      return {
        card:
          "bg-yellow-50 border-yellow-200 dark:bg-yellow-500/10 dark:border-yellow-400/20",
        icon:
          "bg-yellow-100 text-yellow-700 dark:bg-yellow-500/15 dark:text-yellow-300",
        badge:
          "bg-yellow-100 text-yellow-700 dark:bg-yellow-500/15 dark:text-yellow-300",
      };
    }

    /*
    |--------------------------------------------------------------------------
    | APPROVED ITEMS / QR READY
    |--------------------------------------------------------------------------
    */

    if (
      normalizedType ===
        "item_approved" ||
      normalizedType.includes(
        "admin_item_approved"
      ) ||
      normalizedType.includes(
        "security_item_ready"
      )
    ) {
      return {
        card:
          "bg-green-50 border-green-200 dark:bg-emerald-500/10 dark:border-emerald-400/20",
        icon:
          "bg-green-100 text-green-700 dark:bg-emerald-500/15 dark:text-emerald-300",
        badge:
          "bg-green-100 text-green-700 dark:bg-emerald-500/15 dark:text-emerald-300",
      };
    }

    /*
    |--------------------------------------------------------------------------
    | STUDENT SUBMISSION
    |--------------------------------------------------------------------------
    */

    if (
      normalizedType ===
      "item_submitted"
    ) {
      return {
        card:
          "bg-blue-50 border-blue-200 dark:bg-blue-500/10 dark:border-blue-400/20",
        icon:
          "bg-blue-100 text-blue-700 dark:bg-blue-500/15 dark:text-blue-300",
        badge:
          "bg-blue-100 text-blue-700 dark:bg-blue-500/15 dark:text-blue-300",
      };
    }

    /*
    |--------------------------------------------------------------------------
    | LOST & FOUND
    |--------------------------------------------------------------------------
    */

    if (
      normalizedType.includes(
        "lost_found"
      ) ||
      normalizedType.includes(
        "lost"
      ) ||
      normalizedType.includes(
        "found"
      )
    ) {
      return {
        card:
          "bg-purple-50 border-purple-200 dark:bg-purple-500/10 dark:border-purple-400/20",
        icon:
          "bg-purple-100 text-purple-700 dark:bg-purple-500/15 dark:text-purple-300",
        badge:
          "bg-purple-100 text-purple-700 dark:bg-purple-500/15 dark:text-purple-300",
      };
    }

    /*
    |--------------------------------------------------------------------------
    | USER ACCOUNT ACTIVITY
    |--------------------------------------------------------------------------
    */

    if (
      normalizedType.includes(
        "user_account"
      ) ||
      normalizedType.includes(
        "account"
      )
    ) {
      return {
        card:
          "bg-cyan-50 border-cyan-200 dark:bg-cyan-500/10 dark:border-cyan-400/20",
        icon:
          "bg-cyan-100 text-cyan-700 dark:bg-cyan-500/15 dark:text-cyan-300",
        badge:
          "bg-cyan-100 text-cyan-700 dark:bg-cyan-500/15 dark:text-cyan-300",
      };
    }

    /*
    |--------------------------------------------------------------------------
    | SECURITY / INCIDENT ACTIVITY
    |--------------------------------------------------------------------------
    */

    if (
      normalizedType.includes(
        "incident"
      ) ||
      normalizedType.includes(
        "warning"
      ) ||
      normalizedType.includes(
        "failed"
      ) ||
      normalizedType.includes(
        "flagged"
      )
    ) {
      return {
        card:
          "bg-red-50 border-red-200 dark:bg-red-500/10 dark:border-red-400/20",
        icon:
          "bg-red-100 text-red-700 dark:bg-red-500/15 dark:text-red-300",
        badge:
          "bg-red-100 text-red-700 dark:bg-red-500/15 dark:text-red-300",
      };
    }

    return {
      card:
        "bg-slate-50 border-slate-200 dark:bg-slate-400/10 dark:border-slate-400/20",
      icon:
        "bg-slate-100 text-slate-600 dark:bg-slate-400/15 dark:text-slate-300",
      badge:
        "bg-slate-100 text-slate-600 dark:bg-slate-400/15 dark:text-slate-300",
    };
  }

  function getNotificationIcon(
    type:
      | string
      | null
      | undefined
  ) {
    const normalizedType =
      String(type ?? "")
        .toLowerCase();

    if (
      normalizedType ===
        "new_item_registration" ||
      normalizedType.includes(
        "admin_item_registration"
      )
    ) {
      return <Clock size={14} />;
    }

    if (
      normalizedType ===
        "item_approved" ||
      normalizedType.includes(
        "admin_item_approved"
      ) ||
      normalizedType.includes(
        "security_item_ready"
      )
    ) {
      return (
        <CheckCircle size={14} />
      );
    }

    if (
      normalizedType.includes(
        "incident"
      ) ||
      normalizedType.includes(
        "warning"
      ) ||
      normalizedType.includes(
        "failed"
      ) ||
      normalizedType.includes(
        "flagged"
      )
    ) {
      return (
        <AlertTriangle size={14} />
      );
    }

    if (
      normalizedType.includes(
        "lost_found"
      ) ||
      normalizedType.includes(
        "lost"
      ) ||
      normalizedType.includes(
        "found"
      )
    ) {
      return <BookOpen size={14} />;
    }

    if (
      normalizedType.includes(
        "user_account"
      ) ||
      normalizedType.includes(
        "account"
      )
    ) {
      return <User size={14} />;
    }

    if (
      normalizedType ===
      "item_submitted"
    ) {
      return <FileText size={14} />;
    }

    return <Bell size={14} />;
  }

  function getNotificationTypeLabel(
    type:
      | string
      | null
      | undefined
  ) {
    const value =
      String(type ?? "").trim();

    if (!value) {
      return "General";
    }

    return value
      .replace(/_/g, " ")
      .replace(/\b\w/g, (letter) =>
        letter.toUpperCase()
      );
  }

  // =========================================================
  // CLICKABLE NOTIFICATION NAVIGATION
  // =========================================================

  function getNotificationTargetIndex(
    type: string | null | undefined
  ): number | null {
    const normalizedType = String(type ?? "").toLowerCase();
  
    /*
    |--------------------------------------------------------------------------
    | STUDENT
    |--------------------------------------------------------------------------
    */
  
    if (role === "student") {
      if (normalizedType === "item_approved") {
        return 1; // QR Codes
      }
  
      if (
        normalizedType === "item_submitted" ||
        normalizedType.includes("permit")
      ) {
        return 2; // Permit Status
      }
  
      if (
        normalizedType.includes("lost_found") ||
        normalizedType.includes("lost") ||
        normalizedType.includes("found")
      ) {
        return 3; // Lost & Found
      }
  
      return 0; // Register Item
    }
  
    /*
    |--------------------------------------------------------------------------
    | PCO
    |--------------------------------------------------------------------------
    */
  
    if (role === "pco") {
      if (
        normalizedType === "new_item_registration" ||
        normalizedType === "item_submitted" ||
        normalizedType.includes("approval")
      ) {
        return 0; // Registration Requests
      }
  
      if (
        normalizedType === "item_approved" ||
        normalizedType.includes("registry") ||
        normalizedType.includes("qr")
      ) {
        return 1; // Registered Items
      }
  
      return 0;
    }
  
    /*
    |--------------------------------------------------------------------------
    | CSU / SECURITY
    |--------------------------------------------------------------------------
    */
  
    if (role === "security") {
      const destination = (label: string) => {
        const index = navItems.findIndex(
          item => item.label === label
        );
        return index >= 0 ? index : 0;
      };

      if (/lost_found|lost|found/.test(normalizedType))
        return destination("Lost & Found");

      if (/entry|exit/.test(normalizedType))
        return destination("Entry / Exit Log");

      if (normalizedType.includes("report"))
        return destination("Reports");

      if (/registry|registered_item/.test(normalizedType))
        return destination("Registered Items");

      return destination("Scan & Verify");
    }
  
    /*
    |--------------------------------------------------------------------------
    | SYSTEM ADMINISTRATOR
    |--------------------------------------------------------------------------
    |
    | 0 = Overview Dashboard
    | 1 = Registered Items
    | 2 = Lost & Found
    | 3 = Reports & Analytics
    | 4 = User Accounts
    | 5 = System Logs
    | 6 = Active Sessions
    | 7 = System Settings
    |
    */
  
    if (role === "sysadmin") {
      if (
        normalizedType.includes("user_account") ||
        normalizedType.includes("user") ||
        normalizedType.includes("account")
      ) {
        return 4; // User Accounts
      }
  
      if (
        normalizedType.includes("security_config") ||
        normalizedType.includes("permission")
      ) {
        return 7; // System Settings (Security Config no longer appears in sidebar)
      }
  
      if (normalizedType.includes("setting")) {
        return 7; // System Settings
      }
  
      if (
        normalizedType.includes("incident") ||
        normalizedType.includes("audit") ||
        normalizedType.includes("login") ||
        normalizedType.includes("failed") ||
        normalizedType.includes("warning")
      ) {
        return 5; // System Logs
      }
  
      if (normalizedType.includes("report")) {
        return 3; // Reports & Analytics
      }
  
      if (
        normalizedType.includes("lost_found") ||
        normalizedType.includes("lost") ||
        normalizedType.includes("found")
      ) {
        return 2; // Lost & Found
      }
  
      if (
        normalizedType.includes("item") ||
        normalizedType.includes("registration") ||
        normalizedType.includes("qr")
      ) {
        return 1; // Registered Items
      }
  
      return 0; // Overview Dashboard
    }
  
    return null;
  }


  async function handleHeaderNotificationOpen(
    notification: any
  ) {
    if (
      !notification?.is_read &&
      notification?.id
    ) {
      await handleHeaderMarkRead(
        notification.id
      );
    }

    const targetIndex =
      getNotificationTargetIndex(
        notification?.type
      );

    if (
      targetIndex !== null &&
      targetIndex >= 0 &&
      targetIndex < pages.length
    ) {
      setActiveNav(
        targetIndex
      );
    }

    setNotificationOpen(
      false
    );

    setAccountOpen(
      false
    );

    if (isMobile) {
      setSidebarOpen(
        false
      );
    }
  }

  // =========================================================
  // SIDEBAR
  // =========================================================

  function handleNavClick(
    index: number
  ) {
    setActiveNav(index);

    setNotificationOpen(false);
    setAccountOpen(false);

    if (isMobile) {
      setSidebarOpen(false);
    }
  }

  // =========================================================
  // NOTIFICATION TOGGLE
  // =========================================================

  function handleNotificationToggle() {
    const next =
      !notificationOpen;

    setNotificationOpen(next);

    setAccountOpen(false);

    if (next) {
      loadHeaderNotifications();
    }
  }

  // =========================================================
  // ACCOUNT TOGGLE
  // =========================================================

  function handleAccountToggle() {
    setAccountOpen(
      (current) => !current
    );

    setNotificationOpen(false);
  }

  return (
    <div
      data-qrpass-role={role}
      data-qrpass-mobile-uniform={role === "student" || role === "pco" || role === "security"}
      className={`qrpass-dashboard-root h-screen overflow-hidden flex flex-col ${role === "student" || role === "security" || role === "pco" ? "qrpass-web-responsive" : ""} ${role === "security" || role === "sysadmin" ? "qrpass-unified-staff-search" : ""}`}
      style={{
        fontFamily: "Inter, sans-serif",
        background: darkMode
          ? "#000000"
          : "linear-gradient(180deg, #f8fafc 0%, #f4f7fb 100%)",
      }}
    >
      <style>{`

        
        /* QRPass role-based page subtitle removal */

        .qrpass-dashboard-root[data-qrpass-role="student"]
        .qrpass-page-header-subtitle,

        .qrpass-dashboard-root[data-qrpass-role="pco"]
        .qrpass-page-header-subtitle,

        .qrpass-dashboard-root[data-qrpass-role="security"]
        .qrpass-page-header-subtitle {
          display: none !important;
        }

        /* QRPass cross-role responsive foundation: Student / PCO / CSU / Admin */
        .qrpass-dashboard-root {
          width: 100%;
          max-width: 100%;
          min-width: 0;
        }
        @supports (height: 100dvh) {
          .qrpass-dashboard-root { height: 100dvh; }
        }
        .qrpass-dashboard-root .qrpass-main,
        .qrpass-dashboard-root .qrpass-main > div,
        .qrpass-dashboard-root .qrpass-main .grid > * {
          min-width: 0;
          max-width: 100%;
        }
        .qrpass-dashboard-root .qrpass-main .overflow-x-auto {
          max-width: 100%;
          overscroll-behavior-x: contain;
          -webkit-overflow-scrolling: touch;
          scrollbar-width: thin;
        }
        .qrpass-dashboard-root .qrpass-main img,
        .qrpass-dashboard-root .qrpass-main video,
        .qrpass-dashboard-root .qrpass-main canvas {
          max-width: 100%;
        }
        .qrpass-dashboard-root .qrpass-main textarea,
        .qrpass-dashboard-root .qrpass-main select,
        .qrpass-dashboard-root .qrpass-main input {
          min-width: 0;
          box-sizing: border-box;
        }
        @media (max-width: 767px) {
          .qrpass-dashboard-root .qrpass-main { padding: 12px; }
          .qrpass-dashboard-root .qrpass-main input:not([type="checkbox"]):not([type="radio"]),
          .qrpass-dashboard-root .qrpass-main select,
          .qrpass-dashboard-root .qrpass-main textarea {
            max-width: 100%;
            font-size: 16px;
          }
          .qrpass-dashboard-root .qrpass-main button,
          .qrpass-dashboard-root header button,
          .qrpass-dashboard-root aside button {
            touch-action: manipulation;
          }
          .qrpass-dashboard-root .qrpass-main .overflow-x-auto > table {
            width: max-content;
            min-width: 100%;
          }
        }

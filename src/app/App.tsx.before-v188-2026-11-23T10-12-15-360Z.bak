// ── Role selector shared UI ───────────────────────────────────────────────────
function RoleSelector({ selected, onSelect, excludeRoles = [] }: { selected: Role | null; onSelect: (r: Role) => void; excludeRoles?: Role[] }) {
  const visible = ROLES.filter(r => !excludeRoles.includes(r.id));
  const isOdd = visible.length % 2 !== 0;

  const btnStyle = (r: typeof visible[0]) => ({
    backgroundColor: selected === r.id ? r.color : "white",
    color: selected === r.id ? r.textColor : "#111827",
    borderColor: selected === r.id ? r.color : "#dce3ee",
    boxShadow: selected === r.id ? "0 2px 8px rgba(0,0,0,0.15)" : "none",
  });

  // Separate the last item when count is odd so we can center it alone
  const pairs = isOdd ? visible.slice(0, -1) : visible;
  const lastItem = isOdd ? visible[visible.length - 1] : null;

  return (
    <div className="w-full max-w-xl mx-auto space-y-2">
      <div className="grid grid-cols-2 gap-2">
        {pairs.map(r => (
          <button key={r.id} onClick={() => onSelect(r.id)}
            className="py-3 px-3 rounded-md font-semibold text-sm transition-all duration-150 border-2 text-center"
            style={btnStyle(r)}>
            {r.label}
          </button>
        ))}
      </div>
      {lastItem && (
        <div className="flex justify-center">
          <button onClick={() => onSelect(lastItem.id)}
            className="py-3 px-3 rounded-md font-semibold text-sm transition-all duration-150 border-2 text-center"
            style={{ ...btnStyle(lastItem), width: "calc(50% - 4px)" }}>
            {lastItem.label}
          </button>
        </div>
      )}
    </div>
  );
}

// ── Login page ────────────────────────────────────────────────────────────────
type LoginMode =
  | "login"
  | "two-factor"
  | "register"
  | "forgot"
  | "verify"
  | "reset"
  | "reset-done";

// QRPASS_CREATE_ACCOUNT_INPUT_COLORS_V129
function qrpassRegistrationFieldBackgroundV129(
  element: HTMLInputElement | HTMLButtonElement | null,
  state: "idle" | "hover"
) {
  if (!element) return;
  element.style.setProperty(
    "background-color",
    state === "hover" ? "#eef2ff" : "#ffffff",
    "important"
  );
}

// QRPass rounded student registration dropdowns — UI only
function QRPassRegistrationSelect({
  label,
  value,
  options,
  placeholder,
  onValueChange,
}: {
  label: string;
  value: string;
  options: string[];
  placeholder: string;
  onValueChange: (next: string) => void;
}) {
  const [open, setOpen] = React.useState(false);
  const [openAbove, setOpenAbove] = React.useState(false);
  const [activeIndex, setActiveIndex] = React.useState(0);
  const rootRef = React.useRef<HTMLDivElement>(null);
  const triggerRef = React.useRef<HTMLButtonElement>(null);
  React.useEffect(() => {
    qrpassRegistrationFieldBackgroundV129(triggerRef.current, "idle");
  }, []);
  const listboxId = React.useId();

  React.useEffect(() => {
    if (!open) return;
    function closeIfOutside(event: PointerEvent) {
      if (rootRef.current && !rootRef.current.contains(event.target as Node)) {
        setOpen(false);
      }
    }
    document.addEventListener('pointerdown', closeIfOutside);
    return () => document.removeEventListener('pointerdown', closeIfOutside);
  }, [open]);

  const showOptions = () => {
    const rect = triggerRef.current?.getBoundingClientRect();
    const panelHeight = Math.min(240, options.length * 40 + 8);
    if (rect) {
      setOpenAbove(window.innerHeight - rect.bottom < panelHeight + 12 && rect.top > window.innerHeight - rect.bottom);
    }
    const selected = options.indexOf(value);
    setActiveIndex(selected >= 0 ? selected : 0);
    setOpen(true);
  };

  const choose = (next: string) => {
    onValueChange(next);
    setOpen(false);
    triggerRef.current?.focus();
  };

  const keyHandler = (event: React.KeyboardEvent<HTMLButtonElement>) => {
    if (event.key === 'Escape') {
      if (open) { event.preventDefault(); setOpen(false); }
      return;
    }
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      if (!open) { showOptions(); return; }
      setActiveIndex((index) => (index + (event.key === 'ArrowDown' ? 1 : -1) + options.length) % options.length);
      return;
    }
    if (event.key === 'Home' || event.key === 'End') {
      if (!open) return;
      event.preventDefault();
      setActiveIndex(event.key === 'Home' ? 0 : options.length - 1);
      return;
    }
    if ((event.key === 'Enter' || event.key === ' ') && open) {
      event.preventDefault();
      choose(options[activeIndex]);
    }
  };

  return (
    <div className="relative w-full" ref={rootRef}>
      <button
        ref={triggerRef}
        type="button"
        role="combobox"
        aria-label={label}
        aria-haspopup="listbox"
        aria-expanded={open}
        aria-controls={open ? listboxId : undefined}
        aria-activedescendant={open ? `${listboxId}-${activeIndex}` : undefined}
        onMouseEnter={(event) => {
          if (document.activeElement !== event.currentTarget) qrpassRegistrationFieldBackgroundV129(event.currentTarget, "hover");
        }}
        onMouseLeave={(event) => qrpassRegistrationFieldBackgroundV129(event.currentTarget, "idle")}
        onFocus={(event) => qrpassRegistrationFieldBackgroundV129(event.currentTarget, "idle")}
        onClick={() => open ? setOpen(false) : showOptions()}
        onKeyDown={keyHandler}
        onBlur={(event) => {
          qrpassRegistrationFieldBackgroundV129(event.currentTarget, event.currentTarget.matches(":hover") ? "hover" : "idle");
          if (!rootRef.current?.contains(event.relatedTarget as Node)) setOpen(false);
        }}
        className="flex min-h-[44px] w-full items-center justify-between gap-2 rounded-xl border border-[#c7d2fe] !bg-white hover:!bg-[#eef2ff] focus:!bg-white px-3 py-2 text-left text-sm text-[#17336d] shadow-sm transition-colors hover:border-[#8ba9eb] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#2f5fd6]/30"
      >
        <span className={value ? 'truncate' : 'truncate text-[#667d9e]'}>{value || placeholder}</span>
        <ChevronRight size={16} aria-hidden="true" className={`shrink-0 transition-transform ${open ? '-rotate-90' : 'rotate-90'}`} />
      </button>
      {open && (
        <div
          id={listboxId}
          role="listbox"
          aria-label={label}
          className={`absolute left-0 right-0 z-[200] max-h-60 overflow-y-auto rounded-xl border border-[#c7d2fe] bg-[#f8faff] p-1 shadow-[0_12px_28px_rgba(24,52,108,0.18)] ${openAbove ? 'bottom-[calc(100%+6px)]' : 'top-[calc(100%+6px)]'}`}
        >
          {options.map((option, index) => (
            <div
              key={option}
              id={`${listboxId}-${index}`}
              role="option"
              aria-selected={value === option}
              onMouseEnter={() => setActiveIndex(index)}
              onMouseDown={(event) => event.preventDefault()}
              onClick={() => choose(option)}
              className={`cursor-pointer select-none rounded-lg px-3 py-2.5 text-sm transition-colors ${value === option ? 'bg-[#1e448b] font-semibold text-white' : activeIndex === index ? 'bg-[#dce6ff] text-[#17336d]' : 'text-[#17336d] hover:bg-[#e5edff]'}`}
            >
              {option}
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

function LoginPage({ onLogin }: { onLogin: (role: Role) => void }) {
  // Two-factor authentication state
const [twoFactorChallenge, setTwoFactorChallenge] =
  useState("");

const [twoFactorCode, setTwoFactorCode] =
  useState("");

const [twoFactorError, setTwoFactorError] =
  useState("");

const [isVerifyingTwoFactor, setIsVerifyingTwoFactor] =
  useState(false);
  const [mode, setMode] = useState<LoginMode>("login");

  // Login state
  const [username, setUsername] = useState(() =>
    localStorage.getItem("qrpass-remembered-id") ?? ""
  );
  const [rememberMe, setRememberMe] = useState(() =>
    Boolean(localStorage.getItem("qrpass-remembered-id"))
  );
  const [password, setPassword] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [loginError, setLoginError] = useState("");
  const [isLoggingIn, setIsLoggingIn] = useState(false);

  // Registration state
  const [regRole, setRegRole] = useState<Role | null>(null);
  const [regFields, setRegFields] = useState<Record<string, string>>({});
  // QRPass student form validation v3
  const [showRegPassword, setShowRegPassword] = useState(false);
  const [showRegConfirmPassword, setShowRegConfirmPassword] = useState(false);
  const [regSubmitted, setRegSubmitted] = useState(false);
  const [registrationErrorV182, setRegistrationErrorV182] = useState(""); // QRPASS_REVOKED_ID_MESSAGES_V182

  // Forgot password state
  const [forgotEmail, setForgotEmail] = useState("");
  const [codeInputs, setCodeInputs] = useState([
    "",
    "",
    "",
    "",
    "",
    "",
  ]);
  const [newPass, setNewPass] = useState("");
  const [confirmPass, setConfirmPass] = useState("");
  const [codeError, setCodeError] = useState(false);

  const [verifiedResetCode, setVerifiedResetCode] = useState("");

  // ==========================================================================
  // LOGIN
  // ==========================================================================

  function saveRememberedLoginId() {
    if (rememberMe) {
      localStorage.setItem(
        "qrpass-remembered-id",
        username.trim()
      );
    } else {
      localStorage.removeItem(
        "qrpass-remembered-id"
      );
    }
  }

  async function handleLogin(
  e: React.FormEvent
) {
  e.preventDefault();

  setLoginError("");
  setIsLoggingIn(true);

  try {
    const data =
      await login(
        username.trim(),
        password
      );

    /*
    |--------------------------------------------------------------------------
    | TWO-FACTOR AUTHENTICATION REQUIRED
    |--------------------------------------------------------------------------
    */

    if (
      data?.requires_2fa === true
    ) {
      if (
        !data.challenge_token
      ) {
        throw new Error(
          "The server did not return a two-factor authentication challenge."
        );
      }

      setTwoFactorChallenge(
        data.challenge_token
      );

      setTwoFactorCode("");
      setTwoFactorError("");

      setMode(
        "two-factor"
      );

      return;
    }

    /*
    |--------------------------------------------------------------------------
    | NORMAL LOGIN
    |--------------------------------------------------------------------------
    */

    if (!data?.token) {
      throw new Error(
        "Login token was not returned by the server."
      );
    }

    localStorage.setItem(
      "token",
      data.token
    );

    localStorage.setItem(
      "user",
      JSON.stringify(
        data.user
      )
    );

    localStorage.setItem(
      "role",
      data.user?.role ??
        ""
    );

    saveRememberedLoginId();

    const userRole =
      data.user?.role as Role;

    if (!userRole) {
      throw new Error(
        "User role was not returned by the server."
      );
    }

    const validRoles: Role[] = [
      "student",
      "security",
      "pco",
      "sysadmin",
    ];

    if (
      !validRoles.includes(
        userRole
      )
    ) {
      throw new Error(
        "This account has an invalid access role."
      );
    }

    onLogin(
      userRole
    );
  } catch (error) {
    setLoginError(
      error instanceof Error
        ? error.message
        : "Unable to sign in. Please try again."
    );
  } finally {
    setIsLoggingIn(false);
  }
}

  // ==========================================================================
  // REGISTRATION
  // ==========================================================================

  async function handleRegister(
    e: React.FormEvent
  ) {
    e.preventDefault();
    setRegistrationErrorV182("");

    if (regRole !== "student") {
      return;
    }

    const name =
      regFields["Full Name"]?.trim();

    const email =
      regFields["Email Address"]?.trim();

    const registrationUsername =
      regFields["Student ID No."]?.trim();

    const registrationPassword =
      regFields["Password"] ?? "";

    const confirmPassword =
      regFields["Confirm Password"] ?? "";

    const college = regFields["Year Level"] === "Senior High School" ? "" : (regFields["College / Department"] ?? "");
    const yearLevel = regFields["Year Level"] ?? "";
    const contactNumber = regFields["Contact Number"]?.trim() ?? "";

    if (
      !name ||
      !email ||
      !registrationUsername ||
      !registrationPassword ||
      (!college && yearLevel !== "Senior High School") ||
      !yearLevel
    ) {
      alert(
        "Please complete all required fields."
      );
      return;
    }

    if (/[0-9]/.test(name)) {
      alert("Full Name must not contain numbers.");
      return;
    }
    if (!/^[0-9]+$/.test(registrationUsername)) {
      alert("Student ID No. must contain numbers only.");
      return;
    }
    if (contactNumber && !/^[0-9]+$/.test(contactNumber)) {
      alert("Contact Number must contain numbers only.");
      return;
    }

    if (
      registrationPassword !==
      confirmPassword
    ) {
      alert(
        "Passwords do not match."
      );
      return;
    }

    try {
      await register(
        name,
        email,
        registrationUsername,
        registrationPassword,
        "student",
        college,
        yearLevel,
        contactNumber
      );

      setRegSubmitted(true);
    } catch (error) {
      setRegistrationErrorV182(error instanceof Error ? error.message : "Registration failed.");
    }
  }

  // ==========================================================================
  // FORGOT PASSWORD
  // ==========================================================================

  async function handleForgotSubmit(
  e: React.FormEvent
) {
  e.preventDefault();

  try {
    await requestPasswordReset(
      forgotEmail.trim()
    );

    setCodeInputs([
      "",
      "",
      "",
      "",
      "",
      "",
    ]);

    setCodeError(false);

    setMode("verify");
  } catch (error) {
    alert(
      error instanceof Error
        ? error.message
        : "Unable to send verification code."
    );
  }
}


async function handleVerifySubmit(
  e: React.FormEvent
) {
  e.preventDefault();

  const enteredCode =
    codeInputs.join("");

  if (enteredCode.length !== 6) {
    setCodeError(true);
    return;
  }

  try {
    await verifyPasswordResetCode(
      forgotEmail.trim(),
      enteredCode
    );

    setVerifiedResetCode(
      enteredCode
    );

    setCodeError(false);

    setMode("reset");
  } catch (error) {
    setCodeError(true);
  }
}


async function handleResetSubmit(
  e: React.FormEvent
) {
  e.preventDefault();

  if (!newPass) {
    return;
  }

  if (newPass !== confirmPass) {
    return;
  }

  try {
    await resetPassword(
      forgotEmail.trim(),
      verifiedResetCode,
      newPass
    );

    setMode("reset-done");
  } catch (error) {
    alert(
      error instanceof Error
        ? error.message
        : "Unable to reset password."
    );
  }
}
async function handleTwoFactorSubmit(
  e: React.FormEvent
) {
  e.preventDefault();

  setTwoFactorError("");

  const code =
    twoFactorCode.trim();

  if (!twoFactorChallenge) {
    setTwoFactorError(
      "Your login verification session is missing. Please sign in again."
    );

    return;
  }

  if (!/^\d{6}$/.test(code)) {
    setTwoFactorError(
      "Please enter the 6-digit verification code."
    );

    return;
  }

  try {
    setIsVerifyingTwoFactor(
      true
    );

    const data =
      await verifyTwoFactor(
        twoFactorChallenge,
        code
      );

    if (!data?.token) {
      throw new Error(
        "Login token was not returned by the server."
      );
    }

    const userRole =
      data.user?.role as Role;

    const validRoles: Role[] = [
      "student",
      "security",
      "pco",
      "sysadmin",
    ];

    if (
      !userRole ||
      !validRoles.includes(
        userRole
      )
    ) {
      throw new Error(
        "This account has an invalid access role."
      );
    }

    localStorage.setItem(
      "token",
      data.token
    );

    localStorage.setItem(
      "user",
      JSON.stringify(
        data.user
      )
    );

    localStorage.setItem(
      "role",
      userRole
    );

    saveRememberedLoginId();

    setTwoFactorChallenge("");
    setTwoFactorCode("");
    setTwoFactorError("");

    onLogin(
      userRole
    );
  } catch (error) {
    setTwoFactorError(
      error instanceof Error
        ? error.message
        : "Unable to verify the code."
    );
  } finally {
    setIsVerifyingTwoFactor(
      false
    );
  }
}
  // ==========================================================================
  // SWITCH PAGE
  // ==========================================================================

  function switchMode(
    newMode: LoginMode
  ) {
    setMode(newMode);

    setRegSubmitted(false);
    setRegRole(newMode === "register" ? "student" : null);
    setRegFields({});

    setForgotEmail("");

    setCodeInputs([
      "",
      "",
      "",
      "",
      "",
      "",
    ]);

    setNewPass("");
    setConfirmPass("");
    setCodeError(false);

    setLoginError("");
    setShowPassword(false);

    setTwoFactorChallenge("");
    setTwoFactorCode("");
    setTwoFactorError("");
    setIsVerifyingTwoFactor(false);
  }

  const fields =
    regRole
      ? REG_FIELDS[regRole]
      : [];

  // ==========================================================================
  // SHARED TOP BAR
  // ==========================================================================

  const TopBar = (
    <div className="bg-primary h-1.5 w-full" />
  );

    // ==========================================================================
  // SHARED NAVBAR
  // ==========================================================================

  const NavBar = (
    <div className="flex items-center justify-between px-4 py-2.5 bg-white border-b border-[#cfd8e6] shadow-sm">
      <div className="flex items-center gap-2.5">
        <QRpassLogo size={90} showText />
        <div>
          <p
            className="text-xs font-semibold text-primary"
            style={{ fontFamily: "Barlow, sans-serif" }}
          >
            QRpass
          </p>
          <p className="text-xs text-muted-foreground">
            Campus Item Registration & Verification System
          </p>
        </div>
      </div>
      <span className="text-xs text-muted-foreground">V1.0</span>
    </div>
  );

  // ==========================================================================
  // BOTTOM UC COLOR STRIP
  // ==========================================================================

  const BottomColorStrip = (
    <div className="flex h-2">
      <div
        className="flex-1"
        style={{
          backgroundColor: "#1a3a7b",
        }}
      />

      <div
        className="flex-1"
        style={{
          backgroundColor: "#2f5fd6",
        }}
      />

      <div
        className="flex-1"
        style={{
          backgroundColor: "#557bdc",
        }}
      />

      <div
        className="flex-1"
        style={{
          backgroundColor: "#f6f8fb",
        }}
      />
    </div>
  );

  // ==========================================================================
  // SHARED PAGE SHELL
  // ==========================================================================

  // Visual-only styling shared by Register, Forgot Password, verification and reset screens.
  const AuthThemeStyles = (
    <style>{`
        /* QRPASS_ADMIN_CSU_UNIFIED_SEARCH_V1: staff-only consistent search toolbar. */
        .qrpass-unified-staff-search .qrpass-main input[placeholder^="Search"],
        .qrpass-unified-staff-search .qrpass-main input[aria-label^="Search"] {
          box-sizing: border-box;
          width: 100%;
          min-width: 0;
          height: 48px !important;
          border: 1px solid #c7d2fe !important;
          border-radius: 12px !important;
          background-color: #eef2ff !important;
          padding-right: 16px !important;
          font-size: 14px !important;
          color: #17336d !important;
          outline: none;
        }
        .qrpass-unified-staff-search .qrpass-main input[placeholder^="Search"]::placeholder,
        .qrpass-unified-staff-search .qrpass-main input[aria-label^="Search"]::placeholder {color:#8195bb; opacity:1;}
        .qrpass-unified-staff-search .qrpass-main input[placeholder^="Search"]:focus,
        .qrpass-unified-staff-search .qrpass-main input[aria-label^="Search"]:focus {
          border-color:#5278e7 !important;
          background-color:#ffffff !important;
          box-shadow:0 0 0 2px rgba(82,120,231,.2) !important;
        }
        .qrpass-unified-staff-search .qrpass-main select[aria-label="Sort records"],
        .qrpass-unified-staff-search .qrpass-main select[aria-label="Sort system logs"] {
          box-sizing:border-box;
          height:48px !important;

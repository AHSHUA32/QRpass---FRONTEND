            />
          </div>

          <div>
            <label className="mb-1 block text-xs font-medium text-foreground">Brand / Model (if known)</label>
            <QRPassInlineOtherSelect
              label="Brand / Model"
              value={form.brand_model}
              options={categoryBrands}
              onChange={value => setForm(current => ({...current, brand_model: value}))}
              placeholder="Brand / Model (optional)"
              specifyPlaceholder="Specify brand and model (optional)"
              maxLength={255}
              className="w-full min-h-[44px] rounded-lg border border-[#c7d2fe] bg-[#eef2ff] px-3 py-2.5 text-sm text-[#17336d] outline-none transition-[background-color,border-color,box-shadow] duration-150 focus:border-[#5278e7] focus:bg-white focus:ring-2 focus:ring-[#5278e7]/20"
            />
          </div>

          <div>
            <label className="mb-1 block text-xs font-medium text-foreground">Color (if known)</label>
            <QRPassInlineOtherSelect
              label="Item Color"
              value={form.color}
              options={COMMON_ITEM_COLORS}
              onChange={value => setForm(current => ({...current, color: value}))}
              placeholder="Color (optional)"
              specifyPlaceholder="Specify item color (optional)"
              maxLength={100}
              className="w-full min-h-[44px] rounded-lg border border-[#c7d2fe] bg-[#eef2ff] px-3 py-2.5 text-sm text-[#17336d] outline-none transition-[background-color,border-color,box-shadow] duration-150 focus:border-[#5278e7] focus:bg-white focus:ring-2 focus:ring-[#5278e7]/20"
            />
          </div>

          <div>
            <label className="mb-1 block text-xs font-medium text-foreground">Serial / Identification No. (optional)</label>
            <input
              value={itemSpecs.serial_number ?? ""}
              onChange={e => setItemSpecs(current => ({...current, serial_number: e.target.value}))}
              maxLength={255}
              placeholder="Enter only if available"
              className="w-full rounded-lg border border-[#cfd8e6] px-3 py-2.5 text-sm outline-none focus:ring-2 focus:ring-primary/20 !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
            />
          </div>

          <div className="md:col-span-2">
            <label className="mb-1 block text-xs font-medium text-foreground">Identifying Features / Accessories (optional)</label>
            <input
              value={itemSpecs.accessories_included ?? ""}
              onChange={e => setItemSpecs(current => ({...current, accessories_included: e.target.value}))}
              maxLength={600}
              placeholder="e.g. Sticker on the lid, scratches, carrying case, charger, keychain"
              className="w-full rounded-lg border border-[#cfd8e6] px-3 py-2.5 text-sm outline-none focus:ring-2 focus:ring-primary/20 !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
            />
          </div>
        </div>
      </div>
    );
  }

  const [submitting, setSubmitting] =
    useState(false);

  const [photoFile, setPhotoFile] =
    useState<File | null>(null);

  const [photoPreview, setPhotoPreview] =
    useState("");

  const [fullImage, setFullImage] =
    useState<{
      url: string;
      name: string;
    } | null>(null);

  const [cameraOpen, setCameraOpen] =
    useState(false);

  const [cameraError, setCameraError] =
    useState("");

  const videoRef =
    useRef<HTMLVideoElement | null>(null);

  const cameraStreamRef =
    useRef<MediaStream | null>(null);

  const photoInputRef =
    useRef<HTMLInputElement | null>(null);

  const photoUploadButtonRef =
    useRef<HTMLButtonElement | null>(null);

  const photoScrollTopRef =
    useRef(0);


  const [recoveringId, setRecoveringId] =
    useState<number | null>(null);

  const [recoveringItem, setRecoveringItem] =
    useState<any | null>(null);

  const [recoveryForm, setRecoveryForm] = useState({
    found_by_identifier: "",
    location_found: "",
    date_found: "",
  });

  const [form, setForm] = useState({
    found_by_identifier: "",
    location_found: "",
    date_found: "",

    lost_by_identifier: "",
    location_lost: "",
    date_lost: "",

    item_name: "",
    category: "",
    brand_model: "",
    color: "",
    description: "",
  });

  // Optional identifying information is serialized into the existing description field.
  const [itemSpecs, setItemSpecs] = useState<Record<string, string>>({});

  function buildLostFoundDescription() {
    const identifying = [
      itemSpecs.serial_number?.trim() ? `Serial / Identification No.: ${itemSpecs.serial_number.trim()}` : "",
      itemSpecs.accessories_included?.trim() ? `Identifying Features / Accessories: ${itemSpecs.accessories_included.trim()}` : "",
    ].filter(Boolean);
    return [form.description.trim(), identifying.join("\n")].filter(Boolean).join("\n\n");
  }

  async function loadItems() {
    try {
      setLoading(true);
      setError("");

      const data = await getLostFoundItems();
      const list = Array.isArray(data)
        ? data
        : data?.items ?? [];

      setItems(list);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Failed to load Lost & Found registry."
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadItems();
  }, []);

  useEffect(() => {
    if (!cameraOpen) {
      return;
    }

    let cancelled = false;

    async function startCamera() {
      try {
        setCameraError("");

        if (
          !navigator.mediaDevices ||
          !navigator.mediaDevices.getUserMedia
        ) {
          throw new Error(
            "Camera access is not supported by this browser."
          );
        }

        const stream =
          await navigator.mediaDevices.getUserMedia({
            video: {
              facingMode: {
                ideal: "environment",
              },
            },
            audio: false,
          });

        if (cancelled) {
          stream
            .getTracks()
            .forEach((track) => track.stop());
          return;
        }

        cameraStreamRef.current = stream;

        if (videoRef.current) {
          videoRef.current.srcObject = stream;
          await videoRef.current.play();
        }
      } catch (err) {
        setCameraError(
          err instanceof Error
            ? err.message
            : "Unable to access the camera."
        );
      }
    }

    startCamera();

    return () => {
      cancelled = true;

      cameraStreamRef.current
        ?.getTracks()
        .forEach((track) => track.stop());

      cameraStreamRef.current = null;
    };
  }, [cameraOpen]);

  function closeCamera() {
    setCameraOpen(false);
    setCameraError("");
  }

  function captureCameraPhoto() {
    const video = videoRef.current;

    if (
      !video ||
      !video.videoWidth ||
      !video.videoHeight
    ) {
      setCameraError(
        "The camera is still starting. Please wait a moment and try again."
      );
      return;
    }

    const canvas = document.createElement("canvas");
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;

    const context = canvas.getContext("2d");

    if (!context) {
      setCameraError(
        "Unable to capture the camera image."
      );
      return;
    }

    context.drawImage(
      video,
      0,
      0,
      canvas.width,
      canvas.height
    );

    canvas.toBlob(
      (blob) => {
        if (!blob) {
          setCameraError(
            "Unable to capture the camera image."
          );
          return;
        }

        if (blob.size > 5 * 1024 * 1024) {
          setCameraError(
            "The captured photo is larger than 5 MB."
          );
          return;
        }

        const file = new File(
          [blob],
          `lost-found-${Date.now()}.jpg`,
          { type: "image/jpeg" }
        );

        if (photoPreview) {
          URL.revokeObjectURL(photoPreview);
        }

        setPhotoFile(file);
        setPhotoPreview("");
        setError("");
        closeCamera();
      },
      "image/jpeg",
      0.9
    );
  }

  function handleFormChange(
    e: React.ChangeEvent<
      | HTMLInputElement
      | HTMLTextAreaElement
      | HTMLSelectElement
    >
  ) {
    const { name, value } = e.target;

    if (name === "category") {
      setItemSpecs({});
    }

    setForm((current) => ({
      ...current,
      [name]: value,
    }));
  }

  function clearPhoto() {
    if (photoPreview) {
      URL.revokeObjectURL(photoPreview);
    }

    setPhotoFile(null);
    setPhotoPreview("");

    if (photoInputRef.current) {
      photoInputRef.current.value = "";
    }
  }

  function openPhotoPicker() {
    const main =
      document.querySelector("main");

    if (main) {
      photoScrollTopRef.current =
        main.scrollTop;
    }

    if (photoInputRef.current) {
      photoInputRef.current.value = "";
      photoInputRef.current.click();
    }
  }

  function restorePhotoPickerPosition() {
    window.requestAnimationFrame(() => {
      window.requestAnimationFrame(() => {
        const main =
          document.querySelector("main");

        if (main) {
          main.scrollTop =
            photoScrollTopRef.current;
        }

        try {
          photoUploadButtonRef.current?.focus({
            preventScroll: true,
          });
        } catch {
          photoUploadButtonRef.current?.focus();
        }
      });
    });
  }

  function handlePhotoChange(
    e: React.ChangeEvent<HTMLInputElement>
  ) {
    const file = e.target.files?.[0];

    if (!file) {
      restorePhotoPickerPosition();
      return;
    }

    const allowedTypes = [
      "image/jpeg",
      "image/png",
      "image/webp",
    ];

    if (!allowedTypes.includes(file.type)) {
      setError(
        "Please select a JPG, JPEG, PNG, or WEBP image."
      );
      e.target.value = "";
      restorePhotoPickerPosition();
      return;
    }

    if (file.size > 5 * 1024 * 1024) {
      setError(
        "The item photo must not be larger than 5 MB."
      );
      e.target.value = "";
      restorePhotoPickerPosition();
      return;
    }

    if (photoPreview) {
      URL.revokeObjectURL(photoPreview);
    }

    setError("");
    setPhotoFile(file);
    setPhotoPreview("");
    restorePhotoPickerPosition();
  }

  function clearForm() {
    setForm({
      found_by_identifier: "",
      location_found: "",
      date_found: "",

      lost_by_identifier: "",
      location_lost: "",
      date_lost: "",

      item_name: "",
      category: "",
      brand_model: "",
      color: "",
      description: "",
    });

    setItemSpecs({});
    setSelectedReportGroup(null);
    clearPhoto();
  }

  async function handleSubmit(
    e: React.FormEvent
  ) {
    e.preventDefault();

    setError("");
    setSuccess("");

    const reportItemName = form.item_name.trim();
    const reportBrandModel = form.brand_model.trim() === "__OTHER__" ? "" : form.brand_model.trim();

    if (!selectedReportGroup) {
      setError("Please choose an item category first.");
      return;
    }

    if (!reportItemName || reportItemName === "__OTHER__") {
      setError("Please complete the item name or equipment description.");
      return;
    }

    if (!form.category.trim()) {
      setError("Please select an item category.");
      return;
    }

    const itemDescription = buildLostFoundDescription();
    if (itemDescription.length > 2000) {
      setError("The item description and identifying details must not exceed 2,000 characters combined.");
      return;
    }

    const selectedLocation = reportMode === "found" ? form.location_found : form.location_lost;
    if (!isCompleteCSULocation(selectedLocation)) {
      setError("Please choose the building and floor (or specify another campus area).");
      return;
    }

    if (reportMode === "found") {
      if (!form.found_by_identifier.trim()) {
        setError(
          "Please enter the Student/Employee ID of the person who turned over the item."
        );
        return;
      }

      if (!form.location_found.trim()) {
        setError(
          "Please enter where the item was found."
        );
        return;
      }

      if (!form.date_found) {
        setError(
          "Please select the date the item was found."
        );
        return;
      }
    }

    if (reportMode === "lost") {
      if (!form.lost_by_identifier.trim()) {
        setError(
          "Please enter the Student/Employee ID of the person who lost the item."
        );
        return;
      }

      if (!form.location_lost.trim()) {
        setError(
          "Please enter where the item was last seen."
        );
        return;
      }

      if (!form.date_lost) {
        setError(
          "Please select the date the item was lost."
        );
        return;
      }
    }

    try {
      setSubmitting(true);

      if (reportMode === "found") {
        const result = await createLostFoundItem({
          report_type: "found",
          found_by_identifier:
            form.found_by_identifier.trim(),
          item_name: reportItemName,
          category:
            form.category.trim() || undefined,
          brand_model:
            reportBrandModel || undefined,
          color:
            (form.color.trim() === "__OTHER__" ? "" : form.color.trim()) || undefined,
          location_found:
            form.location_found.trim(),
          date_found: form.date_found,
          description:
            itemDescription || undefined,
          photo: photoFile,
        });

        setSuccess(
          result?.message ||
            "Found item recorded successfully."
        );
      } else {
        const result = await createLostFoundItem({
          report_type: "lost",
          lost_by_identifier:
            form.lost_by_identifier.trim(),
          item_name: reportItemName,
          category:
            form.category.trim() || undefined,
          brand_model:
            reportBrandModel || undefined,
          color:
            (form.color.trim() === "__OTHER__" ? "" : form.color.trim()) || undefined,
          location_lost:
            form.location_lost.trim(),
          date_lost: form.date_lost,
          description:
            itemDescription || undefined,
          photo: photoFile,
        });

        setSuccess(
          result?.message ||
            "Lost item report recorded successfully."
        );
      }

      clearForm();
      await loadItems();
      setTab("registry");

      setTimeout(() => {
        setSuccess("");
      }, 5000);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Failed to save Lost & Found report."
      );
    } finally {
      setSubmitting(false);
    }
  }

  function toDateTimeLocal(
    value?: string | null
  ) {
    if (!value) {
      return "";
    }

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return String(value).slice(0, 16);
    }

    const offset = date.getTimezoneOffset();
    const local = new Date(
      date.getTime() - offset * 60 * 1000
    );

    return local.toISOString().slice(0, 16);
  }

  async function handleDeleteReport(item: any) {
    const itemId = Number(item?.id);

    if (!itemId) {
      setError("Invalid Lost & Found report ID.");
      return;
    }

    const status = String(
      item?.status ?? ""
    ).toLowerCase();

    if (
      status === "pending" ||
      status === "claimed" ||
      status === "recovered" ||
      item?.claimed_by
    ) {
      setError(
        "Pending, claimed, or recovered reports cannot be deleted because they must remain in the audit history."
      );
      return;
    }

    const confirmed = window.confirm(
      `Delete Report #${itemId} (${item?.item_name || "Lost & Found item"})?\n\nThis permanently deletes the report and its uploaded photo. This action cannot be undone.`
    );

    if (!confirmed) {
      return;
    }

    try {
      setDeletingId(itemId);
      setError("");
      setSuccess("");

      const token =
        localStorage.getItem("token");

      const response = await fetch(
        `http://localhost:8000/api/lost-found/${itemId}`,
        {
          method: "DELETE",
          headers: {
            Accept: "application/json",
            Authorization: `Bearer ${token}`,
          },
        }
      );

      let data: any = {};

      try {
        data = await response.json();
      } catch {
        data = {};
      }

      if (!response.ok) {
        throw new Error(
          data?.message ||
            "Failed to delete Lost & Found report."
        );
      }

      setSuccess(
        data?.message ||
          `Report #${itemId} deleted successfully.`
      );

      if (
        editingItem &&
        Number(editingItem.id) === itemId
      ) {
        setEditingItem(null);
      }

      await loadItems();

      setTimeout(() => {
        setSuccess("");
      }, 4000);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Failed to delete Lost & Found report."
      );
    } finally {
      setDeletingId(null);
    }
  }

  function openEditReport(item: any) {
    const reportType = String(
      item.report_type ?? "found"
    ).toLowerCase();

    setError("");
    setSuccess("");
    setEditError("");
    setEditingItem(item);

    setEditForm({
      person_identifier:
        reportType === "lost"
          ? item.lost_by?.username ?? ""
          : item.finder?.username ?? "",

      item_name:
        item.item_name ?? "",

      category:
        item.category ?? "",

      brand_model:
        item.brand_model ?? "",

      color:
        item.color ?? "",

      location:
        reportType === "lost"
          ? item.location_lost ?? ""
          : item.location_found ?? "",

      date_time:
        toDateTimeLocal(
          reportType === "lost"
            ? item.date_lost
            : item.date_found
        ),

      description:
        item.description ?? "",
    });
  }

  function handleEditFormChange(
    e: React.ChangeEvent<
      | HTMLInputElement
      | HTMLTextAreaElement
      | HTMLSelectElement
    >
  ) {
    const { name, value } = e.target;

    setEditForm((current) => ({
      ...current,
      [name]: value,
    }));

    if (editError) {
      setEditError("");
    }
  }

  async function handleEditSubmit(
    e: React.FormEvent
  ) {
    e.preventDefault();

    if (!editingItem) {
      return;
    }

    const reportType = String(
      editingItem.report_type ?? "found"
    ).toLowerCase();

    if (!editForm.person_identifier.trim()) {
      setEditError(
        reportType === "lost"
          ? "Please enter the owner Student/Employee ID."
          : "Please enter the finder Student/Employee ID."
      );
      return;
    }

    if (!editForm.item_name.trim()) {
      setError("Please enter the item name.");
      return;
    }

    if (!editForm.location.trim()) {
      setEditError(
        reportType === "lost"
          ? "Please enter the last seen location."
          : "Please enter the location found."
      );
      return;
    }

    if (!isCompleteCSULocation(editForm.location)) {
      setEditError("Please select a campus building and floor (or another campus area).");
      return;
    }

    if (!editForm.date_time) {
      setEditError(
        reportType === "lost"
          ? "Please enter the date and time lost / last seen."
          : "Please enter the date and time found."
      );
      return;
    }

    try {
      setEditSubmitting(true);
      setEditError("");
      setSuccess("");

      const common = {
        item_name:
          editForm.item_name.trim(),
        category:
          editForm.category.trim() || undefined,
        brand_model:
          editForm.brand_model.trim() || undefined,
        color:
          editForm.color.trim() || undefined,
        description:
          editForm.description.trim() || undefined,
      };

      const result =
        reportType === "lost"
          ? await updateLostFoundItem(
              Number(editingItem.id),
              {
                ...common,
                lost_by_identifier:
                  editForm.person_identifier.trim(),
                location_lost:
                  editForm.location.trim(),
                date_lost:
                  editForm.date_time,
              }
            )
          : await updateLostFoundItem(
              Number(editingItem.id),
              {
                ...common,
                found_by_identifier:
                  editForm.person_identifier.trim(),
                location_found:
                  editForm.location.trim(),
                date_found:
                  editForm.date_time,
              }
            );

      setSuccess(
        result?.message ||
          "Lost & Found report updated successfully."
      );

      setEditError("");
      setEditingItem(null);
      await loadItems();

      setTimeout(() => {
        setSuccess("");
      }, 5000);
    } catch (err) {
      setEditError(
        err instanceof Error
          ? err.message
          : "Failed to update Lost & Found report."
      );
    } finally {
      setEditSubmitting(false);
    }
  }

  function localDateTimeNow() {
    const now = new Date();
    const offset = now.getTimezoneOffset();
    const local = new Date(
      now.getTime() - offset * 60 * 1000
    );

    return local.toISOString().slice(0, 16);
  }

  async function handleRecovered(item: any) {
    const reportType = String(
      item.report_type ?? "found"
    ).toLowerCase();

    // Lost reports need turnover/recovery details first.
    if (reportType === "lost") {
      setError("");
      setSuccess("");
      setRecoveringItem(item);
      setRecoveryForm({
        found_by_identifier: "",
        location_found: "",
        date_found: localDateTimeNow(),
      });
      return;
    }

    // Found reports keep the existing claim-verification workflow.
    const confirmed = window.confirm(
      "CSU verification: Have you checked the student's ownership evidence and confirmed the item will be released to the rightful owner? This will change the status from Pending to Claimed."
    );

    if (!confirmed) {
      return;
    }

    try {
      setRecoveringId(Number(item.id));
      setError("");
      setSuccess("");

      const result = await markLostFoundRecovered(
        Number(item.id)
      );

      setSuccess(
        result?.message ||
          "Item marked as recovered."
      );

      await loadItems();

      setTimeout(() => {
        setSuccess("");
      }, 5000);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Failed to mark the item as recovered."
      );
    } finally {
      setRecoveringId(null);
    }
  }

  async function handleLostRecoverySubmit(
    e: React.FormEvent
  ) {
    e.preventDefault();

    if (!recoveringItem) {
      return;
    }

    if (!recoveryForm.found_by_identifier.trim()) {
      setError(
        "Please enter the Student/Employee ID of the person who found or returned the item."
      );
      return;
    }

    if (!isCompleteCSULocation(recoveryForm.location_found)) {
      setError("Please select a campus building and floor for this recovery.");
      return;
    }

    if (!recoveryForm.location_found.trim()) {
      setError(
        "Please enter where the item was found or turned over."
      );
      return;
    }

    if (!recoveryForm.date_found) {
      setError(
        "Please enter the exact date and time the item was found or turned over."
      );
      return;
    }

    try {
      setRecoveringId(Number(recoveringItem.id));
      setError("");
      setSuccess("");

      const result = await markLostFoundRecovered(
        Number(recoveringItem.id),
        {
          found_by_identifier:
            recoveryForm.found_by_identifier.trim(),
          location_found:
            recoveryForm.location_found.trim(),
          date_found: recoveryForm.date_found,
        }
      );

      setSuccess(
        result?.message ||
          "Lost item recovery recorded successfully."
      );

      setRecoveringItem(null);
      setRecoveryForm({
        found_by_identifier: "",
        location_found: "",
        date_found: "",
      });

      await loadItems();

      setTimeout(() => {
        setSuccess("");
      }, 5000);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Failed to record lost item recovery."
      );
    } finally {
      setRecoveringId(null);
    }
  }

  // Date is based on when CSU recorded the lost/found report.
  const periodItems = items.filter(item =>
    csuMatchesPeriod(item.created_at ?? item.reported_at ?? item.date_found ?? item.date_lost,
      lostFoundPeriod, lostFoundStart, lostFoundEnd)
  );

  const filteredItems = periodItems.filter((item) => {
    const query = search.trim().toLowerCase();
    const status = String(item.status ?? "").toLowerCase();
    const reportType = String(item.report_type ?? "found").toLowerCase();
    const recovered = status === "recovered" || status === "claimed";
    if (lostFoundFilter === "recovered" && !recovered) return false;
    if (lostFoundFilter === "lost" && (recovered || reportType !== "lost")) return false;
    if (lostFoundFilter === "found" && (recovered || reportType !== "found")) return false;

    if (!query) {
      return true;
    }

    const searchableText = [
      item.id,
      item.report_type,
      item.item_name,
      item.category,
      item.brand_model,
      item.color,
      item.location_found,
      item.location_lost,
      item.description,
      item.status,

      item.finder?.name,
      item.finder?.username,

      item.lost_by?.name,
      item.lost_by?.username,

      item.processor?.name,
      item.processor?.username,

      item.claimant?.name,
      item.claimant?.username,
    ]
      .filter(Boolean)
      .join(" ")
      .toLowerCase();

    return searchableText.includes(query);
  });


  const shownLostFound = [...filteredItems].sort((a, b) => {
    const x = new Date(a.created_at ?? a.reported_at ?? a.date_found ?? 0).getTime() || 0;
    const y = new Date(b.created_at ?? b.reported_at ?? b.date_found ?? 0).getTime() || 0;
    return csuListSort === "newest" ? y - x : x - y;
  });

  const foundCount = periodItems.filter(
    (item) =>
      String(item.report_type ?? "found").toLowerCase() ===
        "found" &&
      String(item.status ?? "").toLowerCase() ===
        "found"
  ).length;

  const lostCount = periodItems.filter(
    (item) =>
      String(item.report_type ?? "").toLowerCase() ===
        "lost" &&
      String(item.status ?? "").toLowerCase() ===
        "lost"
  ).length;

  const pendingClaimsCount = periodItems.filter(
    (item) =>
      String(item.report_type ?? "found").toLowerCase() === "found" &&
      String(item.status ?? "").toLowerCase() === "pending"
  ).length;

  const recoveredCount = periodItems.filter(
    (item) =>
      String(item.status ?? "").toLowerCase() ===
      "recovered"
  ).length;

  function formatDate(value?: string | null) {
    if (!value) {
      return "—";
    }

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return value;
    }

    return date.toLocaleString("en-PH", {
      year: "numeric",
      month: "short",
      day: "numeric",
      hour: "numeric",
      minute: "2-digit",
    });
  }

  function getStatusClass(status: string) {
    const normalized = status.toLowerCase();

    if (normalized === "recovered") {
      return "bg-green-100 text-green-700";
    }

    if (normalized === "pending") {
      return "bg-amber-100 text-amber-800";
    }

    if (normalized === "claimed") {
      return "bg-green-100 text-green-700";
    }

    if (normalized === "lost") {
      return "bg-red-100 text-red-700";
    }

    return "bg-blue-100 text-blue-700";
  }

  return (
    <div className="w-full min-w-0 space-y-5">
      <PageHeader
        title="Lost & Found"
        subtitle="Manage found and lost item reports in one registry, credit finders, identify owners, and process recoveries."
      />

      {error && (
        <div className="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          {error}
        </div>
      )}

      {success && (
        <div className="rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700">
          {success}
        </div>
      )}

      <StatisticalCardsSection>
      <div className="grid grid-cols-2 gap-3 md:grid-cols-5">
        <StatCard
          label="Total Reports"
          value={String(periodItems.length)}
          icon={<BookOpen size={20} />}
          color="#1a3a7b"
        />

        <StatCard
          label="Found"
          value={String(foundCount)}
          icon={<Package size={20} />}
          color="#557bdc"
        />

        <StatCard
          label="Lost"
          value={String(lostCount)}
          icon={<AlertTriangle size={20} />}
          color="#e74c3c"
        />

        <StatCard
          label="Pending Claims"
          value={String(pendingClaimsCount)}
          icon={<Clock size={20} />}
          color="#2f5fd6"
        />

        <div className="col-span-2 md:col-span-1">
        <StatCard
          label="Recovered"
          value={String(recoveredCount)}
          icon={<CheckCircle size={20} />}
          color="#2ecc71"
        />
        </div>
      </div>
      </StatisticalCardsSection>

            

      
<div className="grid grid-cols-2 gap-2 border-b border-border pb-3 sm:flex sm:flex-wrap">
        
        <button
          type="button"
          aria-pressed={tab === "registry"}
          onClick={() => {
            setTab("registry");
            setError("");
          }}
          className="min-h-11 w-full rounded-full border px-4 py-2 text-xs font-semibold transition-colors sm:w-auto sm:px-5 sm:text-sm"
          ref={(button) => {
            if (!button) return;
            button.style.setProperty("background", "#ffffff", "important");
            button.style.setProperty("background-color", "#ffffff", "important");
            button.style.setProperty("color", "#17336d", "important");
            button.style.setProperty("border-color", "#c7d2fe", "important");
            button.style.setProperty("box-shadow", "none", "important");
          }}
          onMouseEnter={(event) => {
            event.currentTarget.style.setProperty("background", "#eef2ff", "important");
            event.currentTarget.style.setProperty("background-color", "#eef2ff", "important");
          }}
          onMouseLeave={(event) => {
            event.currentTarget.style.setProperty("background", "#ffffff", "important");
            event.currentTarget.style.setProperty("background-color", "#ffffff", "important");
          }}
          onFocus={(event) => {
            event.currentTarget.style.setProperty("background", "#ffffff", "important");
            event.currentTarget.style.setProperty("background-color", "#ffffff", "important");
          }}
        >
          Lost & Found Reports
        </button>

        
        <button
          type="button"
          aria-pressed={tab === "report"}
          onClick={() => {
            setTab("report");
            setError("");
            setSuccess("");
          }}
          className="min-h-11 w-full rounded-full border px-4 py-2 text-xs font-semibold transition-colors sm:w-auto sm:px-5 sm:text-sm"
          ref={(button) => {
            if (!button) return;
            button.style.setProperty("background", "#ffffff", "important");
            button.style.setProperty("background-color", "#ffffff", "important");
            button.style.setProperty("color", "#17336d", "important");
            button.style.setProperty("border-color", "#c7d2fe", "important");
            button.style.setProperty("box-shadow", "none", "important");
          }}
          onMouseEnter={(event) => {
            event.currentTarget.style.setProperty("background", "#eef2ff", "important");
            event.currentTarget.style.setProperty("background-color", "#eef2ff", "important");
          }}
          onMouseLeave={(event) => {
            event.currentTarget.style.setProperty("background", "#ffffff", "important");
            event.currentTarget.style.setProperty("background-color", "#ffffff", "important");
          }}
          onFocus={(event) => {
            event.currentTarget.style.setProperty("background", "#ffffff", "important");
            event.currentTarget.style.setProperty("background-color", "#ffffff", "important");
          }}
        >
          + Record Lost / Found Item
        </button>
      <button
        type="button"
        onClick={() => setShowLostFoundGuide(v => !v)}
        aria-expanded={showLostFoundGuide}
        aria-controls="csu-lost-found-guide"
        className="col-span-2 inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-xl border border-border bg-card px-4 py-2 text-xs font-semibold text-primary hover:bg-muted sm:ml-auto sm:w-auto sm:text-sm"
      >
        <BookOpen size={15} />
        How it works
        <ChevronRight
          size={14}
          className={`transition-transform ${showLostFoundGuide ? "rotate-90" : ""}`}
        />
      </button>
      </div>

      {/* Floating How It Works modal */}
      {showLostFoundGuide && (
        <div
          id="csu-lost-found-guide"
          className="fixed inset-0 z-[100] flex items-center justify-center bg-black/55 p-4 sm:p-6"
          role="dialog"
          aria-modal="true"
          aria-label="How Lost and Found works"
          onMouseDown={e => {
            if (e.target === e.currentTarget) {
              setShowLostFoundGuide(false);
            }
          }}
        >
          <div className="relative w-full max-w-5xl max-h-[90vh] overflow-y-auto rounded-[26px] border border-[#cfd8e6] bg-card p-6 shadow-2xl sm:p-8">

            <button
              type="button"
              aria-label="Close guide"
              onClick={() => setShowLostFoundGuide(false)}
              className="absolute right-4 top-4 rounded-xl border border-border p-2.5 hover:bg-muted"
            >
              <X size={20} />
            </button>

            <div className="mb-6 pr-12">
              <h3 className="text-lg font-bold text-foreground sm:text-xl">
                {tab === "registry"
                  ? "How Lost & Found Reports Work"
                  : "How Lost & Found Reporting Works"}
              </h3>

              <p className="mt-2 max-w-3xl text-sm leading-7 text-muted-foreground">
                {tab === "registry"
                  ? "View existing records, check the status of an item, and manage recovery or claims. Found Item is for an item surrendered to Security, while Lost Item is for an item reported missing."
                  : "Choose the matching category, enter the identifying details, and save the report for monitoring and verification."}
              </p>
            </div>

            <div className="grid grid-cols-1 gap-4 md:grid-cols-3">
              {(tab === "registry"
                ? [
                    ["1", "Find a Report", "Use Search or Refresh to quickly locate an existing Lost or Found record."],
                    ["2", "Review Details", "Check the item information, owner or finder details, location, and current recovery status."],
                    ["3", "Manage the Case", "Use Edit Report or the available recovery and claim actions based on the situation."],
                  ]
                : [
                    ["1", "Choose Category", "Select the item category that best matches the reported item."],
                    ["2", "Complete Details", "Enter identifying details, the owner or finder ID, location, and date and time."],
                    ["3", "Save the Report", "Security saves the record for recovery, claiming, or further verification."],
                  ]
              ).map(([number, title, description]) => (
                <div
                  key={number}
                  className="rounded-2xl border border-[#dce3ee] bg-[#f8fafc] p-5 dark:bg-muted/40 sm:p-6"
                >
                  <div className="flex items-start gap-4">
                    <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-white">
                      {number}
                    </div>

                    <div className="min-w-0">
                      <p className="text-sm font-semibold text-foreground">
                        {title}
                      </p>

                      <p className="mt-2 text-xs leading-6 text-muted-foreground sm:text-sm">
                        {description}
                      </p>
                    </div>
                  </div>
                </div>
              ))}
            </div>

          </div>
        </div>
      )}
      {tab === "registry" && (
        <div className="space-y-4">
          
          <CSURecordToolbar
            search={search} onSearch={setSearch}
            sort={csuListSort} onSort={setCsuListSort}
            onRefresh={loadItems} loading={loading}
            placeholder="Search report, item, owner/finder, claimant..."
            filter={
              <select
                aria-label="Filter Lost and Found reports"
                value={lostFoundFilter}
                onChange={(e) =>
                  setLostFoundFilter(
                    e.target.value as
                      "all" | "lost" | "found" | "recovered"
                  )
                }
                className="h-12 min-w-[170px] max-w-full flex-1 rounded-xl border border-[#bfceff] px-3 text-sm text-foreground outline-none focus:border-[#6488ff] dark:border-[#35537e] dark:bg-[#1b2b49] sm:flex-none !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
              >
                <option value="all">
                  All Reports ({periodItems.length})
                </option>
                <option value="lost">
                  Lost ({periodItems.filter(item =>
                    String(item.report_type ?? "").toLowerCase() === "lost" &&
                    !["claimed", "recovered"].includes(
                      String(item.status ?? "").toLowerCase()
                    )
                  ).length})
                </option>
                <option value="found">
                  Found ({periodItems.filter(item =>
                    String(item.report_type ?? "found").toLowerCase() === "found" &&
                    !["claimed", "recovered"].includes(
                      String(item.status ?? "").toLowerCase()
                    )
                  ).length})
                </option>
                <option value="recovered">
                  Recovered / Claimed ({periodItems.filter(item =>
                    ["recovered", "claimed"].includes(
                      String(item.status ?? "").toLowerCase()
                    )
                  ).length})
                </option>
              </select>
            }
          />
          


          {loading && (
            <div className="rounded-lg border border-[#cfd8e6] bg-card p-10 text-center text-sm text-muted-foreground">
              Loading Lost & Found records...
            </div>
          )}

          {!loading && filteredItems.length === 0 && (
            <div className="rounded-lg border border-[#cfd8e6] bg-card p-10 text-center">
              <BookOpen
                size={32}
                className="mx-auto mb-3 text-muted-foreground"
              />

              <p className="text-sm font-medium text-foreground">
                No Lost & Found records found.
              </p>

              <p className="mt-1 text-xs text-muted-foreground">
                Use the Record Lost / Found Item tab above, then choose the report type from the dropdown.
              </p>
            </div>
          )}

          {!loading &&
            shownLostFound.map((item) => {
              const reportType = String(
                item.report_type ?? "found"
              ).toLowerCase();
              const isLostReport = reportType === "lost";

              const status = String(
                item.status ??
                  (isLostReport ? "Lost" : "Found")
              );
              const statusLower = status.toLowerCase();
              const isPending = statusLower === "pending";
              const isClaimed = statusLower === "claimed";
              const isRecovered =
                statusLower === "recovered";
              const isLost =
                isLostReport && statusLower === "lost";

              return (
                <div
                  key={item.id}
                  className="w-full min-w-0 rounded-xl border border-border bg-card shadow-sm"
                >
                  <div className="p-4">
                    <div className="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                      <div className="min-w-0 flex-1">
                        <div className="flex flex-wrap items-center gap-2">
                          <h3 className="text-base font-semibold text-foreground">
                            {item.item_name}
                          </h3>

                          <span
                            className={`rounded-full px-2 py-0.5 text-xs font-medium ${
                              isLostReport
                                ? "bg-red-100 text-red-700"
                                : "bg-blue-100 text-blue-700"
                            }`}
                          >
                            {isLostReport
                              ? "Lost Report"
                              : "Found Report"}
                          </span>

                          <span
                            className={`rounded-full px-2 py-0.5 text-xs font-medium ${getStatusClass(
                              status
                            )}`}
                          >
                            {status}
                          </span>

                          <span className="rounded-full bg-muted px-2 py-0.5 text-xs text-muted-foreground">
                            Report #{item.id}
                          </span>
                        </div>

                        <div className="mt-4 grid grid-cols-1 gap-x-6 gap-y-3 text-sm sm:grid-cols-2 lg:grid-cols-3">
                          <div>
                            <p className="text-xs text-muted-foreground">
                              Category
                            </p>
                            <p className="font-medium text-foreground">
                              {item.category || "—"}
                            </p>
                          </div>

                          <div>
                            <p className="text-xs text-muted-foreground">
                              Brand / Model
                            </p>
                            <p className="font-medium text-foreground">
                              {item.brand_model || "—"}
                            </p>
                          </div>

                          <div>
                            <p className="text-xs text-muted-foreground">
                              Color
                            </p>
                            <p className="font-medium text-foreground">
                              {item.color || "—"}
                            </p>
                          </div>

                          <div>
                            <p className="text-xs text-muted-foreground">
                              {isLostReport
                                ? "Last Seen Location"
                                : "Location Found"}
                            </p>
                            <p className="font-medium text-foreground">
                              {(isLostReport
                                ? item.location_lost
                                : item.location_found) || "—"}
                            </p>
                          </div>

                          <div>
                            <p className="text-xs text-muted-foreground">
                              {isLostReport
                                ? "Date & Time Lost / Last Seen"
                                : "Date & Time Found"}
                            </p>
                            <p className="font-medium text-foreground">
                              {formatDate(
                                isLostReport
                                  ? item.date_lost
                                  : item.date_found
                              )}
                            </p>
                          </div>

                          <div>
                            <p className="text-xs text-muted-foreground">
                              Date Reported
                            </p>
                            <p className="font-medium text-foreground">
                              {formatDate(item.created_at)}
                            </p>
                          </div>
                        </div>

                        {isLostReport ? (
                          <div className="mt-4 rounded-lg border border-red-200 bg-red-50 p-3 dark:border-red-700/60 dark:bg-red-950/40">
                            <div className="flex items-start gap-2">
                              <User
                                size={15}
                                className="mt-0.5 flex-shrink-0 text-red-700 dark:text-red-300"
                              />

                              <div>
                                <p className="text-xs font-semibold text-red-800 dark:text-red-200">
                                  Reported Lost By / Owner
                                </p>
                                <p className="mt-1 text-sm font-medium text-red-900 dark:text-red-100">
                                  {item.lost_by?.name ||
                                    "Not available"}
                                </p>
                                {item.lost_by?.username && (
                                  <p className="text-xs text-red-700 dark:text-red-300">
                                    ID: {item.lost_by.username}
                                  </p>
                                )}
                              </div>
                            </div>
                          </div>
                        ) : (
                          <div className="mt-4 rounded-lg border border-green-200 bg-green-50 p-3 dark:border-emerald-700/60 dark:bg-emerald-950/40">
                            <div className="flex items-start gap-2">
                              <User
                                size={15}
                                className="mt-0.5 flex-shrink-0 text-green-700 dark:text-emerald-300"
                              />

                              <div>
                                <p className="text-xs font-semibold text-green-800 dark:text-emerald-200">
                                  Turned Over By / Finder Credit
                                </p>
                                <p className="mt-1 text-sm font-medium text-green-900 dark:text-emerald-100">
                                  {item.finder?.name ||
                                    "Not available"}
                                </p>
                                {item.finder?.username && (
                                  <p className="text-xs text-green-700 dark:text-emerald-300">
                                    ID: {item.finder.username}
                                  </p>
                                )}
                              </div>
                            </div>
                          </div>
                        )}

                        {isLostReport && isRecovered && (
                          <div className="mt-3 rounded-lg border border-green-200 bg-green-50 p-3">
                            <div className="flex items-start gap-2">
                              <User
                                size={15}
                                className="mt-0.5 flex-shrink-0 text-green-700 dark:text-emerald-300"
                              />
                              <div>
                                <p className="text-xs font-semibold text-green-800 dark:text-emerald-200">
                                  Found / Turned Over By
                                </p>
                                <p className="mt-1 text-sm font-medium text-green-900 dark:text-emerald-100">
                                  {item.finder?.name || "Not available"}
                                </p>
                                {item.finder?.username && (
                                  <p className="text-xs text-green-700 dark:text-emerald-300">
                                    ID: {item.finder.username}
                                  </p>
                                )}
                                <p className="mt-2 text-xs text-green-700 dark:text-emerald-300">
                                  Turnover location: {item.location_found || "—"}
                                </p>
                                <p className="text-xs text-green-700 dark:text-emerald-300">
                                  Turned over: {formatDate(item.date_found)}
                                </p>
                              </div>
                            </div>
                          </div>
                        )}

                        <div className="mt-3 rounded-lg border border-blue-100 bg-blue-50/50 p-3 dark:border-slate-600 dark:bg-slate-800/90">
                          <p className="text-xs text-muted-foreground">
                            Processed by Security
                          </p>
                          <p className="mt-0.5 text-sm font-medium text-foreground">
                            {item.processor?.name ||
                              item.reporter?.name ||
                              "—"}
                          </p>
                        </div>

                        {!isLostReport && item.claimant && (
                          <div className="mt-3 rounded-lg border border-yellow-200 bg-yellow-50 p-3 dark:border-amber-700/60 dark:bg-amber-950/40">
                            <p className="text-xs font-semibold text-yellow-800 dark:text-amber-200">
                              Claimant
                            </p>
                            <p className="mt-1 text-sm font-medium text-yellow-900 dark:text-amber-100">
                              {item.claimant.name}
                            </p>
                            {item.claimant.username && (
                              <p className="text-xs text-yellow-700 dark:text-amber-300">
                                ID: {item.claimant.username}
                              </p>
                            )}
                            {item.claimed_at && (
                              <p className="mt-1 text-xs text-yellow-700 dark:text-amber-300">
                                Claim submitted:{" "}
                                {formatDate(item.claimed_at)}
                              </p>
                            )}
                          </div>
                        )}

                        {item.photo_url && (
                          <div className="mt-3 rounded-xl border border-[#cfd8e6] bg-muted/20 p-3">
                            <p className="mb-2 text-xs font-medium text-muted-foreground">
                              Item Photo
                            </p>

                            <div className="flex flex-col items-center gap-3">
                              <button
                                type="button"
                                onClick={() =>
                                  setFullImage({
                                    url: item.photo_url,
                                    name:
                                      item.item_name ||
                                      "Lost and Found item",
                                  })
                                }
                                className="group flex w-full max-w-sm items-center justify-center overflow-hidden rounded-lg border border-[#cfd8e6] bg-background"
                                style={{ height: "220px" }}
                                title="View full image"
                              >
                                <img
                                  src={item.photo_url}
                                  alt={`${item.item_name || "Lost and Found item"} photo`}
                                  className="h-full w-full object-contain transition-transform duration-200 group-hover:scale-[1.02]"
                                />
                              </button>

                              <button
                                type="button"
                                onClick={() =>
                                  setFullImage({
                                    url: item.photo_url,
                                    name:
                                      item.item_name ||
                                      "Lost and Found item",
                                  })
                                }
                                className="rounded-lg border border-[#cfd8e6] bg-background px-4 py-2 text-sm font-medium text-primary transition hover:bg-[#eef2fc]"
          >
                                View Full Image
                              </button>
                            </div>
                          </div>
                        )}

                        {item.description && (
                          <div className="mt-3 rounded-lg bg-muted/40 p-3">
                            <p className="text-xs font-medium text-muted-foreground">
                              Description
                            </p>
                            <p className="mt-1 whitespace-pre-wrap break-words text-sm text-foreground">
                              {item.description}
                            </p>
                          </div>
                        )}
                      </div>

                      <div className="flex flex-shrink-0 flex-col gap-2">
                        <button
                          type="button"
                          onClick={() =>
                            openEditReport(item)
                          }
                          className="rounded-lg border border-[#cfd8e6] bg-white px-4 py-2 text-sm font-medium text-primary hover:bg-[#eef2fc]"
          >
                          Edit Report
                        </button>

                        {!isPending && !isClaimed && !isRecovered && (
                          <button
                            type="button"
                            disabled={
                              deletingId === Number(item.id)
                            }
                            onClick={() =>
                              handleDeleteReport(item)
                            }
                            className="rounded-lg border border-red-300 bg-red-50 px-4 py-2 text-sm font-medium text-red-700 transition hover:bg-red-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-red-700/70 dark:bg-red-950/35 dark:text-red-300 dark:hover:bg-red-950/55"
                          >
                            {deletingId === Number(item.id)
                              ? "Deleting..."
                              : "Delete Report"}
                          </button>
                        )}

                        {(isPending || isLost) && !isRecovered && (
                          <button
                            type="button"
                            disabled={
                              recoveringId === Number(item.id)
                            }
                            onClick={() =>
                              handleRecovered(item)
                            }
                            className="rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
                          >
                            {recoveringId === Number(item.id)
                              ? "Processing..."
                              : isLostReport
                              ? "Record Recovery"
                              : "Verify Claim & Mark Claimed"}
                          </button>
                        )}

                        {isClaimed && (
                          <div className="rounded-lg border border-green-200 bg-green-50 px-3 py-2 text-xs font-medium text-green-700">
                            CSU verified ownership — Item Claimed
                          </div>
                        )}

                        {isRecovered && (
                          <div className="rounded-lg border border-green-200 bg-green-50 px-3 py-2 text-xs font-medium text-green-700">
                            Item recovered / returned to owner
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              );
            })}
        </div>
      )}

      {tab === "report" && (
        <div className="w-full min-w-0 rounded-xl border border-border bg-card shadow-sm">
          {selectedReportGroup ? (
            <>
          <div className="flex flex-col gap-3 border-b border-[#cfd8e6] px-4 py-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
            <h3 className="font-semibold text-foreground">
              {reportMode === "found"
                ? "Report Found Item"
                : "Report Lost Item"}
            </h3>

            <p className="mt-1 text-xs text-muted-foreground">
              {reportMode === "found"
                ? "Use this form after a found item has been physically surrendered to the Security office."
                : "Use this form when a student or employee reports an item as lost or missing."}
            </p>
            </div>
            <button
              type="button"
              onClick={() => {
                setSelectedReportGroup(null);
                setError("");
              }}
              className="inline-flex h-10 items-center justify-center rounded-xl border border-[#cfd8e6] bg-white px-4 text-xs font-semibold text-primary hover:bg-[#eef2fc]"
          >
              Change Category
            </button>
          </div>

          <form
            onSubmit={handleSubmit}
            className="space-y-5 p-4"
          >
            <div className="rounded-lg border border-[#cfd8e6] bg-muted/30 p-4">
              <label className="mb-1 block text-xs font-medium text-foreground">
                Report Type *
              </label>

              <select
                value={reportMode}
                onChange={(e) => {
                  const nextMode = e.target.value as "found" | "lost";
                  setReportMode(nextMode);
                  setError("");
                  setSuccess("");
                }}
                className="w-full rounded-lg border border-[#cfd8e6] px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-primary/20 !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
              >
                <option value="found">Found Item</option>
                <option value="lost">Lost Item</option>
              </select>

              <p className="mt-2 text-xs text-muted-foreground">
                Choose whether Security is recording an item that was found and turned over, or an item reported as lost. The required fields below will change automatically.
              </p>
            </div>

            {reportMode === "found" ? (
              <div className="rounded-lg border border-green-200 bg-green-50 p-4">
                <div className="mb-3">
                  <p className="text-sm font-semibold text-green-900">
                    Finder / Turnover Credit
                  </p>
                  <p className="mt-1 text-xs text-green-700">
                    Enter the Student or Employee ID of the person who found and physically turned over the item.
                  </p>
                </div>

                <label className="mb-1 block text-xs font-medium text-green-900">
                  Finder Student / Employee ID *
                </label>

                <input
                  type="text"
                  name="found_by_identifier"
                  value={form.found_by_identifier}
                  onChange={handleFormChange}
                  required
                  placeholder="Example: 26-9999"
                  className="w-full rounded-lg border border-green-300 px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-green-200 !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
                />
              </div>
            ) : (
              <div className="rounded-lg border border-red-200 bg-red-50 p-4">
                <div className="mb-3">
                  <p className="text-sm font-semibold text-red-900">
                    Person Reporting Lost Item
                  </p>
                  <p className="mt-1 text-xs text-red-700">
                    Enter the Student or Employee ID of the person who owns and reported the missing item.
                  </p>
                </div>

                <label className="mb-1 block text-xs font-medium text-red-900">
                  Owner Student / Employee ID *
                </label>

                <input
                  type="text"
                  name="lost_by_identifier"
                  value={form.lost_by_identifier}
                  onChange={handleFormChange}
                  required
                  placeholder="Example: 26-9999"
                  className="w-full rounded-lg border border-red-300 px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-red-200 !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
                />
              </div>
            )}

            {/* Simple item identification fields. No permit-only specifications. */}
            <section className="overflow-hidden rounded-[14px] border border-[#dce3ee] bg-white">
              <div className="flex items-center gap-3 border-b border-[#dce3ee] px-3 py-4 sm:px-5">
                <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#dce3ee] bg-[#f2f5fb] text-[#16224b]">
                  {activeReportCategory?.icon}
                </div>
                <div>
                  <h3 className="text-base font-semibold text-foreground">
                    {activeReportCategory?.name}
                  </h3>
                  <p className="mt-0.5 text-xs text-muted-foreground">
                    Item Identification Details
                  </p>
                </div>
              </div>
              <div className="p-3 sm:p-5">
                {renderStudentStyleReportFields()}
              </div>
            </section>

            <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
              <div>
                <CSULocationPicker
                  label={reportMode === "found" ? "Location Found" : "Last Seen Location"}
                  value={reportMode === "found" ? form.location_found : form.location_lost}
                  onChange={value => setForm(current => ({
                    ...current,
                    [reportMode === "found" ? "location_found" : "location_lost"]: value,
                  }))}
                />
              </div>

              <div>
                <label className="mb-1 block text-xs font-medium text-foreground">
                  {reportMode === "found"
                    ? "Date & Time Found *"
                    : "Date & Time Lost / Last Seen *"}
                </label>
                <input
                  type="datetime-local"
                  name={
                    reportMode === "found"
                      ? "date_found"
                      : "date_lost"
                  }
                  value={
                    reportMode === "found"
                      ? form.date_found
                      : form.date_lost
                  }
                  onChange={handleFormChange}
                  required
                  className="w-full rounded-lg border border-[#cfd8e6] px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-primary/20 !bg-white hover:!bg-[#eef2ff] focus:!bg-white"
                />
              </div>
            </div>

            <div>
              <label className="mb-1 block text-xs font-medium text-foreground">
                Item Description
              </label>
              <textarea
                name="description"
                value={form.description}
                onChange={handleFormChange}
                rows={4}
                placeholder="Describe identifying features, case, stickers, scratches, accessories, or other useful details."
                className="w-full resize-none rounded-lg border border-[#cfd8e6] bg-background px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-primary/20"
              />
            </div>

            <div className="rounded-lg border border-[#cfd8e6] bg-muted/20 p-4">
              <div className="mb-3">
                <p className="text-sm font-semibold text-foreground">
                  Item Photo
                </p>
                <p className="mt-1 text-xs text-muted-foreground">
                  Optional. CSU can take a photo on a phone or upload an existing image. JPG, PNG, or WEBP up to 5 MB.
                </p>
              </div>

              <div className="flex flex-col gap-2 sm:flex-row sm:items-center">
                <button
                  ref={photoUploadButtonRef}
                  type="button"
                  onClick={openPhotoPicker}
                  className="inline-flex items-center justify-center gap-2 rounded-lg border border-[#cfd8e6] bg-background px-4 py-2 text-sm font-medium text-foreground hover:bg-muted"
                >
                  <Upload size={16} />
                  Upload Photo
                </button>

                <button
                  type="button"
                  onClick={() => {
                    setCameraError("");
                    setCameraOpen(true);
                  }}
                  className="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:!bg-[#eef2ff] hover:!text-[#17336d] hover:!border-[#a8bde4] focus-visible:!ring-0 focus-visible:!shadow-none"
          >
                  <Camera size={16} />
                  Use Camera
                </button>
              </div>

              <input
                ref={photoInputRef}
                id="lost-found-photo"
                type="file"
                accept="image/jpeg,image/png,image/webp"
                onChange={handlePhotoChange}
                tabIndex={-1}
                aria-hidden="true"
                style={{ display: "none" }}
              />

              {cameraOpen && (
                <div className="fixed inset-0 z-[120] flex items-center justify-center bg-black/70 p-4">
                  <div className="w-full max-w-2xl rounded-xl bg-card p-4 shadow-2xl">
                    <div className="mb-3 flex items-center justify-between gap-3">
                      <div>
                        <h3 className="text-base font-semibold text-foreground">
                          Take Item Photo
                        </h3>
                        <p className="mt-1 text-xs text-muted-foreground">
                          Allow camera access, position the item clearly, then capture the photo.
                        </p>
                      </div>

                      <button
                        type="button"
                        onClick={closeCamera}
                        className="rounded-lg p-2 text-muted-foreground hover:bg-muted hover:text-foreground"
                      >
                        <X size={20} />
                      </button>
                    </div>

                    <div className="overflow-hidden rounded-lg bg-black">
                      <video
                        ref={videoRef}
                        autoPlay
                        playsInline
                        muted
                        className="max-h-[60vh] w-full object-contain"
                      />
                    </div>

                    {cameraError && (
                      <div className="mt-3 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
                        {cameraError}
                      </div>
                    )}

                    <div className="mt-4 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
                      <button
                        type="button"
                        onClick={closeCamera}
                        className="rounded-lg border border-[#cfd8e6] bg-background px-4 py-2 text-sm font-medium !bg-white !text-[#17336d] !border-[#cbd5e1] transition-colors hover:!bg-[#eef2ff] hover:!border-[#a8bde4] hover:!text-[#17336d] focus-visible:!ring-0 focus-visible:!shadow-none focus-visible:!outline-none"
                       
            onMouseEnter={(e) => {
              const el=e.currentTarget;
              if(!el.dataset.qrpassV158Saved) {
                el.dataset.qrpassV158Saved=el.style.cssText || " ";
              }
              el.style.setProperty("background", "#eef2ff", "important");
              el.style.setProperty("background-color", "#eef2ff", "important");
              el.style.setProperty("background-image", "none", "important");
              el.style.setProperty("color", "#17336d", "important");
              el.style.setProperty("border-color", "#a8bde4", "important");
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onMouseLeave={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onFocus={(e) => {
              e.currentTarget.style.setProperty("box-shadow", "none", "important");
              e.currentTarget.style.setProperty("outline", "none", "important");
            }}
            onBlur={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}

           data-qrpass-neutral-v169="true">
                        Cancel
                      </button>

                      <button
                        type="button"
                        onClick={captureCameraPhoto}
                        disabled={Boolean(cameraError)}
                        className="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground disabled:cursor-not-allowed disabled:opacity-50 transition-colors hover:!bg-[#eef2ff] hover:!text-[#17336d] hover:!border-[#a8bde4] focus-visible:!ring-0 focus-visible:!shadow-none"
          >
                        <Camera size={16} />
                        Capture Photo
                      </button>
                    </div>
                  </div>
                </div>
              )}

              <div className="mt-4">
                {photoFile ? (
                  <div className="flex flex-col gap-3 rounded-lg border border-green-200 bg-green-50 p-3 sm:flex-row sm:items-center sm:justify-between dark:border-green-900/70 dark:bg-green-950/30">
                    <div className="min-w-0">
                      <p className="text-xs font-semibold text-green-800 dark:text-green-300">
                        Photo selected
                      </p>
                      <p className="mt-1 truncate text-xs text-green-700 dark:text-green-400">
                        {photoFile.name}
                      </p>
                      <p className="mt-1 text-[11px] text-green-600 dark:text-green-500">
                        The photo will be uploaded when you submit this report.
                      </p>
                    </div>

                    <button
                      type="button"
                      onClick={clearPhoto}
                      className="flex-shrink-0 rounded-lg border border-red-200 bg-white px-3 py-2 text-xs font-medium text-red-700 hover:bg-red-50 dark:border-red-900/70 dark:bg-red-950/20 dark:text-red-300 dark:hover:bg-red-950/40"
                    >
                      Remove Photo
                    </button>
                  </div>
                ) : (
                  <div className="rounded-lg border border-dashed border-[#cfd8e6] bg-background px-4 py-3 text-xs text-muted-foreground">
                    No photo selected. You may upload a JPG, PNG, or WEBP image up to 5 MB.
                  </div>
                )}
              </div>
            </div>

            <div
              className={`rounded-lg border px-4 py-3 ${
                reportMode === "found"
                  ? "border-yellow-200 bg-yellow-50"
                  : "border-red-200 bg-red-50"
              }`}
            >
              <p
                className={`text-xs ${
                  reportMode === "found"
                    ? "text-yellow-800"
                    : "text-red-800"
                }`}
              >
                {reportMode === "found"
                  ? "Confirm that the item has already been physically received by Security before saving this record."
                  : "Confirm the owner's identity and the reported last-seen information before saving this lost-item report."}
              </p>
            </div>

            <div className="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
              <button
                type="button"
                onClick={() => {
                  clearForm();
                  setTab("registry");
                  setError("");
                  setSuccess("");
                }}
                className="rounded-lg border border-[#cfd8e6] bg-background px-5 py-2 text-sm font-medium !bg-white !text-[#17336d] !border-[#cbd5e1] transition-colors hover:!bg-[#eef2ff] hover:!border-[#a8bde4] hover:!text-[#17336d] focus-visible:!ring-0 focus-visible:!shadow-none focus-visible:!outline-none"
               
            onMouseEnter={(e) => {
              const el=e.currentTarget;
              if(!el.dataset.qrpassV158Saved) {
                el.dataset.qrpassV158Saved=el.style.cssText || " ";
              }
              el.style.setProperty("background", "#eef2ff", "important");
              el.style.setProperty("background-color", "#eef2ff", "important");
              el.style.setProperty("background-image", "none", "important");
              el.style.setProperty("color", "#17336d", "important");
              el.style.setProperty("border-color", "#a8bde4", "important");
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onMouseLeave={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}
            onFocus={(e) => {
              e.currentTarget.style.setProperty("box-shadow", "none", "important");
              e.currentTarget.style.setProperty("outline", "none", "important");
            }}
            onBlur={(e) => {
              const el=e.currentTarget;
              if(el.dataset.qrpassV158Saved) {
                el.style.cssText=el.dataset.qrpassV158Saved===" " ? "" : el.dataset.qrpassV158Saved;
                delete el.dataset.qrpassV158Saved;
              }
              el.style.setProperty("box-shadow", "none", "important");
              el.style.setProperty("outline", "none", "important");
            }}

           data-qrpass-neutral-v169="true">
                Cancel
              </button>

              <button
                type="submit"
                disabled={submitting}
                className="rounded-lg bg-primary px-5 py-2 text-sm font-medium text-primary-foreground disabled:cursor-not-allowed disabled:opacity-50 transition-colors hover:!bg-[#eef2ff] hover:!text-[#17336d] hover:!border-[#a8bde4] focus-visible:!ring-0 focus-visible:!shadow-none"
          >
                {submitting
                  ? "Saving..."
                  : reportMode === "found"
                  ? "Report Found Item"
                  : "Report Lost Item"}
              </button>
            </div>
          </form>
            </>
          ) : (
            <div className="space-y-5">
              <div className="overflow-hidden rounded-xl border border-[#cfd8e6] bg-card">
                <div className="border-b border-[#cfd8e6] px-5 py-4">
                  <h3 className="text-sm font-semibold text-foreground">
                    Select an Item Category
                  </h3>
                </div>
                <div className="divide-y divide-[#dce3ee]">
                  {reportCategories.map((category) => (
                    <button
                      key={category.id}
                      type="button"
                      onClick={() => chooseReportCategory(category.id)}
                      className="group flex w-full min-w-0 items-center gap-3 px-3 py-3.5 text-left transition-colors hover:bg-[#eef2fc]/10 sm:gap-4 sm:px-5"
          >
                      <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-[#d6dde8] bg-white text-[#1a3a7b]">
                        {category.icon}
                      </div>
                      <div className="min-w-0 flex-1">
                        <p className="text-sm font-semibold text-foreground">
                          {category.name}
                        </p>
                      </div>
                      <ChevronRight
                        size={17}
                        className="shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5 group-hover:text-primary"
                      />
                    </button>
                  ))}
                </div>
              </div>

            </div>
          )}
        </div>
      )}

      {editingItem && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4">
          <div className="max-h-[calc(100dvh-2rem)] w-full max-w-2xl overflow-y-auto rounded-xl border border-border bg-card shadow-xl">

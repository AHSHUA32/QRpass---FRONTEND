/* QRPASS_SYSADMIN_HIDE_SEARCH_V24
   Hide Sysadmin search UI while preserving Lost & Found and all other roles.
   Only visual search fields disappear; existing page data/filter logic is not modified. */

/* Standard Sysadmin page, excluding the Lost & Found nav page. */
.qrpass-admin-page.qrpass-sysadmin-hide-search-v24 :is(input,textarea):is([type="search"],[placeholder^="Search"],[placeholder^="search"],[aria-label^="Search"],[aria-label^="search"]):not([aria-label="Search PCO registered items"]):not([aria-label="Search user accounts"]) {
  display: none !important;
}

/* Remove the empty search icon + input container without removing adjacent filters. */
.qrpass-admin-page.qrpass-sysadmin-hide-search-v24 :is(div,label,form):has(> input:is([type="search"],[placeholder^="Search"],[placeholder^="search"],[aria-label^="Search"])):not(:has(> input[aria-label="Search PCO registered items"])):not(:has(> input[aria-label="Search user accounts"])):not(:has(> button)):not(:has(> select)) {
  display: none !important;
}

/* System Logs Manage Logs is a React portal outside .qrpass-admin-page. */
[role="dialog"][aria-label="Manage System Logs"] :is(input,textarea)[aria-label="Search managed logs"],
[role="dialog"][aria-label="Manage System Logs"] div:has(> input[aria-label="Search managed logs"]) {
  display: none !important;
}


/* QRPASS_ADMIN_SEARCH_WHITE_HOVER_V25 */

/* Sysadmin Registered Items and User Accounts only */
.qrpass-admin-page input[aria-label="Search PCO registered items"],
.qrpass-admin-page input[aria-label="Search user accounts"] {
    background-color: #ffffff !important;
    color: #17336d !important;
    border-color: #c7d2fe !important;
    transition: background-color 180ms ease, border-color 180ms ease;
}

.qrpass-admin-page input[aria-label="Search PCO registered items"]:hover,
.qrpass-admin-page input[aria-label="Search user accounts"]:hover {
    background-color: #eef2ff !important;
}

.qrpass-admin-page input[aria-label="Search PCO registered items"]:focus,
.qrpass-admin-page input[aria-label="Search user accounts"]:focus {
    background-color: #ffffff !important;
    border-color: #5278e7 !important;
    outline: none !important;
    box-shadow: 0 0 0 2px rgba(82, 120, 231, 0.15);
}
/* QRPASS_RESTORE_SEARCH_V26 */
.qrpass-admin-page label:has(> input[aria-label="Search PCO registered items"]),
.qrpass-admin-page div:has(> input[aria-label="Search user accounts"]) { display: block !important; }
.qrpass-admin-page input[aria-label="Search PCO registered items"],
.qrpass-admin-page input[aria-label="Search user accounts"] { display: block !important; background-color: #fff !important; color: #17336d !important; border-color: #c7d2fe !important; transition: background-color .18s ease, border-color .18s ease; }
.qrpass-admin-page input[aria-label="Search PCO registered items"]:hover,
.qrpass-admin-page input[aria-label="Search user accounts"]:hover { background-color: #eef2ff !important; }
.qrpass-admin-page input[aria-label="Search PCO registered items"]:focus,
.qrpass-admin-page input[aria-label="Search user accounts"]:focus { background-color: #fff !important; border-color: #5278e7 !important; }


/* QRPASS SYSADMIN STANDARD SEARCH — LOST & FOUND STYLE */

.qrpass-admin-page input[aria-label="Search PCO registered items"],
.qrpass-admin-page input[aria-label="Search user accounts"] {
    display: block !important;
    width: 100% !important;
    min-width: 0 !important;
    height: 48px !important;
    padding: 0 16px 0 40px !important;
    border: 1px solid #c7d2fe !important;
    border-radius: 12px !important;
    background: #ffffff !important;
    color: #17336d !important;
    font-size: 14px !important;
    outline: none !important;
    transition: background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease !important;
}

.qrpass-admin-page input[aria-label="Search PCO registered items"]:hover,
.qrpass-admin-page input[aria-label="Search user accounts"]:hover {
    background: #eef2ff !important;
}

.qrpass-admin-page input[aria-label="Search PCO registered items"]:focus,
.qrpass-admin-page input[aria-label="Search user accounts"]:focus {
    background: #ffffff !important;
    border-color: #5278e7 !important;
    box-shadow: 0 0 0 2px rgba(82, 120, 231, 0.20) !important;
}

.qrpass-admin-page input[aria-label="Search PCO registered items"]::placeholder,
.qrpass-admin-page input[aria-label="Search user accounts"]::placeholder {
    color: #8292ae !important;
    opacity: 1 !important;
}